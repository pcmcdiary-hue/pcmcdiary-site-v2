---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFile } from 'node:fs/promises';
import path from 'node:path';

export async function getStaticPaths() {
  const DATA_DIR = path.resolve('./src/data');
  const catFile = path.join(DATA_DIR, 'categories.json');
  const catsRaw = await readFile(catFile, 'utf8');
  const categories = (JSON.parse(catsRaw).categories) || [];

  const allPaths = [];

  for (const cat of categories) {
    try {
      const bizFile = path.join(DATA_DIR, 'clients', cat.file);
      const bizRaw = await readFile(bizFile, 'utf8');
      const businesses = JSON.parse(bizRaw);
      if (!Array.isArray(businesses)) continue;

      for (const biz of businesses) {
        if (!biz.businessId) continue;
        allPaths.push({
          params: { id: biz.businessId },
          props: { biz, category: cat }
        });
      }
    } catch (e) {}
  }

  return allPaths;
}

const { biz, category } = Astro.props;
const name = biz.businessName || 'Business';
const phone = (biz.phone || '').replace(/\s/g, '');
const waPhone = phone.replace(/^91/, '');
const rating = parseFloat(biz.rating) || 0;
const reviews = parseInt(biz.reviews) || 0;

const tier = (biz.tier || '').toLowerCase();
const isVerified = ['featured','premium','premium_pro','vp','vb'].includes(tier);
const isFeatured = tier === 'featured';
const isPro = ['premium_pro','premium'].includes(tier);
const tierLabel = isFeatured ? 'Featured' : (isPro ? 'Premium' : (isVerified ? 'Verified' : ''));
const tierClass = isFeatured ? 'tier-featured' : (isPro ? 'tier-premium' : 'tier-verified');
const tierIcon = isFeatured ? 'fa-star' : (isPro ? 'fa-crown' : 'fa-circle-check');

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": name,
  "telephone": phone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": biz.address || '',
    "addressLocality": biz.location || '',
    "addressRegion": "Maharashtra",
    "postalCode": String(biz.pincode || '').replace('.0','')
  },
  "aggregateRating": rating > 0 ? {
    "@type": "AggregateRating",
    "ratingValue": rating,
    "reviewCount": reviews || 1
  } : undefined
};
---

<BaseLayout
  title={name + ' — ' + (biz.subCategory || category.categoryName) + ' in ' + (biz.location || 'PCMC')}
  description={(biz.description || name + ' in ' + (biz.location || 'PCMC') + '. Call ' + phone)}
>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="biz-page">
    <div class="biz-container">

      <nav class="breadcrumb">
        <a href="/"><i class="fa-solid fa-house"></i> Home</a>
        <i class="fa-solid fa-chevron-right sep"></i>
        <a href="/directory">Directory</a>
        <i class="fa-solid fa-chevron-right sep"></i>
        <a href={'/category/' + category.categoryId}>{category.categoryName}</a>
        <i class="fa-solid fa-chevron-right sep"></i>
        <span>{name}</span>
      </nav>

      <!-- ═══ HERO CARD ═══ -->
      <header class="biz-hero">
        <div class="hero-top">
          <div class="hero-avatar">{(name.charAt(0) || 'B').toUpperCase()}</div>
          <div class="hero-info">
            <h1>{name}</h1>
            <div class="hero-sub">
              {biz.subCategory && <span>{biz.subCategory}</span>}
              {biz.subCategory && biz.location && <span class="dot">·</span>}
              {biz.location && <span>{biz.location}</span>}
            </div>
            <div class="hero-badges">
              {tierLabel && (
                <span class={`badge ${tierClass}`}>
                  <i class={`fa-solid ${tierIcon}`}></i>
                  {tierLabel}
                </span>
              )}
              {rating > 0 && (
                <span class="badge badge-rating">
                  <i class="fa-solid fa-star"></i>
                  {rating.toFixed(1)}
                  {reviews > 0 && <span class="rating-count">({reviews})</span>}
                </span>
              )}
            </div>
          </div>
        </div>

        <div class="hero-actions">
          {phone && (
            <a href={'tel:' + phone} class="act act-primary">
              <i class="fa-solid fa-phone"></i>
              <span>Call Now</span>
            </a>
          )}
          {waPhone && (
            <a href={'https://wa.me/91' + waPhone} target="_blank" rel="noopener" class="act act-wa">
              <i class="fa-brands fa-whatsapp"></i>
              <span>WhatsApp</span>
            </a>
          )}
          {biz.googleMap && biz.googleMap !== '-' && (
            <a href={biz.googleMap} target="_blank" rel="noopener" class="act act-neutral">
              <i class="fa-solid fa-map-location-dot"></i>
              <span>Directions</span>
            </a>
          )}
          {biz.website && biz.website !== '-' && (
            <a href={biz.website} target="_blank" rel="noopener" class="act act-neutral">
              <i class="fa-solid fa-globe"></i>
              <span>Website</span>
            </a>
          )}
        </div>
      </header>

      <!-- ═══ ABOUT ═══ -->
      {biz.description && (
        <section class="card">
          <h2 class="card-title">About</h2>
          <p class="about-text">{biz.description}</p>
        </section>
      )}

      <!-- ═══ CONTACT & INFO ═══ -->
      <section class="card">
        <h2 class="card-title">Contact & Info</h2>
        <div class="info-list">
          {biz.address && biz.address !== '-' && (
            <div class="info-item">
              <div class="info-icon"><i class="fa-solid fa-location-dot"></i></div>
              <div class="info-body">
                <div class="info-label">Address</div>
                <div class="info-value">{biz.address}</div>
              </div>
            </div>
          )}
          {biz.timing && (
            <div class="info-item">
              <div class="info-icon"><i class="fa-regular fa-clock"></i></div>
              <div class="info-body">
                <div class="info-label">Hours</div>
                <div class="info-value">{biz.timing}</div>
              </div>
            </div>
          )}
          {phone && (
            <div class="info-item">
              <div class="info-icon"><i class="fa-solid fa-phone"></i></div>
              <div class="info-body">
                <div class="info-label">Phone</div>
                <a class="info-value link" href={'tel:' + phone}>{biz.phone}</a>
              </div>
            </div>
          )}
          {biz.email && biz.email !== '-' && (
            <div class="info-item">
              <div class="info-icon"><i class="fa-solid fa-envelope"></i></div>
              <div class="info-body">
                <div class="info-label">Email</div>
                <a class="info-value link" href={'mailto:' + biz.email}>{biz.email}</a>
              </div>
            </div>
          )}
          {biz.website && biz.website !== '-' && (
            <div class="info-item">
              <div class="info-icon"><i class="fa-solid fa-globe"></i></div>
              <div class="info-body">
                <div class="info-label">Website</div>
                <a class="info-value link" href={biz.website} target="_blank" rel="noopener">{biz.website}</a>
              </div>
            </div>
          )}
        </div>
      </section>

      <!-- ═══ DEAL ═══ -->
      {biz.deals && biz.deals !== '-' && (
        <section class="deal-card">
          <div class="deal-icon"><i class="fa-solid fa-gift"></i></div>
          <div class="deal-content">
            <div class="deal-tag">Special Offer</div>
            <div class="deal-text">{biz.deals}</div>
            {biz.dealCode && biz.dealCode !== '-' && (
              <div class="deal-code">
                <span class="code-label">CODE</span>
                <span class="code-value">{biz.dealCode}</span>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- ═══ CLAIM / VERIFIED ═══ -->
      {!isVerified && (
        <section class="claim-card">
          <div class="claim-icon"><i class="fa-solid fa-circle-check"></i></div>
          <div class="claim-body">
            <h3>Is this your business?</h3>
            <p>Claim this listing for free to add photos, update timings, and get a verified badge.</p>
          </div>
          <a href={'/claim/' + biz.businessId + '/'} class="claim-btn">
            Claim Free <i class="fa-solid fa-arrow-right"></i>
          </a>
        </section>
      )}

      {isVerified && (
        <section class="verified-card">
          <div class="verified-icon"><i class="fa-solid fa-circle-check"></i></div>
          <div class="verified-body">
            <h3>Verified Business</h3>
            <p>This listing has been verified by PCMC Diary. <a href={'/claim/' + biz.businessId + '/'}>Manage this listing</a></p>
          </div>
        </section>
      )}

    </div>
  </div>

</BaseLayout>

<style is:global>
.biz-page { background: #f8fafc; min-height: 100vh; padding: 24px 16px 80px; }
.biz-container { max-width: 900px; margin: 0 auto; }

/* Breadcrumb */
.breadcrumb {
  display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
  font-size: 13px; color: #64748b; margin-bottom: 24px;
}
.breadcrumb a { color: #64748b; text-decoration: none; transition: color 0.2s; }
.breadcrumb a:hover { color: #dc2626; }
.breadcrumb .sep { font-size: 9px; color: #cbd5e1; }
.breadcrumb span { color: #0f172a; font-weight: 700; }

/* HERO CARD */
.biz-hero {
  background: #fff;
  border: 1px solid #e8ecf1;
  border-radius: 20px;
  padding: 32px;
  margin-bottom: 20px;
  box-shadow: 0 1px 3px rgba(15,23,42,0.04), 0 8px 24px -12px rgba(15,23,42,0.08);
}
.hero-top {
  display: flex; align-items: flex-start; gap: 20px;
  padding-bottom: 24px;
  border-bottom: 1px solid #f1f5f9;
  margin-bottom: 24px;
}
.hero-avatar {
  width: 80px; height: 80px; border-radius: 18px;
  background: linear-gradient(135deg, #dc2626, #991b1b);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 36px; font-weight: 800;
  flex-shrink: 0;
  box-shadow: 0 12px 24px -10px rgba(220,38,38,0.5), inset 0 1px 0 rgba(255,255,255,0.15);
  letter-spacing: -1px;
}
.hero-info { flex: 1; min-width: 0; }
.hero-info h1 {
  font-size: 30px; font-weight: 800; color: #0f172a;
  letter-spacing: -0.8px; line-height: 1.15;
  margin: 0 0 10px;
}
.hero-sub {
  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
  font-size: 14.5px; color: #64748b; font-weight: 500;
  margin-bottom: 16px;
}
.hero-sub .dot { color: #cbd5e1; }

.hero-badges { display: flex; flex-wrap: wrap; gap: 8px; }
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 12px; border-radius: 8px;
  font-size: 11px; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.5px;
  line-height: 1;
}
.badge i { font-size: 11px; }
.tier-featured { background: linear-gradient(135deg, #fef3c7, #fbbf24); color: #78350f; }
.tier-premium { background: linear-gradient(135deg, #f3e8ff, #c084fc); color: #581c87; }
.tier-verified { background: linear-gradient(135deg, #d1fae5, #6ee7b7); color: #065f46; }
.badge-rating { background: #fef3c7; color: #92400e; padding: 6px 12px; }
.badge-rating i { color: #f59e0b; }
.rating-count { font-weight: 700; color: #a16207; margin-left: 1px; }

.hero-actions { display: flex; flex-wrap: wrap; gap: 10px; }
.act {
  display: inline-flex; align-items: center; gap: 9px;
  padding: 13px 22px; border-radius: 12px;
  font-size: 14px; font-weight: 700;
  text-decoration: none; transition: all 0.2s;
  border: 1.5px solid transparent;
  white-space: nowrap;
}
.act i { font-size: 13px; }
.act-primary {
  background: linear-gradient(135deg, #dc2626, #991b1b);
  color: #fff;
  box-shadow: 0 10px 20px -8px rgba(220,38,38,0.5);
}
.act-primary:hover { transform: translateY(-1px); text-decoration: none; box-shadow: 0 14px 28px -8px rgba(220,38,38,0.6); }
.act-wa {
  background: linear-gradient(135deg, #25d366, #15803d);
  color: #fff;
  box-shadow: 0 10px 20px -8px rgba(37,211,102,0.5);
}
.act-wa:hover { transform: translateY(-1px); text-decoration: none; box-shadow: 0 14px 28px -8px rgba(37,211,102,0.6); }
.act-neutral { background: #fff; color: #334155; border-color: #e2e8f0; }
.act-neutral:hover { background: #f8fafc; border-color: #cbd5e1; transform: translateY(-1px); text-decoration: none; }

/* CARDS */
.card {
  background: #fff; border: 1px solid #e8ecf1;
  border-radius: 20px; padding: 28px;
  margin-bottom: 20px;
  box-shadow: 0 1px 3px rgba(15,23,42,0.04);
}
.card-title {
  font-size: 18px; font-weight: 800; color: #0f172a;
  margin: 0 0 20px; letter-spacing: -0.3px;
  display: flex; align-items: center; gap: 12px;
}
.card-title::before {
  content: ''; width: 4px; height: 20px;
  background: linear-gradient(180deg, #dc2626, #991b1b);
  border-radius: 2px;
  flex-shrink: 0;
}
.about-text {
  font-size: 15px; color: #334155; line-height: 1.7; margin: 0;
}

/* INFO LIST */
.info-list { display: flex; flex-direction: column; }
.info-item {
  display: flex; align-items: flex-start; gap: 16px;
  padding: 18px 0;
  border-bottom: 1px solid #f1f5f9;
}
.info-item:last-child { border-bottom: 0; padding-bottom: 0; }
.info-item:first-child { padding-top: 0; }
.info-icon {
  width: 42px; height: 42px; border-radius: 11px;
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
  color: #dc2626;
  display: flex; align-items: center; justify-content: center;
  font-size: 15px; flex-shrink: 0;
}
.info-body { flex: 1; min-width: 0; padding-top: 2px; }
.info-label {
  font-size: 10.5px; font-weight: 800; color: #94a3b8;
  text-transform: uppercase; letter-spacing: 1.2px;
  margin-bottom: 5px;
}
.info-value {
  font-size: 14.5px; font-weight: 600; color: #0f172a;
  line-height: 1.5; word-break: break-word;
}
.info-value.link { color: #2563eb; text-decoration: none; }
.info-value.link:hover { text-decoration: underline; }

/* DEAL CARD */
.deal-card {
  display: flex; gap: 18px; align-items: flex-start;
  background: linear-gradient(135deg, #fffbeb, #fef3c7);
  border: 1.5px solid #fde68a;
  border-radius: 20px; padding: 24px;
  margin-bottom: 20px;
  position: relative; overflow: hidden;
}
.deal-card::before {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px;
  background: linear-gradient(180deg, #f59e0b, #d97706);
}
.deal-icon {
  width: 50px; height: 50px; border-radius: 13px;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff; font-size: 20px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8px 16px -6px rgba(217,119,6,0.5);
}
.deal-content { flex: 1; min-width: 0; }
.deal-tag {
  font-size: 10.5px; font-weight: 800; color: #b45309;
  text-transform: uppercase; letter-spacing: 1.2px;
  margin-bottom: 6px;
}
.deal-text {
  font-size: 16px; font-weight: 700; color: #78350f;
  line-height: 1.4; margin-bottom: 12px;
}
.deal-code {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 8px 14px;
  background: #fff; border: 1.5px dashed #d97706;
  border-radius: 10px;
}
.code-label { font-size: 9px; font-weight: 800; color: #94a3b8; letter-spacing: 1px; }
.code-value { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; font-weight: 800; color: #0f172a; letter-spacing: 0.5px; }

/* CLAIM / VERIFIED */
.claim-card {
  display: flex; align-items: center; gap: 20px;
  background: #fff; border: 1px solid #e8ecf1;
  border-radius: 20px; padding: 24px 28px;
  margin-bottom: 20px;
}
.claim-icon {
  width: 50px; height: 50px; border-radius: 13px;
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
  color: #dc2626; font-size: 20px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.claim-body { flex: 1; min-width: 0; }
.claim-body h3 { font-size: 16px; font-weight: 800; color: #0f172a; margin: 0 0 4px; letter-spacing: -0.2px; }
.claim-body p { font-size: 13.5px; color: #64748b; margin: 0; line-height: 1.5; }
.claim-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 22px; border-radius: 12px;
  background: linear-gradient(135deg, #dc2626, #991b1b);
  color: #fff; font-size: 13.5px; font-weight: 800;
  text-decoration: none; transition: all 0.2s;
  white-space: nowrap;
  box-shadow: 0 10px 20px -8px rgba(220,38,38,0.5);
}
.claim-btn:hover { transform: translateY(-1px); text-decoration: none; box-shadow: 0 14px 28px -8px rgba(220,38,38,0.6); }
.claim-btn i { font-size: 11px; }

.verified-card {
  display: flex; align-items: center; gap: 20px;
  background: linear-gradient(135deg, #f0fdf4, #dcfce7);
  border: 1.5px solid #bbf7d0;
  border-radius: 20px; padding: 24px 28px;
  margin-bottom: 20px;
}
.verified-icon {
  width: 50px; height: 50px; border-radius: 13px;
  background: linear-gradient(135deg, #059669, #047857);
  color: #fff; font-size: 20px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8px 16px -6px rgba(5,150,105,0.5);
}
.verified-body { flex: 1; min-width: 0; }
.verified-body h3 { font-size: 16px; font-weight: 800; color: #065f46; margin: 0 0 4px; letter-spacing: -0.2px; }
.verified-body p { font-size: 13.5px; color: #065f46; margin: 0; line-height: 1.5; }
.verified-body a { color: #047857; font-weight: 800; text-decoration: underline; }

/* RESPONSIVE */
@media (max-width: 640px) {
  .biz-page { padding: 16px 12px 60px; }
  .breadcrumb { font-size: 12px; margin-bottom: 16px; }

  .biz-hero { padding: 22px 20px; border-radius: 16px; }
  .hero-top { flex-direction: column; gap: 16px; padding-bottom: 20px; margin-bottom: 20px; }
  .hero-avatar { width: 64px; height: 64px; font-size: 28px; border-radius: 14px; }
  .hero-info h1 { font-size: 22px; letter-spacing: -0.5px; margin-bottom: 8px; }
  .hero-sub { font-size: 13px; margin-bottom: 12px; }
  .hero-badges { gap: 6px; }
  .badge { font-size: 10px; padding: 5px 10px; }
  .hero-actions { gap: 8px; }
  .act { padding: 11px 16px; font-size: 13px; gap: 7px; flex: 1; justify-content: center; min-width: calc(50% - 4px); }
  .act i { font-size: 12px; }

  .card { padding: 22px 20px; border-radius: 16px; margin-bottom: 14px; }
  .card-title { font-size: 16px; margin-bottom: 16px; }
  .about-text { font-size: 14px; }

  .info-item { gap: 12px; padding: 14px 0; }
  .info-icon { width: 38px; height: 38px; border-radius: 10px; font-size: 14px; }
  .info-label { font-size: 10px; margin-bottom: 4px; }
  .info-value { font-size: 13.5px; }

  .deal-card { padding: 20px; gap: 14px; border-radius: 16px; }
  .deal-icon { width: 44px; height: 44px; font-size: 18px; border-radius: 12px; }
  .deal-text { font-size: 14.5px; margin-bottom: 10px; }

  .claim-card, .verified-card { padding: 20px; gap: 14px; flex-wrap: wrap; border-radius: 16px; }
  .claim-icon, .verified-icon { width: 44px; height: 44px; font-size: 18px; border-radius: 12px; }
  .claim-btn { width: 100%; justify-content: center; margin-top: 4px; }
  .claim-body h3, .verified-body h3 { font-size: 15px; }
  .claim-body p, .verified-body p { font-size: 12.5px; }
}
</style>
