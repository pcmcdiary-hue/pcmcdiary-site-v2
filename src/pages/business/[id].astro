.biz-grid .card-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 14px 16px; background: linear-gradient(180deg, #fafbfc 0%, #f8fafc 100%); border: 1px solid #f1f5f9; border-radius: 12px; margin-bottom: 16px; }
