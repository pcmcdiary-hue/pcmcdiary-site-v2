import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const url = 'https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data/locations.json';
  const res = await fetch(url);
  if (!res.ok) throw new Error('HTTP ' + res.status);
  const data = await res.json();
  const locs = data.locations || [];
  if (locs.length === 0) throw new Error('Locations empty');

  return locs.map(function(loc) {
    return {
      params: { id: loc.locationId },
      props: { location: loc }
    };
  });
}

const { location } = Astro.props;

let businesses = [];
try {
  const baseUrl = 'https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data';
  const catRes = await fetch(baseUrl + '/categories.json');
  const catData = await catRes.json();
  const cats = catData.categories || [];

  const results = await Promise.all(
    cats.map(async function(cat) {
      try {
        const res = await fetch(baseUrl + '/' + cat.file);
        const data = await res.json();
        return (Array.isArray(data) ? data : []).map(function(b) {
          return Object.assign({}, b, { categoryId: cat.categoryId, categoryName: cat.categoryName });
        });
      } catch (e) { return []; }
    })
  );
  const all = results.flat();

  businesses = all.filter(function(b) {
    if ((b.location || '') === location.locationName) return true;
    const sa = (b.serviceArea || '').split(',').map(function(s) { return s.trim(); });
    return sa.indexOf(location.locationName) !== -1;
  });
} catch (e) { businesses = []; }

const uniqueCats = [];
const seen = {};
for (let i = 0; i < businesses.length; i++) {
  const cid = businesses[i].categoryId;
  const cname = businesses[i].categoryName;
  if (cid && cname && !seen[cid]) { seen[cid] = true; uniqueCats.push({ id: cid, name: cname }); }
}
uniqueCats.sort(function(a, b) { return a.name.localeCompare(b.name); });
---

<BaseLayout title={'Businesses in ' + location.locationName + ', PCMC'} description={'Find verified businesses in ' + location.locationName + ', Pimpri-Chinchwad.'}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Businesses in " + location.locationName + ", Pimpri-Chinchwad",
    "url": "https://pcmcdiary.com/location/" + location.locationId,
    "description": "Find " + businesses.length + " verified local businesses serving " + location.locationName + ", Pimpri-Chinchwad, Pune.",
    "isPartOf": {
      "@type": "WebSite",
      "name": "PCMC Diary",
      "url": "https://pcmcdiary.com"
    },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": businesses.length,
      "itemListElement": businesses.slice(0, 10).map(function(b, i) {
        return {
          "@type": "ListItem",
          "position": i + 1,
          "url": "https://pcmcdiary.com/business/" + b.businessId
        };
      })
    }
  })} />

  <div class="loc-page">

    <section class="loc-hero">
      <div class="loc-hero-bg"></div>
      <div class="loc-container">
        <nav class="breadcrumb">
          <a href="/"><i class="fa-solid fa-house"></i> Home</a>
          <i class="fa-solid fa-chevron-right sep"></i>
          <a href="/directory">Directory</a>
          <i class="fa-solid fa-chevron-right sep"></i>
          <span>{location.locationName}</span>
        </nav>
        <div class="loc-hero-inner">
          <div class="loc-hero-icon">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <div class="loc-hero-text">
            <h1>Businesses in {location.locationName}</h1>
            <p>{businesses.length} verified {businesses.length === 1 ? 'business' : 'businesses'} serving this area</p>
          </div>
        </div>
        <div class="loc-meta">
          <span class="loc-meta-item"><i class="fa-solid fa-map-pin"></i>{location.locationName}</span>
          {location.zone && <span class="loc-meta-item"><i class="fa-solid fa-compass"></i>{location.zone} Zone</span>}
          {location.pincode && <span class="loc-meta-item"><i class="fa-solid fa-envelope"></i>{location.pincode}</span>}
        </div>
      </div>
    </section>

    <section class="loc-body">
      <div class="loc-container">
        <div class="results-bar">
          <span class="results-count" id="resultsCount">
            <i class="fa-solid fa-store"></i> {businesses.length} {businesses.length === 1 ? 'business' : 'businesses'}
          </span>
          <div class="filter-row">
            <div class="search-wrap">
              <i class="fa-solid fa-magnifying-glass"></i>
              <input type="text" id="searchInput" class="filter-search" placeholder="Search business name, tag…" />
            </div>
            <select id="catFilter" class="filter-select">
              <option value="all">All Categories</option>
              {uniqueCats.map(c => <option value={c.id}>{c.name}</option>)}
            </select>
            <a href="/directory" class="back-link">
              <i class="fa-solid fa-arrow-left"></i> All Locations
            </a>
          </div>
        </div>
        <div class="biz-grid" id="bizGrid"></div>
      </div>
    </section>

  </div>

</BaseLayout>

<script define:vars={{ businesses }}>
  const ALL = businesses || [];

  function tierRank(b) {
    const t = (b.tier || '').toLowerCase();
    if (t === 'featured') return 1;
    if (t === 'premium_pro') return 2;
    if (t === 'premium') return 3;
    if (t === 'vp') return 4;
    if (t === 'vb') return 5;
    return 6;
  }

  function avatarColors(name) {
    const pal = [['#dc2626','#991b1b'],['#ea580c','#c2410c'],['#d97706','#b45309'],['#ca8a04','#a16207'],['#65a30d','#4d7c0f'],['#059669','#047857'],['#0891b2','#0e7490'],['#0284c7','#0369a1'],['#4f46e5','#4338ca'],['#7c3aed','#6d28d9'],['#c026d3','#a21caf'],['#db2777','#be185d'],['#e11d48','#be123c'],['#9333ea','#7e22ce']];
    let h = 0;
    for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
    return pal[Math.abs(h) % pal.length];
  }

  function getBadges(b) {
    const t = (b.tier || '').toLowerCase();
    const out = [];
    if (t === 'featured') out.push('<span class="badge badge-featured"><i class="fa-solid fa-star"></i><span>Featured</span></span>');
    else if (t === 'premium_pro') out.push('<span class="badge badge-premium"><i class="fa-solid fa-crown"></i><span>Premium Pro</span></span>');
    else if (t === 'premium') out.push('<span class="badge badge-premium"><i class="fa-solid fa-crown"></i><span>Premium</span></span>');
    if (['featured','premium','premium_pro','vp','vb'].indexOf(t) !== -1) out.push('<span class="badge badge-verified"><i class="fa-solid fa-circle-check"></i><span>Verified</span></span>');
    return out.join('');
  }

  function clean(p) { return (p || '').replace(/\s/g, ''); }

  function parseSocialLinks(raw) {
    if (!raw) return '';
    const icons = { insta: 'fa-brands fa-instagram', fb: 'fa-brands fa-facebook-f', yt: 'fa-brands fa-youtube', tw: 'fa-brands fa-x-twitter', li: 'fa-brands fa-linkedin-in', wa: 'fa-brands fa-whatsapp' };
    const out = [];
    const parts = String(raw).split('|');
    for (let i = 0; i < parts.length; i++) {
      const trimmed = parts[i].trim();
      if (!trimmed) continue;
      const idx = trimmed.indexOf(':');
      if (idx === -1) continue;
      const key = trimmed.substring(0, idx).trim().toLowerCase();
      let url = trimmed.substring(idx + 1).trim();
      if (!url) continue;
      if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
      out.push('<a href="' + url + '" target="_blank" rel="noopener" title="' + key + '"><i class="' + (icons[key] || 'fa-solid fa-link') + '"></i></a>');
    }
    return out.join('');
  }

  function renderCard(b) {
    const t = (b.tier || '').toLowerCase();
    const isPremium = ['featured','premium','premium_pro'].indexOf(t) !== -1;
    const isPro = t === 'premium_pro';
    const name = b.businessName || 'Business';
    const initial = name.trim().charAt(0).toUpperCase();
    const colors = avatarColors(name);
    const c1 = colors[0], c2 = colors[1];
    const rating = parseFloat(b.rating) || 0;
    const reviews = parseInt(b.reviews) || 0;

    const badgesHtml = getBadges(b);

    let statsHtml = '';
    if (rating > 0) {
      statsHtml += '<div class="stat"><i class="fa-solid fa-star stat-star"></i><div class="stat-body"><span class="stat-val">' + rating.toFixed(1) + '</span>' + (reviews ? '<span class="stat-sub">' + reviews + ' reviews</span>' : '') + '</div></div>';
    }
    if (b.location) {
      statsHtml += '<div class="stat"><i class="fa-solid fa-location-dot stat-loc"></i><div class="stat-body"><span class="stat-val">' + b.location + '</span><span class="stat-sub">Area</span></div></div>';
    }

    let dealHtml = '';
    if (isPremium && b.deals) {
      dealHtml = '<div class="deal-box"><div class="deal-icon"><i class="fa-solid fa-gift"></i></div><div class="deal-body"><div class="deal-label">Limited Offer</div><div class="deal-text">' + b.deals + '</div></div></div>';
    }

    const socialLinksHtml = (isPro) ? parseSocialLinks(b.socialLinks) : '';

    let metaRowHtml = '';
    if ((isPremium && b.timing) || socialLinksHtml) {
      const timing = (isPremium && b.timing) ? '<div class="meta-item"><i class="fa-regular fa-clock"></i><span>' + b.timing + '</span></div>' : '';
      const social = socialLinksHtml ? '<div class="meta-social">' + socialLinksHtml + '</div>' : '';
      metaRowHtml = '<div class="meta-row">' + timing + social + '</div>';
    }

    let actions = '';
    if (b.phone) actions += '<a href="tel:' + clean(b.phone) + '" class="act act-call"><i class="fa-solid fa-phone"></i><span>Call</span></a>';
    if (isPremium && b.phone) actions += '<a href="https://wa.me/' + clean(b.phone) + '" target="_blank" rel="noopener" class="act act-wa"><i class="fa-brands fa-whatsapp"></i><span>WhatsApp</span></a>';
    if (isPremium && b.website) actions += '<a href="' + b.website + '" target="_blank" rel="noopener" class="act act-web"><i class="fa-solid fa-globe"></i><span>Web</span></a>';
    if (isPremium && b.googleMap) actions += '<a href="' + b.googleMap + '" target="_blank" rel="noopener" class="act act-map"><i class="fa-solid fa-map-location-dot"></i><span>Map</span></a>';
    if (isPro && b.email) actions += '<a href="mailto:' + b.email + '" class="act act-mail"><i class="fa-solid fa-envelope"></i><span>Email</span></a>';

    return '<article class="biz-card">' +
      '<div class="card-accent" style="background: linear-gradient(90deg, ' + c1 + ', ' + c2 + ')"></div>' +
      '<header class="card-head">' +
        '<div class="avatar" style="background: linear-gradient(135deg, ' + c1 + ', ' + c2 + ')"><span>' + initial + '</span></div>' +
        '<div class="head-text">' +
          '<h3 class="biz-name"><a href="/business/' + b.businessId + '" class="biz-link">' + name + '</a></h3>' +
          (b.subCategory ? '<div class="biz-sub">' + b.subCategory + '</div>' : '') +
        '</div>' +
      '</header>' +
      (badgesHtml ? '<div class="card-badges">' + badgesHtml + '</div>' : '') +
      (statsHtml ? '<div class="card-stats">' + statsHtml + '</div>' : '') +
      dealHtml +
      metaRowHtml +
      (actions ? '<footer class="card-actions">' + actions + '</footer>' : '') +
    '</article>';
  }

  function applyAndRender() {
    const grid = document.getElementById('bizGrid');
    const countEl = document.getElementById('resultsCount');
    const catEl = document.getElementById('catFilter');
    const searchEl = document.getElementById('searchInput');
    if (!grid) return;

    const catVal = catEl ? catEl.value : 'all';
    const searchVal = searchEl ? searchEl.value.trim().toLowerCase() : '';
    let filtered = ALL.slice();

    if (catVal !== 'all') {
      filtered = filtered.filter(function(b) { return b.categoryId === catVal; });
    }

    if (searchVal) {
      filtered = filtered.filter(function(b) {
        const name = (b.businessName || '').toLowerCase();
        const sub = (b.subCategory || '').toLowerCase();
        const tags = (b.tags || '').toLowerCase();
        const loc = (b.location || '').toLowerCase();
        return name.indexOf(searchVal) !== -1 || sub.indexOf(searchVal) !== -1 || tags.indexOf(searchVal) !== -1 || loc.indexOf(searchVal) !== -1;
      });
    }

    if (countEl) {
      countEl.innerHTML = '<i class="fa-solid fa-store"></i> ' + filtered.length + ' ' + (filtered.length === 1 ? 'business' : 'businesses');
    }

    if (filtered.length === 0) {
      grid.innerHTML = '<div class="empty"><i class="fa-solid fa-store"></i><h3>No businesses found</h3><p>Try a different search or filter.</p></div>';
      return;
    }

    var tiers = { 1: [], 2: [], 3: [], 4: [], 5: [], 6: [] };
    for (var i = 0; i < filtered.length; i++) {
      var t = tierRank(filtered[i]);
      tiers[t].push(filtered[i]);
    }
    function shuffle(arr) {
      for (var i = arr.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
      }
      return arr;
    }
    filtered = []
      .concat(shuffle(tiers[1]))
      .concat(shuffle(tiers[2]))
      .concat(shuffle(tiers[3]))
      .concat(shuffle(tiers[4]))
      .concat(shuffle(tiers[5]))
      .concat(shuffle(tiers[6]));

    let html = '';
    for (let i = 0; i < filtered.length; i++) {
      html += renderCard(filtered[i]);
    }
    grid.innerHTML = html;
  }

  function init() {
    const catEl = document.getElementById('catFilter');
    const searchEl = document.getElementById('searchInput');
    if (catEl) catEl.addEventListener('change', applyAndRender);
    if (searchEl) {
      searchEl.addEventListener('input', function() {
        clearTimeout(window._searchTimer);
        window._searchTimer = setTimeout(applyAndRender, 250);
      });
    }
    applyAndRender();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style is:global>
