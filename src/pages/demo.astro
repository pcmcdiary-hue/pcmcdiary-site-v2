function switchTab(name){
  document.querySelectorAll('.tab').forEach(function(b){
    b.classList.toggle('active', b.dataset.tab === name);
  });
  $('tab-messages').classList.toggle('hidden', name !== 'messages');
  $('tab-billing').classList.toggle('hidden', name !== 'billing');
  $('controls-messages').classList.toggle('hidden', name !== 'messages');
  $('controls-billing').classList.toggle('hidden', name !== 'billing');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

