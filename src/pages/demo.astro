function $(id){ return document.getElementById(id); }
function esc(s){
  return String(s == null ? '' : s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function toast(msg){
  var t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._timer);
  t._timer = setTimeout(function(){ t.classList.remove('show'); }, 2800);
}
function demoBlocked(){
  toast('🔒 Copy is disabled in this demo.\nGet the full version to copy & share instantly.');
}

/* ══════════════════════════════════════════════════════════
   LOGIN
   ══════════════════════════════════════════════════════════ */
function handleLogin(){
  var u = $('usernameInput').value.trim();
  var p = $('passwordInput').value.trim();
  if (!u || !p){
    $('loginError').textContent = 'Please enter username and password';
    return;
  }
  $('loginError').textContent = '';
  try { localStorage.setItem('pcmd_logged', '1'); } catch(e){}
  enterApp();
}
function enterApp(){
  $('loginScreen').classList.add('hidden');
  $('appScreen').classList.remove('hidden');
  loadDetails();
  renderMessages();
}
function logout(){
  try { localStorage.removeItem('pcmd_logged'); } catch(e){}
  $('appScreen').classList.add('hidden');
  $('loginScreen').classList.remove('hidden');
  $('passwordInput').value = '';
}
/* auto-login if already logged in */
(function(){
  try {
    if (localStorage.getItem('pcmd_logged') === '1') {
      $('loginScreen').classList.add('hidden');
      $('appScreen').classList.remove('hidden');
      loadDetails();
      renderMessages();
    }
  } catch(e){}
})();

/* ══════════════════════════════════════════════════════════
