  return MESSAGES.filter(function(m){
    if (state.category !== 'all' && m.cat !== state.category) return false;
    if (!q) return true;
    var hay = (m.title.mr + m.title.en + m.title.hi + m.text.mr + m.text.en + m.text.hi).toLowerCase();
    return hay.indexOf(q) !== -1;
  });
}

function renderMessages(){
  var list = currentList();
  var el = $('messageList');
  if (!list.length){
    el.innerHTML = '<div class="empty">😕 No messages found<br><span style="font-size:.78rem">Try a different search or category</span></div>';
    return;
  }
  el.innerHTML = list.map(function(m){
    return '' +
    '<article class="msg-card">' +
      '<div class="msg-head">' +
        '<span class="badge ' + m.cat + '">' + CAT_LABEL[m.cat] + '</span>' +
      '</div>' +
      '<h3 class="msg-title">' + esc(m.title[state.lang]) + '</h3>' +
      '<p class="msg-text">' + esc(m.text[state.lang]) + '</p>' +
      '<div class="msg-actions">' +
        '<button class="btn-copy" onclick="demoBlocked()">📋 Copy</button>' +
        '<button class="btn-ghost" onclick="openPreview(' + m.id + ')">👁 Preview</button>' +
        '<button class="btn-wa" onclick="demoBlocked()">💬 WhatsApp</button>' +
      '</div>' +
    '</article>';
  }).join('');
}

/* ── Signature from business details ── */
function signatureText(){
  var d = bizDetails;
  if (!d.name && !d.phone) return '';
  var lines = ['—'];
  if (d.name)    lines.push(d.name);
  if (d.phone)   lines.push('📞 ' + d.phone);
  if (d.website) lines.push('🌐 ' + d.website);
  if (d.address) lines.push('📍 ' + d.address);
  if (d.map)     lines.push('⭐ ' + d.map);
  return lines.join('\n');
}

/* ── Preview modal ── */
function openPreview(id){
  var m = MESSAGES.filter(function(x){ return x.id === id; })[0];
  if (!m) return;
  var sig = signatureText();
  var back = document.createElement('div');
  back.className = 'modal-back';
  back.innerHTML = '' +
    '<div class="modal-card">' +
      '<h3>' + esc(m.title[state.lang]) + '</h3>' +
      '<div class="modal-sub">' + CAT_LABEL[m.cat] + ' · This is exactly what your customer will receive</div>' +
      '<div class="modal-body">' + esc(m.text[state.lang]) +
        (sig ? '<div class="modal-sig">' + esc(sig) + '</div>' : '') +
      '</div>' +
      '<div class="modal-actions">' +
        '<button class="m-close" onclick="this.closest(\'.modal-back\').remove()">Close</button>' +
        '<button class="btn-copy" style="flex:1;border-radius:11px;padding:12px;font-size:.8rem;font-weight:700" onclick="demoBlocked()">📋 Copy</button>' +
      '</div>' +
    '</div>';
  back.addEventListener('click', function(e){ if (e.target === back) back.remove(); });
  document.body.appendChild(back);
}

/* ══════════════════════════════════════════════════════════
   BUSINESS DETAILS (localStorage)
   ══════════════════════════════════════════════════════════ */
function toggleDetailsForm(){
  var f = $('detailsForm');
  f.classList.toggle('hidden');
  if (!f.classList.contains('hidden')) {
    var empty = !bizDetails.name && !bizDetails.phone;
    $('welcomeBanner').classList.toggle('hidden', !empty);
  }
}
function saveDetails(){
  bizDetails = {
    name:    $('bizName').value.trim(),
    phone:   $('bizPhone').value.trim(),
    website: $('bizWebsite').value.trim(),
    address: $('bizAddress').value.trim(),
    map:     $('bizMapLink').value.trim()
  };
  try { localStorage.setItem('pcmd_biz', JSON.stringify(bizDetails)); } catch(e){}
  updateDetailsStatus();
  toast('✅ Business details saved on this device');
  $('detailsForm').classList.add('hidden');
}
function loadDetails(){
  try {
    var raw = localStorage.getItem('pcmd_biz');
    if (raw) bizDetails = JSON.parse(raw);
  } catch(e){}
  $('bizName').value    = bizDetails.name    || '';
  $('bizPhone').value   = bizDetails.phone   || '';
  $('bizWebsite').value = bizDetails.website || '';
  $('bizAddress').value = bizDetails.address || '';
  $('bizMapLink').value = bizDetails.map     || '';
  updateDetailsStatus();
}
function updateDetailsStatus(){
  var s = $('detailsStatus');
  if (bizDetails.name || bizDetails.phone) {
    s.textContent = '✓ Saved: ' + (bizDetails.name || bizDetails.phone);
  } else {
    s.textContent = 'No details saved yet';
  }
}

/* ══════════════════════════════════════════════════════════
   BILLING STUDIO
   ══════════════════════════════════════════════════════════ */
(function(){
  var RS = '\u20B9', EM = '\u2014';
  var items = [], docType = 'invoice', gstOn = false;

  var SAMPLE_ITEMS = [
    { service: 'Business Directory Listing ' + EM + ' PCMC', schedule: 'Yearly',  qty: 1, rate: 1500 },
    { service: 'Featured Placement ' + EM + ' Homepage',    schedule: 'Monthly', qty: 1, rate: 800  },
    { service: 'WhatsApp Lead Alerts',                      schedule: 'Monthly', qty: 3, rate: 200  }
  ];

  function money(n){
    return RS + Math.abs(Number(n) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function todayStr(){
    var d = new Date(), m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return String(d.getDate()).padStart(2,'0') + '-' + m[d.getMonth()] + '-' + d.getFullYear();
  }
  function addDaysStr(days){
    var d = new Date(); d.setDate(d.getDate() + days);
    var m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return String(d.getDate()).padStart(2,'0') + '-' + m[d.getMonth()] + '-' + d.getFullYear();
  }

  function renderItems(){
    var tb = $('demo-items-body');
    tb.innerHTML = '';
    items.forEach(function(it, i){
      var tr = document.createElement('tr');
      tr.style.borderBottom = '1px solid #f1f5f9';
      if (i % 2 === 1) tr.style.background = '#f8fafc';

      tr.innerHTML =
        '<td style="padding:14px 6px; text-align:center; font-weight:700; color:#2c7fb8; font-size:0.9rem;">' + (i + 1) + '</td>' +
        '<td style="padding:14px 14px;"><input type="text" data-i="' + i + '" data-f="service" value="' + esc(it.service) + '" placeholder="Service description" style="border:none; background:transparent; width:100%; font-size:0.88rem; font-family:inherit; color:#0f172a; font-weight:500; padding:4px 0; outline:none; box-sizing:border-box;"></td>' +
        '<td style="padding:14px 8px; text-align:center;"><select data-i="' + i + '" data-f="schedule" style="border:none; background:transparent; font-size:0.85rem; font-family:inherit; color:#0f172a; font-weight:500; text-align:center; cursor:pointer; outline:none; padding:4px 0; width:100%;">' +
          ['One-time','Monthly','Quarterly','Half-Yearly','Yearly','AMC'].map(function(s){
            return '<option value="' + s + '"' + (s === it.schedule ? ' selected' : '') + '>' + s + '</option>';
          }).join('') +
        '</select></td>' +
        '<td style="padding:14px 8px; text-align:right;"><input type="number" min="0" data-i="' + i + '" data-f="qty" value="' + it.qty + '" style="border:none; background:transparent; width:100%; font-size:0.88rem; font-family:inherit; color:#0f172a; font-weight:600; text-align:right; padding:4px 0; outline:none; box-sizing:border-box;"></td>' +
        '<td style="padding:14px 8px; text-align:right;"><input type="number" min="0" data-i="' + i + '" data-f="rate" value="' + it.rate + '" style="border:none; background:transparent; width:100%; font-size:0.88rem; font-family:inherit; color:#0f172a; font-weight:600; text-align:right; padding:4px 0; outline:none; box-sizing:border-box;"></td>' +
        '<td style="padding:14px 8px; text-align:right; font-weight:700; color:#0f172a; font-size:0.88rem;">' + money(it.qty * it.rate) + '</td>' +
        '<td class="demo-act-cell demo-no-print" style="padding:12px 4px; text-align:center;">' +
          '<button class="demo-row-del" data-i="' + i + '" title="Remove" style="width:24px; height:24px; border-radius:50%; border:1px solid #e2e8f0; background:#f1f5f9; color:#64748b; font-size:0.7rem; font-weight:700; cursor:pointer; font-family:inherit; vertical-align:middle;">✕</button>' +
        '</td>';
      tb.appendChild(tr);
    });
    recalc();
  }

  function recalc(){
    var sub = 0;
    items.forEach(function(it){ sub += (Number(it.qty) || 0) * (Number(it.rate) || 0); });
    var tax = gstOn ? sub * 0.18 : 0;
    var total = Math.round(sub + tax);
    $('demo-subtotal').textContent = money(sub);
    $('demo-tax').textContent = money(tax);
    $('demo-total').textContent = money(total);
    $('demo-tax-row').style.display = gstOn ? 'flex' : 'none';
    $('demo-gst-note').style.display = gstOn ? '' : 'none';
  }

  $('demo-items-body').addEventListener('input', function(e){
    var t = e.target;
    if (!t.dataset || !t.dataset.f) return;
    var i = +t.dataset.i, f = t.dataset.f;
    items[i][f] = t.value;
    if (f === 'qty' || f === 'rate'){
      var cell = t.closest('tr').querySelector('td:nth-child(6)');
      if (cell) cell.textContent = money(items[i].qty * items[i].rate);
    }
    recalc();
  });

  $('demo-items-body').addEventListener('change', function(e){
    var t = e.target;
    if (!t.dataset || !t.dataset.f) return;
    items[+t.dataset.i][t.dataset.f] = t.value;
  });

  $('demo-items-body').addEventListener('click', function(e){
    var btn = e.target.closest('button');
    if (!btn) return;
    var i = +btn.dataset.i;
    if (btn.classList.contains('demo-row-del')){
      if (items.length <= 1){ toast('At least one line is required'); return; }
      items.splice(i, 1);
    }
    renderItems();
  });

  function addRow(){
    items.push({ service: '', schedule: 'One-time', qty: 1, rate: 0 });
    renderItems();
  }
  $('demo-add-row').addEventListener('click', addRow);
  $('demo-add-row2').addEventListener('click', addRow);

  var titles = { invoice: 'INVOICE', proforma: 'PROFORMA', quotation: 'QUOTATION', proposal: 'PROPOSAL' };
  var showValidFor = { quotation: true, proposal: true };

  document.querySelectorAll('.demo-doc-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.demo-doc-btn').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      docType = btn.dataset.doc;
      $('demo-doc-title').textContent = titles[docType];
      if (showValidFor[docType]){
        $('demo-valid-row').style.display = 'flex';
        $('demo-valid').textContent = addDaysStr(30);
      } else {
        $('demo-valid-row').style.display = 'none';
      }
    });
  });

  function setGst(on){
    gstOn = on;
    $('demo-gst-on').classList.toggle('active', on);
    $('demo-gst-off').classList.toggle('active', !on);
    recalc();
  }
  $('demo-gst-on').addEventListener('click', function(){ setGst(true); });
  $('demo-gst-off').addEventListener('click', function(){ setGst(false); });

  $('demo-print').addEventListener('click', function(){ window.print(); });

  function openModal(){
    var m = document.createElement('div');
    m.className = 'modal-back';
    m.innerHTML =
      '<div class="modal-card" style="max-width:400px;text-align:center;">' +
        '<h3>Download Document</h3>' +
        '<div class="modal-sub">Choose a format</div>' +
        '<button id="demo-dl-png" style="display:flex; align-items:center; gap:14px; width:100%; background:#fff; border:1px solid #e5e7eb; border-radius:14px; padding:15px 18px; margin-bottom:10px; text-align:left; cursor:pointer; font-family:inherit;">' +
          '<div style="width:44px; height:44px; background:#f8fafc; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.2rem;">📷</div>' +
          '<div><div style="font-size:0.9rem; font-weight:600; color:#0f172a;">PNG Image</div><div style="font-size:0.72rem; color:#94a3b8;">Best for WhatsApp</div></div>' +
        '</button>' +
        '<button id="demo-dl-pdf" style="display:flex; align-items:center; gap:14px; width:100%; background:#fff; border:1px solid #e5e7eb; border-radius:14px; padding:15px 18px; margin-bottom:10px; text-align:left; cursor:pointer; font-family:inherit;">' +
          '<div style="width:44px; height:44px; background:#f8fafc; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.2rem;">📄</div>' +
          '<div><div style="font-size:0.9rem; font-weight:600; color:#0f172a;">PDF Document</div><div style="font-size:0.72rem; color:#94a3b8;">Best for email &amp; printing</div></div>' +
        '</button>' +
        '<button id="demo-dl-cancel" style="background:transparent; border:none; color:#94a3b8; font-size:0.82rem; font-weight:500; padding:10px; width:100%; cursor:pointer; font-family:inherit;">Cancel</button>' +
      '</div>';
    document.body.appendChild(m);
    m.addEventListener('click', function(e){ if (e.target === m) m.remove(); });
    $('demo-dl-cancel').addEventListener('click', function(){ m.remove(); });
    $('demo-dl-png').addEventListener('click', function(){ m.remove(); downloadAs('png'); });
    $('demo-dl-pdf').addEventListener('click', function(){ m.remove(); downloadAs('pdf'); });
  }
  $('demo-download').addEventListener('click', openModal);

  async function downloadAs(format){
    var doc = $('demo-doc');
    var actCells = document.querySelectorAll('.demo-act-cell, .demo-act-head');
    actCells.forEach(function(c){ c.style.display = 'none'; });

    try {
      if (document.fonts && document.fonts.ready){ try { await document.fonts.ready; } catch(e){} }
      await new Promise(function(r){ setTimeout(r, 100); });

      var W = Math.round(doc.getBoundingClientRect().width);
      var H = Math.round(doc.scrollHeight);

      var canvas = await html2canvas(doc, {
        scale: 2, backgroundColor: '#ffffff', useCORS: true, allowTaint: false, logging: false,
        width: W, height: H, windowWidth: W, windowHeight: H, scrollX: 0, scrollY: 0, x: 0, y: 0
      });

      var PAD = 60;
      var padded = document.createElement('canvas');
      padded.width = canvas.width + PAD * 2;
      padded.height = canvas.height + PAD * 2;
      var ctx = padded.getContext('2d');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, padded.width, padded.height);
      ctx.drawImage(canvas, PAD, PAD);

      var filename = 'pcmc-diary-' + docType + '-' + new Date().toISOString().slice(0, 10);

      if (format === 'png'){
        await new Promise(function(resolve){
          padded.toBlob(function(blob){
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.download = filename + '.png';
            link.href = url;
            link.click();
            setTimeout(function(){ URL.revokeObjectURL(url); }, 3000);
            resolve();
          }, 'image/png', 1.0);
        });
        toast('✅ PNG downloaded');
      } else {
        var jsPDF = window.jspdf.jsPDF;
        var pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4', compress: true });
        var pageW = pdf.internal.pageSize.getWidth();
        var pageH = pdf.internal.pageSize.getHeight();
        var imgData = padded.toDataURL('image/jpeg', 0.95);
        var imgRatio = padded.height / padded.width;
        var imgW = pageW;
        var imgH = imgW * imgRatio;
        if (imgH <= pageH){
          pdf.addImage(imgData, 'JPEG', 0, 0, imgW, imgH);
        } else {
          var remaining = imgH, y = 0;
          while (remaining > 0){
            pdf.addImage(imgData, 'JPEG', 0, y, imgW, imgH);
            remaining -= pageH;
            if (remaining > 0){ pdf.addPage(); y = -(imgH - remaining); }
          }
        }
        pdf.save(filename + '.pdf');
        toast('✅ PDF downloaded');
      }
    } catch(err){
      toast('❌ Download failed: ' + err.message);
    } finally {
      actCells.forEach(function(c){ c.style.display = ''; });
    }
  }

  /* init */
  $('demo-date').textContent = todayStr();
  items = SAMPLE_ITEMS.slice();
  renderItems();
  setGst(false);
})();
</script>
</body>
</html>
