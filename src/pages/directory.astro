---
import BaseLayout from '../layouts/BaseLayout.astro';

const CDN = 'https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data';

let categories = [];
let locations = [];
let businesses = [];

try {
  const catRes = await fetch(`${CDN}/categories.json`);
  const catData = await catRes.json();
  categories = catData.categories || [];
} catch (e) { console.error(e); }

try {
  const locRes = await fetch(`${CDN}/locations.json`);
  const locData = await locRes.json();
  locations = locData.locations || [];
} catch (e) { console.error(e); }

// Fetch all business JSONs
const results = await Promise.all(
  categories.map(async (cat) => {
    try {
      const res = await fetch(`${CDN}/${cat.file}`);
      const data = await res.json();
      return data.map(b => ({ ...b, categoryId: cat.categoryId, categoryName: cat.categoryName, categoryIcon: cat.icon }));
    } catch (e) { return []; }
  })
);
businesses = results.flat();

// Tier priority
function tierPriority(b) {
  const t = (b.tier || '').toLowerCase();
  if (t === 'featured') return 1;
  if (t === 'premium_pro') return 2;
  if (t === 'premium') return 3;
  if (t === 'vp') return 4;
  if (t === 'vb') return 5;
  return 6;
}
---

<BaseLayout title="Directory" description="Browse all verified local businesses in Pimpri-Chinchwad.">

  <section class="dir-head">
    <div class="container">
      <h1>Business Directory</h1>
      <p>Find trusted local businesses across Pimpri-Chinchwad</p>
    </div>
  </section>

  <section class="dir-body">
    <div class="container">

      <div class="filters">
        <input type="text" id="searchInput" placeholder="Search business name, tag…" />
        <select id="catFilter">
          <option value="">All Categories</option>
          {categories.map(c => <option value={c.categoryId}>{c.icon} {c.categoryName}</option>)}
        </select>
        <select id="locFilter">
          <option value="">All Locations</option>
          {locations.map(l => <option value={l.locationId}>{l.locationName}</option>)}
        </select>
        <select id="sortFilter">
          <option value="tier">Featured First</option>
          <option value="rating">Top Rated</option>
          <option value="name">Name A-Z</option>
        </select>
        <button id="nearMeBtn" class="near-btn">📍 Near Me</button>
        <span class="results-count" id="resultsCount">{businesses.length} businesses</span>
      </div>

      <div class="biz-grid" id="bizGrid"></div>

      <div class="pagination" id="pagination"></div>

    </div>
  </section>

</BaseLayout>

<script define:vars={{ businesses, categories, locations }}>
  const ALL = businesses;
  const CATS = categories;
  const LOCS = locations;
  const PER_PAGE = 20;

  let state = {
    search: '',
    category: '',
    location: '',
    sort: 'tier',
    page: 1,
    filtered: [...ALL]
  };

  function tierPriority(b) {
    const t = (b.tier || '').toLowerCase();
    if (t === 'featured') return 1;
    if (t === 'premium_pro') return 2;
    if (t === 'premium') return 3;
    if (t === 'vp') return 4;
    if (t === 'vb') return 5;
    return 6;
  }

  function getInitials(name) {
    return (name || 'B').trim().charAt(0).toUpperCase();
  }

  function avatarColor(name) {
    const pal = ['#dc2626','#ea580c','#d97706','#65a30d','#059669','#0891b2','#0284c7','#4f46e5','#7c3aed','#c026d3','#db2777','#e11d48','#9333ea'];
    let h = 0;
    for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
    return pal[Math.abs(h) % pal.length];
  }

  function getTierBadges(b) {
    const t = (b.tier || '').toLowerCase();
    const badges = [];
    if (t === 'featured') badges.push('<span class="badge gold">⭐ Featured</span>');
    else if (t === 'premium_pro') badges.push('<span class="badge gold">👑 Premium Pro</span>');
    else if (t === 'premium') badges.push('<span class="badge gold">👑 Premium</span>');
    if (['featured','premium','premium_pro','vp','vb'].includes(t)) {
      badges.push('<span class="badge green">✅ Verified</span>');
    }
    return badges.join(' ');
  }

  function formatPhone(p) {
    return (p || '').replace(/\s/g, '');
  }

  function renderCard(b) {
    const t = (b.tier || '').toLowerCase();
    const isPremium = ['premium','premium_pro','featured'].includes(t);
    const hasWa = isPremium;
    const hasWeb = isPremium && b.website;
    const hasMap = isPremium && b.googleMap;
    const hasCoupon = isPremium && b.deals;
    const hasEmail = t === 'premium_pro' && b.email;
    const hasSocial = t === 'premium_pro' && b.socialLinks;
    const showTiming = isPremium && b.timing;

    const name = b.businessName || 'Business';
    const initial = getInitials(name);
    const color = avatarColor(name);
    const rating = parseFloat(b.rating) || 0;
    const reviews = parseInt(b.reviews) || 0;

    const ratingHtml = rating > 0
      ? `<span class="pill rating">⭐ ${rating.toFixed(1)}${reviews ? ` (${reviews})` : ''}</span>`
      : '';
    const locHtml = b.location ? `<span class="pill loc">📍 ${b.location}</span>` : '';
    const couponHtml = hasCoupon ? `<span class="pill deal">🎁 ${b.deals}</span>` : '';

    let actions = '';
    if (b.phone) actions += `<a href="tel:${formatPhone(b.phone)}" class="act call">📞 Call</a>`;
    if (hasWa && b.phone) actions += `<a href="https://wa.me/${formatPhone(b.phone)}" target="_blank" class="act wa">💬 WhatsApp</a>`;
    if (hasWeb) actions += `<a href="${b.website}" target="_blank" rel="noopener" class="act web">🌐 Web</a>`;
    if (hasMap) actions += `<a href="${b.googleMap}" target="_blank" rel="noopener" class="act map">🗺️ Map</a>`;
    if (hasEmail) actions += `<a href="mailto:${b.email}" class="act email">✉️ Email</a>`;

    const socialHtml = hasSocial ? `<div class="social">${parseSocial(b.socialLinks)}</div>` : '';
    const timingHtml = showTiming ? `<div class="timing">🕐 ${b.timing}</div>` : '';

    return `
      <article class="biz-card">
        <div class="biz-top">
          <div class="biz-av" style="background:${color}">${initial}</div>
          <div class="biz-info">
            <h3 class="biz-name">${name}</h3>
            ${b.subCategory ? `<div class="biz-sub">${b.subCategory}</div>` : ''}
          </div>
          <div class="badges">${getTierBadges(b)}</div>
        </div>
        <div class="biz-meta">${ratingHtml}${locHtml}${couponHtml}</div>
        ${timingHtml}
        ${socialHtml}
        <div class="actions">${actions}</div>
      </article>
    `;
  }

  function parseSocial(links) {
    if (!links) return '';
    const map = { insta: '📷', fb: '👍', yt: '▶️', tw: '🐦', li: '💼', wa: '💬' };
    return links.split('|').map(part => {
      const [key, url] = part.split(':');
      if (!url) return '';
      const icon = map[key.trim()] || '🔗';
      return `<a href="${url.trim()}" target="_blank" rel="noopener">${icon}</a>`;
    }).join(' ');
  }

  function applyFilters() {
    let list = [...ALL];

    if (state.search) {
      const q = state.search.toLowerCase();
      list = list.filter(b =>
        (b.businessName || '').toLowerCase().includes(q) ||
        (b.subCategory || '').toLowerCase().includes(q) ||
        (b.tags || '').toLowerCase().includes(q) ||
        (b.location || '').toLowerCase().includes(q)
      );
    }

    if (state.category) list = list.filter(b => b.categoryId === state.category);
    if (state.location) {
      const loc = LOCS.find(l => l.locationId === state.location);
      if (loc) {
        list = list.filter(b =>
          (b.location || '') === loc.locationName ||
          (b.serviceArea || '').includes(loc.locationName)
        );
      }
    }

    // Sort
    if (state.sort === 'tier') {
      list.sort((a, b) => {
        const ta = tierPriority(a), tb = tierPriority(b);
        if (ta !== tb) return ta - tb;
        return (parseFloat(b.rating) || 0) - (parseFloat(a.rating) || 0);
      });
    } else if (state.sort === 'rating') {
      list.sort((a, b) => (parseFloat(b.rating) || 0) - (parseFloat(a.rating) || 0));
    } else if (state.sort === 'name') {
      list.sort((a, b) => (a.businessName || '').localeCompare(b.businessName || ''));
    }

    state.filtered = list;
    state.page = 1;
    render();
  }

  function render() {
    const total = state.filtered.length;
    const totalPages = Math.ceil(total / PER_PAGE) || 1;
    const start = (state.page - 1) * PER_PAGE;
    const items = state.filtered.slice(start, start + PER_PAGE);

    document.getElementById('resultsCount').textContent = `${total} businesses`;

    const grid = document.getElementById('bizGrid');
    if (total === 0) {
      grid.innerHTML = `<div class="empty">No businesses found. Try different filters.</div>`;
      document.getElementById('pagination').innerHTML = '';
      return;
    }

    grid.innerHTML = items.map(renderCard).join('');
    renderPagination(totalPages);
  }

  function renderPagination(totalPages) {
    const el = document.getElementById('pagination');
    if (totalPages <= 1) { el.innerHTML = ''; return; }
    let html = '';
    html += `<button ${state.page === 1 ? 'disabled' : ''} data-page="${state.page - 1}">‹</button>`;
    const startP = Math.max(1, state.page - 2);
    const endP = Math.min(totalPages, state.page + 2);
    if (startP > 1) {
      html += `<button data-page="1">1</button>`;
      if (startP > 2) html += `<span>…</span>`;
    }
    for (let i = startP; i <= endP; i++) {
      html += `<button data-page="${i}" ${i === state.page ? 'class="active"' : ''}>${i}</button>`;
    }
    if (endP < totalPages) {
      if (endP < totalPages - 1) html += `<span>…</span>`;
      html += `<button data-page="${totalPages}">${totalPages}</button>`;
    }
    html += `<button ${state.page === totalPages ? 'disabled' : ''} data-page="${state.page + 1}">›</button>`;
    el.innerHTML = html;

    el.querySelectorAll('button[data-page]').forEach(btn => {
      btn.addEventListener('click', () => {
        state.page = parseInt(btn.dataset.page);
        render();
        window.scrollTo({ top: 200, behavior: 'smooth' });
      });
    });
  }

  // Events
  document.getElementById('searchInput').addEventListener('input', (e) => {
    state.search = e.target.value;
    applyFilters();
  });
  document.getElementById('catFilter').addEventListener('change', (e) => {
    state.category = e.target.value;
    applyFilters();
  });
  document.getElementById('locFilter').addEventListener('change', (e) => {
    state.location = e.target.value;
    applyFilters();
  });
  document.getElementById('sortFilter').addEventListener('change', (e) => {
    state.sort = e.target.value;
    applyFilters();
  });

  document.getElementById('nearMeBtn').addEventListener('click', () => {
    if (!navigator.geolocation) return alert('Geolocation not supported');
    const btn = document.getElementById('nearMeBtn');
    btn.textContent = '📍 Detecting…';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        const dist = (lat1, lon1, lat2, lon2) => {
          const R = 6371;
          const dLat = (lat2 - lat1) * Math.PI / 180;
          const dLon = (lon2 - lon1) * Math.PI / 180;
          const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLon/2)**2;
          return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        };
        state.filtered = [...ALL].filter(b => {
          const lat = parseFloat(b.latitude), lng = parseFloat(b.longitude);
          if (!lat || !lng) return false;
          return dist(latitude, longitude, lat, lng) <= 15;
        }).sort((a, b) => {
          const da = dist(latitude, longitude, parseFloat(a.latitude), parseFloat(a.longitude));
          const db = dist(latitude, longitude, parseFloat(b.latitude), parseFloat(b.longitude));
          return da - db;
        });
        state.page = 1;
        document.getElementById('resultsCount').textContent = `${state.filtered.length} near you`;
        const grid = document.getElementById('bizGrid');
        if (state.filtered.length === 0) {
          grid.innerHTML = `<div class="empty">No businesses within 15 km.</div>`;
          document.getElementById('pagination').innerHTML = '';
        } else {
          grid.innerHTML = state.filtered.slice(0, PER_PAGE).map(renderCard).join('');
          renderPagination(Math.ceil(state.filtered.length / PER_PAGE));
        }
        btn.textContent = '📍 Near Me (ON)';
        btn.classList.add('active');
      },
      () => {
        btn.textContent = '📍 Near Me';
        alert('Could not detect location');
      }
    );
  });

  // Init
  applyFilters();
</script>

<style>
.dir-head {
  background: linear-gradient(135deg, #b91c1c, #7f1d1d);
  color: #fff;
  padding: 40px 0;
}
.dir-head h1 {
  font-size: 32px;
  font-weight: 800;
  letter-spacing: -0.5px;
  margin-bottom: 6px;
}
.dir-head p { opacity: 0.9; font-size: 15px; }

.dir-body { padding: 30px 0 60px; }

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding: 16px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  margin-bottom: 22px;
  align-items: center;
}
.filters input,
.filters select {
  padding: 10px 14px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  font-size: 14px;
  font-family: inherit;
  background: #fff;
  color: #334155;
  outline: none;
}
.filters input { flex: 1; min-width: 180px; }
.filters select { min-width: 150px; }
.filters input:focus,
.filters select:focus { border-color: #b91c1c; }

.near-btn {
  background: #b91c1c;
  color: #fff;
  border: 0;
  padding: 10px 18px;
  border-radius: 8px;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  font-family: inherit;
  white-space: nowrap;
}
.near-btn:hover { background: #991b1b; }
.near-btn.active { background: #059669; }

.results-count {
  font-size: 13px;
  font-weight: 700;
  color: #64748b;
  margin-left: auto;
  padding: 8px 12px;
  background: #f1f5f9;
  border-radius: 8px;
}

.biz-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 16px;
}

.biz-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 18px;
  transition: all 0.2s;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.biz-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 28px -8px rgba(185,28,28,0.15);
  border-color: #fca5a5;
}

.biz-top { display: flex; gap: 12px; align-items: flex-start; }
.biz-av {
  width: 48px; height: 48px;
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 800; font-size: 20px;
  flex-shrink: 0;
}
.biz-info { flex: 1; min-width: 0; }
.biz-name {
  font-size: 15.5px; font-weight: 800; color: #0f172a;
  margin: 0 0 3px; line-height: 1.25;
  overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.biz-sub { font-size: 12px; color: #64748b; }

.badges { display: flex; flex-direction: column; gap: 4px; align-items: flex-end; }
.badge {
  font-size: 9.5px; font-weight: 800;
  padding: 3px 8px; border-radius: 6px;
  text-transform: uppercase; letter-spacing: 0.4px;
  white-space: nowrap;
}
.badge.gold { background: linear-gradient(135deg,#fef3c7,#fde68a); color: #92400e; border: 1px solid #fbbf24; }
.badge.green { background: linear-gradient(135deg,#d1fae5,#a7f3d0); color: #065f46; border: 1px solid #34d399; }

.biz-meta { display: flex; flex-wrap: wrap; gap: 6px; font-size: 12px; }
.pill {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 4px 9px; border-radius: 99px;
  background: #f8fafc; border: 1px solid #e2e8f0;
  color: #334155; font-weight: 600;
  font-size: 11.5px;
}
.pill.rating { background: #f0fdf4; color: #166534; border-color: #bbf7d0; }
.pill.loc { color: #334155; }
.pill.deal { background: linear-gradient(135deg,#fffbeb,#fef3c7); color: #92400e; border-color: #fbbf24; font-weight: 700; }

.timing { font-size: 12px; color: #64748b; }
.social { display: flex; gap: 8px; font-size: 15px; }
.social a { text-decoration: none; }

.actions {
  display: flex; flex-wrap: wrap; gap: 6px;
  margin-top: auto; padding-top: 12px;
  border-top: 1px solid #f1f5f9;
}
.act {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 7px 12px; border-radius: 8px;
  font-size: 11.5px; font-weight: 700;
  text-decoration: none;
  border: 1px solid transparent;
  transition: all 0.2s;
}
.act.call { background: #fef2f2; color: #991b1b; border-color: #fecaca; }
.act.call:hover { background: #dc2626; color: #fff; }
.act.wa { background: #f0fdf4; color: #14532d; border-color: #bbf7d0; }
.act.wa:hover { background: #16a34a; color: #fff; }
.act.web { background: #eff6ff; color: #1e3a8a; border-color: #bfdbfe; }
.act.web:hover { background: #2563eb; color: #fff; }
.act.map { background: #f5f3ff; color: #4c1d95; border-color: #ddd6fe; }
.act.map:hover { background: #7c3aed; color: #fff; }
.act.email { background: #fefce8; color: #854d0e; border-color: #fef08a; }
.act.email:hover { background: #ca8a04; color: #fff; }

.empty {
  grid-column: 1 / -1;
  text-align: center; padding: 60px 20px;
  color: #64748b; font-size: 15px;
  background: #fff; border-radius: 14px;
  border: 1px dashed #cbd5e1;
}

.pagination {
  display: flex; justify-content: center;
  gap: 6px; margin-top: 32px; flex-wrap: wrap;
}
.pagination button {
  padding: 8px 14px; border: 1px solid #e2e8f0;
  background: #fff; border-radius: 8px;
  cursor: pointer; font-size: 13px; font-weight: 700;
  color: #334155; font-family: inherit;
  transition: all 0.2s;
}
.pagination button:hover:not(:disabled) { border-color: #b91c1c; color: #b91c1c; }
.pagination button.active { background: #b91c1c; color: #fff; border-color: #b91c1c; }
.pagination button:disabled { opacity: 0.4; cursor: not-allowed; }
.pagination span { padding: 8px 4px; color: #94a3b8; }

@media (max-width: 768px) {
  .dir-head h1 { font-size: 24px; }
  .filters { flex-direction: column; align-items: stretch; }
  .filters input, .filters select { min-width: 100%; }
  .results-count { margin-left: 0; text-align: center; }
  .biz-grid { grid-template-columns: 1fr; }
}
</style>
