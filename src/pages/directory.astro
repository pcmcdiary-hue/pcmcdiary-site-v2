---
import BaseLayout from '../layouts/BaseLayout.astro';

const CDN = 'https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data';

const iconMap = {
  'Food & Dining': 'fa-utensils',
  'Grocery & Kirana': 'fa-cart-shopping',
  'Health & Medical': 'fa-stethoscope',
  'Beauty & Personal Care': 'fa-spa',
  'Fitness & Wellness': 'fa-dumbbell',
  'Education & Learning': 'fa-graduation-cap',
  'Fashion & Apparel': 'fa-shirt',
  'Jewelry & Gold': 'fa-gem',
  'Electronics & Gadgets': 'fa-laptop',
  'Home & Interior': 'fa-couch',
  'Automotive': 'fa-car',
  'Domestic Services': 'fa-broom',
  'IT & Digital Services': 'fa-code',
  'Logistics & Movers': 'fa-truck-fast',
  'Hospitality & Travel': 'fa-plane',
  'Entertainment & Events': 'fa-film',
  'Kids & Baby': 'fa-child',
  'Books & Stationery': 'fa-book',
  'Gardening & Outdoor': 'fa-seedling',
  'Pet Care': 'fa-paw',
  'Real Estate & Property': 'fa-building',
  'Finance & Legal': 'fa-coins',
  'Packaging & Printing': 'fa-print',
  'Cafes & Quick Bites': 'fa-mug-hot',
  'Shopping & Retail': 'fa-bag-shopping',
  'Communication & Internet': 'fa-wifi',
  'Security Services': 'fa-shield-halved',
  'Alternative Medicine': 'fa-leaf',
  'Photography & Video': 'fa-camera',
  'Celebrations & Gifts': 'fa-gift',
  'Government Services': 'fa-landmark',
  'Utilities': 'fa-bolt',
  'Daily Use Services': 'fa-screwdriver-wrench',
  'Fitness Equipment': 'fa-person-running',
  'Ayurveda & Wellness': 'fa-mortar-pestle',
  'Coaches & Trainers': 'fa-chalkboard-user',
  'Interior & Exterior Design': 'fa-paint-roller',
  'Consulting Services': 'fa-handshake',
  'Specialty Stores': 'fa-store'
};

let categories = [];
let locations = [];
let businesses = [];

try {
  const catRes = await fetch(`${CDN}/categories.json`);
  const catData = await catRes.json();
  categories = (catData.categories || []).map(c => ({
    ...c,
    iconClass: iconMap[c.categoryName] || 'fa-folder'
  }));
} catch (e) { console.error(e); }

try {
  const locRes = await fetch(`${CDN}/locations.json`);
  const locData = await locRes.json();
  locations = locData.locations || [];
} catch (e) { console.error(e); }

const results = await Promise.all(
  categories.map(async (cat) => {
    try {
      const res = await fetch(`${CDN}/${cat.file}`);
      const data = await res.json();
      return data.map(b => ({
        ...b,
        categoryId: cat.categoryId,
        categoryName: cat.categoryName,
        categoryIcon: cat.iconClass
      }));
    } catch (e) { return []; }
  })
);
businesses = results.flat();
---

<BaseLayout title="Directory" description="Browse all verified local businesses in Pimpri-Chinchwad.">

  <section class="dir-hero">
    <div class="container">
      <div class="hero-eyebrow">
        <i class="fa-solid fa-list"></i>
        Directory
      </div>
      <h1>Discover <em>local businesses</em></h1>
      <p>Browse {businesses.length}+ verified businesses across 33 areas of Pimpri-Chinchwad</p>
    </div>
  </section>

  <section class="dir-body">
    <div class="container">

      <div class="filters">
        <div class="f-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="searchInput" placeholder="Search by name, tag, area…" />
        </div>
        <select id="catFilter" class="f-select">
          <option value="">All Categories</option>
          {categories.map(c => <option value={c.categoryId}>{c.categoryName}</option>)}
        </select>
        <select id="locFilter" class="f-select">
          <option value="">All Locations</option>
          {locations.map(l => <option value={l.locationId}>{l.locationName}</option>)}
        </select>
        <select id="sortFilter" class="f-select">
          <option value="tier">Featured First</option>
          <option value="rating">Top Rated</option>
          <option value="name">Name A-Z</option>
        </select>
        <button id="nearMeBtn" class="near-btn">
          <i class="fa-solid fa-location-crosshairs"></i>
          Near Me
        </button>
      </div>

      <div class="results-bar">
        <span class="results-count" id="resultsCount">
          <i class="fa-solid fa-store"></i>
          {businesses.length} businesses
        </span>
        <span class="results-hint">
          <i class="fa-solid fa-circle-check"></i>
          Updated daily
        </span>
      </div>

      <div class="biz-grid" id="bizGrid"></div>

      <div class="pagination" id="pagination"></div>

    </div>
  </section>

</BaseLayout>

<script define:vars={{ businesses, categories, locations }}>
  const ALL = businesses;
  const LOCS = locations;
  const PER_PAGE = 24;

  const state = {
    search: '',
    category: '',
    location: '',
    sort: 'tier',
    page: 1,
    filtered: [...ALL]
  };

  function tierPriority(b) {
    const t = (b.tier || '').toLowerCase();
    if (t === 'featured') return 1;
    if (t === 'premium_pro') return 2;
    if (t === 'premium') return 3;
    if (t === 'vp') return 4;
    if (t === 'vb') return 5;
    return 6;
  }

  function avatarColors(name) {
    const pal = [
      ['#dc2626','#991b1b'],['#ea580c','#c2410c'],['#d97706','#b45309'],
      ['#65a30d','#4d7c0f'],['#059669','#047857'],['#0891b2','#0e7490'],
      ['#0284c7','#0369a1'],['#4f46e5','#4338ca'],['#7c3aed','#6d28d9'],
      ['#c026d3','#a21caf'],['#db2777','#be185d'],['#e11d48','#be123c']
    ];
    let h = 0;
    for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
    return pal[Math.abs(h) % pal.length];
  }

  function getBadges(b) {
    const t = (b.tier || '').toLowerCase();
    const out = [];
    if (t === 'featured') out.push('<span class="badge badge-featured"><i class="fa-solid fa-star"></i> Featured</span>');
    else if (t === 'premium_pro') out.push('<span class="badge badge-premium"><i class="fa-solid fa-crown"></i> Premium Pro</span>');
    else if (t === 'premium') out.push('<span class="badge badge-premium"><i class="fa-solid fa-crown"></i> Premium</span>');
    if (['featured','premium','premium_pro','vp','vb'].includes(t)) {
      out.push('<span class="badge badge-verified"><i class="fa-solid fa-circle-check"></i> Verified</span>');
    }
    return out.join('');
  }

  function cleanPhone(p) { return (p || '').replace(/\s/g, ''); }

  function renderCard(b) {
    const t = (b.tier || '').toLowerCase();
    const isPremium = ['premium','premium_pro','featured'].includes(t);
    const isPro = t === 'premium_pro';
    const name = b.businessName || 'Business';
    const initial = name.trim().charAt(0).toUpperCase();
    const [c1, c2] = avatarColors(name);
    const rating = parseFloat(b.rating) || 0;
    const reviews = parseInt(b.reviews) || 0;

    const metaPills = [];
    if (rating > 0) {
      metaPills.push(`<span class="meta-pill meta-rating"><i class="fa-solid fa-star"></i> ${rating.toFixed(1)}${reviews ? ` <span class="rev">(${reviews})</span>` : ''}</span>`);
    }
    if (b.location) {
      metaPills.push(`<span class="meta-pill meta-loc"><i class="fa-solid fa-location-dot"></i> ${b.location}</span>`);
    }
    if (isPremium && b.deals) {
      metaPills.push(`<span class="meta-pill meta-deal"><i class="fa-solid fa-gift"></i> ${b.deals}</span>`);
    }

    const actions = [];
    if (b.phone) actions.push(`<a href="tel:${cleanPhone(b.phone)}" class="act act-call"><i class="fa-solid fa-phone"></i> Call</a>`);
    if (isPremium && b.phone) actions.push(`<a href="https://wa.me/${cleanPhone(b.phone)}" target="_blank" rel="noopener" class="act act-wa"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>`);
    if (isPremium && b.website) actions.push(`<a href="${b.website}" target="_blank" rel="noopener" class="act act-web"><i class="fa-solid fa-globe"></i> Web</a>`);
    if (isPremium && b.googleMap) actions.push(`<a href="${b.googleMap}" target="_blank" rel="noopener" class="act act-map"><i class="fa-solid fa-map-location-dot"></i> Map</a>`);
    if (isPro && b.email) actions.push(`<a href="mailto:${b.email}" class="act act-mail"><i class="fa-solid fa-envelope"></i> Email</a>`);

    const timingHtml = (isPremium && b.timing)
      ? `<div class="biz-timing"><i class="fa-solid fa-clock"></i> ${b.timing}</div>`
      : '';

    let socialHtml = '';
    if (isPro && b.socialLinks) {
      const icons = {
        insta: 'fa-brands fa-instagram',
        fb: 'fa-brands fa-facebook',
        yt: 'fa-brands fa-youtube',
        tw: 'fa-brands fa-x-twitter',
        li: 'fa-brands fa-linkedin',
        wa: 'fa-brands fa-whatsapp'
      };
      socialHtml = `<div class="biz-social">${b.socialLinks.split('|').map(p => {
        const [k, u] = p.split(':');
        if (!u) return '';
        return `<a href="${u.trim()}" target="_blank" rel="noopener" title="${k}"><i class="${icons[k.trim()] || 'fa-solid fa-link'}"></i></a>`;
      }).join('')}</div>`;
    }

    return `
      <article class="biz-card">
        <div class="biz-glow" style="background: radial-gradient(circle at 30% 0%, ${c1}22, transparent 70%)"></div>
        <header class="biz-head">
          <div class="biz-av" style="background: linear-gradient(135deg, ${c1}, ${c2})">
            <span>${initial}</span>
          </div>
          <div class="biz-head-text">
            <h3 class="biz-name">${name}</h3>
            ${b.subCategory ? `<div class="biz-sub">${b.subCategory}</div>` : ''}
          </div>
        </header>
        <div class="biz-badges">${getBadges(b)}</div>
        <div class="biz-meta">${metaPills.join('')}</div>
        ${timingHtml}
        ${socialHtml}
        <footer class="biz-actions">${actions.join('')}</footer>
      </article>
    `;
  }

  function applyFilters() {
    let list = [...ALL];
    if (state.search) {
      const q = state.search.toLowerCase();
      list = list.filter(b =>
        (b.businessName || '').toLowerCase().includes(q) ||
        (b.subCategory || '').toLowerCase().includes(q) ||
        (b.tags || '').toLowerCase().includes(q) ||
        (b.location || '').toLowerCase().includes(q)
      );
    }
    if (state.category) list = list.filter(b => b.categoryId === state.category);
    if (state.location) {
      const loc = LOCS.find(l => l.locationId === state.location);
      if (loc) {
        list = list.filter(b =>
          (b.location || '') === loc.locationName ||
          (b.serviceArea || '').includes(loc.locationName)
        );
      }
    }
    if (state.sort === 'tier') {
      list.sort((a, b) => {
        const d = tierPriority(a) - tierPriority(b);
        if (d !== 0) return d;
        return (parseFloat(b.rating) || 0) - (parseFloat(a.rating) || 0);
      });
    } else if (state.sort === 'rating') {
      list.sort((a, b) => (parseFloat(b.rating) || 0) - (parseFloat(a.rating) || 0));
    } else if (state.sort === 'name') {
      list.sort((a, b) => (a.businessName || '').localeCompare(b.businessName || ''));
    }
    state.filtered = list;
    state.page = 1;
    render();
  }

  function render() {
    const total = state.filtered.length;
    const totalPages = Math.ceil(total / PER_PAGE) || 1;
    const start = (state.page - 1) * PER_PAGE;
    const items = state.filtered.slice(start, start + PER_PAGE);
    document.getElementById('resultsCount').innerHTML = `<i class="fa-solid fa-store"></i> ${total} businesses`;
    const grid = document.getElementById('bizGrid');
    if (total === 0) {
      grid.innerHTML = `<div class="empty"><i class="fa-solid fa-magnifying-glass" style="font-size:40px;color:#cbd5e1;margin-bottom:16px;display:block"></i>No businesses found. Try adjusting filters.</div>`;
      document.getElementById('pagination').innerHTML = '';
      return;
    }
    grid.innerHTML = items.map(renderCard).join('');
    renderPagination(totalPages);
  }

  function renderPagination(totalPages) {
    const el = document.getElementById('pagination');
    if (totalPages <= 1) { el.innerHTML = ''; return; }
    let html = '';
    html += `<button ${state.page === 1 ? 'disabled' : ''} data-page="${state.page - 1}"><i class="fa-solid fa-chevron-left"></i></button>`;
    const s = Math.max(1, state.page - 2);
    const e = Math.min(totalPages, state.page + 2);
    if (s > 1) { html += `<button data-page="1">1</button>`; if (s > 2) html += `<span>…</span>`; }
    for (let i = s; i <= e; i++) html += `<button data-page="${i}" ${i === state.page ? 'class="active"' : ''}>${i}</button>`;
    if (e < totalPages) { if (e < totalPages - 1) html += `<span>…</span>`; html += `<button data-page="${totalPages}">${totalPages}</button>`; }
    html += `<button ${state.page === totalPages ? 'disabled' : ''} data-page="${state.page + 1}"><i class="fa-solid fa-chevron-right"></i></button>`;
    el.innerHTML = html;
    el.querySelectorAll('button[data-page]').forEach(btn => {
      btn.addEventListener('click', () => {
        state.page = parseInt(btn.dataset.page);
        render();
        window.scrollTo({ top: 300, behavior: 'smooth' });
      });
    });
  }

  document.getElementById('searchInput').addEventListener('input', e => { state.search = e.target.value; applyFilters(); });
  document.getElementById('catFilter').addEventListener('change', e => { state.category = e.target.value; applyFilters(); });
  document.getElementById('locFilter').addEventListener('change', e => { state.location = e.target.value; applyFilters(); });
  document.getElementById('sortFilter').addEventListener('change', e => { state.sort = e.target.value; applyFilters(); });

  document.getElementById('nearMeBtn').addEventListener('click', () => {
    if (!navigator.geolocation) return alert('Not supported');
    const btn = document.getElementById('nearMeBtn');
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Detecting…';
    navigator.geolocation.getCurrentPosition(
      pos => {
        const { latitude, longitude } = pos.coords;
        const dist = (a,b,c,d) => {
          const R = 6371, dLat = (c-a)*Math.PI/180, dLon = (d-b)*Math.PI/180;
          const x = Math.sin(dLat/2)**2 + Math.cos(a*Math.PI/180)*Math.cos(c*Math.PI/180)*Math.sin(dLon/2)**2;
          return R*2*Math.atan2(Math.sqrt(x), Math.sqrt(1-x));
        };
        state.filtered = [...ALL].filter(b => {
          const la = parseFloat(b.latitude), lo = parseFloat(b.longitude);
          if (!la || !lo) return false;
          return dist(latitude, longitude, la, lo) <= 15;
        }).sort((a, b) => dist(latitude, longitude, parseFloat(a.latitude), parseFloat(a.longitude)) - dist(latitude, longitude, parseFloat(b.latitude), parseFloat(b.longitude)));
        state.page = 1;
        document.getElementById('resultsCount').innerHTML = `<i class="fa-solid fa-location-crosshairs"></i> ${state.filtered.length} near you`;
        const grid = document.getElementById('bizGrid');
        if (state.filtered.length === 0) {
          grid.innerHTML = `<div class="empty">No businesses within 15 km.</div>`;
          document.getElementById('pagination').innerHTML = '';
        } else {
          grid.innerHTML = state.filtered.slice(0, PER_PAGE).map(renderCard).join('');
          renderPagination(Math.ceil(state.filtered.length / PER_PAGE));
        }
        btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Near Me (ON)';
        btn.classList.add('active');
      },
      () => {
        btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Near Me';
        alert('Location denied');
      }
    );
  });

  applyFilters();
</script>

<style>
.dir-hero {
  background: linear-gradient(135deg, #b91c1c 0%, #7f1d1d 60%, #450a0a 100%);
  color: #fff;
  padding: 56px 0 48px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.dir-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.06) 1px, transparent 1px),
              radial-gradient(circle at 80% 70%, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 60px 60px, 80px 80px;
  opacity: 0.6;
}
.dir-hero .container { position: relative; z-index: 2; }
.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #fde047;
  margin-bottom: 14px;
  padding: 6px 16px;
  background: rgba(255,255,255,0.1);
  border-radius: 50px;
  border: 1px solid rgba(255,255,255,0.15);
  backdrop-filter: blur(10px);
}
.hero-eyebrow i { font-size: 11px; }
.dir-hero h1 {
  font-size: 40px;
  font-weight: 800;
  letter-spacing: -1px;
  line-height: 1.12;
  margin: 0 0 12px;
}
.dir-hero h1 em { font-style: italic; color: #fde047; }
.dir-hero p {
  font-size: 15px;
  opacity: 0.85;
  max-width: 560px;
  margin: 0 auto;
}

.dir-body { padding: 32px 0 72px; background: #f8fafc; min-height: 60vh; }

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding: 14px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  margin-bottom: 16px;
  align-items: center;
  box-shadow: 0 1px 3px rgba(15,23,42,0.04);
}
.f-search {
  flex: 1;
  min-width: 200px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 16px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  transition: all 0.2s;
}
.f-search:focus-within {
  border-color: #b91c1c;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(185,28,28,0.08);
}
.f-search i {
  font-size: 14px;
  color: #94a3b8;
}
.f-search:focus-within i { color: #b91c1c; }
.f-search input {
  flex: 1;
  border: 0;
  background: transparent;
  padding: 13px 0;
  font-size: 14px;
  font-family: inherit;
  outline: none;
  color: #0f172a;
  font-weight: 500;
}
.f-search input::placeholder { color: #94a3b8; }

.f-select {
  padding: 13px 16px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  font-size: 13.5px;
  font-family: inherit;
  background: #fff;
  color: #334155;
  font-weight: 600;
  outline: none;
  cursor: pointer;
  transition: all 0.2s;
}
.f-select:hover { border-color: #cbd5e1; }
.f-select:focus { border-color: #b91c1c; box-shadow: 0 0 0 3px rgba(185,28,28,0.08); }

.near-btn {
  background: linear-gradient(135deg, #b91c1c, #991b1b);
  color: #fff;
  border: 0;
  padding: 13px 20px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  font-family: inherit;
  white-space: nowrap;
  box-shadow: 0 4px 12px -4px rgba(185,28,28,0.4);
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.near-btn i { font-size: 12px; }
.near-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px -4px rgba(185,28,28,0.5); }
.near-btn.active { background: linear-gradient(135deg, #059669, #047857); }

.results-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
  padding: 0 4px;
  flex-wrap: wrap;
  gap: 8px;
}
.results-count {
  font-size: 13.5px;
  font-weight: 800;
  color: #0f172a;
  padding: 8px 16px;
  background: #fff;
  border-radius: 50px;
  border: 1px solid #e2e8f0;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.results-count i { color: #b91c1c; font-size: 12px; }
.results-hint {
  font-size: 12px;
  color: #64748b;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.results-hint i { color: #059669; font-size: 12px; }

.biz-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
  gap: 16px;
}

.biz-card {
  position: relative;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  box-shadow: 0 1px 2px rgba(15,23,42,0.03);
}
.biz-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20px;
  right: 20px;
  height: 3px;
  background: linear-gradient(90deg, #b91c1c, #f59e0b);
  border-radius: 0 0 4px 4px;
  opacity: 0;
  transition: opacity 0.3s;
}
.biz-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 40px -16px rgba(15,23,42,0.12), 0 8px 16px -8px rgba(15,23,42,0.06);
  border-color: #fca5a5;
}
.biz-card:hover::before { opacity: 1; }

.biz-glow {
  position: absolute;
  top: -50px;
  right: -50px;
  width: 200px;
  height: 200px;
  pointer-events: none;
  opacity: 0.4;
  border-radius: 50%;
}

.biz-head {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  position: relative;
  z-index: 1;
}
.biz-av {
  width: 54px;
  height: 54px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 800;
  font-size: 22px;
  flex-shrink: 0;
  box-shadow: 0 8px 20px -8px rgba(15,23,42,0.3), inset 0 1px 0 rgba(255,255,255,0.2);
  position: relative;
}
.biz-av span { position: relative; z-index: 1; }
.biz-head-text { flex: 1; min-width: 0; padding-top: 2px; }
.biz-name {
  font-size: 16px;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 4px;
  line-height: 1.25;
  letter-spacing: -0.3px;
  overflow: hidden;
