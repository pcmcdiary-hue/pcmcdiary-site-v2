---
import BaseLayout from '../layouts/BaseLayout.astro';

const CDN = 'https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data';

const iconMap = {
  'Food & Dining': 'fa-utensils','Grocery & Kirana': 'fa-cart-shopping','Health & Medical': 'fa-stethoscope',
  'Beauty & Personal Care': 'fa-spa','Fitness & Wellness': 'fa-dumbbell','Education & Learning': 'fa-graduation-cap',
  'Fashion & Apparel': 'fa-shirt','Jewelry & Gold': 'fa-gem','Electronics & Gadgets': 'fa-laptop',
  'Home & Interior': 'fa-couch','Automotive': 'fa-car','Domestic Services': 'fa-broom',
  'IT & Digital Services': 'fa-code','Logistics & Movers': 'fa-truck-fast','Hospitality & Travel': 'fa-plane',
  'Entertainment & Events': 'fa-film','Kids & Baby': 'fa-child','Books & Stationery': 'fa-book',
  'Gardening & Outdoor': 'fa-seedling','Pet Care': 'fa-paw','Real Estate & Property': 'fa-building',
  'Finance & Legal': 'fa-coins','Packaging & Printing': 'fa-print','Cafes & Quick Bites': 'fa-mug-hot',
  'Shopping & Retail': 'fa-bag-shopping','Communication & Internet': 'fa-wifi','Security Services': 'fa-shield-halved',
  'Alternative Medicine': 'fa-leaf','Photography & Video': 'fa-camera','Celebrations & Gifts': 'fa-gift',
  'Government Services': 'fa-landmark','Utilities': 'fa-bolt','Daily Use Services': 'fa-screwdriver-wrench',
  'Fitness Equipment': 'fa-person-running','Ayurveda & Wellness': 'fa-mortar-pestle','Coaches & Trainers': 'fa-chalkboard-user',
  'Interior & Exterior Design': 'fa-paint-roller','Consulting Services': 'fa-handshake','Specialty Stores': 'fa-store'
};

let categories = [];
let locations = [];
let businesses = [];

try {
  const catRes = await fetch(`${CDN}/categories.json`);
  const catData = await catRes.json();
  categories = (catData.categories || []).map(c => ({ ...c, iconClass: iconMap[c.categoryName] || 'fa-folder' }));
} catch (e) { console.error(e); }

try {
  const locRes = await fetch(`${CDN}/locations.json`);
  const locData = await locRes.json();
  locations = locData.locations || [];
} catch (e) { console.error(e); }

const results = await Promise.all(
  categories.map(async (cat) => {
    try {
      const res = await fetch(`${CDN}/${cat.file}`);
      const data = await res.json();
      return data.map(b => ({ ...b, categoryId: cat.categoryId }));
    } catch (e) { return []; }
  })
);
businesses = results.flat();
---

<BaseLayout title="Directory" description="Browse verified businesses in Pimpri-Chinchwad.">

  <div class="dir-page">
    <div class="dir-container">

      <header class="dir-head">
        <h1><span>PCMC</span> Business Directory</h1>
        <p>Find trusted local businesses &amp; services</p>
      </header>

      <div class="cat-pills" id="catPills">
        <button class="cat-pill active" data-cat="all">
          <span class="cp-icon"><i class="fa-solid fa-border-all"></i></span>
          <span class="cp-name">All</span>
        </button>
        {categories.map(c => (
          <button class="cat-pill" data-cat={c.categoryId}>
            <span class="cp-icon"><i class={`fa-solid ${c.iconClass}`}></i></span>
            <span class="cp-name">{c.categoryName.length > 14 ? c.categoryName.substring(0, 12) + '…' : c.categoryName}</span>
          </button>
        ))}
      </div>

      <div class="filters">
        <select id="locFilter" class="f-select">
          <option value="all">All Locations</option>
          {locations.map(l => <option value={l.locationName}>{l.locationName}</option>)}
        </select>
        <select id="sortFilter" class="f-select">
          <option value="featured">Featured First</option>
          <option value="rating">Top Rated</option>
          <option value="name">Name A-Z</option>
        </select>
        <input type="text" id="searchInput" class="f-input" placeholder="Search…" />
        <button id="nearMeBtn" class="near-btn">
          <i class="fa-solid fa-location-crosshairs"></i> Near Me
        </button>
        <span class="results-count" id="resultsCount">
          <i class="fa-solid fa-store"></i> {businesses.length} businesses
        </span>
      </div>

      <div class="biz-grid" id="bizGrid"></div>
      <div class="pagination" id="pagination"></div>

    </div>
  </div>

</BaseLayout>

<script define:vars={{ businesses, locations }}>
  const ALL = businesses;
  const LOCS = locations;
  const PER_PAGE = 20;

  const state = { search: '', category: 'all', location: 'all', sort: 'featured', page: 1, filtered: [...ALL] };

  function tierRank(b) {
    const t = (b.tier || '').toLowerCase();
    if (t === 'featured') return 1;
    if (t === 'premium_pro') return 2;
    if (t === 'premium') return 3;
    if (t === 'vp') return 4;
    if (t === 'vb') return 5;
    return 6;
  }

  function avatarColors(name) {
    const pal = [['#dc2626','#991b1b'],['#ea580c','#c2410c'],['#d97706','#b45309'],['#ca8a04','#a16207'],['#65a30d','#4d7c0f'],['#059669','#047857'],['#0891b2','#0e7490'],['#0284c7','#0369a1'],['#4f46e5','#4338ca'],['#7c3aed','#6d28d9'],['#c026d3','#a21caf'],['#db2777','#be185d'],['#e11d48','#be123c'],['#9333ea','#7e22ce']];
    let h = 0;
    for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
    return pal[Math.abs(h) % pal.length];
  }

  function getBadges(b) {
    const t = (b.tier || '').toLowerCase();
    const out = [];
    if (t === 'featured') out.push('<span class="badge badge-featured"><i class="fa-solid fa-star"></i><span>Featured</span></span>');
    else if (t === 'premium_pro') out.push('<span class="badge badge-premium"><i class="fa-solid fa-crown"></i><span>Premium Pro</span></span>');
    else if (t === 'premium') out.push('<span class="badge badge-premium"><i class="fa-solid fa-crown"></i><span>Premium</span></span>');
    if (['featured','premium','premium_pro','vp','vb'].includes(t)) out.push('<span class="badge badge-verified"><i class="fa-solid fa-circle-check"></i><span>Verified</span></span>');
    return out.join('');
  }

  function clean(p) { return (p || '').replace(/\s/g, ''); }

  function renderCard(b) {
    const t = (b.tier || '').toLowerCase();
    const isPremium = ['featured','premium','premium_pro'].includes(t);
    const isPro = t === 'premium_pro';
    const name = b.businessName || 'Business';
    const initial = name.trim().charAt(0).toUpperCase();
    const [c1, c2] = avatarColors(name);
    const rating = parseFloat(b.rating) || 0;
    const reviews = parseInt(b.reviews) || 0;

    const badgesHtml = getBadges(b);

    let statsHtml = '';
    if (rating > 0) {
      statsHtml += `<div class="stat"><i class="fa-solid fa-star stat-star"></i><div class="stat-body"><span class="stat-val">${rating.toFixed(1)}</span>${reviews ? `<span class="stat-sub">${reviews} reviews</span>` : ''}</div></div>`;
    }
    if (b.location) {
      statsHtml += `<div class="stat"><i class="fa-solid fa-location-dot stat-loc"></i><div class="stat-body"><span class="stat-val">${b.location}</span><span class="stat-sub">Area</span></div></div>`;
    }

    let dealHtml = '';
    if (isPremium && b.deals) {
      dealHtml = `
        <div class="deal-box">
          <div class="deal-icon"><i class="fa-solid fa-gift"></i></div>
          <div class="deal-body">
            <div class="deal-label">Limited Offer</div>
            <div class="deal-text">${b.deals}</div>
          </div>
        </div>`;
    }

    let metaRowHtml = '';
    if ((isPremium && b.timing) || (isPro && b.socialLinks)) {
      const timing = (isPremium && b.timing) ? `<div class="meta-item"><i class="fa-regular fa-clock"></i><span>${b.timing}</span></div>` : '';
      let social = '';
      if (isPro && b.socialLinks) {
        const icons = { insta: 'fa-brands fa-instagram', fb: 'fa-brands fa-facebook-f', yt: 'fa-brands fa-youtube', tw: 'fa-brands fa-x-twitter', li: 'fa-brands fa-linkedin-in', wa: 'fa-brands fa-whatsapp' };
        social = `<div class="meta-social">${b.socialLinks.split('|').map(p => {
        const idx = p.indexOf(':');
if (idx === -1) return '';
const k = p.substring(0, idx);
const u = p.substring(idx + 1);
          if (!u) return '';
          return `<a href="${u.trim()}" target="_blank" rel="noopener" title="${k}"><i class="${icons[k.trim()] || 'fa-solid fa-link'}"></i></a>`;
        }).join('')}</div>`;
      }
      metaRowHtml = `<div class="meta-row">${timing}${social}</div>`;
    }

    let actions = '';
    if (b.phone) actions += `<a href="tel:${clean(b.phone)}" class="act act-call"><i class="fa-solid fa-phone"></i><span>Call</span></a>`;
    if (isPremium && b.phone) actions += `<a href="https://wa.me/${clean(b.phone)}" target="_blank" rel="noopener" class="act act-wa"><i class="fa-brands fa-whatsapp"></i><span>WhatsApp</span></a>`;
    if (isPremium && b.website) actions += `<a href="${b.website}" target="_blank" rel="noopener" class="act act-web"><i class="fa-solid fa-globe"></i><span>Web</span></a>`;
    if (isPremium && b.googleMap) actions += `<a href="${b.googleMap}" target="_blank" rel="noopener" class="act act-map"><i class="fa-solid fa-map-location-dot"></i><span>Map</span></a>`;
    if (isPro && b.email) actions += `<a href="mailto:${b.email}" class="act act-mail"><i class="fa-solid fa-envelope"></i><span>Email</span></a>`;

    return `
      <article class="biz-card">
        <div class="card-accent" style="background: linear-gradient(90deg, ${c1}, ${c2})"></div>

        <header class="card-head">
          <div class="avatar" style="background: linear-gradient(135deg, ${c1}, ${c2})">
            <span>${initial}</span>
          </div>
          <div class="head-text">
            <h3 class="biz-name">${name}</h3>
            ${b.subCategory ? `<div class="biz-sub">${b.subCategory}</div>` : ''}
          </div>
        </header>

        ${badgesHtml ? `<div class="card-badges">${badgesHtml}</div>` : ''}

        ${statsHtml ? `<div class="card-stats">${statsHtml}</div>` : ''}

        ${dealHtml}

        ${metaRowHtml}

        ${actions ? `<footer class="card-actions">${actions}</footer>` : ''}
      </article>
    `;
  }

  function applyFilters() {
    let list = [...ALL];
    if (state.category !== 'all') list = list.filter(b => b.categoryId === state.category);
    if (state.location !== 'all') list = list.filter(b => (b.location || '') === state.location || (b.serviceArea || '').includes(state.location));
    if (state.search) {
      const q = state.search.toLowerCase();
      list = list.filter(b =>
        (b.businessName || '').toLowerCase().includes(q) ||
        (b.subCategory || '').toLowerCase().includes(q) ||
        (b.tags || '').toLowerCase().includes(q) ||
        (b.location || '').toLowerCase().includes(q)
      );
    }
    if (state.sort === 'featured') {
      list.sort((a, b) => {
        const d = tierRank(a) - tierRank(b);
        if (d !== 0) return d;
        return (parseFloat(b.rating) || 0) - (parseFloat(a.rating) || 0);
      });
    } else if (state.sort === 'rating') {
      list.sort((a, b) => (parseFloat(b.rating) || 0) - (parseFloat(a.rating) || 0));
    } else if (state.sort === 'name') {
      list.sort((a, b) => (a.businessName || '').localeCompare(b.businessName || ''));
    }
    state.filtered = list;
    state.page = 1;
    render();
  }

  function render() {
    const total = state.filtered.length;
    const totalPages = Math.ceil(total / PER_PAGE) || 1;
    const start = (state.page - 1) * PER_PAGE;
    const items = state.filtered.slice(start, start + PER_PAGE);

    document.getElementById('resultsCount').innerHTML = `<i class="fa-solid fa-store"></i> ${total} business${total !== 1 ? 'es' : ''}`;
    const grid = document.getElementById('bizGrid');
    if (total === 0) {
      grid.innerHTML = `<div class="empty"><i class="fa-solid fa-magnifying-glass"></i><h3>No businesses found</h3><p>Try adjusting filters</p></div>`;
      document.getElementById('pagination').innerHTML = '';
      return;
    }
    grid.innerHTML = items.map(renderCard).join('');
    renderPagination(totalPages);
  }

  function renderPagination(totalPages) {
    const el = document.getElementById('pagination');
    if (totalPages <= 1) { el.innerHTML = ''; return; }
    let html = `<button ${state.page === 1 ? 'disabled' : ''} data-page="${state.page - 1}"><i class="fa-solid fa-chevron-left"></i></button>`;
    const s = Math.max(1, state.page - 2), e = Math.min(totalPages, state.page + 2);
    if (s > 1) { html += `<button data-page="1">1</button>`; if (s > 2) html += `<span>…</span>`; }
    for (let i = s; i <= e; i++) html += `<button data-page="${i}" ${i === state.page ? 'class="active"' : ''}>${i}</button>`;
    if (e < totalPages) { if (e < totalPages - 1) html += `<span>…</span>`; html += `<button data-page="${totalPages}">${totalPages}</button>`; }
    html += `<button ${state.page === totalPages ? 'disabled' : ''} data-page="${state.page + 1}"><i class="fa-solid fa-chevron-right"></i></button>`;
    el.innerHTML = html;
    el.querySelectorAll('button[data-page]').forEach(btn => {
      btn.addEventListener('click', () => {
        state.page = parseInt(btn.dataset.page);
        render();
        window.scrollTo({ top: 200, behavior: 'smooth' });
      });
    });
  }

  document.getElementById('catPills').addEventListener('click', e => {
    const btn = e.target.closest('.cat-pill');
    if (!btn) return;
    document.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    state.category = btn.dataset.cat;
    applyFilters();
    window.scrollTo({ top: 200, behavior: 'smooth' });
  });

  document.getElementById('locFilter').addEventListener('change', e => { state.location = e.target.value; applyFilters(); });
  document.getElementById('sortFilter').addEventListener('change', e => { state.sort = e.target.value; applyFilters(); });
  document.getElementById('searchInput').addEventListener('input', e => {
    clearTimeout(window._t);
    window._t = setTimeout(() => { state.search = e.target.value; applyFilters(); }, 250);
  });

  document.getElementById('nearMeBtn').addEventListener('click', () => {
    if (!navigator.geolocation) return alert('Not supported');
    const btn = document.getElementById('nearMeBtn');
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Detecting…';
    navigator.geolocation.getCurrentPosition(
      pos => {
        const { latitude, longitude } = pos.coords;
        const dist = (a,b,c,d) => {
          const R = 6371, dLat = (c-a)*Math.PI/180, dLon = (d-b)*Math.PI/180;
          const x = Math.sin(dLat/2)**2 + Math.cos(a*Math.PI/180)*Math.cos(c*Math.PI/180)*Math.sin(dLon/2)**2;
          return R*2*Math.atan2(Math.sqrt(x), Math.sqrt(1-x));
        };
        state.filtered = [...ALL].filter(b => {
          const la = parseFloat(b.latitude), lo = parseFloat(b.longitude);
          if (!la || !lo) return false;
          return dist(latitude, longitude, la, lo) <= 15;
        }).sort((a, b) => dist(latitude, longitude, parseFloat(a.latitude), parseFloat(a.longitude)) - dist(latitude, longitude, parseFloat(b.latitude), parseFloat(b.longitude)));
        state.page = 1;
        document.getElementById('resultsCount').innerHTML = `<i class="fa-solid fa-location-crosshairs"></i> ${state.filtered.length} near you`;
        const grid = document.getElementById('bizGrid');
        if (state.filtered.length === 0) {
          grid.innerHTML = `<div class="empty"><i class="fa-solid fa-magnifying-glass"></i><h3>No businesses within 15 km</h3></div>`;
          document.getElementById('pagination').innerHTML = '';
        } else {
          grid.innerHTML = state.filtered.slice(0, PER_PAGE).map(renderCard).join('');
          renderPagination(Math.ceil(state.filtered.length / PER_PAGE));
        }
        btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Near Me (ON)';
        btn.classList.add('active');
      },
      () => {
        btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Near Me';
        alert('Location denied');
      }
    );
  });

  applyFilters();
</script>

<style is:global>
/* ============ PAGE LAYOUT ============ */
.dir-page { background: #f8fafc; min-height: 60vh; padding: 32px 0 60px; }
.dir-container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }

.dir-head { padding: 8px 0 18px; border-bottom: 3px solid #dc2626; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; }
.dir-head h1 { font-size: 28px; font-weight: 800; color: #0f172a; margin: 0 8px 0 0; line-height: 1.2; letter-spacing: -0.5px; }
.dir-head h1 span { color: #dc2626; }
.dir-head p { color: #64748b; font-size: 14px; font-weight: 500; padding-bottom: 2px; }

.cat-pills { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 8px; margin-bottom: 20px; }
.cat-pill { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px 6px; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; cursor: pointer; transition: all 0.2s; min-height: 72px; font-family: inherit; text-align: center; }
.cat-pill:hover { border-color: #dc2626; background: #fef2f2; transform: translateY(-2px); }
.cat-pill.active { background: linear-gradient(135deg, #dc2626, #b91c1c); border-color: #dc2626; color: #fff; }
.cp-icon { font-size: 18px; line-height: 1; color: #64748b; margin-bottom: 6px; }
.cat-pill.active .cp-icon { color: #fff; }
.cat-pill:hover .cp-icon { color: #dc2626; }
.cat-pill.active:hover .cp-icon { color: #fff; }
.cp-name { font-size: 11.5px; font-weight: 700; color: #334155; line-height: 1.2; }
.cat-pill.active .cp-name { color: #fff; }

.filters { display: flex; flex-wrap: wrap; margin-bottom: 24px; padding: 14px 0; border-bottom: 1px solid #e2e8f0; align-items: center; }
.f-select, .f-input { padding: 10px 14px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 13.5px; background: #fff; flex: 1; min-width: 130px; font-family: inherit; color: #334155; font-weight: 600; outline: none; margin-right: 10px; margin-bottom: 6px; }
.f-select:focus, .f-input:focus { border-color: #dc2626; box-shadow: 0 0 0 3px rgba(220,38,38,0.08); }
.near-btn { background: linear-gradient(135deg, #dc2626, #b91c1c); color: #fff; border: 0; padding: 10px 20px; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 13px; display: inline-flex; align-items: center; white-space: nowrap; font-family: inherit; margin-right: 10px; margin-bottom: 6px; }
.near-btn i { margin-right: 6px; font-size: 12px; }
.near-btn:hover { transform: translateY(-1px); }
.near-btn.active { background: linear-gradient(135deg, #059669, #047857); }
.results-count { font-size: 13px; color: #64748b; font-weight: 700; margin-left: auto; padding: 8px 14px; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; white-space: nowrap; display: inline-flex; align-items: center; }
.results-count i { color: #dc2626; margin-right: 7px; }

.biz-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }

/* ============================================
   PREMIUM CARD
   ============================================ */
.biz-grid .biz-card {
  position: relative;
  background: #ffffff;
  border: 1px solid #e8ecf1;
  border-radius: 16px;
  padding: 22px 22px 0;
  display: flex;
  flex-direction: column;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03), 0 4px 12px -8px rgba(15, 23, 42, 0.04);
}
.biz-grid .biz-card:hover {
  border-color: #fecaca;
  box-shadow: 0 20px 40px -16px rgba(15, 23, 42, 0.12), 0 8px 16px -8px rgba(220, 38, 38, 0.08);
  transform: translateY(-4px);
}

.biz-grid .card-accent {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  opacity: 0.85;
}

.biz-grid .card-head {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  margin-bottom: 16px;
}
.biz-grid .avatar {
  width: 54px;
  height: 54px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 800;
  font-size: 22px;
  letter-spacing: -0.5px;
  flex-shrink: 0;
  box-shadow: 0 6px 16px -6px rgba(15, 23, 42, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.18);
}
.biz-grid .head-text { flex: 1; min-width: 0; padding-top: 2px; }
.biz-grid .biz-name {
  font-size: 16.5px;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 5px 0;
  line-height: 1.28;
  letter-spacing: -0.4px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.biz-grid .biz-sub {
  font-size: 12.5px;
  color: #64748b;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.biz-grid .card-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 18px;
}
.biz-grid .badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 10px;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  white-space: nowrap;
  line-height: 1;
}
.biz-grid .badge i { font-size: 10px; }
.biz-grid .badge-featured {
  background: linear-gradient(135deg, #fef3c7, #fbbf24);
  color: #78350f;
  box-shadow: 0 2px 6px -2px rgba(251, 191, 36, 0.5);
}
.biz-grid .badge-premium {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #854d0e;
  border: 1px solid #fcd34d;
}
.biz-grid .badge-verified {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  color: #065f46;
  border: 1px solid #6ee7b7;
}
.biz-grid .badge-verified i { color: #059669; }

.biz-grid .card-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  padding: 14px 16px;
  background: linear-gradient(180deg, #fafbfc 0%, #f8fafc 100%);
  border: 1px solid #f1f5f9;
  border-radius: 12px;
  margin-bottom: 16px;
}
.biz-grid .stat {
  display: flex;
  align-items: center;
  gap: 10px;
