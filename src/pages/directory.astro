---
import BaseLayout from '../layouts/BaseLayout.astro';

const CDN = 'https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data';

const iconMap = {
  'Food & Dining': 'fa-utensils',
  'Grocery & Kirana': 'fa-cart-shopping',
  'Health & Medical': 'fa-stethoscope',
  'Beauty & Personal Care': 'fa-spa',
  'Fitness & Wellness': 'fa-dumbbell',
  'Education & Learning': 'fa-graduation-cap',
  'Fashion & Apparel': 'fa-shirt',
  'Jewelry & Gold': 'fa-gem',
  'Electronics & Gadgets': 'fa-laptop',
  'Home & Interior': 'fa-couch',
  'Automotive': 'fa-car',
  'Domestic Services': 'fa-broom',
  'IT & Digital Services': 'fa-code',
  'Logistics & Movers': 'fa-truck-fast',
  'Hospitality & Travel': 'fa-plane',
  'Entertainment & Events': 'fa-film',
  'Kids & Baby': 'fa-child',
  'Books & Stationery': 'fa-book',
  'Gardening & Outdoor': 'fa-seedling',
  'Pet Care': 'fa-paw',
  'Real Estate & Property': 'fa-building',
  'Finance & Legal': 'fa-coins',
  'Packaging & Printing': 'fa-print',
  'Cafes & Quick Bites': 'fa-mug-hot',
  'Shopping & Retail': 'fa-bag-shopping',
  'Communication & Internet': 'fa-wifi',
  'Security Services': 'fa-shield-halved',
  'Alternative Medicine': 'fa-leaf',
  'Photography & Video': 'fa-camera',
  'Celebrations & Gifts': 'fa-gift',
  'Government Services': 'fa-landmark',
  'Utilities': 'fa-bolt',
  'Daily Use Services': 'fa-screwdriver-wrench',
  'Fitness Equipment': 'fa-person-running',
  'Ayurveda & Wellness': 'fa-mortar-pestle',
  'Coaches & Trainers': 'fa-chalkboard-user',
  'Interior & Exterior Design': 'fa-paint-roller',
  'Consulting Services': 'fa-handshake',
  'Specialty Stores': 'fa-store'
};

let categories = [];
let locations = [];
let businesses = [];

try {
  const catRes = await fetch(`${CDN}/categories.json`);
  const catData = await catRes.json();
  categories = (catData.categories || []).map(c => ({
    ...c,
    iconClass: iconMap[c.categoryName] || 'fa-folder'
  }));
} catch (e) { console.error(e); }

try {
  const locRes = await fetch(`${CDN}/locations.json`);
  const locData = await locRes.json();
  locations = locData.locations || [];
} catch (e) { console.error(e); }

const results = await Promise.all(
  categories.map(async (cat) => {
    try {
      const res = await fetch(`${CDN}/${cat.file}`);
      const data = await res.json();
      return data.map(b => ({ ...b, categoryId: cat.categoryId, categoryName: cat.categoryName }));
    } catch (e) { return []; }
  })
);
businesses = results.flat();
---

<BaseLayout title="Directory" description="Browse all verified local businesses in Pimpri-Chinchwad.">

  <div class="dir-page">
    <div class="dir-container">

      <header class="dir-head">
        <h1><span>PCMC</span> Business Directory</h1>
        <p>Find trusted local businesses &amp; services</p>
      </header>

      <div class="cat-pills" id="catPills">
        <button class="cat-pill active" data-cat="all">
          <span class="cp-icon"><i class="fa-solid fa-border-all"></i></span>
          <span class="cp-name">All</span>
        </button>
        {categories.map(c => (
          <button class="cat-pill" data-cat={c.categoryId}>
            <span class="cp-icon"><i class={`fa-solid ${c.iconClass}`}></i></span>
            <span class="cp-name">{c.categoryName.length > 14 ? c.categoryName.substring(0, 12) + '…' : c.categoryName}</span>
          </button>
        ))}
      </div>

      <div class="filters">
        <select id="locFilter" class="f-select">
          <option value="all">All Locations</option>
          {locations.map(l => <option value={l.locationName}>{l.locationName}</option>)}
        </select>
        <select id="sortFilter" class="f-select">
          <option value="featured">Featured First</option>
          <option value="rating">Top Rated</option>
          <option value="name">Name A-Z</option>
        </select>
        <input type="text" id="searchInput" class="f-input" placeholder="Search…" />
        <button id="nearMeBtn" class="near-btn">
          <i class="fa-solid fa-location-crosshairs"></i> Near Me
        </button>
        <span class="results-count" id="resultsCount">
          <i class="fa-solid fa-store"></i> {businesses.length} businesses
        </span>
      </div>

      <div class="biz-grid" id="bizGrid"></div>

      <div class="pagination" id="pagination"></div>

    </div>
  </div>

</BaseLayout>

<script define:vars={{ businesses, categories, locations }}>
  const ALL = businesses;
  const LOCS = locations;
  const PER_PAGE = 20;

  const state = {
    search: '',
    category: 'all',
    location: 'all',
    sort: 'featured',
    page: 1,
    filtered: [...ALL]
  };

  function tierRank(b) {
    const t = (b.tier || '').toLowerCase();
    if (t === 'featured') return 1;
    if (t === 'premium_pro') return 2;
    if (t === 'premium') return 3;
    if (t === 'vp') return 4;
    if (t === 'vb') return 5;
    return 6;
  }

  function avatarColor(name) {
    const pal = ['#dc2626','#ea580c','#d97706','#ca8a04','#65a30d','#059669','#0891b2','#0284c7','#4f46e5','#7c3aed','#c026d3','#db2777','#e11d48','#be123c','#9333ea'];
    let h = 0;
    for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
    return pal[Math.abs(h) % pal.length];
  }

  function tierBadge(b) {
    const t = (b.tier || '').toLowerCase();
    if (t === 'featured') return '<span class="tier tier-featured"><i class="fa-solid fa-star"></i> Featured</span>';
    if (t === 'premium_pro') return '<span class="tier tier-premium"><i class="fa-solid fa-crown"></i> Premium Pro</span>';
    if (t === 'premium') return '<span class="tier tier-premium"><i class="fa-solid fa-crown"></i> Premium</span>';
    if (t === 'vp') return '<span class="tier tier-verified"><i class="fa-solid fa-circle-check"></i> Verified</span>';
    if (t === 'vb') return '<span class="tier tier-verified"><i class="fa-solid fa-circle-check"></i> Verified</span>';
    return '';
  }

  function clean(p) { return (p || '').replace(/\s/g, ''); }

  function renderCard(b) {
    const t = (b.tier || '').toLowerCase();
    const isPremium = ['featured','premium','premium_pro'].includes(t);
    const isPro = t === 'premium_pro';
    const name = b.businessName || 'Business';
    const initial = name.trim().charAt(0).toUpperCase();
    const color = avatarColor(name);
    const rating = parseFloat(b.rating) || 0;
    const reviews = parseInt(b.reviews) || 0;

    let meta = '';
    if (rating > 0) {
      meta += `<span class="meta meta-rating"><i class="fa-solid fa-star"></i> ${rating.toFixed(1)}${reviews ? ` <span class="rev">(${reviews})</span>` : ''}</span>`;
    }
    if (b.location) {
      meta += `<span class="meta meta-loc"><i class="fa-solid fa-location-dot"></i> ${b.location}</span>`;
    }

    let deal = '';
    if (isPremium && b.deals) {
      deal = `<div class="deal"><i class="fa-solid fa-gift"></i> ${b.deals}</div>`;
    }

    let timing = '';
    if (isPremium && b.timing) {
      timing = `<div class="timing"><i class="fa-solid fa-clock"></i> ${b.timing}</div>`;
    }

    let social = '';
    if (isPro && b.socialLinks) {
      const icons = { insta: 'fa-brands fa-instagram', fb: 'fa-brands fa-facebook-f', yt: 'fa-brands fa-youtube', tw: 'fa-brands fa-x-twitter', li: 'fa-brands fa-linkedin-in', wa: 'fa-brands fa-whatsapp' };
      social = `<div class="social">${b.socialLinks.split('|').map(p => {
        const [k, u] = p.split(':');
        if (!u) return '';
        return `<a href="${u.trim()}" target="_blank" rel="noopener"><i class="${icons[k.trim()] || 'fa-solid fa-link'}"></i></a>`;
      }).join('')}</div>`;
    }

    let actions = '';
    if (b.phone) actions += `<a href="tel:${clean(b.phone)}" class="act act-call"><i class="fa-solid fa-phone"></i> Call</a>`;
    if (isPremium && b.phone) actions += `<a href="https://wa.me/${clean(b.phone)}" target="_blank" rel="noopener" class="act act-wa"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>`;
    if (isPremium && b.website) actions += `<a href="${b.website}" target="_blank" rel="noopener" class="act act-web"><i class="fa-solid fa-globe"></i> Website</a>`;
    if (isPremium && b.googleMap) actions += `<a href="${b.googleMap}" target="_blank" rel="noopener" class="act act-map"><i class="fa-solid fa-map-location-dot"></i> Map</a>`;
    if (isPro && b.email) actions += `<a href="mailto:${b.email}" class="act act-mail"><i class="fa-solid fa-envelope"></i> Email</a>`;

    return `
      <article class="biz-card">
        <div class="biz-head">
          <div class="biz-av" style="background:${color}">${initial}</div>
          <div class="biz-info">
            <h3 class="biz-name">${name}</h3>
            ${b.subCategory ? `<div class="biz-sub"><i class="fa-solid fa-tag"></i> ${b.subCategory}</div>` : ''}
          </div>
          ${tierBadge(b)}
        </div>
        <div class="biz-meta">${meta}</div>
        ${deal}
        ${timing}
        ${social}
        ${actions ? `<div class="biz-actions">${actions}</div>` : ''}
      </article>
    `;
  }

  function applyFilters() {
    let list = [...ALL];
    if (state.category !== 'all') list = list.filter(b => b.categoryId === state.category);
    if (state.location !== 'all') {
      list = list.filter(b => (b.location || '') === state.location || (b.serviceArea || '').includes(state.location));
    }
    if (state.search) {
      const q = state.search.toLowerCase();
      list = list.filter(b =>
        (b.businessName || '').toLowerCase().includes(q) ||
        (b.subCategory || '').toLowerCase().includes(q) ||
        (b.tags || '').toLowerCase().includes(q) ||
        (b.location || '').toLowerCase().includes(q)
      );
    }
    if (state.sort === 'featured') {
      list.sort((a, b) => {
        const d = tierRank(a) - tierRank(b);
        if (d !== 0) return d;
        return (parseFloat(b.rating) || 0) - (parseFloat(a.rating) || 0);
      });
    } else if (state.sort === 'rating') {
      list.sort((a, b) => (parseFloat(b.rating) || 0) - (parseFloat(a.rating) || 0));
    } else if (state.sort === 'name') {
      list.sort((a, b) => (a.businessName || '').localeCompare(b.businessName || ''));
    }
    state.filtered = list;
    state.page = 1;
    render();
  }

  function render() {
    const total = state.filtered.length;
    const totalPages = Math.ceil(total / PER_PAGE) || 1;
    const start = (state.page - 1) * PER_PAGE;
    const items = state.filtered.slice(start, start + PER_PAGE);

    document.getElementById('resultsCount').innerHTML = `<i class="fa-solid fa-store"></i> ${total} business${total !== 1 ? 'es' : ''}`;

    const grid = document.getElementById('bizGrid');
    if (total === 0) {
      grid.innerHTML = `<div class="empty"><i class="fa-solid fa-magnifying-glass"></i><h3>No businesses found</h3><p>Try adjusting your filters.</p></div>`;
      document.getElementById('pagination').innerHTML = '';
      return;
    }
    grid.innerHTML = items.map(renderCard).join('');
    renderPagination(totalPages);
  }

  function renderPagination(totalPages) {
    const el = document.getElementById('pagination');
    if (totalPages <= 1) { el.innerHTML = ''; return; }
    let html = '';
    html += `<button ${state.page === 1 ? 'disabled' : ''} data-page="${state.page - 1}"><i class="fa-solid fa-chevron-left"></i></button>`;
    const s = Math.max(1, state.page - 2);
    const e = Math.min(totalPages, state.page + 2);
    if (s > 1) { html += `<button data-page="1">1</button>`; if (s > 2) html += `<span>…</span>`; }
    for (let i = s; i <= e; i++) html += `<button data-page="${i}" ${i === state.page ? 'class="active"' : ''}>${i}</button>`;
    if (e < totalPages) { if (e < totalPages - 1) html += `<span>…</span>`; html += `<button data-page="${totalPages}">${totalPages}</button>`; }
    html += `<button ${state.page === totalPages ? 'disabled' : ''} data-page="${state.page + 1}"><i class="fa-solid fa-chevron-right"></i></button>`;
    el.innerHTML = html;
    el.querySelectorAll('button[data-page]').forEach(btn => {
      btn.addEventListener('click', () => {
        state.page = parseInt(btn.dataset.page);
        render();
        window.scrollTo({ top: 200, behavior: 'smooth' });
      });
    });
  }

  // Category pills
  document.getElementById('catPills').addEventListener('click', e => {
    const btn = e.target.closest('.cat-pill');
    if (!btn) return;
    document.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    state.category = btn.dataset.cat;
    applyFilters();
    window.scrollTo({ top: 200, behavior: 'smooth' });
  });

  document.getElementById('locFilter').addEventListener('change', e => { state.location = e.target.value; applyFilters(); });
  document.getElementById('sortFilter').addEventListener('change', e => { state.sort = e.target.value; applyFilters(); });
  document.getElementById('searchInput').addEventListener('input', e => {
    clearTimeout(window._t);
    window._t = setTimeout(() => { state.search = e.target.value; applyFilters(); }, 250);
  });

  document.getElementById('nearMeBtn').addEventListener('click', () => {
    if (!navigator.geolocation) return alert('Not supported');
    const btn = document.getElementById('nearMeBtn');
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Detecting…';
    navigator.geolocation.getCurrentPosition(
      pos => {
        const { latitude, longitude } = pos.coords;
        const dist = (a,b,c,d) => {
          const R = 6371, dLat = (c-a)*Math.PI/180, dLon = (d-b)*Math.PI/180;
          const x = Math.sin(dLat/2)**2 + Math.cos(a*Math.PI/180)*Math.cos(c*Math.PI/180)*Math.sin(dLon/2)**2;
          return R*2*Math.atan2(Math.sqrt(x), Math.sqrt(1-x));
        };
        state.filtered = [...ALL].filter(b => {
          const la = parseFloat(b.latitude), lo = parseFloat(b.longitude);
          if (!la || !lo) return false;
          return dist(latitude, longitude, la, lo) <= 15;
        }).sort((a, b) => dist(latitude, longitude, parseFloat(a.latitude), parseFloat(a.longitude)) - dist(latitude, longitude, parseFloat(b.latitude), parseFloat(b.longitude)));
        state.page = 1;
        document.getElementById('resultsCount').innerHTML = `<i class="fa-solid fa-location-crosshairs"></i> ${state.filtered.length} near you`;
        const grid = document.getElementById('bizGrid');
        if (state.filtered.length === 0) {
          grid.innerHTML = `<div class="empty"><i class="fa-solid fa-magnifying-glass"></i><h3>No businesses within 15 km</h3></div>`;
          document.getElementById('pagination').innerHTML = '';
        } else {
          grid.innerHTML = state.filtered.slice(0, PER_PAGE).map(renderCard).join('');
          renderPagination(Math.ceil(state.filtered.length / PER_PAGE));
        }
        btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Near Me (ON)';
        btn.classList.add('active');
      },
      () => {
        btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Near Me';
        alert('Location denied');
      }
    );
  });

  applyFilters();
</script>

<style>
.dir-page {
  background: #f8fafc;
  min-height: 60vh;
  padding: 32px 0 60px;
}
.dir-container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 20px;
}

/* HEADER */
.dir-head {
  padding: 8px 0 18px;
  border-bottom: 3px solid #dc2626;
  margin-bottom: 24px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  flex-wrap: wrap;
  gap: 8px;
}
.dir-head h1 {
  font-size: 28px;
  font-weight: 800;
  color: #0f172a;
  margin: 0;
  line-height: 1.2;
  letter-spacing: -0.5px;
}
.dir-head h1 span { color: #dc2626; }
.dir-head p {
  color: #64748b;
  font-size: 14px;
  font-weight: 500;
  padding-bottom: 2px;
}

/* CATEGORY PILLS */
.cat-pills {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  gap: 8px;
  margin-bottom: 20px;
}
.cat-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 12px 6px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.2s;
  min-height: 72px;
  font-family: inherit;
  text-align: center;
  box-shadow: 0 1px 2px rgba(15,23,42,0.02);
}
.cat-pill:hover {
  border-color: #dc2626;
  background: #fef2f2;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px -6px rgba(220,38,38,0.2);
}
.cat-pill.active {
  background: linear-gradient(135deg, #dc2626, #b91c1c);
  border-color: #dc2626;
  color: #fff;
  box-shadow: 0 4px 12px -4px rgba(220,38,38,0.4);
}
.cp-icon {
  font-size: 18px;
  line-height: 1;
  color: #64748b;
  transition: color 0.2s;
}
.cat-pill.active .cp-icon { color: #fff; }
.cat-pill:hover .cp-icon { color: #dc2626; }
.cat-pill.active:hover .cp-icon { color: #fff; }
.cp-name {
  font-size: 11.5px;
  font-weight: 700;
  color: #334155;
  line-height: 1.2;
  letter-spacing: -0.1px;
}
.cat-pill.active .cp-name { color: #fff; }

/* FILTERS */
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
  padding: 14px 0;
  border-bottom: 1px solid #e2e8f0;
  align-items: center;
}
.f-select, .f-input {
  padding: 10px 14px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  font-size: 13.5px;
  background: #fff;
  flex: 1;
  min-width: 130px;
  font-family: inherit;
  color: #334155;
  font-weight: 600;
  outline: none;
  transition: all 0.2s;
}
.f-select:hover, .f-input:hover { border-color: #cbd5e1; }
.f-select:focus, .f-input:focus { border-color: #dc2626; box-shadow: 0 0 0 3px rgba(220,38,38,0.08); }

.near-btn {
  background: linear-gradient(135deg, #dc2626, #b91c1c);
  color: #fff;
  border: 0;
  padding: 10px 20px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
  font-size: 13px;
  white-space: nowrap;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: inherit;
  box-shadow: 0 4px 12px -4px rgba(220,38,38,0.4);
}
.near-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px -4px rgba(220,38,38,0.5); }
.near-btn.active { background: linear-gradient(135deg, #059669, #047857); }

.results-count {
  font-size: 13px;
  color: #64748b;
  font-weight: 700;
  margin-left: auto;
  padding: 8px 14px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 7px;
}
.results-count i { color: #dc2626; }

/* GRID — 2 columns like old design */
.biz-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

/* CARD */
.biz-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 18px;
  box-shadow: 0 1px 3px rgba(15,23,42,0.04);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.biz-card:hover {
  box-shadow: 0 12px 24px -8px rgba(220,38,38,0.15), 0 4px 8px -4px rgba(0,0,0,0.06);
  border-color: #fca5a5;
  transform: translateY(-3px);
}

/* HEAD */
.biz-head {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.biz-av {
  flex-shrink: 0;
  width: 46px;
  height: 46px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 800;
  font-size: 20px;
  box-shadow: 0 4px 12px -4px rgba(15,23,42,0.2);
}
.biz-info { flex: 1; min-width: 0; }
.biz-name {
  font-size: 16px;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 4px;
  line-height: 1.3;
  letter-spacing: -0.3px;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}
.biz-sub {
  font-size: 12.5px;
  color: #64748b;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 5px;
}
.biz-sub i { color: #94a3b8; font-size: 10px; }

/* TIER BADGE */
.tier {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: 7px;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  white-space: nowrap;
  flex-shrink: 0;
}
.tier i { font-size: 9.5px; }
.tier-featured {
  background: linear-gradient(135deg, #fef3c7, #fbbf24);
  color: #78350f;
  box-shadow: 0 2px 6px -2px rgba(251,191,36,0.4);
}
.tier-premium {
  background: linear-gradient(135deg, #fef9c3, #fde68a);
  color: #854d0e;
  border: 1px solid #facc15;
}
.tier-verified {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  color: #065f46;
  border: 1px solid #34d399;
}

/* META */
.biz-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  font-size: 12.5px;
  align-items: center;
}
.meta {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 7px;
}
