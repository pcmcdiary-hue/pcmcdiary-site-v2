---
import BaseLayout from '../layouts/BaseLayout.astro';

const CDN = 'https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data';

let categories = [];
let locations = [];
let businesses = [];

try {
  const catRes = await fetch(`${CDN}/categories.json`);
  const catData = await catRes.json();
  categories = catData.categories || [];
} catch (e) { console.error(e); }

try {
  const locRes = await fetch(`${CDN}/locations.json`);
  const locData = await locRes.json();
  locations = locData.locations || [];
} catch (e) { console.error(e); }

const results = await Promise.all(
  categories.map(async (cat) => {
    try {
      const res = await fetch(`${CDN}/${cat.file}`);
      const data = await res.json();
      return data.map(b => ({ ...b, categoryId: cat.categoryId, categoryName: cat.categoryName, categoryIcon: cat.icon }));
    } catch (e) { return []; }
  })
);
businesses = results.flat();
---

<BaseLayout title="Directory" description="Browse all verified local businesses in Pimpri-Chinchwad.">

  <section class="dir-hero">
    <div class="container">
      <div class="hero-eyebrow">Directory</div>
      <h1>Discover <em>local businesses</em></h1>
      <p>Browse {businesses.length}+ verified businesses across 33 areas of Pimpri-Chinchwad</p>
    </div>
  </section>

  <section class="dir-body">
    <div class="container">

      <div class="filters">
        <div class="f-search">
          <span class="f-icon">⌕</span>
          <input type="text" id="searchInput" placeholder="Search by name, tag, area…" />
        </div>
        <select id="catFilter" class="f-select">
          <option value="">All Categories</option>
          {categories.map(c => <option value={c.categoryId}>{c.categoryName}</option>)}
        </select>
        <select id="locFilter" class="f-select">
          <option value="">All Locations</option>
          {locations.map(l => <option value={l.locationId}>{l.locationName}</option>)}
        </select>
        <select id="sortFilter" class="f-select">
          <option value="tier">Featured First</option>
          <option value="rating">Top Rated</option>
          <option value="name">Name A-Z</option>
        </select>
        <button id="nearMeBtn" class="near-btn">📍 Near Me</button>
      </div>

      <div class="results-bar">
        <span class="results-count" id="resultsCount">{businesses.length} businesses</span>
        <span class="results-hint">Updated daily</span>
      </div>

      <div class="biz-grid" id="bizGrid"></div>

      <div class="pagination" id="pagination"></div>

    </div>
  </section>

</BaseLayout>

<script define:vars={{ businesses, categories, locations }}>
  const ALL = businesses;
  const CATS = categories;
  const LOCS = locations;
  const PER_PAGE = 24;

  const state = {
    search: '',
    category: '',
    location: '',
    sort: 'tier',
    page: 1,
    filtered: [...ALL]
  };

  function tierPriority(b) {
    const t = (b.tier || '').toLowerCase();
    if (t === 'featured') return 1;
    if (t === 'premium_pro') return 2;
    if (t === 'premium') return 3;
    if (t === 'vp') return 4;
    if (t === 'vb') return 5;
    return 6;
  }

  function avatarColor(name) {
    const pal = [
      ['#dc2626','#991b1b'],['#ea580c','#c2410c'],['#d97706','#b45309'],
      ['#65a30d','#4d7c0f'],['#059669','#047857'],['#0891b2','#0e7490'],
      ['#0284c7','#0369a1'],['#4f46e5','#4338ca'],['#7c3aed','#6d28d9'],
      ['#c026d3','#a21caf'],['#db2777','#be185d'],['#e11d48','#be123c']
    ];
    let h = 0;
    for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
    return pal[Math.abs(h) % pal.length];
  }

  function getBadges(b) {
    const t = (b.tier || '').toLowerCase();
    const out = [];
    if (t === 'featured') out.push('<span class="badge badge-featured">⭐ Featured</span>');
    else if (t === 'premium_pro') out.push('<span class="badge badge-premium">👑 Premium Pro</span>');
    else if (t === 'premium') out.push('<span class="badge badge-premium">👑 Premium</span>');
    if (['featured','premium','premium_pro','vp','vb'].includes(t)) {
      out.push('<span class="badge badge-verified">✓ Verified</span>');
    }
    return out.join('');
  }

  function cleanPhone(p) { return (p || '').replace(/\s/g, ''); }

  function renderCard(b) {
    const t = (b.tier || '').toLowerCase();
    const isPremium = ['premium','premium_pro','featured'].includes(t);
    const isPro = t === 'premium_pro';
    const name = b.businessName || 'Business';
    const initial = name.trim().charAt(0).toUpperCase();
    const [c1, c2] = avatarColor(name);
    const rating = parseFloat(b.rating) || 0;
    const reviews = parseInt(b.reviews) || 0;

    const metaPills = [];
    if (rating > 0) {
      metaPills.push(`<span class="meta-pill meta-rating"><svg viewBox="0 0 20 20" width="11" height="11" fill="#f59e0b"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg> ${rating.toFixed(1)}${reviews ? ` <span class="rev">(${reviews})</span>` : ''}</span>`);
    }
    if (b.location) metaPills.push(`<span class="meta-pill meta-loc"><svg viewBox="0 0 20 20" width="10" height="10" fill="#b91c1c"><path d="M10 0C6.13 0 3 3.13 3 7c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 10 4.5a2.5 2.5 0 0 1 0 5z"/></svg>${b.location}</span>`);
    if (isPremium && b.deals) metaPills.push(`<span class="meta-pill meta-deal">🎁 ${b.deals}</span>`);

    const actions = [];
    if (b.phone) actions.push(`<a href="tel:${cleanPhone(b.phone)}" class="act act-call"><svg viewBox="0 0 20 20" width="12" height="12" fill="currentColor"><path d="M6.6 3.3c.3 0 .6.2.7.5l1.2 2.8c.1.3 0 .6-.2.8l-1.2 1.1c1 2 2.6 3.6 4.6 4.6l1.1-1.2c.2-.2.5-.3.8-.2l2.8 1.2c.3.1.5.4.5.7V16c0 .8-.7 1.5-1.5 1.5C7.6 17.5 2.5 12.4 2.5 6.3c0-.8.7-1.5 1.5-1.5h2.6z"/></svg>Call</a>`);
    if (isPremium && b.phone) actions.push(`<a href="https://wa.me/${cleanPhone(b.phone)}" target="_blank" rel="noopener" class="act act-wa">💬 WhatsApp</a>`);
    if (isPremium && b.website) actions.push(`<a href="${b.website}" target="_blank" rel="noopener" class="act act-web">🌐 Web</a>`);
    if (isPremium && b.googleMap) actions.push(`<a href="${b.googleMap}" target="_blank" rel="noopener" class="act act-map">🗺️ Map</a>`);
    if (isPro && b.email) actions.push(`<a href="mailto:${b.email}" class="act act-mail">✉️ Email</a>`);

    const timingHtml = (isPremium && b.timing) ? `<div class="biz-timing">🕐 ${b.timing}</div>` : '';

    let socialHtml = '';
    if (isPro && b.socialLinks) {
      const icons = { insta: '📷', fb: '👍', yt: '▶️', tw: '🐦', li: '💼', wa: '💬' };
      socialHtml = `<div class="biz-social">${b.socialLinks.split('|').map(p => {
        const [k, u] = p.split(':');
        if (!u) return '';
        return `<a href="${u.trim()}" target="_blank" rel="noopener" title="${k}">${icons[k.trim()] || '🔗'}</a>`;
      }).join('')}</div>`;
    }

    return `
      <article class="biz-card">
        <div class="biz-glow" style="background: radial-gradient(circle at 30% 0%, ${c1}22, transparent 70%)"></div>
        <header class="biz-head">
          <div class="biz-av" style="background: linear-gradient(135deg, ${c1}, ${c2})">
            <span>${initial}</span>
          </div>
          <div class="biz-head-text">
            <h3 class="biz-name">${name}</h3>
            ${b.subCategory ? `<div class="biz-sub">${b.subCategory}</div>` : ''}
          </div>
        </header>
        <div class="biz-badges">${getBadges(b)}</div>
        <div class="biz-meta">${metaPills.join('')}</div>
        ${timingHtml}
        ${socialHtml}
        <footer class="biz-actions">${actions.join('')}</footer>
      </article>
    `;
  }

  function applyFilters() {
    let list = [...ALL];
    if (state.search) {
      const q = state.search.toLowerCase();
      list = list.filter(b =>
        (b.businessName || '').toLowerCase().includes(q) ||
        (b.subCategory || '').toLowerCase().includes(q) ||
        (b.tags || '').toLowerCase().includes(q) ||
        (b.location || '').toLowerCase().includes(q)
      );
    }
    if (state.category) list = list.filter(b => b.categoryId === state.category);
    if (state.location) {
      const loc = LOCS.find(l => l.locationId === state.location);
      if (loc) {
        list = list.filter(b =>
          (b.location || '') === loc.locationName ||
          (b.serviceArea || '').includes(loc.locationName)
        );
      }
    }
    if (state.sort === 'tier') {
      list.sort((a, b) => {
        const d = tierPriority(a) - tierPriority(b);
        if (d !== 0) return d;
        return (parseFloat(b.rating) || 0) - (parseFloat(a.rating) || 0);
      });
    } else if (state.sort === 'rating') {
      list.sort((a, b) => (parseFloat(b.rating) || 0) - (parseFloat(a.rating) || 0));
    } else if (state.sort === 'name') {
      list.sort((a, b) => (a.businessName || '').localeCompare(b.businessName || ''));
    }
    state.filtered = list;
    state.page = 1;
    render();
  }

  function render() {
    const total = state.filtered.length;
    const totalPages = Math.ceil(total / PER_PAGE) || 1;
    const start = (state.page - 1) * PER_PAGE;
    const items = state.filtered.slice(start, start + PER_PAGE);
    document.getElementById('resultsCount').textContent = `${total} businesses`;
    const grid = document.getElementById('bizGrid');
    if (total === 0) {
      grid.innerHTML = `<div class="empty">No businesses found. Try adjusting filters.</div>`;
      document.getElementById('pagination').innerHTML = '';
      return;
    }
    grid.innerHTML = items.map(renderCard).join('');
    renderPagination(totalPages);
  }

  function renderPagination(totalPages) {
    const el = document.getElementById('pagination');
    if (totalPages <= 1) { el.innerHTML = ''; return; }
    let html = '';
    html += `<button ${state.page === 1 ? 'disabled' : ''} data-page="${state.page - 1}">‹</button>`;
    const s = Math.max(1, state.page - 2);
    const e = Math.min(totalPages, state.page + 2);
    if (s > 1) { html += `<button data-page="1">1</button>`; if (s > 2) html += `<span>…</span>`; }
    for (let i = s; i <= e; i++) html += `<button data-page="${i}" ${i === state.page ? 'class="active"' : ''}>${i}</button>`;
    if (e < totalPages) { if (e < totalPages - 1) html += `<span>…</span>`; html += `<button data-page="${totalPages}">${totalPages}</button>`; }
    html += `<button ${state.page === totalPages ? 'disabled' : ''} data-page="${state.page + 1}">›</button>`;
    el.innerHTML = html;
    el.querySelectorAll('button[data-page]').forEach(btn => {
      btn.addEventListener('click', () => {
        state.page = parseInt(btn.dataset.page);
        render();
        window.scrollTo({ top: 300, behavior: 'smooth' });
      });
    });
  }

  document.getElementById('searchInput').addEventListener('input', e => { state.search = e.target.value; applyFilters(); });
  document.getElementById('catFilter').addEventListener('change', e => { state.category = e.target.value; applyFilters(); });
  document.getElementById('locFilter').addEventListener('change', e => { state.location = e.target.value; applyFilters(); });
  document.getElementById('sortFilter').addEventListener('change', e => { state.sort = e.target.value; applyFilters(); });

  document.getElementById('nearMeBtn').addEventListener('click', () => {
    if (!navigator.geolocation) return alert('Not supported');
    const btn = document.getElementById('nearMeBtn');
    btn.textContent = '📍 Detecting…';
    navigator.geolocation.getCurrentPosition(
      pos => {
        const { latitude, longitude } = pos.coords;
        const dist = (a,b,c,d) => {
          const R = 6371, dLat = (c-a)*Math.PI/180, dLon = (d-b)*Math.PI/180;
          const x = Math.sin(dLat/2)**2 + Math.cos(a*Math.PI/180)*Math.cos(c*Math.PI/180)*Math.sin(dLon/2)**2;
          return R*2*Math.atan2(Math.sqrt(x), Math.sqrt(1-x));
        };
        state.filtered = [...ALL].filter(b => {
          const la = parseFloat(b.latitude), lo = parseFloat(b.longitude);
          if (!la || !lo) return false;
          return dist(latitude, longitude, la, lo) <= 15;
        }).sort((a, b) => dist(latitude, longitude, parseFloat(a.latitude), parseFloat(a.longitude)) - dist(latitude, longitude, parseFloat(b.latitude), parseFloat(b.longitude)));
        state.page = 1;
        document.getElementById('resultsCount').textContent = `${state.filtered.length} near you`;
        const grid = document.getElementById('bizGrid');
        if (state.filtered.length === 0) {
          grid.innerHTML = `<div class="empty">No businesses within 15 km.</div>`;
          document.getElementById('pagination').innerHTML = '';
        } else {
          grid.innerHTML = state.filtered.slice(0, PER_PAGE).map(renderCard).join('');
          renderPagination(Math.ceil(state.filtered.length / PER_PAGE));
        }
        btn.textContent = '📍 Near Me (ON)';
        btn.classList.add('active');
      },
      () => { btn.textContent = '📍 Near Me'; alert('Location denied'); }
    );
  });

  applyFilters();
</script>

<style>
/* HERO */
.dir-hero {
  background: linear-gradient(135deg, #b91c1c 0%, #7f1d1d 60%, #450a0a 100%);
  color: #fff;
  padding: 52px 0 44px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.dir-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.06) 1px, transparent 1px);
  background-size: 40px 40px;
  opacity: 0.5;
}
.dir-hero .container { position: relative; z-index: 2; }
.hero-eyebrow {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #fde047;
  margin-bottom: 12px;
  padding: 5px 14px;
  background: rgba(255,255,255,0.1);
  border-radius: 50px;
  border: 1px solid rgba(255,255,255,0.15);
}
.dir-hero h1 {
  font-size: 38px;
  font-weight: 800;
  letter-spacing: -1px;
  line-height: 1.15;
  margin: 0 0 10px;
}
.dir-hero h1 em {
  font-style: italic;
  color: #fde047;
}
.dir-hero p {
  font-size: 15px;
  opacity: 0.85;
  max-width: 560px;
  margin: 0 auto;
}

/* BODY */
.dir-body { padding: 32px 0 72px; background: #f8fafc; min-height: 60vh; }

/* FILTERS */
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding: 14px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  margin-bottom: 16px;
  align-items: center;
  box-shadow: 0 1px 3px rgba(15,23,42,0.04);
}
.f-search {
  flex: 1;
  min-width: 200px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 14px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  transition: all 0.2s;
}
.f-search:focus-within {
  border-color: #b91c1c;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(185,28,28,0.08);
}
.f-icon {
  font-size: 18px;
  color: #94a3b8;
  font-weight: 700;
}
.f-search input {
  flex: 1;
  border: 0;
  background: transparent;
  padding: 12px 0;
  font-size: 14px;
  font-family: inherit;
  outline: none;
  color: #0f172a;
}
.f-search input::placeholder { color: #94a3b8; }

.f-select {
  padding: 12px 14px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  font-size: 13.5px;
  font-family: inherit;
  background: #fff;
  color: #334155;
  font-weight: 600;
  outline: none;
  cursor: pointer;
  transition: all 0.2s;
}
.f-select:hover { border-color: #cbd5e1; }
.f-select:focus { border-color: #b91c1c; box-shadow: 0 0 0 3px rgba(185,28,28,0.08); }

.near-btn {
  background: linear-gradient(135deg, #b91c1c, #991b1b);
  color: #fff;
  border: 0;
  padding: 12px 20px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  font-family: inherit;
  white-space: nowrap;
  box-shadow: 0 4px 12px -4px rgba(185,28,28,0.4);
  transition: all 0.2s;
}
.near-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px -4px rgba(185,28,28,0.5); }
.near-btn.active { background: linear-gradient(135deg, #059669, #047857); }

/* RESULTS BAR */
.results-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
  padding: 0 4px;
}
.results-count {
  font-size: 13.5px;
  font-weight: 800;
  color: #0f172a;
  padding: 6px 14px;
  background: #fff;
  border-radius: 50px;
  border: 1px solid #e2e8f0;
}
.results-hint {
  font-size: 12px;
  color: #94a3b8;
  font-weight: 500;
}

/* GRID */
.biz-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
  gap: 16px;
}

/* CARD */
.biz-card {
  position: relative;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  box-shadow: 0 1px 2px rgba(15,23,42,0.03);
}
.biz-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20px;
  right: 20px;
  height: 3px;
  background: linear-gradient(90deg, #b91c1c, #f59e0b);
  border-radius: 0 0 4px 4px;
  opacity: 0;
  transition: opacity 0.3s;
}
.biz-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 40px -16px rgba(15,23,42,0.12), 0 8px 16px -8px rgba(15,23,42,0.06);
  border-color: #fca5a5;
}
.biz-card:hover::before { opacity: 1; }

.biz-glow {
  position: absolute;
  top: -50px;
  right: -50px;
  width: 200px;
  height: 200px;
  pointer-events: none;
  opacity: 0.4;
  border-radius: 50%;
}

.biz-head {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  position: relative;
  z-index: 1;
}
.biz-av {
  width: 54px;
  height: 54px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 800;
  font-size: 22px;
  flex-shrink: 0;
  box-shadow: 0 8px 20px -8px rgba(15,23,42,0.3), inset 0 1px 0 rgba(255,255,255,0.2);
  position: relative;
}
.biz-av span { position: relative; z-index: 1; }
.biz-head-text { flex: 1; min-width: 0; padding-top: 2px; }
.biz-name {
  font-size: 16px;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 4px;
  line-height: 1.25;
  letter-spacing: -0.3px;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.biz-sub {
  font-size: 12.5px;
  color: #64748b;
  font-weight: 600;
}

.biz-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.badge {
  font-size: 10px;
  font-weight: 800;
  padding: 4px 9px;
  border-radius: 6px;
  letter-spacing: 0.3px;
  white-space: nowrap;
}
.badge-featured {
  background: linear-gradient(135deg, #fef3c7, #fbbf24);
  color: #78350f;
  box-shadow: 0 2px 6px -2px rgba(251,191,36,0.5);
}
.badge-premium {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #854d0e;
  border: 1px solid #fbbf24;
}
.badge-verified {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  color: #065f46;
  border: 1px solid #34d399;
}

.biz-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.meta-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 10px;
  border-radius: 8px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  color: #334155;
  font-weight: 700;
  font-size: 11.5px;
  letter-spacing: -0.1px;
}
.meta-rating {
  background: #f0fdf4;
  color: #065f46;
  border-color: #bbf7d0;
}
.meta-rating .rev { color: #65a30d; font-weight: 600; }
.meta-loc { color: #334155; }
.meta-deal {
  background: linear-gradient(135deg, #fffbeb, #fef3c7);
  color: #92400e;
  border-color: #fbbf24;
}

.biz-timing {
  font-size: 12px;
  color: #64748b;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
}

.biz-social {
  display: flex;
  gap: 8px;
  font-size: 16px;
}
.biz-social a {
  text-decoration: none;
  transition: transform 0.2s;
}
.biz-social a:hover { transform: scale(1.15); }

.biz-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: auto;
  padding-top: 14px;
  border-top: 1px solid #f1f5f9;
}
.act {
  display: inline-flex;
  align-items: center;
