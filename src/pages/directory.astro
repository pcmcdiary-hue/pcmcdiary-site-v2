---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFile } from 'node:fs/promises';
import path from 'node:path';

const DATA_DIR = path.resolve('./src/data');

const iconMap = {
  'Food & Dining': 'fa-utensils','Grocery & Kirana': 'fa-cart-shopping','Health & Medical': 'fa-stethoscope',
  'Beauty & Personal Care': 'fa-spa','Fitness & Wellness': 'fa-dumbbell','Education & Learning': 'fa-graduation-cap',
  'Fashion & Apparel': 'fa-shirt','Jewelry & Gold': 'fa-gem','Electronics & Gadgets': 'fa-laptop',
  'Home & Interior': 'fa-couch','Automotive': 'fa-car','Domestic Services': 'fa-broom',
  'IT & Digital Services': 'fa-code','Logistics & Movers': 'fa-truck-fast','Hospitality & Travel': 'fa-plane',
  'Entertainment & Events': 'fa-film','Kids & Baby': 'fa-child','Books & Stationery': 'fa-book',
  'Gardening & Outdoor': 'fa-seedling','Pet Care': 'fa-paw','Real Estate & Property': 'fa-building',
  'Finance & Legal': 'fa-coins','Packaging & Printing': 'fa-print','Cafes & Quick Bites': 'fa-mug-hot',
  'Shopping & Retail': 'fa-bag-shopping','Communication & Internet': 'fa-wifi','Security Services': 'fa-shield-halved',
  'Alternative Medicine': 'fa-leaf','Photography & Video': 'fa-camera','Celebrations & Gifts': 'fa-gift',
  'Government Services': 'fa-landmark','Utilities': 'fa-bolt','Daily Use Services': 'fa-screwdriver-wrench',
  'Fitness Equipment': 'fa-person-running','Ayurveda & Wellness': 'fa-mortar-pestle','Coaches & Trainers': 'fa-chalkboard-user',
  'Interior & Exterior Design': 'fa-paint-roller','Consulting Services': 'fa-handshake','Specialty Stores': 'fa-store'
};

const shortNameMap = {
  'Food & Dining': 'Food','Grocery & Kirana': 'Grocery','Health & Medical': 'Health',
  'Beauty & Personal Care': 'Beauty','Fitness & Wellness': 'Fitness','Education & Learning': 'Edu',
  'Fashion & Apparel': 'Fashion','Jewelry & Gold': 'Jewelry','Electronics & Gadgets': 'Elec',
  'Home & Interior': 'Home','Automotive': 'Auto','Domestic Services': 'Domestic',
  'IT & Digital Services': 'IT','Logistics & Movers': 'Logistics','Hospitality & Travel': 'Travel',
  'Entertainment & Events': 'Events','Kids & Baby': 'Kids','Books & Stationery': 'Books',
  'Gardening & Outdoor': 'Garden','Pet Care': 'Pets','Real Estate & Property': 'Realty',
  'Finance & Legal': 'Finance','Packaging & Printing': 'Print','Cafes & Quick Bites': 'Cafes',
  'Shopping & Retail': 'Shop','Communication & Internet': 'Internet','Security Services': 'Security',
  'Alternative Medicine': 'Ayurved','Photography & Video': 'Photo','Celebrations & Gifts': 'Gifts',
  'Government Services': 'Govt','Utilities': 'Utility','Daily Use Services': 'Repair',
  'Fitness Equipment': 'Equip','Ayurveda & Wellness': 'AltMed','Coaches & Trainers': 'Coach',
  'Interior & Exterior Design': 'Design','Consulting Services': 'Consult','Specialty Stores': 'Store'
};

let categories = [];
let locations = [];
let businesses = [];

try {
  const catRaw = await readFile(path.join(DATA_DIR, 'categories.json'), 'utf8');
  const catData = JSON.parse(catRaw);
  categories = (catData.categories || []).map(c => ({
    ...c,
    iconClass: iconMap[c.categoryName] || 'fa-folder',
    shortName: shortNameMap[c.categoryName] || (c.categoryName.length > 10 ? c.categoryName.substring(0, 8) + '…' : c.categoryName)
  }));
} catch (e) { console.error(e); }

try {
  const locRaw = await readFile(path.join(DATA_DIR, 'locations.json'), 'utf8');
  const locData = JSON.parse(locRaw);
  locations = locData.locations || [];
} catch (e) { console.error(e); }

const results = await Promise.all(
  categories.map(async (cat) => {
    try {
      const bizRaw = await readFile(path.join(DATA_DIR, 'clients', cat.file), 'utf8');
      const data = JSON.parse(bizRaw);
      return data.map(b => ({ ...b, categoryId: cat.categoryId }));
    } catch (e) { return []; }
  })
);
businesses = results.flat();
---

<BaseLayout title="Directory" description="Browse verified businesses in Pimpri-Chinchwad.">

  <div class="dir-page">
    <div class="dir-container">

      <!-- HEADER -->
      <header class="dir-head">
        <h1><span>PCMC</span> Business Directory</h1>
        <p>Find trusted local businesses &amp; services</p>
      </header>

      <!-- FILTERS -->
      <div class="filters">
        <div class="search-wrap">
          <i class="fa-solid fa-magnifying-glass search-icon"></i>
          <input type="text" id="searchInput" class="f-input" placeholder="Search business, service, or area…" />
        </div>
        <button id="nearMeBtn" class="near-btn">
          <i class="fa-solid fa-location-crosshairs"></i> Near Me
        </button>
        <span class="results-count" id="resultsCount">
          <i class="fa-solid fa-store"></i> {businesses.length} businesses
        </span>
      </div>

      <!-- CATEGORY CHIPS -->
      <div class="cat-grid" id="catPills">
        <button class="cat-chip all active" data-cat="all">
          <i class="fa-solid fa-border-all"></i>
          <span>All</span>
        </button>
        {categories.map(c => (
          <button class="cat-chip" data-cat={c.categoryId}>
            <i class={`fa-solid ${c.iconClass}`}></i>
            <span>{c.shortName}</span>
          </button>
        ))}
      </div>

      <!-- RESULTS GRID -->
      <div class="biz-grid" id="bizGrid"></div>
      <div class="pagination" id="pagination"></div>

    </div>
  </div>

</BaseLayout>

<script define:vars={{ businesses, locations }}>
  const ALL = businesses;
  const LOCS = locations;
  const PER_PAGE = 20;

  const state = {
    search: '',
    category: 'all',
    sort: 'featured',
    page: 1,
    filtered: [...ALL],
    nearMe: false,
    userLocation: null
  };

  function haversine(lat1, lng1, lat2, lng2) {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLng = (lng2 - lng1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) ** 2 +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  function getLatLng(b) {
    const clean = (v) => {
      if (v === null || v === undefined) return NaN;
      return parseFloat(String(v).replace(/[^0-9.\-]/g, '').trim());
    };
    const lat = clean(b.latitude ?? b.lat);
    const lng = clean(b.longitude ?? b.lng);
    if (!isFinite(lat) || !isFinite(lng) || lat === 0 || lng === 0) return null;
    return { lat, lng };
  }

  function formatDist(km) {
    if (km < 1) return `${Math.round(km * 1000)} m`;
    if (km < 10) return `${km.toFixed(1)} km`;
    return `${Math.round(km)} km`;
  }

  function scrollToFirstListing() {
    const grid = document.getElementById('bizGrid');
    if (!grid) return;
    const rect = grid.getBoundingClientRect();
    const targetY = rect.top + window.pageYOffset - 12;
    window.scrollTo({ top: Math.max(0, targetY), behavior: 'smooth' });
  }

  function tierRank(b) {
    const t = (b.tier || '').toLowerCase();
    if (t === 'featured') return 1;
    if (t === 'premium_pro') return 2;
    if (t === 'premium') return 3;
    if (t === 'vp') return 4;
    if (t === 'vb') return 5;
    return 6;
  }

  function shuffleArray(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const tmp = arr[i];
      arr[i] = arr[j];
      arr[j] = tmp;
    }
    return arr;
  }

  function avatarColors(name) {
    const pal = [['#dc2626','#991b1b'],['#ea580c','#c2410c'],['#d97706','#b45309'],['#ca8a04','#a16207'],['#65a30d','#4d7c0f'],['#059669','#047857'],['#0891b2','#0e7490'],['#0284c7','#0369a1'],['#4f46e5','#4338ca'],['#7c3aed','#6d28d9'],['#c026d3','#a21caf'],['#db2777','#be185d'],['#e11d48','#be123c'],['#9333ea','#7e22ce']];
    let h = 0;
    for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
    return pal[Math.abs(h) % pal.length];
  }

  function getTierBadge(t) {
    if (t === 'featured') return '<span class="badge badge-featured"><i class="fa-solid fa-star"></i>Featured</span>';
    if (t === 'premium_pro') return '<span class="badge badge-premium"><i class="fa-solid fa-crown"></i>Premium Pro</span>';
    if (t === 'premium') return '<span class="badge badge-premium"><i class="fa-solid fa-crown"></i>Premium</span>';
    if (['vp','vb'].includes(t)) return '<span class="badge badge-verified"><i class="fa-solid fa-circle-check"></i>Verified</span>';
    return '';
  }

  function clean(p) { return (p || '').replace(/\s/g, ''); }

  function renderCard(b) {
    const t = (b.tier || '').toLowerCase();
    const isPremium = ['featured','premium','premium_pro'].includes(t);
    const isPro = t === 'premium_pro';
    const name = b.businessName || 'Business';
    const initial = name.trim().charAt(0).toUpperCase();
    const colors = avatarColors(name);
    const c1 = colors[0], c2 = colors[1];
    const rating = parseFloat(b.rating) || 0;
    const reviews = parseInt(b.reviews) || 0;

    const badgeHtml = getTierBadge(t);
    const isVerified = ['featured','premium','premium_pro','vp','vb'].includes(t);

    let statsHtml = '';
    if (rating > 0) {
      statsHtml += `<div class="stat"><i class="fa-solid fa-star stat-star"></i><div class="stat-body"><span class="stat-val">${rating.toFixed(1)}</span>${reviews ? `<span class="stat-sub">${reviews} reviews</span>` : ''}</div></div>`;
    }
    if (b._dist != null) {
      statsHtml += `<div class="stat"><i class="fa-solid fa-location-crosshairs stat-loc"></i><div class="stat-body"><span class="stat-val">${formatDist(b._dist)}</span><span class="stat-sub">away</span></div></div>`;
    } else if (b.location) {
      statsHtml += `<div class="stat"><i class="fa-solid fa-location-dot stat-loc"></i><div class="stat-body"><span class="stat-val">${b.location}</span><span class="stat-sub">Area</span></div></div>`;
    }

    let dealHtml = '';
    if (isPremium && b.deals && b.deals !== '-') {
      dealHtml = `<div class="deal-box"><i class="fa-solid fa-gift"></i><span>${b.deals}</span></div>`;
    }

    let actions = '';
    if (b.phone) actions += `<a href="tel:${clean(b.phone)}" class="act act-call"><i class="fa-solid fa-phone"></i></a>`;
    if (isPremium && b.phone) actions += `<a href="https://wa.me/${clean(b.phone)}" target="_blank" rel="noopener" class="act act-wa"><i class="fa-brands fa-whatsapp"></i></a>`;
    if (b.website && b.website !== '-') actions += `<a href="${b.website}" target="_blank" rel="noopener" class="act act-web"><i class="fa-solid fa-globe"></i></a>`;
    if (b.googleMap && b.googleMap !== '-') actions += `<a href="${b.googleMap}" target="_blank" rel="noopener" class="act act-map"><i class="fa-solid fa-map-location-dot"></i></a>`;

    return `
      <article class="biz-card">
        <div class="card-accent" style="background: linear-gradient(90deg, ${c1}, ${c2})"></div>
        <header class="card-head">
          <div class="avatar" style="background: linear-gradient(135deg, ${c1}, ${c2})"><span>${initial}</span></div>
          <div class="head-text">
            <h3 class="biz-name"><a href="/business/${b.businessId}">${name}</a></h3>
            ${b.subCategory ? `<div class="biz-sub">${b.subCategory}</div>` : ''}
          </div>
          ${isVerified ? '<div class="verified-dot"><i class="fa-solid fa-circle-check"></i></div>' : ''}
        </header>
        ${badgeHtml ? `<div class="card-badges">${badgeHtml}</div>` : ''}
        ${statsHtml ? `<div class="card-stats">${statsHtml}</div>` : ''}
        ${dealHtml}
        ${actions ? `<footer class="card-actions">${actions}</footer>` : ''}
      </article>
    `;
  }

  function applyFilters() {
    let list = [...ALL];

    if (state.category !== 'all') {
      list = list.filter(b => b.categoryId === state.category);
    }

    if (state.search) {
      const q = state.search.toLowerCase();
      list = list.filter(b =>
        (b.businessName || '').toLowerCase().indexOf(q) !== -1 ||
        (b.subCategory || '').toLowerCase().indexOf(q) !== -1 ||
        (b.tags || '').toLowerCase().indexOf(q) !== -1 ||
        (b.location || '').toLowerCase().indexOf(q) !== -1
      );
    }

    if (state.nearMe && state.userLocation) {
      const withDist = [];
      const withoutDist = [];
      for (const b of list) {
        const ll = getLatLng(b);
        if (ll) {
          const d = haversine(state.userLocation.lat, state.userLocation.lng, ll.lat, ll.lng);
          withDist.push(Object.assign({}, b, { _dist: d }));
        } else {
          withoutDist.push(b);
        }
      }
      withDist.sort((a, b) => a._dist - b._dist);
      list = withDist.concat(withoutDist);
    } else {
      const tiers = { 1: [], 2: [], 3: [], 4: [], 5: [], 6: [] };
      for (const b of list) {
        const t = tierRank(b);
        tiers[t].push(b);
      }
      list = [].concat(
        shuffleArray(tiers[1]),
        shuffleArray(tiers[2]),
        shuffleArray(tiers[3]),
        shuffleArray(tiers[4]),
        shuffleArray(tiers[5]),
        shuffleArray(tiers[6])
      );
    }

    state.filtered = list;
    state.page = 1;
    render();
  }

  function render() {
    const total = state.filtered.length;
    const totalPages = Math.ceil(total / PER_PAGE) || 1;
    const start = (state.page - 1) * PER_PAGE;
    const items = state.filtered.slice(start, start + PER_PAGE);

    const rcEl = document.getElementById('resultsCount');
    if (state.nearMe) {
      const withCoords = state.filtered.filter(b => b._dist != null).length;
      if (withCoords === 0) {
        rcEl.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> GPS unavailable — ${total} shown`;
      } else {
        rcEl.innerHTML = `<i class="fa-solid fa-location-crosshairs"></i> ${total} sorted by distance`;
      }
    } else {
      rcEl.innerHTML = `<i class="fa-solid fa-store"></i> ${total} business${total !== 1 ? 'es' : ''}`;
    }

    const grid = document.getElementById('bizGrid');
    if (total === 0) {
      grid.innerHTML = `<div class="empty"><i class="fa-solid fa-magnifying-glass"></i><h3>No businesses found</h3><p>Try adjusting filters</p></div>`;
      document.getElementById('pagination').innerHTML = '';
      return;
    }
    grid.innerHTML = items.map(renderCard).join('');
    renderPagination(totalPages);
  }

  function renderPagination(totalPages) {
    const el = document.getElementById('pagination');
    if (totalPages <= 1) { el.innerHTML = ''; return; }
    let html = `<button ${state.page === 1 ? 'disabled' : ''} data-page="${state.page - 1}"><i class="fa-solid fa-chevron-left"></i></button>`;
    const s = Math.max(1, state.page - 2), e = Math.min(totalPages, state.page + 2);
    if (s > 1) { html += `<button data-page="1">1</button>`; if (s > 2) html += `<span>…</span>`; }
    for (let i = s; i <= e; i++) html += `<button data-page="${i}" ${i === state.page ? 'class="active"' : ''}>${i}</button>`;
    if (e < totalPages) { if (e < totalPages - 1) html += `<span>…</span>`; html += `<button data-page="${totalPages}">${totalPages}</button>`; }
    html += `<button ${state.page === totalPages ? 'disabled' : ''} data-page="${state.page + 1}"><i class="fa-solid fa-chevron-right"></i></button>`;
    el.innerHTML = html;
    el.querySelectorAll('button[data-page]').forEach(btn => {
      btn.addEventListener('click', () => {
        state.page = parseInt(btn.dataset.page);
        render();
        scrollToFirstListing();
      });
    });
  }

  document.getElementById('catPills').addEventListener('click', e => {
    const btn = e.target.closest('.cat-chip');
    if (!btn) return;
    document.querySelectorAll('.cat-chip').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    state.category = btn.dataset.cat;
    btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    applyFilters();
    setTimeout(scrollToFirstListing, 50);
  });

  document.getElementById('searchInput').addEventListener('input', e => {
    clearTimeout(window._t);
    window._t = setTimeout(() => {
      state.search = e.target.value;
      applyFilters();
    }, 250);
  });

  document.getElementById('nearMeBtn').addEventListener('click', () => {
    const btn = document.getElementById('nearMeBtn');

    if (state.nearMe) {
      state.nearMe = false;
      state.userLocation = null;
      btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Near Me';
      btn.classList.remove('active');
      applyFilters();
      return;
    }

    if (!navigator.geolocation) {
      alert('Your browser does not support location.');
      return;
    }

    const withGps = ALL.filter(b => getLatLng(b)).length;
    if (withGps === 0) {
      alert('Near Me is unavailable — business GPS data is being updated.');
      return;
    }

    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Detecting…';

    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;
        state.userLocation = { lat, lng };
        state.nearMe = true;
        state.category = 'all';
        state.search = '';
        document.getElementById('searchInput').value = '';
        document.querySelectorAll('.cat-chip').forEach(b => b.classList.remove('active'));
        const allPill = document.querySelector('.cat-chip[data-cat="all"]');
        if (allPill) { allPill.classList.add('active'); }
        btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Near Me ON';
        btn.classList.add('active');
        applyFilters();
        setTimeout(scrollToFirstListing, 50);
      },
      (err) => {
        btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Near Me';
        btn.classList.remove('active');
        alert('Could not get your location.');
      },
      { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
    );
  });

  applyFilters();
</script>

<style is:global>
.dir-page { background: #f8fafc; min-height: 60vh; padding: 40px 0 72px; }
.dir-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

/* HEADER */
.dir-head { padding: 0 0 24px; margin-bottom: 28px; border-bottom: 3px solid #dc2626; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px; }
.dir-head h1 { font-size: 32px; font-weight: 800; color: #0f172a; margin: 0; line-height: 1.15; letter-spacing: -0.9px; }
.dir-head h1 span { color: #dc2626; }
.dir-head p { color: #64748b; font-size: 14.5px; font-weight: 500; padding-bottom: 4px; margin: 0; }

/* FILTERS BAR */
.filters {
  display: flex; flex-wrap: wrap; gap: 10px;
  margin-bottom: 20px;
  align-items: center;
}
.search-wrap { position: relative; flex: 1; min-width: 240px; }
.search-icon {
  position: absolute; left: 16px; top: 50%; transform: translateY(-50%);
  color: #94a3b8; font-size: 13px; pointer-events: none;
}
.f-input {
  width: 100%; padding: 13px 16px 13px 42px;
  border: 1.5px solid #e2e8f0; border-radius: 12px;
  font-size: 14px; font-family: inherit; font-weight: 500;
  background: #fff; color: #334155;
  outline: none; transition: all 0.2s;
}
.f-input:focus { border-color: #dc2626; box-shadow: 0 0 0 4px rgba(220,38,38,0.08); }
.f-input::placeholder { color: #94a3b8; }

.near-btn {
  background: linear-gradient(135deg, #dc2626, #991b1b);
  color: #fff; border: 0;
  padding: 13px 22px; border-radius: 12px;
  font-weight: 700; cursor: pointer;
  font-size: 13.5px; display: inline-flex;
  align-items: center; gap: 8px;
  white-space: nowrap; font-family: inherit;
  transition: all 0.2s;
  box-shadow: 0 8px 16px -8px rgba(220,38,38,0.5);
}
.near-btn:hover { transform: translateY(-1px); box-shadow: 0 12px 22px -8px rgba(220,38,38,0.6); }
.near-btn.active { background: linear-gradient(135deg, #059669, #047857); box-shadow: 0 8px 16px -8px rgba(5,150,105,0.5); }
.near-btn i { font-size: 12px; }

.results-count {
  font-size: 13px; color: #334155; font-weight: 700;
  padding: 11px 16px; background: #fff;
  border: 1.5px solid #e2e8f0; border-radius: 12px;
  white-space: nowrap;
  display: inline-flex; align-items: center; gap: 7px;
}
.results-count i { color: #dc2626; font-size: 12px; }

/* CATEGORY CHIPS */
.cat-grid {
  display: flex; flex-wrap: wrap; gap: 8px;
  margin-bottom: 28px; padding: 4px 0;
}
.cat-chip {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 9px 15px;
  background: #fff;
  border: 1.5px solid #e2e8f0;
  border-radius: 50px;
  cursor: pointer;
  font-family: inherit;
  font-size: 12.5px; font-weight: 700;
  color: #475569;
  white-space: nowrap;
  transition: all 0.18s ease;
}
.cat-chip i { font-size: 11px; color: #94a3b8; transition: color 0.18s; }
.cat-chip:hover { border-color: #fecaca; background: #fef2f2; color: #dc2626; transform: translateY(-1px); }
.cat-chip:hover i { color: #dc2626; }
.cat-chip.active {
  background: linear-gradient(135deg, #dc2626, #991b1b);
  border-color: #dc2626; color: #fff;
  box-shadow: 0 8px 16px -6px rgba(220,38,38,0.45);
}
.cat-chip.active i { color: #fff; }
.cat-chip.all {
  background: #0f172a; border-color: #0f172a; color: #fff;
}
.cat-chip.all i { color: #fbbf24; }
.cat-chip.all.active { background: linear-gradient(135deg, #dc2626, #991b1b); border-color: #dc2626; }
.cat-chip.all.active i { color: #fff; }

/* GRID */
.biz-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }

/* BUSINESS CARD */
.biz-grid .biz-card {
  position: relative;
  background: #fff;
  border: 1.5px solid #eef1f6;
  border-radius: 18px;
  padding: 22px 22px 0;
  display: flex;
  flex-direction: column;
  transition: all 0.28s cubic-bezier(0.22,1,0.36,1);
  overflow: hidden;
}
.biz-grid .biz-card:hover {
  border-color: #fecaca;
  box-shadow: 0 20px 40px -16px rgba(15,23,42,0.12), 0 8px 16px -8px rgba(220,38,38,0.08);
  transform: translateY(-4px);
