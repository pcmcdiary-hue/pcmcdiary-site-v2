---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const expertSlugs = {
  'Dr. Saala': 'dr-saala',
  'Arthik Saala': 'arthik-saala',
  'Vastu Saala': 'vastu-saala',
  'Fit Saala': 'fit-saala',
  'Kanoon Saala': 'kanoon-saala',
  'Rashi Saala': 'rashi-saala',
  'Career Saala': 'career-saala',
  'Beauty Saala': 'beauty-saala',
  'Food Saala': 'food-saala',
  'Tech Saala': 'tech-saala',
};

const expertSlug = expertSlugs[article.data.expert] || 'expert-salla';
---

<BaseLayout title={article.data.title} description={article.data.excerpt || article.data.title}>

  <div class="article-page">
    <div class="article-container">

      <!-- Breadcrumb -->
      <nav class="breadcrumb">
        <a href="/"><i class="fa-solid fa-house"></i> Home</a>
        <i class="fa-solid fa-chevron-right sep"></i>
        <a href="/expert-salla">Expert Salla</a>
        <i class="fa-solid fa-chevron-right sep"></i>
        <span>{article.data.expert}</span>
      </nav>

      <!-- Article Header -->
      <header class="article-header">
        <div class="article-cat-badge">
          <i class="fa-solid fa-tag"></i>
          {article.data.category}
        </div>
        <h1>{article.data.title}</h1>
        {article.data.excerpt && (
          <p class="article-excerpt">{article.data.excerpt}</p>
        )}
        <div class="article-meta">
          {article.data.author && (
            <span><i class="fa-solid fa-user-doctor"></i> {article.data.author}</span>
          )}
          <span><i class="fa-solid fa-user-tie"></i> {article.data.expert}</span>
          <span><i class="fa-solid fa-calendar"></i> {article.data.date}</span>
          {article.data.readTime && (
            <span><i class="fa-solid fa-clock"></i> {article.data.readTime}</span>
          )}
        </div>
      </header>

      <!-- Article Body -->
      <article class="article-body">
        <Content />
      </article>

      <!-- Tags -->
      {article.data.tags && article.data.tags.length > 0 && (
        <div class="article-tags">
          <span class="tag-label">Tags:</span>
          {article.data.tags.map(tag => (
            <span class="tag-chip">#{tag}</span>
          ))}
        </div>
      )}

      <!-- Author Footer -->
      <div class="article-author-box">
        <div class="author-icon">
          <i class="fa-solid fa-user-doctor"></i>
        </div>
        <div class="author-info">
          <div class="author-name">{article.data.expert}</div>
          <div class="author-desc">
            Expert column on PCMC Diary. Get weekly insights on {article.data.category.toLowerCase()}.
          </div>
          <a href={`/search/label/${expertSlug}`} class="author-link">
            Read more from {article.data.expert} <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>

      <!-- CTA -->
      <div class="article-cta">
        <div class="cta-icon"><i class="fa-solid fa-bullhorn"></i></div>
        <div class="cta-text">
          <h4>Want to write for PCMC Diary?</h4>
          <p>Share your expertise with 10,000+ PCMC readers.</p>
        </div>
        <a href="/sponsor-package" class="cta-btn">Sponsor Now <i class="fa-solid fa-arrow-right"></i></a>
      </div>

      <!-- Back -->
      <div class="article-back">
        <a href="/expert-salla">
          <i class="fa-solid fa-arrow-left"></i> Back to Expert Salla
        </a>
      </div>

    </div>
  </div>

</BaseLayout>

<style is:global>
.article-page { background: #f8fafc; padding: 32px 0 72px; min-height: 60vh; }
.article-container { max-width: 780px; margin: 0 auto; padding: 0 24px; }

.breadcrumb {
  display: flex; align-items: center; gap: 8px;
  font-size: 12.5px; color: #64748b;
  margin-bottom: 24px; flex-wrap: wrap;
}
.breadcrumb a { color: #475569; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
.breadcrumb a:hover { color: #dc2626; }
.breadcrumb a i { font-size: 11px; }
.breadcrumb .sep { font-size: 9px; opacity: 0.5; }
.breadcrumb span { color: #dc2626; font-weight: 700; }

.article-header {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  padding: 40px 44px 32px;
  margin-bottom: 24px;
  box-shadow: 0 1px 3px rgba(15,23,42,0.04);
}

.article-cat-badge {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 6px 14px;
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
  border: 1px solid #fecaca;
  color: #b91c1c;
  border-radius: 50px;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 18px;
}
.article-cat-badge i { font-size: 10px; }

.article-header h1 {
  font-size: 38px;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -1.2px;
  color: #0f172a;
  margin: 0 0 16px;
}

.article-excerpt {
  font-size: 16.5px;
  color: #475569;
  line-height: 1.6;
  margin: 0 0 24px;
  font-weight: 500;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  font-size: 13px;
  color: #64748b;
  font-weight: 600;
  padding-top: 20px;
  border-top: 1px solid #f1f5f9;
}
.article-meta span { display: inline-flex; align-items: center; gap: 7px; }
.article-meta i { color: #dc2626; font-size: 12px; }

.article-body {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  padding: 44px;
  font-size: 16px;
  line-height: 1.75;
  color: #334155;
  box-shadow: 0 1px 3px rgba(15,23,42,0.04);
}
.article-body :global(h2) {
  font-size: 26px;
  font-weight: 800;
  color: #0f172a;
  margin: 36px 0 16px;
  letter-spacing: -0.5px;
  line-height: 1.25;
}
.article-body :global(h2:first-child) { margin-top: 0; }
.article-body :global(h3) {
  font-size: 20px;
  font-weight: 800;
  color: #0f172a;
  margin: 28px 0 12px;
  letter-spacing: -0.3px;
}
.article-body :global(p) { margin: 0 0 20px; }
.article-body :global(strong) { color: #0f172a; font-weight: 700; }
.article-body :global(a) { color: #dc2626; font-weight: 600; text-decoration: none; }
.article-body :global(a:hover) { text-decoration: underline; }
.article-body :global(ul),
.article-body :global(ol) { margin: 0 0 20px 24px; }
.article-body :global(li) { margin-bottom: 10px; line-height: 1.7; }
.article-body :global(img) {
  max-width: 100%;
  height: auto;
  border-radius: 12px;
  margin: 24px 0;
  display: block;
  box-shadow: 0 4px 12px -8px rgba(15,23,42,0.15);
}
.article-body :global(blockquote) {
  border-left: 4px solid #dc2626;
  padding: 12px 0 12px 20px;
  margin: 24px 0;
  font-style: italic;
  color: #475569;
  background: #fef2f2;
  border-radius: 0 12px 12px 0;
}
.article-body :global(code) {
  background: #f1f5f9;
  padding: 2px 8px;
  border-radius: 6px;
  font-size: 14px;
  font-family: ui-monospace, Menlo, monospace;
  color: #b91c1c;
}

.article-tags {
  display: flex; flex-wrap: wrap; gap: 8px;
  align-items: center;
  margin-top: 24px;
  padding: 20px 24px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
}
.tag-label { font-size: 12.5px; font-weight: 700; color: #64748b; margin-right: 4px; }
.tag-chip {
  padding: 5px 12px;
  background: #f1f5f9;
  border-radius: 50px;
  font-size: 12px;
  font-weight: 600;
  color: #475569;
}

.article-author-box {
  display: flex;
  gap: 20px;
  align-items: flex-start;
  margin-top: 24px;
  padding: 28px;
  background: linear-gradient(135deg, #fefcf8, #fff);
  border: 1px solid #fde68a;
  border-radius: 20px;
}
.author-icon {
  width: 60px; height: 60px;
  border-radius: 16px;
  background: linear-gradient(135deg, #fbbf24, #d97706);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
  box-shadow: 0 10px 20px -8px rgba(217,119,6,0.5);
}
.author-info { flex: 1; min-width: 0; }
.author-name { font-size: 17px; font-weight: 800; color: #0f172a; margin-bottom: 6px; letter-spacing: -0.3px; }
.author-desc { font-size: 13.5px; color: #64748b; line-height: 1.55; margin-bottom: 12px; }
.author-link {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 13px; font-weight: 800;
  color: #b45309; text-decoration: none;
  transition: gap 0.2s;
}
.author-link:hover { gap: 11px; }
.author-link i { font-size: 11px; }

.article-cta {
  display: flex;
  align-items: center;
  gap: 22px;
  margin-top: 24px;
  padding: 28px 32px;
  background: linear-gradient(135deg, #0f172a, #1e293b);
  border-radius: 20px;
  color: #fff;
  flex-wrap: wrap;
  box-shadow: 0 20px 40px -20px rgba(15,23,42,0.3);
}
.cta-icon {
  width: 56px; height: 56px;
  border-radius: 16px;
  background: rgba(251,191,36,0.15);
  border: 1px solid rgba(251,191,36,0.35);
  color: #fbbf24;
  display: flex; align-items: center; justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}
.cta-text { flex: 1; min-width: 200px; }
.cta-text h4 { font-size: 17px; font-weight: 800; margin: 0 0 4px; letter-spacing: -0.2px; }
.cta-text p { font-size: 13px; color: rgba(255,255,255,0.7); margin: 0; line-height: 1.5; }
.cta-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 13px 24px;
  background: linear-gradient(135deg, #fbbf24, #d97706);
  color: #0f0a0a;
  border-radius: 11px;
  font-weight: 800;
  font-size: 13.5px;
  text-decoration: none;
  transition: all 0.2s;
  box-shadow: 0 10px 24px -8px rgba(212,160,23,0.5);
  white-space: nowrap;
}
.cta-btn:hover { transform: translateY(-2px); text-decoration: none; box-shadow: 0 14px 30px -8px rgba(212,160,23,0.6); }
.cta-btn i { font-size: 11px; transition: transform 0.2s; }
.cta-btn:hover i { transform: translateX(3px); }

.article-back {
  text-align: center;
  margin-top: 32px;
}
.article-back a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  background: #fff;
  border: 1.5px solid #e2e8f0;
  border-radius: 50px;
  color: #334155;
  font-weight: 700;
  font-size: 13.5px;
  text-decoration: none;
  transition: all 0.2s;
}
.article-back a:hover {
  background: #0f172a;
  color: #fff;
  border-color: #0f172a;
  transform: translateY(-2px);
  text-decoration: none;
}

@media (max-width: 768px) {
  .article-page { padding: 20px 0 48px; }
  .article-container { padding: 0 16px; }
  .article-header { padding: 28px 24px 24px; border-radius: 16px; }
  .article-header h1 { font-size: 26px; letter-spacing: -0.6px; }
  .article-excerpt { font-size: 14.5px; }
  .article-meta { gap: 14px; font-size: 12px; }
  .article-body { padding: 28px 24px; font-size: 15.5px; border-radius: 16px; }
  .article-body :global(h2) { font-size: 22px; }
  .article-body :global(h3) { font-size: 17px; }
  .article-author-box { padding: 22px; border-radius: 16px; }
  .article-cta { padding: 22px; border-radius: 16px; text-align: center; justify-content: center; }
  .cta-btn { width: 100%; justify-content: center; }
}
</style>
