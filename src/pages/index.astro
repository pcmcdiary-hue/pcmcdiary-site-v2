  letter-spacing: -1.4px;
  line-height: 1.08;
  margin: 0 0 10px;
}
.sec-title em {
  font-style: italic;
  background: linear-gradient(135deg, #b45309, #d97706);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
