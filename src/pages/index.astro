---
import BaseLayout from '../layouts/BaseLayout.astro';

const CDN = 'https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data';
const LOGO = 'https://blogger.googleusercontent.com/img/a/AVvXsEi2G0UUWPHL9444BBONEoAfhRp3pTKc3gSt0iNdnlZ6nPT6e0EuamQAiA7TIlfqBiuKXsb92v7s9HpUlNY0JTlhWUGorlwXkpdSs1A6dkQ6gM4r6Y58Ymgnm8XNBKzQMvfWrUVqtp5LOYUIoz45nN-HwpeVnIwtBNJgkWMtP2XtvwXacyLjtPYuBwAQxO0=s1600';

// ── Icon + color map for categories ──
const catMeta = {
  'Food & Dining':              { icon: 'fa-utensils',            bg: 'linear-gradient(135deg,#fee2e2,#fecaca)', color: '#c62828' },
  'Grocery & Kirana':           { icon: 'fa-shopping-cart',       bg: 'linear-gradient(135deg,#dcfce7,#bbf7d0)', color: '#2e7d32' },
  'Health & Medical':           { icon: 'fa-heartbeat',           bg: 'linear-gradient(135deg,#ffedea,#ffd6cc)', color: '#bf360c' },
  'Beauty & Personal Care':     { icon: 'fa-spa',                 bg: 'linear-gradient(135deg,#fce7f3,#fbcfe8)', color: '#c2185b' },
  'Fitness & Wellness':         { icon: 'fa-dumbbell',            bg: 'linear-gradient(135deg,#e6f7ff,#bae7ff)', color: '#0288d1' },
  'Education & Learning':       { icon: 'fa-graduation-cap',      bg: 'linear-gradient(135deg,#fef9c3,#fef08a)', color: '#f9a825' },
  'Fashion & Apparel':          { icon: 'fa-vest',                bg: 'linear-gradient(135deg,#f3e8ff,#e9d5ff)', color: '#7b1fa2' },
  'Jewelry & Gold':             { icon: 'fa-gem',                 bg: 'linear-gradient(135deg,#fff8e1,#ffecb3)', color: '#f57f17' },
  'Electronics & Gadgets':      { icon: 'fa-microchip',           bg: 'linear-gradient(135deg,#dbeafe,#bfdbfe)', color: '#1565c0' },
  'Home & Interior':            { icon: 'fa-house-chimney',       bg: 'linear-gradient(135deg,#fef3c7,#fde68a)', color: '#ef6c00' },
  'Automotive':                 { icon: 'fa-car',                 bg: 'linear-gradient(135deg,#d1fae5,#a7f3d0)', color: '#2e7d32' },
  'Domestic Services':          { icon: 'fa-broom',               bg: 'linear-gradient(135deg,#e0e7ff,#c7d2fe)', color: '#3949ab' },
  'IT & Digital Services':      { icon: 'fa-code',                bg: 'linear-gradient(135deg,#dbeafe,#bfdbfe)', color: '#1565c0' },
  'Logistics & Movers':         { icon: 'fa-truck-fast',          bg: 'linear-gradient(135deg,#fff3e0,#ffe0b2)', color: '#e65100' },
  'Hospitality & Travel':       { icon: 'fa-plane',               bg: 'linear-gradient(135deg,#e0f2fe,#bae6fd)', color: '#0288d1' },
  'Entertainment & Events':     { icon: 'fa-film',                bg: 'linear-gradient(135deg,#f3e8ff,#e9d5ff)', color: '#7b1fa2' },
  'Kids & Baby':                { icon: 'fa-child',               bg: 'linear-gradient(135deg,#fce7f3,#fbcfe8)', color: '#c2185b' },
  'Books & Stationery':         { icon: 'fa-book-open',           bg: 'linear-gradient(135deg,#fff8e1,#ffecb3)', color: '#f57f17' },
  'Gardening & Outdoor':        { icon: 'fa-seedling',            bg: 'linear-gradient(135deg,#dcfce7,#bbf7d0)', color: '#2e7d32' },
  'Pet Care':                   { icon: 'fa-paw',                 bg: 'linear-gradient(135deg,#fef9e7,#fdebd0)', color: '#ef6c00' },
  'Real Estate & Property':     { icon: 'fa-building',            bg: 'linear-gradient(135deg,#f3e5f5,#e1bee7)', color: '#6a1b9a' },
  'Finance & Legal':            { icon: 'fa-coins',               bg: 'linear-gradient(135deg,#e8f5e9,#c8e6c9)', color: '#2e7d32' },
  'Packaging & Printing':       { icon: 'fa-print',               bg: 'linear-gradient(135deg,#e3f2fd,#bbdefb)', color: '#1565c0' },
  'Cafes & Quick Bites':        { icon: 'fa-mug-hot',             bg: 'linear-gradient(135deg,#fbe9e7,#ffccbc)', color: '#bf360c' },
  'Shopping & Retail':          { icon: 'fa-bag-shopping',        bg: 'linear-gradient(135deg,#fce4ec,#f8bbd0)', color: '#c2185b' },
  'Communication & Internet':   { icon: 'fa-wifi',                bg: 'linear-gradient(135deg,#e3f2fd,#bbdefb)', color: '#1565c0' },
  'Security Services':          { icon: 'fa-shield-halved',       bg: 'linear-gradient(135deg,#e0e7ff,#c7d2fe)', color: '#3949ab' },
  'Alternative Medicine':       { icon: 'fa-leaf',                bg: 'linear-gradient(135deg,#dcfce7,#bbf7d0)', color: '#2e7d32' },
  'Photography & Video':        { icon: 'fa-camera',              bg: 'linear-gradient(135deg,#fbe9e7,#ffccbc)', color: '#bf360c' },
  'Celebrations & Gifts':       { icon: 'fa-gift',                bg: 'linear-gradient(135deg,#fce4ec,#f8bbd0)', color: '#c2185b' },
  'Government Services':        { icon: 'fa-landmark',            bg: 'linear-gradient(135deg,#e0e7ff,#c7d2fe)', color: '#3949ab' },
  'Utilities':                  { icon: 'fa-bolt',                bg: 'linear-gradient(135deg,#fef9c3,#fef08a)', color: '#f9a825' },
  'Daily Use Services':         { icon: 'fa-screwdriver-wrench',  bg: 'linear-gradient(135deg,#fef3c7,#fde68a)', color: '#ef6c00' },
  'Fitness Equipment':          { icon: 'fa-person-running',      bg: 'linear-gradient(135deg,#e6f7ff,#bae7ff)', color: '#0288d1' },
  'Ayurveda & Wellness':        { icon: 'fa-mortar-pestle',       bg: 'linear-gradient(135deg,#dcfce7,#bbf7d0)', color: '#2e7d32' },
  'Coaches & Trainers':         { icon: 'fa-chalkboard-user',     bg: 'linear-gradient(135deg,#fef9c3,#fef08a)', color: '#f9a825' },
  'Interior & Exterior Design': { icon: 'fa-paint-roller',        bg: 'linear-gradient(135deg,#f3e8ff,#e9d5ff)', color: '#7b1fa2' },
  'Consulting Services':        { icon: 'fa-handshake',           bg: 'linear-gradient(135deg,#dbeafe,#bfdbfe)', color: '#1565c0' },
  'Specialty Stores':           { icon: 'fa-store',               bg: 'linear-gradient(135deg,#fce4ec,#f8bbd0)', color: '#c2185b' }
};

const shortNameMap = {
  'Food & Dining': 'Food','Grocery & Kirana': 'Grocery','Health & Medical': 'Health',
  'Beauty & Personal Care': 'Beauty','Fitness & Wellness': 'Fitness','Education & Learning': 'Education',
  'Fashion & Apparel': 'Fashion','Jewelry & Gold': 'Gold','Electronics & Gadgets': 'Electronics',
  'Home & Interior': 'Home','Automotive': 'Automotive','Domestic Services': 'Domestic',
  'IT & Digital Services': 'IT Services','Logistics & Movers': 'Logistics','Hospitality & Travel': 'Travel',
  'Entertainment & Events': 'Events','Kids & Baby': 'Kids','Books & Stationery': 'Books',
  'Gardening & Outdoor': 'Garden','Pet Care': 'Pet Care','Real Estate & Property': 'Real Estate',
  'Finance & Legal': 'Finance','Packaging & Printing': 'Printing','Cafes & Quick Bites': 'Cafes',
  'Shopping & Retail': 'Shopping','Communication & Internet': 'Internet','Security Services': 'Security',
  'Alternative Medicine': 'Alt Medicine','Photography & Video': 'Photography','Celebrations & Gifts': 'Gifts',
  'Government Services': 'Government','Utilities': 'Utilities','Daily Use Services': 'Daily Use',
  'Fitness Equipment': 'Fitness Eq.','Ayurveda & Wellness': 'Ayurveda','Coaches & Trainers': 'Coaches',
  'Interior & Exterior Design': 'Design','Consulting Services': 'Consulting','Specialty Stores': 'Specialty'
};

let categories = [];
let locations = [];

try {
  const catRes = await fetch(`${CDN}/categories.json`);
  const catData = await catRes.json();
  categories = (catData.categories || []).map(c => {
    const meta = catMeta[c.categoryName] || { icon: 'fa-folder', bg: 'linear-gradient(135deg,#f1f5f9,#e2e8f0)', color: '#475569' };
    return {
      ...c,
      icon: meta.icon,
      bg: meta.bg,
      color: meta.color,
      shortName: shortNameMap[c.categoryName] || c.categoryName
    };
  });
} catch (e) { console.error(e); }

try {
  const locRes = await fetch(`${CDN}/locations.json`);
  const locData = await locRes.json();
  locations = locData.locations || [];
} catch (e) { console.error(e); }

// Deals (static — baad me Sheet se dynamic kar sakte ho)
const deals = [
  { badge: '🔥 HOT',  icon: 'fa-pizza-slice',   discount: '30% OFF', desc: 'Pizza & Burgers', code: 'PIZZA30',   theme: 'hot'  },
  { badge: '⭐ BEST', icon: 'fa-mug-saucer',    discount: 'BUY 1 GET 1', desc: 'Coffee & Donuts', code: 'BOGO2024', theme: 'bogo' },
  { badge: '🎁 FREE', icon: 'fa-utensils',      discount: 'FREE LUNCH', desc: 'With Main Course', code: 'LUNCHFREE', theme: 'free' },
  { badge: '⚡ FLASH', icon: 'fa-cart-shopping', discount: '50% OFF', desc: 'Limited Time!', code: 'FLASH50', theme: 'flash' },
  { badge: '🎉 COMBO', icon: 'fa-burger',       discount: 'MEAL DEAL', desc: '2 Meals + Drink', code: 'MEALDEAL', theme: 'combo' },
  { badge: '🎁 FREE', icon: 'fa-gift',          discount: 'FREE GIFT', desc: 'Orders ₹499+', code: 'GIFTGIFT', theme: 'gift' },
  { badge: '⭐ NEW',  icon: 'fa-user',          discount: '₹100 OFF', desc: 'First Order', code: 'FIRST100', theme: 'new' },
  { badge: '💥 SALE', icon: 'fa-spa',           discount: '20% OFF', desc: 'Salon & Spa', code: 'SPA20', theme: 'sale' }
];

// Mahitipurna cards
const mahiti = [
  { icon: 'fa-eye',            color: '#0d47a1', title: 'भविष्य आणि मार्गदर्शन', desc: 'भविष्यातील संधी' },
  { icon: 'fa-user-md',        color: '#c62828', title: 'डॉक्टरांचा सल्ला',      desc: 'आरोग्य व उपचार' },
  { icon: 'fa-compass',        color: '#ef6c00', title: 'वास्तु सल्ला',          desc: 'वास्तुशास्त्र मार्गदर्शन' },
  { icon: 'fa-coins',          color: '#2e7d32', title: 'आर्थिक सल्ला',          desc: 'आर्थिक मार्गदर्शन' },
  { icon: 'fa-briefcase',      color: '#6a1b9a', title: 'रोजगार संधी',           desc: 'नोकरी व करिअर' },
  { icon: 'fa-trophy',         color: '#bf360c', title: 'स्पर्धा व बक्षिसे',     desc: 'स्पर्धा, बक्षिसे' },
  { icon: 'fa-female',         color: '#d81b60', title: 'महिलांसाठी खास',        desc: 'स्त्रीयांसाठी उपयुक्त' },
  { icon: 'fa-child',          color: '#f57c00', title: 'लहान मुलांसाठी खास',    desc: 'खास उपक्रम' },
  { icon: 'fa-book-open',      color: '#1565c0', title: 'इतर मार्गदर्शन',        desc: 'विविध विषय' }
];
---

<BaseLayout title="Home" description="PCMC Diary — Exclusive local deals & savings across Pimpri-Chinchwad.">

  <div class="home-wrap">
    <div class="home-container">

      <div class="pcmc-widget">

        <!-- ═══════════ HERO ═══════════ -->
        <div class="hero-card">
          <img src={LOGO} alt="PCMC Diary" class="hero-logo" />
          <div class="hero-text">
            <div class="hero-eyebrow">
              <span class="pulse-dot"></span>
              Trusted by 10,000+ locals
            </div>
            <h1 class="hero-h1">Exclusive Deals &amp; Local Savings</h1>
            <p class="hero-p">Your friendly neighbourhood guide to smart savings across 22 PCMC areas.</p>
          </div>
        </div>

        <!-- ═══════════ SEARCH ═══════════ -->
        <div class="search-wrap">
          <div class="search-form">
            <input type="text" id="homeSearch" class="search-input" placeholder="Search coupons, deals, areas…" autocomplete="off" />
            <button type="button" class="search-btn" id="homeSearchBtn">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </div>
          <div id="homeSearchResults"></div>
        </div>

        <!-- ═══════════ DEALS ═══════════ -->
        <div class="deals-box">
          <div class="deals-head">
            <span class="deals-title"><i class="fa-solid fa-bolt"></i> Today's Hot Deals</span>
            <a href="/coupons" class="deals-all">View All →</a>
          </div>
          <div class="deals-scroll-wrap">
            <div class="deals-scroll">
              {deals.map(d => (
                <a href="/coupons" class={`deal-card deal-${d.theme}`}>
                  <span class="deal-badge">{d.badge}</span>
                  <span class="deal-icon"><i class={`fa-solid ${d.icon}`}></i></span>
                  <span class="deal-discount">{d.discount}</span>
                  <span class="deal-desc">{d.desc}</span>
                  <span class="deal-code">{d.code}</span>
                </a>
              ))}
              {deals.map(d => (
                <a href="/coupons" class={`deal-card deal-${d.theme}`}>
                  <span class="deal-badge">{d.badge}</span>
                  <span class="deal-icon"><i class={`fa-solid ${d.icon}`}></i></span>
                  <span class="deal-discount">{d.discount}</span>
                  <span class="deal-desc">{d.desc}</span>
                  <span class="deal-code">{d.code}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- ═══════════ LOCATIONS ═══════════ -->
        <div class="sec-head">
          <span class="sec-icon"><i class="fa-solid fa-location-dot"></i></span>
          <span class="sec-title">Browse by Location</span>
          <span class="sec-badge">{locations.length} Areas</span>
        </div>
        <div class="loc-grid">
          {locations.map((loc, i) => (
            <a href={`/location/${loc.locationId}`} class={`loc-card loc-${(i % 10) + 1}`}>
              <span class="loc-name">{loc.locationName}</span>
            </a>
          ))}
        </div>

        <!-- ═══════════ CATEGORIES ═══════════ -->
        <div class="sec-head">
          <span class="sec-icon"><i class="fa-solid fa-tags"></i></span>
          <span class="sec-title">Browse by Category</span>
          <span class="sec-badge">{categories.length} Categories</span>
        </div>
        <div class="cat-grid">
          {categories.map(c => (
            <a href={`/category/${c.categoryId}`} class="cat-card" style={`--cat-bg: ${c.bg}; --cat-color: ${c.color};`}>
              <span class="cat-bg"><i class={`fa-solid ${c.icon}`}></i></span>
              <span class="cat-name">{c.shortName}</span>
            </a>
          ))}
        </div>

        <!-- ═══════════ MAHITIPURNA ═══════════ -->
        <div class="sec-head">
          <span class="sec-icon"><i class="fa-solid fa-compass"></i></span>
          <span class="sec-title">माहितीपूर्ण</span>
          <span class="sec-badge">मार्गदर्शन</span>
        </div>
        <div class="mahiti-grid">
          {mahiti.map(m => (
            <a href="/expert-salla" class="mahiti-card">
              <span class="mahiti-icon" style={`color: ${m.color};`}><i class={`fa-solid ${m.icon}`}></i></span>
              <span class="mahiti-name">{m.title}</span>
              <span class="mahiti-desc">{m.desc}</span>
            </a>
          ))}
        </div>

      </div>
      <!-- end pcmc-widget -->

    </div>
  </div>

</BaseLayout>

<script is:inline>
(function(){
  // ─── Simple client-side search across homepage links ───
  var input = document.getElementById('homeSearch');
  var btn = document.getElementById('homeSearchBtn');
  var results = document.getElementById('homeSearchResults');
  if (!input || !results) return;

  // Build index from page DOM
  var index = [];
  document.querySelectorAll('.loc-card').forEach(function(a){
    var name = a.querySelector('.loc-name').textContent;
    index.push({ title: name + ' — Area', url: a.getAttribute('href'), cat: 'Location' });
  });
  document.querySelectorAll('.cat-card').forEach(function(a){
    var name = a.querySelector('.cat-name').textContent;
    index.push({ title: name + ' — Category', url: a.getAttribute('href'), cat: 'Category' });
  });

  function render(q){
    q = (q || '').toLowerCase().trim();
    if (q.length < 2) { results.innerHTML = ''; return; }
    var found = index.filter(function(item){
      return item.title.toLowerCase().indexOf(q) !== -1;
    }).slice(0, 12);

    if (!found.length) {
      results.innerHTML = '<div class="search-empty">😕 No results for "<strong>' + q + '</strong>"</div>';
      return;
    }
    var html = '';
    found.forEach(function(f){
      html += '<a class="search-item" href="' + f.url + '">' +
        '<div class="si-title">' + f.title + ' <span class="si-badge">' + f.cat + '</span></div>' +
      '</a>';
    });
    results.innerHTML = html;
  }

  var t;
  input.addEventListener('input', function(){
    clearTimeout(t);
    t = setTimeout(function(){ render(input.value); }, 180);
  });
  btn.addEventListener('click', function(){ render(input.value); });
  input.addEventListener('keypress', function(e){
    if (e.key === 'Enter') { e.preventDefault(); render(input.value); }
  });
})();
</script>

<style is:global>
/* ═══════════ BASE ═══════════ */
.home-wrap {
  background: #f5f6f7;
  padding: 24px 0 48px;
  min-height: 60vh;
}
.home-container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 16px;
}

/* ═══════════ WIDGET WRAPPER ═══════════ */
.pcmc-widget {
  background: #ffffff;
  border-radius: 32px 32px 24px 24px;
  padding: 20px 18px 28px;
  box-shadow: 0 12px 40px rgba(0,0,0,0.06);
  border: 1px solid #eef1f6;
}
.pcmc-widget * { box-sizing: border-box; }

/* ═══════════ HERO ═══════════ */
.hero-card {
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #7f1d1d 100%);
  border-radius: 24px;
  padding: 36px 28px 40px;
  text-align: center;
  position: relative;
  overflow: hidden;
  margin-bottom: 22px;
}
.hero-card::before {
  content: '';
  position: absolute;
  top: -50%; right: -20%;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(217,119,6,0.28), transparent 60%);
  border-radius: 50%;
  pointer-events: none;
}
.hero-card::after {
  content: '';
  position: absolute;
  bottom: -60%; left: -15%;
  width: 350px; height: 350px;
  background: radial-gradient(circle, rgba(220,38,38,0.35), transparent 60%);
  border-radius: 50%;
  pointer-events: none;
}
.hero-card > * { position: relative; z-index: 2; }

.hero-logo {
  height: 58px;
  width: auto;
  max-width: 220px;
  object-fit: contain;
  background: rgba(255,255,255,0.98);
  padding: 10px 16px;
  border-radius: 14px;
  margin-bottom: 20px;
  box-shadow: 0 16px 40px -12px rgba(0,0,0,0.5);
  display: inline-block;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: 50px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.14);
  font-size: 11.5px;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
  margin-bottom: 18px;
  letter-spacing: 0.4px;
}
.pulse-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 0 rgba(34,197,94,0.7);
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(34,197,94,0.6); }
  70% { box-shadow: 0 0 0 10px rgba(34,197,94,0); }
  100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
}

.hero-h1 {
  font-size: 34px;
  font-weight: 800;
  color: #fff;
  letter-spacing: -1px;
  line-height: 1.1;
  margin: 0 0 12px;
}
.hero-p {
  font-size: 14.5px;
  color: rgba(255,255,255,0.72);
  line-height: 1.6;
  margin: 0 auto;
  max-width: 520px;
}

/* ═══════════ SEARCH ═══════════ */
.search-wrap { margin-bottom: 22px; }
.search-form {
  display: flex;
  align-items: center;
  background: #f2f5fa;
  border-radius: 60px;
  padding: 4px;
  border: 2px solid #e6eaef;
  transition: all 0.25s ease;
}
.search-form:focus-within {
  border-color: #d43b3b;
  background: #fff;
  box-shadow: 0 6px 20px rgba(212,59,59,0.12);
}
.search-input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  padding: 12px 20px;
  font-size: 15px;
  font-weight: 500;
  color: #1e293b;
  font-family: inherit;
}
.search-input::placeholder { color: #94a3b8; font-weight: 400; }
.search-btn {
  background: #d43b3b;
  border: none;
  color: #fff;
  width: 48px;
  height: 48px;
  border-radius: 60px;
  cursor: pointer;
  font-size: 17px;
  transition: all 0.2s;
  flex-shrink: 0;
}
.search-btn:hover { background: #b22e2e; transform: scale(1.03); }

#homeSearchResults { margin-top: 12px; }
.search-item {
  display: block;
  padding: 12px 16px;
  background: #fff;
  border-radius: 12px;
  margin-bottom: 6px;
  border: 1px solid #edf1f7;
  text-decoration: none;
  transition: all 0.2s;
}
.search-item:hover {
  border-color: #d43b3b;
  box-shadow: 0 4px 16px rgba(212,59,59,0.1);
  transform: translateY(-1px);
  text-decoration: none;
}
.si-title {
  font-size: 14px;
  font-weight: 700;
  color: #0f182a;
}
.si-badge {
  display: inline-block;
  font-size: 9px;
  font-weight: 700;
  color: #fff;
  background: #d43b3b;
  padding: 2px 10px;
  border-radius: 20px;
  margin-left: 8px;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}
.search-empty {
  text-align: center;
  padding: 24px;
  color: #94a3b8;
  font-size: 13.5px;
}
.search-empty strong { color: #d43b3b; }

/* ═══════════ DEALS ═══════════ */
.deals-box {
  background: #fff;
  border-radius: 20px;
