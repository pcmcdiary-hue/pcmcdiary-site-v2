/* ═══════ AREAS — ALL VISIBLE ═══════ */
.loc-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}
.loc-chip {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 18px;
  background: #fff;
  border: 1.5px solid var(--line-2);
  border-radius: 12px;
