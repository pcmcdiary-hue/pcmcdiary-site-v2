---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFile } from 'node:fs/promises';
import path from 'node:path';

const DATA_DIR = path.resolve('./src/data');

// Category styling map (icons + colors)
const CAT_META = {
  'Food & Dining':              { icon: 'fa-utensils',           grad: 'from-red-500 to-rose-700' },
  'Grocery & Kirana':           { icon: 'fa-cart-shopping',      grad: 'from-green-500 to-emerald-700' },
  'Health & Medical':           { icon: 'fa-stethoscope',        grad: 'from-red-500 to-pink-700' },
  'Beauty & Personal Care':     { icon: 'fa-spa',                grad: 'from-pink-500 to-fuchsia-700' },
  'Fitness & Wellness':         { icon: 'fa-dumbbell',           grad: 'from-cyan-500 to-blue-700' },
  'Education & Learning':       { icon: 'fa-graduation-cap',     grad: 'from-amber-500 to-orange-700' },
  'Fashion & Apparel':          { icon: 'fa-shirt',              grad: 'from-violet-500 to-purple-700' },
  'Jewelry & Gold':             { icon: 'fa-gem',                grad: 'from-yellow-500 to-amber-700' },
  'Electronics & Gadgets':      { icon: 'fa-laptop',             grad: 'from-blue-500 to-indigo-700' },
  'Home & Interior':            { icon: 'fa-couch',              grad: 'from-orange-500 to-red-700' },
  'Automotive':                 { icon: 'fa-car',                grad: 'from-slate-600 to-slate-800' },
  'Domestic Services':          { icon: 'fa-broom',              grad: 'from-indigo-500 to-blue-700' },
  'IT & Digital Services':      { icon: 'fa-code',               grad: 'from-sky-500 to-blue-700' },
  'Logistics & Movers':         { icon: 'fa-truck-fast',         grad: 'from-orange-500 to-amber-700' },
  'Hospitality & Travel':       { icon: 'fa-plane',              grad: 'from-cyan-500 to-teal-700' },
  'Entertainment & Events':     { icon: 'fa-film',               grad: 'from-purple-500 to-violet-700' },
  'Kids & Baby':                { icon: 'fa-child',              grad: 'from-pink-400 to-rose-600' },
  'Books & Stationery':         { icon: 'fa-book',               grad: 'from-amber-500 to-yellow-700' },
  'Gardening & Outdoor':        { icon: 'fa-seedling',           grad: 'from-lime-500 to-green-700' },
  'Pet Care':                   { icon: 'fa-paw',                grad: 'from-orange-400 to-amber-600' },
  'Real Estate & Property':     { icon: 'fa-building',           grad: 'from-purple-500 to-indigo-700' },
  'Finance & Legal':            { icon: 'fa-coins',              grad: 'from-emerald-500 to-green-700' },
  'Packaging & Printing':       { icon: 'fa-print',              grad: 'from-blue-500 to-cyan-700' },
  'Cafes & Quick Bites':        { icon: 'fa-mug-hot',            grad: 'from-amber-600 to-red-700' },
  'Shopping & Retail':          { icon: 'fa-bag-shopping',       grad: 'from-pink-500 to-red-700' },
  'Communication & Internet':   { icon: 'fa-wifi',               grad: 'from-sky-500 to-indigo-700' },
  'Security Services':          { icon: 'fa-shield-halved',      grad: 'from-slate-600 to-blue-900' },
  'Alternative Medicine':       { icon: 'fa-leaf',               grad: 'from-green-500 to-emerald-700' },
  'Photography & Video':        { icon: 'fa-camera',             grad: 'from-rose-500 to-pink-700' },
  'Celebrations & Gifts':       { icon: 'fa-gift',               grad: 'from-red-500 to-pink-700' },
  'Government Services':        { icon: 'fa-landmark',           grad: 'from-indigo-600 to-blue-900' },
  'Utilities':                  { icon: 'fa-bolt',               grad: 'from-yellow-500 to-orange-600' },
  'Daily Use Services':         { icon: 'fa-screwdriver-wrench', grad: 'from-orange-500 to-red-700' },
  'Fitness Equipment':          { icon: 'fa-person-running',     grad: 'from-cyan-500 to-blue-700' },
  'Ayurveda & Wellness':        { icon: 'fa-mortar-pestle',      grad: 'from-emerald-500 to-green-700' },
  'Coaches & Trainers':         { icon: 'fa-chalkboard-user',    grad: 'from-amber-500 to-orange-700' },
  'Interior & Exterior Design': { icon: 'fa-paint-roller',       grad: 'from-violet-500 to-purple-700' },
  'Consulting Services':        { icon: 'fa-handshake',          grad: 'from-blue-500 to-indigo-700' },
  'Specialty Stores':           { icon: 'fa-store',              grad: 'from-pink-500 to-rose-700' },
};

let categories = [];
let locations = [];
let businesses = [];

try {
  categories = JSON.parse(await readFile(path.join(DATA_DIR, 'categories.json'), 'utf8')).categories || [];
} catch (e) { console.error(e); }

try {
  locations = JSON.parse(await readFile(path.join(DATA_DIR, 'locations.json'), 'utf8')).locations || [];
} catch (e) { console.error(e); }

try {
  const results = await Promise.all(categories.map(async (cat) => {
    try {
      const data = JSON.parse(await readFile(path.join(DATA_DIR, 'clients', cat.file), 'utf8'));
      return (Array.isArray(data) ? data : []).map(b => ({
        ...b,
        categoryId: cat.categoryId,
        categoryName: cat.categoryName
      }));
    } catch (e) { return []; }
  }));
  businesses = results.flat();
} catch (e) { console.error(e); }

// Add counts + meta to each category
const catsWithMeta = categories.map(c => {
  const meta = CAT_META[c.categoryName] || { icon: 'fa-folder', grad: 'from-slate-500 to-slate-700' };
  const count = businesses.filter(b => b.categoryId === c.categoryId).length;
  return { ...c, ...meta, count };
});

// Featured businesses (premium first)
const premium = businesses.filter(b => ['featured','premium_pro','premium'].includes((b.tier||'').toLowerCase()));
const featured = premium.length >= 8
  ? premium.slice(0, 8)
  : [...premium, ...businesses.filter(b => !premium.includes(b))].slice(0, 8);

const stats = {
  categories: categories.length,
  locations: locations.length,
  listings: businesses.length
};
---

<BaseLayout title="PCMC Diary — Discover Pimpri-Chinchwad" description={`Find ${stats.listings}+ trusted businesses across ${stats.locations} PCMC areas.`}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "PCMC Diary",
    "url": "https://pcmcdiary.com",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://pcmcdiary.com/directory?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-orb hero-orb-3"></div>

    <div class="hero-inner">
      <div class="hero-eyebrow">
        <span class="pulse"></span>
        Trusted by locals across Pimpri-Chinchwad
      </div>

      <h1 class="hero-h1">
        Your Local Guide to<br>
        <span class="hero-accent">Pimpri-Chinchwad</span>
      </h1>

      <p class="hero-p">
        Discover {stats.listings}+ businesses across {stats.locations} areas. Restaurants, doctors, salons, services — all in one place.
      </p>

      <form class="hero-search" action="/directory" method="get">
        <i class="fa-solid fa-magnifying-glass hero-icon"></i>
        <input type="text" name="q" placeholder="Search restaurants, doctors, gyms…" />
        <button type="submit">
          Search <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <div class="hero-stats">
        <div class="stat">
          <div class="stat-num">{stats.categories}</div>
          <div class="stat-lbl">Categories</div>
        </div>
        <div class="stat-div"></div>
        <div class="stat">
          <div class="stat-num">{stats.locations}</div>
          <div class="stat-lbl">Areas</div>
        </div>
        <div class="stat-div"></div>
        <div class="stat">
          <div class="stat-num">{stats.listings}<span>+</span></div>
          <div class="stat-lbl">Listings</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ ALL CATEGORIES ═══════════ -->
  <section class="sec">
    <div class="sec-head">
      <div>
        <div class="sec-tag">Browse</div>
        <h2 class="sec-title">All {stats.categories} Categories</h2>
      </div>
      <a href="/directory" class="sec-link">Full Directory <i class="fa-solid fa-arrow-right"></i></a>
    </div>

    <div class="cat-grid">
      {catsWithMeta.map(c => (
        <a href={`/category/${c.categoryId}`} class="cat-tile">
          <div class={`cat-icon bg-gradient-to-br ${c.grad}`}>
            <i class={`fa-solid ${c.icon}`}></i>
          </div>
          <div class="cat-name">{c.categoryName}</div>
          <div class="cat-count">{c.count} listing{c.count === 1 ? '' : 's'}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══════════ FEATURED ═══════════ -->
  {featured.length > 0 && (
    <section class="sec sec-alt">
      <div class="sec-head">
        <div>
          <div class="sec-tag">Featured</div>
          <h2 class="sec-title">Handpicked Businesses</h2>
        </div>
        <a href="/directory" class="sec-link">View All <i class="fa-solid fa-arrow-right"></i></a>
      </div>

      <div class="biz-grid">
        {featured.map(b => {
          const name = b.businessName || 'Business';
          const initial = name.trim().charAt(0).toUpperCase();
          const rating = parseFloat(b.rating) || 0;
          const t = (b.tier || '').toLowerCase();
          const isVerified = ['featured','premium','premium_pro','vp','vb'].includes(t);
          return (
            <article class="biz-card">
              <div class="biz-head">
                <div class="biz-avatar">{initial}</div>
                <div class="biz-info">
                  <h3 class="biz-name"><a href={`/business/${b.businessId}`}>{name}</a></h3>
                  <div class="biz-sub">{b.subCategory || b.categoryName}</div>
                </div>
                {isVerified && <div class="biz-badge"><i class="fa-solid fa-circle-check"></i></div>}
              </div>
              <div class="biz-meta">
                {b.location && (
                  <span><i class="fa-solid fa-location-dot"></i> {b.location}</span>
                )}
                {rating > 0 && (
                  <span><i class="fa-solid fa-star"></i> {rating.toFixed(1)}{parseInt(b.reviews) > 0 ? ` · ${b.reviews}` : ''}</span>
                )}
              </div>
              <p class="biz-desc">{b.description || `Local business serving ${b.location || 'PCMC'}`}</p>
              <a href={`/business/${b.businessId}`} class="biz-btn">
                View Profile <i class="fa-solid fa-arrow-right"></i>
              </a>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <!-- ═══════════ LOCATIONS ═══════════ -->
  <section class="sec">
    <div class="sec-head">
      <div>
        <div class="sec-tag">Areas</div>
        <h2 class="sec-title">Browse by Location</h2>
      </div>
    </div>
    <div class="loc-grid">
      {locations.map(l => (
        <a href={`/location/${l.locationId}`} class="loc-chip">
          <i class="fa-solid fa-location-dot"></i>
          <span>{l.locationName}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══════════ HOW IT WORKS ═══════════ -->
  <section class="sec sec-alt">
    <div class="sec-head sec-head-center">
      <div>
        <div class="sec-tag">Simple</div>
        <h2 class="sec-title">How It Works</h2>
        <p class="sec-sub">A directory built for PCMC — by people who live here.</p>
      </div>
    </div>

    <div class="steps">
      <div class="step">
        <div class="step-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
        <div class="step-num">01</div>
        <h3 class="step-title">Search & Discover</h3>
        <p class="step-desc">Find any business by name, category, or area — across all 33 PCMC locations.</p>
      </div>
      <div class="step">
        <div class="step-icon"><i class="fa-solid fa-phone"></i></div>
        <div class="step-num">02</div>
        <h3 class="step-title">Connect Directly</h3>
        <p class="step-desc">Call, WhatsApp, or visit. Every listing shows real contact details — no middlemen.</p>
      </div>
      <div class="step">
        <div class="step-icon"><i class="fa-solid fa-ticket"></i></div>
        <div class="step-num">03</div>
        <h3 class="step-title">Grab Local Deals</h3>
        <p class="step-desc">Exclusive coupons from verified businesses. Save money on things you already need.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════ CTA ═══════════ -->
  <section class="sec">
    <div class="cta">
      <div class="cta-orb"></div>
      <div class="cta-inner">
        <div class="cta-badge"><i class="fa-solid fa-store"></i> For Business Owners</div>
        <h2 class="cta-h2">Get Your Business Listed</h2>
        <p class="cta-p">Join {stats.listings}+ businesses already on PCMC Diary. Free forever plan, upgrade anytime for premium placement.</p>
        <div class="cta-btns">
          <a href="/register" class="cta-btn-primary">
            <i class="fa-solid fa-plus"></i> List Business — Free
          </a>
          <a href="/plans" class="cta-btn-outline">
            <i class="fa-solid fa-crown"></i> View Plans
          </a>
        </div>
        <div class="cta-note">
          <i class="fa-solid fa-shield-halved"></i> No credit card · Cancel anytime
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

body { font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif; -webkit-font-smoothing: antialiased; }

/* ═══════════ HERO ═══════════ */
.hero {
  position: relative; overflow: hidden;
  background: radial-gradient(ellipse at top, #1a1f35 0%, #0a0f1e 55%, #0f0a1a 100%);
  color: #fff; padding: 96px 24px 80px;
}
.hero-orb { position: absolute; border-radius: 50%; filter: blur(100px); pointer-events: none; }
.hero-orb-1 { top: -180px; right: -120px; width: 520px; height: 520px; background: radial-gradient(circle, rgba(220,38,38,0.55), transparent 70%); }
.hero-orb-2 { bottom: -200px; left: -120px; width: 560px; height: 560px; background: radial-gradient(circle, rgba(217,119,6,0.35), transparent 70%); }
.hero-orb-3 { top: 40%; left: 40%; width: 400px; height: 400px; background: radial-gradient(circle, rgba(168,85,247,0.18), transparent 70%); }
.hero-inner { position: relative; z-index: 2; max-width: 860px; margin: 0 auto; text-align: center; }

.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 9px 20px; border-radius: 50px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.12);
  backdrop-filter: blur(12px);
  font-size: 12.5px; font-weight: 700;
  color: rgba(255,255,255,0.92);
  margin-bottom: 28px;
}
.pulse { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgba(34,197,94,0.7); animation: pulse 2s infinite; }
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(34,197,94,0.6); }
  70% { box-shadow: 0 0 0 10px rgba(34,197,94,0); }
  100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
}

.hero-h1 {
  font-size: 64px; font-weight: 800;
  letter-spacing: -2.6px; line-height: 1.02;
  margin: 0 0 24px;
}
.hero-accent {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  font-style: italic; padding-right: 8px;
}
.hero-p {
  font-size: 17.5px; color: rgba(255,255,255,0.72);
  line-height: 1.6; margin: 0 auto 44px;
  max-width: 580px;
}

.hero-search {
  display: flex; align-items: center; gap: 6px;
  max-width: 700px; margin: 0 auto 40px;
  padding: 8px 8px 8px 20px;
  background: rgba(255,255,255,0.98);
  border-radius: 20px;
  box-shadow: 0 28px 64px -20px rgba(0,0,0,0.65), 0 12px 28px -10px rgba(0,0,0,0.4);
  transition: all 0.3s;
}
.hero-search:focus-within {
  box-shadow: 0 28px 64px -20px rgba(0,0,0,0.65), 0 12px 28px -10px rgba(0,0,0,0.4), 0 0 0 4px rgba(220,38,38,0.18);
}
.hero-icon { color: #94a3b8; font-size: 15px; padding-left: 4px; flex-shrink: 0; }
.hero-search input {
  flex: 1; border: 0; padding: 15px 6px;
  font-size: 15.5px; font-family: inherit; font-weight: 500;
  color: #0f172a; background: transparent; outline: none; min-width: 0;
}
.hero-search input::placeholder { color: #94a3b8; font-weight: 400; }
.hero-search button {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 14px 26px; border: 0; border-radius: 14px;
  background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
  color: #fff; font-family: inherit; font-size: 14.5px; font-weight: 800;
  cursor: pointer; transition: all 0.2s;
  box-shadow: 0 10px 24px -8px rgba(220,38,38,0.65);
  white-space: nowrap;
}
.hero-search button:hover { transform: translateY(-1px); box-shadow: 0 14px 30px -8px rgba(220,38,38,0.75); }
.hero-search button i { font-size: 12px; transition: transform 0.2s; }
.hero-search button:hover i { transform: translateX(3px); }

.hero-stats { display: flex; align-items: center; justify-content: center; gap: 32px; flex-wrap: wrap; }
.stat { text-align: center; min-width: 80px; }
.stat-num {
  font-size: 32px; font-weight: 800; color: #fff;
  letter-spacing: -1.2px; line-height: 1;
}
.stat-num span { color: #fbbf24; }
.stat-lbl {
  font-size: 10.5px; text-transform: uppercase; letter-spacing: 1.6px;
  color: rgba(255,255,255,0.45); font-weight: 700; margin-top: 10px;
}
.stat-div { width: 1px; height: 40px; background: rgba(255,255,255,0.12); }

/* ═══════════ SECTIONS ═══════════ */
.sec { max-width: 1280px; margin: 0 auto; padding: 76px 24px; }
.sec-alt { background: #f8fafc; border-radius: 32px; margin: 8px auto; max-width: 1280px; }
.sec-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 16px; margin-bottom: 40px; flex-wrap: wrap;
}
.sec-head-center { justify-content: center; text-align: center; flex-direction: column; align-items: center; }
.sec-tag {
  font-size: 11px; font-weight: 800; text-transform: uppercase;
  letter-spacing: 1.8px; color: #dc2626; margin-bottom: 8px;
}
.sec-title {
  font-size: 36px; font-weight: 800; color: #0f172a;
  letter-spacing: -1px; line-height: 1.15; margin: 0;
}
.sec-sub { font-size: 14.5px; color: #64748b; margin: 10px 0 0; line-height: 1.55; max-width: 500px; }
.sec-link {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 13.5px; font-weight: 700; color: #dc2626;
  text-decoration: none; padding: 10px 20px; border-radius: 40px;
  background: #fef2f2; border: 1px solid #fecaca;
  transition: all 0.2s;
}
.sec-link:hover { background: #dc2626; color: #fff; border-color: #dc2626; text-decoration: none; }
.sec-link i { font-size: 10px; transition: transform 0.2s; }
.sec-link:hover i { transform: translateX(3px); }

/* ═══════════ CATEGORY TILES ═══════════ */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 14px;
}
.cat-tile {
  display: flex; flex-direction: column; align-items: center;
  padding: 24px 14px 18px;
  background: #fff; border: 1.5px solid #eef1f6;
  border-radius: 18px; text-decoration: none;
  transition: all 0.28s cubic-bezier(0.22,1,0.36,1);
  position: relative; overflow: hidden;
}
.cat-tile::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 60%, rgba(220,38,38,0.03));
  opacity: 0; transition: opacity 0.3s;
  pointer-events: none;
}
.cat-tile:hover::before { opacity: 1; }
.cat-tile:hover {
  transform: translateY(-6px);
  border-color: #fecaca;
  box-shadow: 0 22px 44px -18px rgba(15,23,42,0.15), 0 10px 20px -10px rgba(220,38,38,0.1);
  text-decoration: none;
}
.cat-icon {
  width: 60px; height: 60px; border-radius: 18px;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 24px;
  margin-bottom: 14px;
  box-shadow: 0 12px 24px -10px rgba(15,23,42,0.25), inset 0 1px 0 rgba(255,255,255,0.15);
  transition: transform 0.3s cubic-bezier(0.22,1,0.36,1);
}
.cat-tile:hover .cat-icon { transform: scale(1.08) rotate(-3deg); }
.cat-name {
  font-size: 13px; font-weight: 800; color: #0f172a;
  text-align: center; line-height: 1.3;
  letter-spacing: -0.2px;
  margin-bottom: 6px;
  min-height: 34px;
  display: flex; align-items: center; justify-content: center;
}
.cat-count {
  font-size: 10.5px; font-weight: 700; color: #94a3b8;
  text-transform: uppercase; letter-spacing: 0.6px;
}

/* ═══════════ FEATURED BUSINESSES ═══════════ */
.biz-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px;
}
.biz-card {
  display: flex; flex-direction: column;
  padding: 26px; background: #fff;
  border: 1.5px solid #eef1f6; border-radius: 20px;
  transition: all 0.28s cubic-bezier(0.22,1,0.36,1);
  position: relative; overflow: hidden;
}
.biz-card::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: 0;
  height: 3px;
  background: linear-gradient(90deg, #dc2626, #f59e0b);
  transform: scaleX(0); transform-origin: left;
  transition: transform 0.4s cubic-bezier(0.22,1,0.36,1);
}
.biz-card:hover::after { transform: scaleX(1); }
.biz-card:hover {
  transform: translateY(-5px);
  border-color: #fecaca;
  box-shadow: 0 24px 48px -20px rgba(15,23,42,0.15), 0 10px 20px -10px rgba(220,38,38,0.1);
}
.biz-head { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
.biz-avatar {
  width: 54px; height: 54px; border-radius: 15px;
  background: linear-gradient(135deg, #dc2626, #991b1b);
