  transition: all 0.2s var(--tr);
  position: relative;
  overflow: hidden;
}
.loc-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--brand);
  flex-shrink: 0;
  transition: all 0.2s;
