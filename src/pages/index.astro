---
import BaseLayout from '../layouts/BaseLayout.astro';

const CDN = 'https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data';

const catMeta = {
  'Food & Dining':              { icon: 'fa-utensils',            bg: 'linear-gradient(135deg,#fee2e2,#fecaca)', color: '#c62828' },
  'Grocery & Kirana':           { icon: 'fa-shopping-cart',       bg: 'linear-gradient(135deg,#dcfce7,#bbf7d0)', color: '#2e7d32' },
  'Health & Medical':           { icon: 'fa-heartbeat',           bg: 'linear-gradient(135deg,#ffedea,#ffd6cc)', color: '#bf360c' },
  'Beauty & Personal Care':     { icon: 'fa-spa',                 bg: 'linear-gradient(135deg,#fce7f3,#fbcfe8)', color: '#c2185b' },
  'Fitness & Wellness':         { icon: 'fa-dumbbell',            bg: 'linear-gradient(135deg,#e6f7ff,#bae7ff)', color: '#0288d1' },
  'Education & Learning':       { icon: 'fa-graduation-cap',      bg: 'linear-gradient(135deg,#fef9c3,#fef08a)', color: '#f9a825' },
  'Fashion & Apparel':          { icon: 'fa-vest',                bg: 'linear-gradient(135deg,#f3e8ff,#e9d5ff)', color: '#7b1fa2' },
  'Jewelry & Gold':             { icon: 'fa-gem',                 bg: 'linear-gradient(135deg,#fff8e1,#ffecb3)', color: '#f57f17' },
  'Electronics & Gadgets':      { icon: 'fa-microchip',           bg: 'linear-gradient(135deg,#dbeafe,#bfdbfe)', color: '#1565c0' },
  'Home & Interior':            { icon: 'fa-house-chimney',       bg: 'linear-gradient(135deg,#fef3c7,#fde68a)', color: '#ef6c00' },
  'Automotive':                 { icon: 'fa-car',                 bg: 'linear-gradient(135deg,#d1fae5,#a7f3d0)', color: '#2e7d32' },
  'Domestic Services':          { icon: 'fa-broom',               bg: 'linear-gradient(135deg,#e0e7ff,#c7d2fe)', color: '#3949ab' },
  'IT & Digital Services':      { icon: 'fa-code',                bg: 'linear-gradient(135deg,#dbeafe,#bfdbfe)', color: '#1565c0' },
  'Logistics & Movers':         { icon: 'fa-truck-fast',          bg: 'linear-gradient(135deg,#fff3e0,#ffe0b2)', color: '#e65100' },
  'Hospitality & Travel':       { icon: 'fa-plane',               bg: 'linear-gradient(135deg,#e0f2fe,#bae6fd)', color: '#0288d1' },
  'Entertainment & Events':     { icon: 'fa-film',                bg: 'linear-gradient(135deg,#f3e8ff,#e9d5ff)', color: '#7b1fa2' },
  'Kids & Baby':                { icon: 'fa-child',               bg: 'linear-gradient(135deg,#fce7f3,#fbcfe8)', color: '#c2185b' },
  'Books & Stationery':         { icon: 'fa-book-open',           bg: 'linear-gradient(135deg,#fff8e1,#ffecb3)', color: '#f57f17' },
  'Gardening & Outdoor':        { icon: 'fa-seedling',            bg: 'linear-gradient(135deg,#dcfce7,#bbf7d0)', color: '#2e7d32' },
  'Pet Care':                   { icon: 'fa-paw',                 bg: 'linear-gradient(135deg,#fef9e7,#fdebd0)', color: '#ef6c00' },
  'Real Estate & Property':     { icon: 'fa-building',            bg: 'linear-gradient(135deg,#f3e5f5,#e1bee7)', color: '#6a1b9a' },
  'Finance & Legal':            { icon: 'fa-coins',               bg: 'linear-gradient(135deg,#e8f5e9,#c8e6c9)', color: '#2e7d32' },
  'Packaging & Printing':       { icon: 'fa-print',               bg: 'linear-gradient(135deg,#e3f2fd,#bbdefb)', color: '#1565c0' },
  'Cafes & Quick Bites':        { icon: 'fa-mug-hot',             bg: 'linear-gradient(135deg,#fbe9e7,#ffccbc)', color: '#bf360c' },
  'Shopping & Retail':          { icon: 'fa-bag-shopping',        bg: 'linear-gradient(135deg,#fce4ec,#f8bbd0)', color: '#c2185b' },
  'Communication & Internet':   { icon: 'fa-wifi',                bg: 'linear-gradient(135deg,#e3f2fd,#bbdefb)', color: '#1565c0' },
  'Security Services':          { icon: 'fa-shield-halved',       bg: 'linear-gradient(135deg,#e0e7ff,#c7d2fe)', color: '#3949ab' },
  'Alternative Medicine':       { icon: 'fa-leaf',                bg: 'linear-gradient(135deg,#dcfce7,#bbf7d0)', color: '#2e7d32' },
  'Photography & Video':        { icon: 'fa-camera',              bg: 'linear-gradient(135deg,#fbe9e7,#ffccbc)', color: '#bf360c' },
  'Celebrations & Gifts':       { icon: 'fa-gift',                bg: 'linear-gradient(135deg,#fce4ec,#f8bbd0)', color: '#c2185b' },
  'Government Services':        { icon: 'fa-landmark',            bg: 'linear-gradient(135deg,#e0e7ff,#c7d2fe)', color: '#3949ab' },
  'Utilities':                  { icon: 'fa-bolt',                bg: 'linear-gradient(135deg,#fef9c3,#fef08a)', color: '#f9a825' },
  'Daily Use Services':         { icon: 'fa-screwdriver-wrench',  bg: 'linear-gradient(135deg,#fef3c7,#fde68a)', color: '#ef6c00' },
  'Fitness Equipment':          { icon: 'fa-person-running',      bg: 'linear-gradient(135deg,#e6f7ff,#bae7ff)', color: '#0288d1' },
  'Ayurveda & Wellness':        { icon: 'fa-mortar-pestle',       bg: 'linear-gradient(135deg,#dcfce7,#bbf7d0)', color: '#2e7d32' },
  'Coaches & Trainers':         { icon: 'fa-chalkboard-user',     bg: 'linear-gradient(135deg,#fef9c3,#fef08a)', color: '#f9a825' },
  'Interior & Exterior Design': { icon: 'fa-paint-roller',        bg: 'linear-gradient(135deg,#f3e8ff,#e9d5ff)', color: '#7b1fa2' },
  'Consulting Services':        { icon: 'fa-handshake',           bg: 'linear-gradient(135deg,#dbeafe,#bfdbfe)', color: '#1565c0' },
  'Specialty Stores':           { icon: 'fa-store',               bg: 'linear-gradient(135deg,#fce4ec,#f8bbd0)', color: '#c2185b' }
};

const shortNameMap = {
  'Food & Dining': 'Food','Grocery & Kirana': 'Grocery','Health & Medical': 'Health',
  'Beauty & Personal Care': 'Beauty','Fitness & Wellness': 'Fitness','Education & Learning': 'Education',
  'Fashion & Apparel': 'Fashion','Jewelry & Gold': 'Gold','Electronics & Gadgets': 'Electronics',
  'Home & Interior': 'Home','Automotive': 'Automotive','Domestic Services': 'Domestic',
  'IT & Digital Services': 'IT Services','Logistics & Movers': 'Logistics','Hospitality & Travel': 'Travel',
  'Entertainment & Events': 'Events','Kids & Baby': 'Kids','Books & Stationery': 'Books',
  'Gardening & Outdoor': 'Garden','Pet Care': 'Pet Care','Real Estate & Property': 'Real Estate',
  'Finance & Legal': 'Finance','Packaging & Printing': 'Printing','Cafes & Quick Bites': 'Cafes',
  'Shopping & Retail': 'Shopping','Communication & Internet': 'Internet','Security Services': 'Security',
  'Alternative Medicine': 'Alt Medicine','Photography & Video': 'Photography','Celebrations & Gifts': 'Gifts',
  'Government Services': 'Government','Utilities': 'Utilities','Daily Use Services': 'Daily Use',
  'Fitness Equipment': 'Fitness Eq.','Ayurveda & Wellness': 'Ayurveda','Coaches & Trainers': 'Coaches',
  'Interior & Exterior Design': 'Design','Consulting Services': 'Consulting','Specialty Stores': 'Specialty'
};

let categories = [];
let locations = [];

try {
  const catRes = await fetch(`${CDN}/categories.json`);
  const catData = await catRes.json();
  categories = (catData.categories || []).map(c => {
    const meta = catMeta[c.categoryName] || { icon: 'fa-folder', bg: 'linear-gradient(135deg,#f1f5f9,#e2e8f0)', color: '#475569' };
    return { ...c, icon: meta.icon, bg: meta.bg, color: meta.color, shortName: shortNameMap[c.categoryName] || c.categoryName };
  });
} catch (e) { console.error(e); }

try {
  const locRes = await fetch(`${CDN}/locations.json`);
  const locData = await locRes.json();
  locations = locData.locations || [];
} catch (e) { console.error(e); }

const deals = [
  { badge: '🔥 HOT',  icon: 'fa-pizza-slice',   discount: '30% OFF', desc: 'Pizza & Burgers', code: 'PIZZA30',   theme: 'hot'  },
  { badge: '⭐ BEST', icon: 'fa-mug-saucer',    discount: 'BUY 1 GET 1', desc: 'Coffee & Donuts', code: 'BOGO2024', theme: 'bogo' },
  { badge: '🎁 FREE', icon: 'fa-utensils',      discount: 'FREE LUNCH', desc: 'with Purchase of Main Course', code: 'LUNCHFREE', theme: 'free' },
  { badge: '⚡ FLASH', icon: 'fa-cart-shopping', discount: '50% OFF', desc: 'Limited Time!', code: 'FLASH50', theme: 'flash' },
  { badge: '🎉 COMBO', icon: 'fa-burger',       discount: 'MEAL DEAL', desc: '2 Meals + Drink', code: 'MEALDEAL', theme: 'combo' },
  { badge: '🎁 FREE', icon: 'fa-gift',          discount: 'FREE GIFT', desc: 'Orders ₹499+', code: 'GIFTGIFT', theme: 'gift' },
  { badge: '⭐ NEW',  icon: 'fa-user',          discount: '₹100 OFF', desc: 'First Order', code: 'FIRST100', theme: 'new' },
  { badge: '💥 SALE', icon: 'fa-spa',           discount: '20% OFF', desc: 'Salon & Spa', code: 'SPA20', theme: 'sale' }
];

const experts = [
  { name: 'Dr. Advisor', cat: 'Health', icon: 'fa-heart-pulse', grad: 'linear-gradient(135deg,#ef4444,#b91c1c)', sample: '5 early signs of diabetes you should not ignore', slug: 'dr-advisor', readers: '8.4k' },
  { name: 'Arthik Advisor', cat: 'Finance', icon: 'fa-coins', grad: 'linear-gradient(135deg,#10b981,#047857)', sample: 'How to save ₹46,800 in taxes this year (legally)', slug: 'arthik-advisor', readers: '6.2k' },
  { name: 'Vastu Advisor', cat: 'Vastu', icon: 'fa-compass', grad: 'linear-gradient(135deg,#8b5cf6,#5b21b6)', sample: 'Kitchen direction: why it affects your relationships', slug: 'vastu-advisor', readers: '5.1k' },
  { name: 'Fit Advisor', cat: 'Fitness', icon: 'fa-dumbbell', grad: 'linear-gradient(135deg,#f97316,#c2410c)', sample: 'Lose 5 kg in 8 weeks — without giving up roti', slug: 'fit-advisor', readers: '7.3k' },
  { name: 'Kanoon Advisor', cat: 'Legal', icon: 'fa-scale-balanced', grad: 'linear-gradient(135deg,#334155,#0f172a)', sample: 'Rent agreement: 7 clauses you must check', slug: 'kanoon-advisor', readers: '4.8k' },
  { name: 'Rashi Advisor', cat: 'Astrology', icon: 'fa-star', grad: 'linear-gradient(135deg,#a855f7,#7c3aed)', sample: 'Your weekly rashi phal — career & health', slug: 'rashi-advisor', readers: '9.1k' }
];

const mahiti = [
  { icon: 'fa-eye',       color: '#0d47a1', title: 'भविष्य आणि मार्गदर्शन', desc: 'भविष्यातील संधी' },
  { icon: 'fa-user-md',   color: '#c62828', title: 'डॉक्टरांचा सल्ला',      desc: 'आरोग्य व उपचार' },
  { icon: 'fa-compass',   color: '#ef6c00', title: 'वास्तु सल्ला',          desc: 'वास्तुशास्त्र मार्गदर्शन' },
  { icon: 'fa-coins',     color: '#2e7d32', title: 'आर्थिक सल्ला',          desc: 'आर्थिक मार्गदर्शन' },
  { icon: 'fa-briefcase', color: '#6a1b9a', title: 'रोजगार संधी',           desc: 'नोकरी व करिअर' },
  { icon: 'fa-trophy',    color: '#bf360c', title: 'स्पर्धा व बक्षिसे',     desc: 'स्पर्धा, बक्षिसे' },
  { icon: 'fa-female',    color: '#d81b60', title: 'महिलांसाठी खास',        desc: 'स्त्रियांसाठी उपयुक्त' },
  { icon: 'fa-child',     color: '#f57c00', title: 'लहान मुलांसाठी खास',    desc: 'खास उपक्रम' },
  { icon: 'fa-book-open', color: '#1565c0', title: 'इतर मार्गदर्शन',        desc: 'इतर विविध विषय' }
];
---

<BaseLayout title="Home" description="PCMC Diary — Exclusive local deals & savings across Pimpri-Chinchwad.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "PCMC Diary",
    "url": "https://pcmcdiary.com",
    "description": "Trusted local business directory for Pimpri-Chinchwad. Find verified businesses, exclusive coupons & expert advice.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://pcmcdiary.com/directory?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />

  <div class="home-wrap">
    <div class="home-container">

      <!-- ═══════════ HERO ═══════════ -->
      <section class="hero-card">
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="hero-grid-bg"></div>

        <div class="hero-inner">
          <div class="hero-brand">
            <span class="brand-text">PCMC</span>
            <span class="brand-text brand-accent">Diary</span>
            <span class="brand-dot">.</span>
          </div>

          <div class="hero-eyebrow">
            <span class="pulse-dot"></span>
            Trusted by 10,000+ locals in Pimpri-Chinchwad
          </div>

          <h1 class="hero-h1">
            Exclusive Deals &amp;<br>
            <span class="hero-h1-accent">Local Savings</span>
          </h1>

          <p class="hero-p">
            Your friendly neighbourhood guide to smart savings across {locations.length} PCMC areas.
          </p>

          <form class="hero-search" action="/directory" method="get">
            <div class="hero-search-icon">
              <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <input type="search" name="q" placeholder="Search restaurants, gyms, doctors, CA…" />
            <button type="submit">
              Search <i class="fa-solid fa-arrow-right"></i>
            </button>
          </form>

          <div class="hero-quick">
            <span>Popular:</span>
            <a href="/category/CAT001">Food</a>
            <a href="/category/CAT005">Fitness</a>
            <a href="/category/CAT003">Doctors</a>
            <a href="/category/CAT004">Salons</a>
            <a href="/category/CAT002">Grocery</a>
          </div>

          <div class="trust-strip">
            <div class="trust-item">
              <div class="trust-num">{categories.length}<span>+</span></div>
              <div class="trust-lbl">Categories</div>
            </div>
            <div class="trust-div"></div>
            <div class="trust-item">
              <div class="trust-num">{locations.length}</div>
              <div class="trust-lbl">Areas</div>
            </div>
            <div class="trust-div"></div>
            <div class="trust-item">
              <div class="trust-num">500<span>+</span></div>
              <div class="trust-lbl">Listed</div>
            </div>
            <div class="trust-div"></div>
            <div class="trust-item">
              <div class="trust-num">21</div>
              <div class="trust-lbl">Experts</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════════ DEALS ═══════════ -->
      <section class="widget-box">
        <div class="box-head">
          <div class="box-head-left">
            <span class="box-icon"><i class="fa-solid fa-bolt"></i></span>
            <span class="box-title">Today's Hot Deals</span>
          </div>
          <a href="/coupons" class="box-link">View All <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <div class="deals-scroll-wrap">
          <div class="deals-scroll">
            {deals.map(d => (
              <a href="/coupons" class={`deal-card deal-${d.theme}`}>
                <span class="deal-badge">{d.badge}</span>
                <span class="deal-icon"><i class={`fa-solid ${d.icon}`}></i></span>
                <span class="deal-discount">{d.discount}</span>
                <span class="deal-desc">{d.desc}</span>
                <span class="deal-code">{d.code}</span>
              </a>
            ))}
            {deals.map(d => (
              <a href="/coupons" class={`deal-card deal-${d.theme}`}>
                <span class="deal-badge">{d.badge}</span>
                <span class="deal-icon"><i class={`fa-solid ${d.icon}`}></i></span>
                <span class="deal-discount">{d.discount}</span>
                <span class="deal-desc">{d.desc}</span>
                <span class="deal-code">{d.code}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- ═══════════ LOCATIONS ═══════════ -->
      <section class="widget-box">
        <div class="box-head">
          <div class="box-head-left">
            <span class="box-icon"><i class="fa-solid fa-location-dot"></i></span>
            <span class="box-title">Browse by Location</span>
          </div>
          <span class="box-badge">{locations.length} Areas</span>
        </div>
        <div class="loc-grid">
          {locations.map((loc, i) => (
            <a href={`/location/${loc.locationId}`} class={`loc-card loc-${(i % 10) + 1}`}>
              <span class="loc-name">{loc.locationName}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- ═══════════ CATEGORIES ═══════════ -->
      <section class="widget-box">
        <div class="box-head">
          <div class="box-head-left">
            <span class="box-icon"><i class="fa-solid fa-tags"></i></span>
            <span class="box-title">Browse by Category</span>
          </div>
          <span class="box-badge">{categories.length} Categories</span>
        </div>
        <div class="cat-grid">
          {categories.map(c => (
            <a href={`/category/${c.categoryId}`} class="cat-card" style={`--cat-bg: ${c.bg}; --cat-color: ${c.color};`}>
              <span class="cat-bg"><i class={`fa-solid ${c.icon}`}></i></span>
              <span class="cat-name">{c.shortName}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- ═══════════ EXPERT ADVICE ═══════════ -->
      <section class="widget-box section-expert">
        <div class="box-head">
          <div class="box-head-left">
            <span class="box-icon icon-gold"><i class="fa-solid fa-crown"></i></span>
            <span class="box-title">PCMC <em>Expert Advice</em></span>
          </div>
          <a href="/expert-advice" class="box-link link-gold">All Experts <i class="fa-solid fa-arrow-right"></i></a>
        </div>

        <div class="ex-featured">
          <div class="ex-feat-left">
            <div class="ex-pill">
              <i class="fa-solid fa-crown"></i>
              Column of the month
            </div>
            <h3 class="ex-feat-title">Dr. Advisor — <em>Your weekly health companion</em></h3>
            <p class="ex-feat-desc">Practical medical advice for PCMC families. Get seasonal tips, home remedies, guidance on when to see a doctor, and report explanations — in plain language.</p>
            <div class="ex-feat-meta">
              <span><i class="fa-solid fa-calendar"></i> Weekly</span>
              <span><i class="fa-solid fa-eye"></i> 8,400+ readers</span>
              <span><i class="fa-solid fa-user-doctor"></i> Verified MD</span>
            </div>
            <a href="/search/label/dr-advisor" class="ex-feat-btn">
              <i class="fa-solid fa-book-open"></i>
              Read latest article
            </a>
          </div>
          <div class="ex-feat-right">
            <div class="ex-stat">
              <i class="fa-solid fa-users"></i>
              <div><div class="ex-stat-num">21</div><div class="ex-stat-lbl">Expert columns</div></div>
            </div>
            <div class="ex-stat">
              <i class="fa-solid fa-newspaper"></i>
              <div><div class="ex-stat-num">500+</div><div class="ex-stat-lbl">Articles published</div></div>
            </div>
            <div class="ex-stat">
              <i class="fa-solid fa-hand-holding-dollar"></i>
              <div><div class="ex-stat-num">₹2,999</div><div class="ex-stat-lbl">Sponsor / month</div></div>
            </div>
          </div>
        </div>

        <div class="ex-grid">
          {experts.map(ex => (
            <a href={`/search/label/${ex.slug}`} class="ex-card">
              <div class="ex-card-av" style={`background:${ex.grad}`}>
                <i class={`fa-solid ${ex.icon}`}></i>
              </div>
              <div class="ex-card-body">
                <div class="ex-card-name">{ex.name}</div>
                <div class="ex-card-sample">"{ex.sample}"</div>
                <div class="ex-card-foot">
                  <span class="ex-card-cat">{ex.cat}</span>
                  <span class="ex-card-read">{ex.readers} <i class="fa-solid fa-arrow-right"></i></span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- ═══════════ REAL ESTATE ═══════════ -->
      <section class="widget-box section-re">
        <div class="re-promo">
          <div class="re-glow-1"></div>
          <div class="re-glow-2"></div>
          <div class="re-inner">
            <div class="re-left">
              <div class="re-badge">
                <i class="fa-solid fa-building"></i>
                Real Estate Special
              </div>
              <h2 class="re-title">List your <em>real estate project</em> on PCMC Diary</h2>
              <p class="re-desc">Get high-intent property leads from thousands of PCMC buyers. Dedicated project pages, verified listings, and direct WhatsApp inquiries.</p>

              <div class="re-stats">
                <div class="re-stat">
                  <div class="re-stat-num">10k+</div>
                  <div class="re-stat-lbl">Monthly Readers</div>
                </div>
                <div class="re-stat">
                  <div class="re-stat-num">₹10k</div>
                  <div class="re-stat-lbl">Starting At</div>
                </div>
                <div class="re-stat">
                  <div class="re-stat-num">33</div>
                  <div class="re-stat-lbl">Areas Covered</div>
                </div>
              </div>

              <div class="re-btns">
                <a href="/real-estate-special" class="re-btn-primary">
                  View Packages <i class="fa-solid fa-arrow-right"></i>
                </a>
                <a href="https://wa.me/918793932827?text=Hi, I want to list my real estate project" target="_blank" rel="noopener" class="re-btn-outline">
                  <i class="fa-brands fa-whatsapp"></i> Talk to Us
                </a>
              </div>
            </div>

            <div class="re-right">
              <div class="re-card">
                <div class="re-card-icon"><i class="fa-solid fa-file-signature"></i></div>
                <div class="re-card-body">
                  <div class="re-card-title">Dedicated Project Page</div>
                  <div class="re-card-desc">Complete project info with gallery, floor plans &amp; amenities.</div>
                </div>
              </div>
              <div class="re-card">
                <div class="re-card-icon"><i class="fa-solid fa-phone"></i></div>
                <div class="re-card-body">
                  <div class="re-card-title">Direct Leads</div>
                  <div class="re-card-desc">WhatsApp button + contact form — buyers reach you instantly.</div>
                </div>
              </div>
              <div class="re-card">
                <div class="re-card-icon"><i class="fa-solid fa-chart-line"></i></div>
                <div class="re-card-body">
                  <div class="re-card-title">Analytics Dashboard</div>
                  <div class="re-card-desc">Track views, clicks, and inquiries for your project.</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

