---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFile } from 'node:fs/promises';
import path from 'node:path';

const DATA_DIR = path.resolve('./src/data');

// Category groups — organizes 39 categories into 9 visible groups
const GROUPS = [
  { id: 'food-daily',    name: 'Food & Daily Needs',    icon: 'fa-utensils',         desc: 'Restaurants, cafés, kirana, grocery & more',
    categories: ['food-dining','cafes-quick-bites','grocery-kirana','specialty-stores','books-stationery'] },
  { id: 'health-well',   name: 'Health & Wellness',     icon: 'fa-heart-pulse',      desc: 'Doctors, fitness, Ayurveda, beauty & spa',
    categories: ['health-medical','fitness-wellness','ayurveda-wellness','alternative-medicine','beauty-personal-care'] },
  { id: 'home-living',   name: 'Home & Living',         icon: 'fa-house-chimney',    desc: 'Interiors, domestic help, garden, repairs',
    categories: ['home-interior','interior-exterior-design','domestic-services','gardening-outdoor','utilities','daily-use-services'] },
  { id: 'shop-fashion',  name: 'Shopping & Fashion',    icon: 'fa-bag-shopping',     desc: 'Apparel, jewellery, gifts, kids, pets',
    categories: ['fashion-apparel','jewelry-gold','shopping-retail','celebrations-gifts','kids-baby','pet-care'] },
  { id: 'tech-digital',  name: 'Tech & Digital',        icon: 'fa-laptop',           desc: 'Electronics, IT, internet, photography',
    categories: ['electronics-gadgets','it-digital-services','communication-internet','photography-video'] },
  { id: 'auto-travel',   name: 'Auto & Travel',         icon: 'fa-car',              desc: 'Vehicles, movers, hotels, travel agents',
    categories: ['automotive','logistics-movers','hospitality-travel'] },
  { id: 'property-fin',  name: 'Property & Finance',    icon: 'fa-building',         desc: 'Real estate, CA, legal, government services',
    categories: ['real-estate-property','finance-legal','government-services','consulting-services'] },
  { id: 'learn-lifestyle', name: 'Learning & Lifestyle', icon: 'fa-graduation-cap',  desc: 'Schools, coaches, events, fitness gear',
    categories: ['education-learning','coaches-trainers','entertainment-events','fitness-equipment'] },
  { id: 'biz-services',  name: 'Business Services',     icon: 'fa-briefcase',        desc: 'Printing, packaging, security',
    categories: ['packaging-printing','security-services'] },
];

// Read data
let categories = [];
let locations = [];
let businesses = [];

try {
  const catRaw = await readFile(path.join(DATA_DIR, 'categories.json'), 'utf8');
  categories = JSON.parse(catRaw).categories || [];
} catch (e) { console.error(e); }

try {
  const locRaw = await readFile(path.join(DATA_DIR, 'locations.json'), 'utf8');
  locations = JSON.parse(locRaw).locations || [];
} catch (e) { console.error(e); }

try {
  const results = await Promise.all(
    categories.map(async (cat) => {
      try {
        const bizRaw = await readFile(path.join(DATA_DIR, 'clients', cat.file), 'utf8');
        const data = JSON.parse(bizRaw);
        return (Array.isArray(data) ? data : []).map(b => ({
          ...b,
          categoryId: cat.categoryId,
          categoryName: cat.categoryName
        }));
      } catch (e) { return []; }
    })
  );
  businesses = results.flat();
} catch (e) { console.error(e); }

// Build groups with their categories
const groups = GROUPS.map(g => ({
  ...g,
  cats: g.categories
    .map(slug => categories.find(c => c.file === slug + '.json'))
    .filter(Boolean)
}));

// Featured listings — pick premium/featured tier first, then any
const premium = businesses.filter(b => ['featured','premium_pro','premium'].includes((b.tier||'').toLowerCase()));
const featured = premium.length >= 6
  ? premium.slice(0, 6)
  : [...premium, ...businesses.filter(b => !premium.includes(b))].slice(0, 6);

const stats = {
  categories: categories.length,
  locations: locations.length,
  listings: businesses.length
};
---

<BaseLayout title="PCMC Diary — Local Business Directory" description="Discover trusted local businesses across Pimpri-Chinchwad. Restaurants, doctors, services, shops and more.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "PCMC Diary",
    "url": "https://pcmcdiary.com",
    "description": "Trusted local business directory for Pimpri-Chinchwad.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://pcmcdiary.com/directory?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero">
    <div class="hero-glow hero-glow-1"></div>
    <div class="hero-glow hero-glow-2"></div>

    <div class="hero-inner">
      <div class="hero-eyebrow">
        <i class="fa-solid fa-location-dot"></i>
        Trusted by locals across Pimpri-Chinchwad
      </div>

      <h1 class="hero-h1">
        Find Trusted<br>
        <span class="hero-accent">Local Businesses</span>
      </h1>

      <p class="hero-p">
        Search {stats.listings}+ verified businesses across {stats.locations} PCMC areas — restaurants, doctors, salons, services and more.
      </p>

      <form class="hero-search" action="/directory" method="get">
        <i class="fa-solid fa-magnifying-glass hero-search-icon"></i>
        <input type="text" name="q" placeholder="Search restaurants, doctors, gyms, CA…" />
        <button type="submit">
          Search <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <div class="hero-trust">
        <span><i class="fa-solid fa-circle-check"></i> Verified Listings</span>
        <span><i class="fa-solid fa-circle-check"></i> Direct Contact</span>
        <span><i class="fa-solid fa-circle-check"></i> Free to Browse</span>
      </div>
    </div>
  </section>

  <!-- ═══════════ CATEGORY GROUPS ═══════════ -->
  <section class="sec">
    <div class="sec-head">
      <div>
        <div class="sec-tag">Directory</div>
        <h2 class="sec-title">Explore by Category</h2>
      </div>
      <a href="/directory" class="sec-link">View all <i class="fa-solid fa-arrow-right"></i></a>
    </div>

    <div class="group-grid">
      {groups.map(g => (
        <button type="button" class="group-card" data-group={g.id}>
          <div class="group-icon"><i class={`fa-solid ${g.icon}`}></i></div>
          <h3 class="group-name">{g.name}</h3>
          <p class="group-desc">{g.desc}</p>
          <div class="group-foot">
            <span>{g.cats.length} categories</span>
            <i class="fa-solid fa-arrow-right"></i>
          </div>
        </button>
      ))}
    </div>

    <!-- Expand panel -->
    <div class="group-panel" id="groupPanel" style="display:none">
      <div class="panel-head">
        <div class="panel-title" id="panelTitle">Select a category</div>
        <button type="button" class="panel-close" id="panelClose">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="panel-body" id="panelBody"></div>
    </div>
  </section>

  <!-- ═══════════ FEATURED LISTINGS ═══════════ -->
  {featured.length > 0 && (
    <section class="sec">
      <div class="sec-head">
        <div>
          <div class="sec-tag">Featured</div>
          <h2 class="sec-title">Featured Businesses</h2>
        </div>
        <a href="/directory" class="sec-link">View all <i class="fa-solid fa-arrow-right"></i></a>
      </div>

      <div class="biz-grid">
        {featured.map(b => {
          const t = (b.tier || '').toLowerCase();
          const name = b.businessName || 'Business';
          const initial = name.trim().charAt(0).toUpperCase();
          const rating = parseFloat(b.rating) || 0;
          return (
            <article class="biz-card">
              <div class="biz-head">
                <div class="biz-avatar">{initial}</div>
                <div class="biz-info">
                  <h3 class="biz-name"><a href={`/business/${b.businessId}`}>{name}</a></h3>
                  <div class="biz-sub">{b.subCategory || b.categoryName} · {b.location || 'PCMC'}</div>
                </div>
              </div>
              {rating > 0 && (
                <div class="biz-rating">
                  <i class="fa-solid fa-star"></i> {rating.toFixed(1)}
                  {parseInt(b.reviews) > 0 && <span>({b.reviews})</span>}
                </div>
              )}
              <p class="biz-desc">{b.description || `Local ${b.subCategory || 'business'} in ${b.location || 'PCMC'}`}</p>
              <a href={`/business/${b.businessId}`} class="biz-btn">
                View Profile <i class="fa-solid fa-arrow-right"></i>
              </a>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <!-- ═══════════ HOW IT WORKS ═══════════ -->
  <section class="sec">
    <div class="sec-head sec-head-center">
      <div>
        <div class="sec-tag">Simple</div>
        <h2 class="sec-title">How PCMC Diary Works</h2>
        <p class="sec-sub">A local directory built for PCMC businesses and the people who need them.</p>
      </div>
    </div>

    <div class="steps">
      <div class="step">
        <div class="step-num">01</div>
        <h3 class="step-title">Search</h3>
        <p class="step-desc">Find businesses by name, category, or area across all 33 PCMC locations.</p>
      </div>
      <div class="step">
        <div class="step-num">02</div>
        <h3 class="step-title">Connect</h3>
        <p class="step-desc">Call, WhatsApp, or visit — every listing has direct contact details. No middlemen.</p>
      </div>
      <div class="step">
        <div class="step-num">03</div>
        <h3 class="step-title">Get Deals</h3>
        <p class="step-desc">Exclusive coupons and offers from verified local businesses across PCMC.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════ CTA ═══════════ -->
  <section class="sec">
    <div class="cta">
      <div class="cta-glow"></div>
      <div class="cta-inner">
        <h2 class="cta-h2">Own a business in PCMC?</h2>
        <p class="cta-p">Get discovered by thousands of local customers. Free listing, upgrade anytime for premium visibility.</p>
        <div class="cta-btns">
          <a href="/register" class="cta-btn-primary">
            <i class="fa-solid fa-plus"></i> List Your Business
          </a>
          <a href="/plans" class="cta-btn-outline">
            <i class="fa-solid fa-crown"></i> View Plans
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ groups }}>
    const GROUPS_DATA = groups;

    const panel = document.getElementById('groupPanel');
    const panelTitle = document.getElementById('panelTitle');
    const panelBody = document.getElementById('panelBody');
    const panelClose = document.getElementById('panelClose');

    document.querySelectorAll('.group-card').forEach(card => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-group');
        const group = GROUPS_DATA.find(g => g.id === id);
        if (!group) return;

        panelTitle.textContent = group.name;
        panelBody.innerHTML = '';
        group.cats.forEach(c => {
          const a = document.createElement('a');
          a.href = `/category/${c.categoryId}`;
          a.className = 'panel-item';
          a.innerHTML = `<span>${c.categoryName}</span><i class="fa-solid fa-arrow-right"></i>`;
          panelBody.appendChild(a);
        });

        panel.style.display = 'block';
        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });

    panelClose.addEventListener('click', () => {
      panel.style.display = 'none';
    });
  </script>

</BaseLayout>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

body { font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif; -webkit-font-smoothing: antialiased; }

/* ═══════════ HERO ═══════════ */
.hero {
  position: relative;
  background: linear-gradient(135deg, #0a0f1e 0%, #1a1f35 55%, #2a1530 100%);
  color: #fff;
  padding: 84px 24px 72px;
  overflow: hidden;
}
.hero-glow { position: absolute; border-radius: 50%; filter: blur(90px); pointer-events: none; }
.hero-glow-1 { top: -140px; right: -80px; width: 480px; height: 480px; background: radial-gradient(circle, rgba(220,38,38,0.55), transparent 70%); }
.hero-glow-2 { bottom: -180px; left: -100px; width: 520px; height: 520px; background: radial-gradient(circle, rgba(217,119,6,0.35), transparent 70%); }
.hero-inner { position: relative; z-index: 2; max-width: 860px; margin: 0 auto; text-align: center; }

.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 9px;
  padding: 8px 18px; border-radius: 50px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  backdrop-filter: blur(12px);
  font-size: 12.5px; font-weight: 700;
  color: rgba(255,255,255,0.9);
  margin-bottom: 26px;
}
.hero-eyebrow i { color: #fbbf24; font-size: 12px; }

.hero-h1 {
  font-size: 62px; font-weight: 800;
  letter-spacing: -2.4px; line-height: 1.02;
  margin: 0 0 22px; color: #fff;
}
.hero-accent {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  font-style: italic; padding-right: 6px;
}
.hero-p {
  font-size: 17px; color: rgba(255,255,255,0.7);
  line-height: 1.6; margin: 0 auto 40px;
  max-width: 560px;
}

.hero-search {
  display: flex; align-items: center; gap: 6px;
  max-width: 700px; margin: 0 auto 26px;
  padding: 8px 8px 8px 20px;
  background: rgba(255,255,255,0.98);
  border-radius: 20px;
  box-shadow: 0 28px 60px -20px rgba(0,0,0,0.6), 0 10px 24px -8px rgba(0,0,0,0.4);
  transition: all 0.3s;
}
.hero-search:focus-within {
  box-shadow: 0 28px 60px -20px rgba(0,0,0,0.6), 0 10px 24px -8px rgba(0,0,0,0.4), 0 0 0 4px rgba(220,38,38,0.15);
}
.hero-search-icon { color: #94a3b8; font-size: 15px; padding-left: 4px; flex-shrink: 0; }
.hero-search input {
  flex: 1; border: 0; padding: 15px 6px;
  font-size: 15.5px; font-family: inherit; font-weight: 500;
  color: #0f172a; background: transparent; outline: none; min-width: 0;
}
.hero-search input::placeholder { color: #94a3b8; font-weight: 400; }
.hero-search button {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 14px 26px; border: 0; border-radius: 14px;
  background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
  color: #fff; font-family: inherit; font-size: 14.5px; font-weight: 800;
  cursor: pointer; transition: all 0.2s;
  box-shadow: 0 10px 24px -8px rgba(220,38,38,0.6);
  white-space: nowrap;
}
.hero-search button:hover { transform: translateY(-1px); box-shadow: 0 14px 30px -8px rgba(220,38,38,0.7); }
.hero-search button i { font-size: 12px; transition: transform 0.2s; }
.hero-search button:hover i { transform: translateX(3px); }

.hero-trust {
  display: flex; flex-wrap: wrap; justify-content: center;
  gap: 22px; font-size: 12.5px; font-weight: 600;
  color: rgba(255,255,255,0.55);
}
.hero-trust span { display: inline-flex; align-items: center; gap: 7px; }
.hero-trust i { color: #22c55e; font-size: 11px; }

/* ═══════════ SECTIONS ═══════════ */
.sec { max-width: 1200px; margin: 0 auto; padding: 72px 24px; }
.sec-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 16px; margin-bottom: 36px; flex-wrap: wrap;
}
.sec-head-center { justify-content: center; text-align: center; }
.sec-tag {
  font-size: 11px; font-weight: 800; text-transform: uppercase;
  letter-spacing: 1.6px; color: #dc2626; margin-bottom: 8px;
}
.sec-title {
  font-size: 34px; font-weight: 800; color: #0f172a;
  letter-spacing: -0.9px; line-height: 1.15; margin: 0;
}
.sec-sub { font-size: 14.5px; color: #64748b; margin: 10px 0 0; line-height: 1.55; }
.sec-link {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 13.5px; font-weight: 700; color: #dc2626;
  text-decoration: none;
  padding: 9px 18px; border-radius: 40px;
  background: #fef2f2; border: 1px solid #fecaca;
  transition: all 0.2s;
}
.sec-link:hover { background: #dc2626; color: #fff; border-color: #dc2626; text-decoration: none; }
.sec-link i { font-size: 10px; transition: transform 0.2s; }
.sec-link:hover i { transform: translateX(3px); }

/* ═══════════ GROUP CARDS ═══════════ */
.group-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
}
.group-card {
  display: flex; flex-direction: column;
  align-items: flex-start; text-align: left;
  padding: 26px 24px 20px;
  background: #fff; border: 1.5px solid #eef1f6;
  border-radius: 20px; cursor: pointer;
  font-family: inherit; transition: all 0.25s cubic-bezier(0.22,1,0.36,1);
}
.group-card:hover {
  transform: translateY(-4px);
  border-color: #fecaca;
  box-shadow: 0 20px 40px -16px rgba(15,23,42,0.12), 0 8px 16px -8px rgba(220,38,38,0.08);
}
.group-icon {
  width: 52px; height: 52px; border-radius: 15px;
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
  color: #dc2626; font-size: 22px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 18px;
  transition: all 0.25s;
}
.group-card:hover .group-icon {
  background: linear-gradient(135deg, #dc2626, #991b1b);
  color: #fff;
}
.group-name {
  font-size: 17px; font-weight: 800; color: #0f172a;
  letter-spacing: -0.4px; margin: 0 0 8px;
}
.group-desc {
  font-size: 13px; color: #64748b; line-height: 1.5;
  margin: 0 0 18px; flex: 1;
}
.group-foot {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; padding-top: 14px;
  border-top: 1px solid #f1f5f9;
  font-size: 12px; font-weight: 700; color: #94a3b8;
}
.group-foot i {
  color: #dc2626; font-size: 11px;
  transition: transform 0.25s;
}
.group-card:hover .group-foot i { transform: translateX(4px); }

/* ═══════════ PANEL ═══════════ */
.group-panel {
  margin-top: 24px;
  background: #fff; border: 1.5px solid #eef1f6;
  border-radius: 20px; overflow: hidden;
  box-shadow: 0 20px 40px -20px rgba(15,23,42,0.12);
}
.panel-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 24px; border-bottom: 1px solid #f1f5f9;
}
.panel-title {
  font-size: 15px; font-weight: 800; color: #0f172a;
  letter-spacing: -0.3px;
}
.panel-close {
  width: 34px; height: 34px; border-radius: 9px;
  background: transparent; border: 0; cursor: pointer;
  color: #94a3b8; font-size: 16px;
  display: inline-flex; align-items: center; justify-content: center;
  transition: all 0.2s;
}
.panel-close:hover { background: #f1f5f9; color: #0f172a; }
.panel-body {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
}
.panel-item {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; padding: 15px 24px;
  font-size: 13.5px; font-weight: 700; color: #334155;
  text-decoration: none;
  border-bottom: 1px solid #f8fafc;
  transition: all 0.2s;
}
.panel-item:hover {
  background: #fef2f2; color: #dc2626; text-decoration: none;
}
.panel-item i { color: #cbd5e1; font-size: 11px; transition: all 0.2s; }
.panel-item:hover i { color: #dc2626; transform: translateX(3px); }

/* ═══════════ FEATURED BIZ ═══════════ */
.biz-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  gap: 18px;
}
.biz-card {
  display: flex; flex-direction: column;
  padding: 24px;
  background: #fff; border: 1.5px solid #eef1f6;
  border-radius: 18px;
  transition: all 0.25s cubic-bezier(0.22,1,0.36,1);
}
.biz-card:hover {
  transform: translateY(-4px);
  border-color: #fecaca;
  box-shadow: 0 20px 40px -16px rgba(15,23,42,0.12), 0 8px 16px -8px rgba(220,38,38,0.08);
}
.biz-head { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
.biz-avatar {
  width: 52px; height: 52px; border-radius: 14px;
  background: linear-gradient(135deg, #dc2626, #991b1b);
  color: #fff; font-weight: 800; font-size: 22px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8px 16px -6px rgba(220,38,38,0.4);
}
.biz-info { flex: 1; min-width: 0; }
.biz-name {
  font-size: 16px; font-weight: 800; color: #0f172a;
  margin: 0 0 4px; letter-spacing: -0.3px; line-height: 1.25;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.biz-name a { color: inherit; text-decoration: none; }
.biz-name a:hover { color: #dc2626; }
.biz-sub {
  font-size: 12.5px; color: #64748b; font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.biz-rating {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 12.5px; font-weight: 800; color: #92400e;
  background: #fef3c7; padding: 5px 10px; border-radius: 8px;
  margin-bottom: 12px; align-self: flex-start;
}
.biz-rating i { color: #f59e0b; font-size: 11px; }
.biz-rating span { color: #a16207; font-weight: 600; font-size: 11px; }
.biz-desc {
  font-size: 13px; color: #475569; line-height: 1.55;
  margin: 0 0 18px; flex: 1;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.biz-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 11px 18px; border-radius: 11px;
  background: #fef2f2; color: #dc2626;
  font-size: 13px; font-weight: 800; text-decoration: none;
  border: 1.5px solid #fecaca;
  transition: all 0.2s; align-self: flex-start;
