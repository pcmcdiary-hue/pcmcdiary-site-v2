---
import BaseLayout from '../layouts/BaseLayout.astro';

const CDN = 'https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data';

const iconMap = {
  'Food & Dining': 'fa-utensils','Grocery & Kirana': 'fa-cart-shopping','Health & Medical': 'fa-stethoscope',
  'Beauty & Personal Care': 'fa-spa','Fitness & Wellness': 'fa-dumbbell','Education & Learning': 'fa-graduation-cap',
  'Fashion & Apparel': 'fa-shirt','Jewelry & Gold': 'fa-gem','Electronics & Gadgets': 'fa-laptop',
  'Home & Interior': 'fa-couch','Automotive': 'fa-car','Domestic Services': 'fa-broom',
  'IT & Digital Services': 'fa-code','Logistics & Movers': 'fa-truck-fast','Hospitality & Travel': 'fa-plane',
  'Entertainment & Events': 'fa-film','Kids & Baby': 'fa-child','Books & Stationery': 'fa-book',
  'Gardening & Outdoor': 'fa-seedling','Pet Care': 'fa-paw','Real Estate & Property': 'fa-building',
  'Finance & Legal': 'fa-coins','Packaging & Printing': 'fa-print','Cafes & Quick Bites': 'fa-mug-hot',
  'Shopping & Retail': 'fa-bag-shopping','Communication & Internet': 'fa-wifi','Security Services': 'fa-shield-halved',
  'Alternative Medicine': 'fa-leaf','Photography & Video': 'fa-camera','Celebrations & Gifts': 'fa-gift',
  'Government Services': 'fa-landmark','Utilities': 'fa-bolt','Daily Use Services': 'fa-screwdriver-wrench',
  'Fitness Equipment': 'fa-person-running','Ayurveda & Wellness': 'fa-mortar-pestle','Coaches & Trainers': 'fa-chalkboard-user',
  'Interior & Exterior Design': 'fa-paint-roller','Consulting Services': 'fa-handshake','Specialty Stores': 'fa-store'
};

const experts = [
  { name: 'Dr. Saala', cat: 'Health & Medical', icon: 'fa-heart-pulse', gradient: 'linear-gradient(135deg,#dc2626,#991b1b)', sample: '"5 early signs of diabetes you should not ignore"', freq: 'Weekly', slug: 'dr-saala' },
  { name: 'Arthik Saala', cat: 'Finance & Tax', icon: 'fa-coins', gradient: 'linear-gradient(135deg,#059669,#047857)', sample: '"How to save ₹46,800 tax this year (legally)"', freq: 'Weekly', slug: 'arthik-saala' },
  { name: 'Vastu Saala', cat: 'Vastu & Harmony', icon: 'fa-compass', gradient: 'linear-gradient(135deg,#7c3aed,#5b21b6)', sample: '"Kitchen direction: why it affects your relationships"', freq: 'Weekly', slug: 'vastu-saala' },
  { name: 'Fit Saala', cat: 'Fitness & Nutrition', icon: 'fa-dumbbell', gradient: 'linear-gradient(135deg,#ea580c,#c2410c)', sample: '"Lose 5 kg in 8 weeks — without giving up roti"', freq: 'Weekly', slug: 'fit-saala' },
  { name: 'Kanoon Saala', cat: 'Legal & Rights', icon: 'fa-scale-balanced', gradient: 'linear-gradient(135deg,#1e293b,#0f172a)', sample: '"Rent agreement: 7 clauses you must check"', freq: 'Monthly', slug: 'kanoon-saala' },
  { name: 'Rashi Saala', cat: 'Astrology', icon: 'fa-star', gradient: 'linear-gradient(135deg,#9333ea,#7c3aed)', sample: '"Your weekly rashi phal — career & health"', freq: 'Weekly', slug: 'rashi-saala' },
  { name: 'Beauty Saala', cat: 'Skin & Hair', icon: 'fa-spa', gradient: 'linear-gradient(135deg,#db2777,#be185d)', sample: '"Monsoon skincare: 5 dermatologist-approved tips"', freq: 'Weekly', slug: 'beauty-saala' },
  { name: 'Food Saala', cat: 'Food & Recipes', icon: 'fa-utensils', gradient: 'linear-gradient(135deg,#b45309,#92400e)', sample: '"5 PCMC street foods you must try before 30"', freq: 'Weekly', slug: 'food-saala' },
  { name: 'Property Saala', cat: 'Real Estate', icon: 'fa-building', gradient: 'linear-gradient(135deg,#059669,#065f46)', sample: '"Wakad vs Hinjawadi: where to buy in 2026"', freq: 'Monthly', slug: 'property-saala' },
  { name: 'Travel Saala', cat: 'Travel', icon: 'fa-umbrella-beach', gradient: 'linear-gradient(135deg,#0284c7,#075985)', sample: '"Weekend getaways under ₹5,000 from Pune"', freq: 'Weekly', slug: 'travel-saala' }
];

let categories = [];
let locations = [];

try {
  const catRes = await fetch(`${CDN}/categories.json`);
  const catData = await catRes.json();
  categories = (catData.categories || []).map(c => ({ ...c, iconClass: iconMap[c.categoryName] || 'fa-folder' }));
} catch (e) { console.error(e); }

try {
  const locRes = await fetch(`${CDN}/locations.json`);
  const locData = await locRes.json();
  locations = locData.locations || [];
} catch (e) { console.error(e); }
---

<BaseLayout title="Home" description="PCMC Diary — Find trusted local businesses in Pimpri-Chinchwad.">

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        <i class="fa-solid fa-crown"></i>
        PCMC's #1 Local Discovery Platform
      </div>
      <h1>Discover the best of <span>Pimpri-Chinchwad</span></h1>
      <p class="hero-sub">Verified businesses, exclusive coupons &amp; expert advice — curated for the people of PCMC.</p>
      <form class="hero-search" action="/directory" method="get">
        <div class="hs-field">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" name="q" placeholder="Search restaurants, gyms, doctors, CA…" />
        </div>
        <button type="submit">
          <i class="fa-solid fa-arrow-right"></i>
          Search
        </button>
      </form>
      <div class="hero-stats">
        <div>
          <strong>{categories.length}+</strong>
          <span>Categories</span>
        </div>
        <div class="stat-divider"></div>
        <div>
          <strong>{locations.length}</strong>
          <span>Areas</span>
        </div>
        <div class="stat-divider"></div>
        <div>
          <strong>500+</strong>
          <span>Businesses</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ALL CATEGORIES -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div>
          <span class="sec-eyebrow">Explore</span>
          <h2>Browse by Category</h2>
          <p class="sec-sub">All {categories.length} categories across PCMC</p>
        </div>
        <a href="/directory" class="sec-link">
          View All
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
      <div class="cat-grid">
        {categories.map(cat => (
          <a href={`/category/${cat.categoryId}`} class="cat-card">
            <div class="cat-icon">
              <i class={`fa-solid ${cat.iconClass}`}></i>
            </div>
            <div class="cat-name">{cat.categoryName}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- EXPERT SALLA SECTION -->
  <section class="section section-expert">
    <div class="container">
      <div class="sec-head">
        <div>
          <span class="sec-eyebrow sec-eyebrow-gold">Expert Advice</span>
          <h2>PCMC <em>Expert Salla</em></h2>
          <p class="sec-sub">Real advice from doctors, CAs, trainers, astrologers &amp; more</p>
        </div>
        <a href="/expert-salla" class="sec-link">
          All Experts
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <div class="expert-grid">
        {experts.map(ex => (
          <a href={`/search/label/${ex.slug}`} class="expert-card">
            <div class="expert-accent" style={`background:${ex.gradient}`}></div>
            <div class="expert-top">
              <div class="expert-av" style={`background:${ex.gradient}`}>
                <i class={`fa-solid ${ex.icon}`}></i>
              </div>
              <div class="expert-info">
                <div class="expert-name">{ex.name}</div>
                <div class="expert-cat">{ex.cat}</div>
              </div>
              <span class={`expert-freq ${ex.freq === 'Free' ? 'free' : ''}`}>{ex.freq}</span>
            </div>
            <div class="expert-sample">{ex.sample}</div>
            <div class="expert-foot">
              <span class="expert-read">Read Articles <i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>
        ))}
      </div>

      <div class="expert-cta">
        <div class="expert-cta-inner">
          <div class="expert-cta-icon"><i class="fa-solid fa-bullhorn"></i></div>
          <div class="expert-cta-text">
            <h3>Want to sponsor a column?</h3>
            <p>Reach 10,000+ engaged PCMC readers every month with expert articles.</p>
          </div>
          <a href="/plans" class="expert-cta-btn">See Packages <i class="fa-solid fa-arrow-right"></i></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ALL LOCATIONS -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div>
          <span class="sec-eyebrow">Near You</span>
          <h2>All Areas of PCMC</h2>
          <p class="sec-sub">Browse businesses across {locations.length} areas</p>
        </div>
        <a href="/directory" class="sec-link">
          Full Directory
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
      <div class="loc-chips">
        {locations.map(loc => (
          <a href={`/location/${loc.locationId}`} class="loc-chip">
            <i class="fa-solid fa-location-dot"></i>
            {loc.locationName}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta">
        <div class="cta-icon">
          <i class="fa-solid fa-rocket"></i>
        </div>
        <h2>Own a business? Get discovered.</h2>
        <p>Join hundreds of local businesses reaching thousands of customers across PCMC.</p>
        <div class="cta-btns">
          <a href="/register" class="cta-primary">
            <i class="fa-solid fa-circle-plus"></i>
            List Your Business — Free
          </a>
          <a href="/plans" class="cta-outline">
            <i class="fa-solid fa-crown"></i>
            View Premium Plans
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
/* HERO */
.hero {
  background: linear-gradient(135deg, #b91c1c 0%, #7f1d1d 60%, #450a0a 100%);
  color: #fff; padding: 72px 0 60px;
  text-align: center; position: relative; overflow: hidden;
}
.hero::before {
  content: ''; position: absolute; inset: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(255,255,255,0.06) 1px, transparent 1px),
    radial-gradient(circle at 80% 70%, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 60px 60px, 80px 80px;
  opacity: 0.6; pointer-events: none;
}
.hero::after {
  content: ''; position: absolute; bottom: -40%; right: -10%;
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(253,224,71,0.12), transparent 65%);
  border-radius: 50%; pointer-events: none;
}
.hero .container { position: relative; z-index: 2; }
.hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,0.12);
  padding: 7px 16px; border-radius: 50px;
  font-size: 12px; font-weight: 700;
  margin-bottom: 18px; letter-spacing: 0.5px;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.15);
}
.hero-badge i { color: #fde047; font-size: 12px; }
.hero h1 {
  font-size: 46px; font-weight: 800; line-height: 1.12;
  letter-spacing: -1px; margin-bottom: 16px;
}
.hero h1 span { color: #fde047; }
.hero-sub {
  font-size: 16px; opacity: 0.9;
  max-width: 600px; margin: 0 auto 32px; line-height: 1.6;
}
.hero-search {
  display: flex; max-width: 620px; margin: 0 auto;
  background: #fff; border-radius: 14px; padding: 8px;
  box-shadow: 0 20px 40px -12px rgba(0,0,0,0.4); gap: 8px;
}
.hs-field {
  flex: 1; display: flex; align-items: center; gap: 12px;
  padding: 0 16px; background: #f8fafc;
  border-radius: 10px; min-width: 0;
}
.hs-field i { color: #94a3b8; font-size: 15px; flex-shrink: 0; }
.hero-search input {
  flex: 1; border: 0; padding: 14px 0; font-size: 15px;
  outline: none; font-family: inherit; background: transparent;
  min-width: 0; color: #0f172a; font-weight: 500;
}
.hero-search input::placeholder { color: #94a3b8; }
.hero-search button {
  background: linear-gradient(135deg, #b91c1c, #991b1b);
  color: #fff; border: 0; padding: 14px 26px; border-radius: 10px;
  font-weight: 700; font-size: 14px; cursor: pointer;
  font-family: inherit; display: inline-flex; align-items: center; gap: 8px;
  transition: all 0.2s; white-space: nowrap;
  box-shadow: 0 8px 20px -6px rgba(185,28,28,0.4);
}
.hero-search button i { font-size: 12px; }
.hero-search button:hover { transform: translateY(-2px); box-shadow: 0 12px 26px -6px rgba(185,28,28,0.5); }
.hero-stats {
  display: flex; justify-content: center; align-items: center;
  gap: 42px; margin-top: 40px; flex-wrap: wrap;
  position: relative; z-index: 2;
}
.hero-stats > div:not(.stat-divider) { text-align: center; }
.hero-stats strong {
  display: block; font-size: 28px; font-weight: 800;
  line-height: 1; letter-spacing: -0.5px;
}
.hero-stats span {
  font-size: 10.5px; opacity: 0.75; text-transform: uppercase;
  letter-spacing: 1.5px; margin-top: 6px; display: block; font-weight: 700;
}
.stat-divider { width: 1px; height: 32px; background: rgba(255,255,255,0.18); }

/* SECTIONS */
.section { padding: 60px 0; }
.section:nth-child(even) { background: #f8fafc; }
.section-expert { background: linear-gradient(180deg, #fef9f3 0%, #fff 100%) !important; }

.sec-head {
  display: flex; justify-content: space-between; align-items: flex-end;
  margin-bottom: 28px; flex-wrap: wrap; gap: 12px;
}
.sec-eyebrow {
  display: inline-block; font-size: 11px; font-weight: 800;
  letter-spacing: 1.5px; text-transform: uppercase;
  color: #b91c1c; margin-bottom: 6px;
}
.sec-eyebrow-gold { color: #b45309; }
.sec-head h2 {
  font-size: 28px; font-weight: 800; color: #0f172a;
  letter-spacing: -0.5px; line-height: 1.15;
}
.sec-head h2 em { font-style: italic; color: #b45309; }
.sec-sub {
  font-size: 13.5px; color: #64748b;
  margin-top: 6px; font-weight: 500;
}
.sec-link {
  font-size: 13.5px; font-weight: 700; color: #b91c1c;
  display: inline-flex; align-items: center; gap: 8px;
  padding: 9px 16px; border-radius: 50px;
  background: #fef2f2; border: 1px solid #fecaca;
  transition: all 0.2s; text-decoration: none;
}
.sec-link:hover {
  background: #b91c1c; color: #fff; border-color: #b91c1c;
  text-decoration: none; transform: translateX(3px);
}
.sec-link i { font-size: 11px; transition: transform 0.2s; }
.sec-link:hover i { transform: translateX(2px); }

/* CATEGORY GRID — all categories */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 14px;
}
.cat-card {
  background: #fff; border: 1px solid #e2e8f0;
  border-radius: 14px; padding: 20px 12px;
  text-align: center; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  text-decoration: none; display: flex; flex-direction: column;
  align-items: center; gap: 10px;
}
.cat-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 32px -12px rgba(185,28,28,0.2);
  border-color: #fca5a5; text-decoration: none;
}
.cat-icon {
  width: 52px; height: 52px; border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
  color: #b91c1c; font-size: 22px; transition: all 0.25s;
}
.cat-card:hover .cat-icon {
  background: linear-gradient(135deg, #b91c1c, #991b1b);
  color: #fff; transform: scale(1.08) rotate(-5deg);
}
.cat-name {
  font-size: 12.5px; font-weight: 700; color: #334155;
  line-height: 1.3; letter-spacing: -0.1px;
}

/* EXPERT SALLA SECTION */
.expert-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 14px;
  margin-bottom: 24px;
}
.expert-card {
  position: relative; background: #fff;
  border: 1px solid #e8ecf1; border-radius: 14px;
  padding: 18px 18px 16px; text-decoration: none;
  display: flex; flex-direction: column; gap: 12px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  box-shadow: 0 1px 2px rgba(15,23,42,0.03);
}
.expert-card:hover {
  transform: translateY(-4px);
  border-color: #fde68a;
  box-shadow: 0 20px 40px -16px rgba(15,23,42,0.12), 0 8px 16px -8px rgba(180,83,9,0.1);
  text-decoration: none;
}
.expert-accent { position: absolute; top: 0; left: 0; right: 0; height: 3px; }

.expert-top { display: flex; align-items: center; gap: 12px; padding-top: 4px; }
.expert-av {
  width: 44px; height: 44px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 18px; flex-shrink: 0;
  box-shadow: 0 6px 14px -6px rgba(15,23,42,0.25);
}
.expert-info { flex: 1; min-width: 0; }
.expert-name {
  font-size: 14.5px; font-weight: 800; color: #0f172a;
  margin: 0 0 3px; letter-spacing: -0.2px;
}
.expert-cat {
  font-size: 10.5px; font-weight: 700; color: #94a3b8;
  text-transform: uppercase; letter-spacing: 0.5px;
}
.expert-freq {
  padding: 3px 8px; border-radius: 6px;
  font-size: 9.5px; font-weight: 800;
  background: linear-gradient(135deg,#fffbeb,#fef3c7);
  border: 1px solid #fde68a;
  color: #b45309;
  text-transform: uppercase; letter-spacing: 0.4px;
  white-space: nowrap; flex-shrink: 0;
}
.expert-freq.free {
  background: linear-gradient(135deg,#d1fae5,#a7f3d0);
  color: #065f46; border-color: #6ee7b7;
}

.expert-sample {
  font-size: 12.5px; color: #475569; line-height: 1.5;
  font-style: italic; font-weight: 500;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
  padding: 10px 0 0;
  border-top: 1px dashed #e2e8f0;
  min-height: 46px;
}
.expert-foot {
  display: flex; justify-content: flex-end;
  padding-top: 10px; border-top: 1px solid #f1f5f9;
}
.expert-read {
  font-size: 12px; font-weight: 800; color: #b45309;
  display: inline-flex; align-items: center; gap: 5px;
  transition: gap 0.2s;
}
.expert-card:hover .expert-read { gap: 8px; }
.expert-read i { font-size: 10px; }

.expert-cta {
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  border-radius: 18px; padding: 24px 28px;
  position: relative; overflow: hidden;
}
.expert-cta::before {
  content: ''; position: absolute; top: -40%; right: -10%;
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(251,191,36,0.2), transparent 65%);
  border-radius: 50%;
}
.expert-cta-inner {
  display: flex; align-items: center; gap: 20px;
  position: relative; z-index: 2; flex-wrap: wrap;
}
.expert-cta-icon {
  width: 52px; height: 52px; border-radius: 14px;
  background: rgba(251,191,36,0.15);
  border: 1px solid rgba(251,191,36,0.3);
  display: flex; align-items: center; justify-content: center;
  color: #fbbf24; font-size: 20px; flex-shrink: 0;
}
.expert-cta-text { flex: 1; min-width: 200px; }
.expert-cta-text h3 {
  font-size: 17px; font-weight: 800; color: #fff;
  margin: 0 0 4px; letter-spacing: -0.2px;
}
.expert-cta-text p {
  font-size: 13px; color: rgba(255,255,255,0.75); margin: 0;
  line-height: 1.5;
}
.expert-cta-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 22px; border-radius: 10px;
  background: linear-gradient(135deg, #fbbf24, #d97706);
  color: #0f0a0a; font-weight: 800; font-size: 13px;
  text-decoration: none; transition: all 0.2s;
  box-shadow: 0 8px 20px -6px rgba(212,160,23,0.5);
  white-space: nowrap;
}
.expert-cta-btn:hover { transform: translateY(-2px); text-decoration: none; box-shadow: 0 12px 26px -6px rgba(212,160,23,0.6); }
.expert-cta-btn i { font-size: 11px; }

/* LOCATIONS — all */
.loc-chips { display: flex; flex-wrap: wrap; gap: 10px; }
.loc-chip {
  background: #fff; border: 1px solid #e2e8f0;
  padding: 10px 18px; border-radius: 50px;
  font-size: 13px; font-weight: 600; color: #334155;
  text-decoration: none; transition: all 0.2s;
  display: inline-flex; align-items: center; gap: 8px;
  box-shadow: 0 1px 2px rgba(15,23,42,0.03);
}
.loc-chip i { color: #b91c1c; font-size: 11px; transition: color 0.2s; }
.loc-chip:hover {
  background: #b91c1c; color: #fff; border-color: #b91c1c;
  text-decoration: none; transform: translateY(-2px);
  box-shadow: 0 8px 20px -8px rgba(185,28,28,0.4);
}
.loc-chip:hover i { color: #fde047; }

/* CTA */
.cta {
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #334155 100%);
  color: #fff; border-radius: 24px;
  padding: 56px 40px; text-align: center;
  position: relative; overflow: hidden;
}
.cta::before {
  content: ''; position: absolute; top: -40%; right: -10%;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(185,28,28,0.35), transparent 65%);
  border-radius: 50%;
}
.cta::after {
  content: ''; position: absolute; bottom: -40%; left: -10%;
  width: 350px; height: 350px;
  background: radial-gradient(circle, rgba(253,224,71,0.12), transparent 65%);
  border-radius: 50%;
}
.cta-icon {
  position: relative; z-index: 2;
