.sec-link-gold:hover {
  background: var(--gold-dark);
  border-color: var(--gold-dark);
  box-shadow: var(--shadow-gold);
}

/* ═══════ CATEGORIES — ALL VISIBLE ═══════ */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 10px;
}
.cat-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 16px 8px 12px;
  background: #fff;
  border: 1.5px solid var(--line-2);
  border-radius: 14px;
  text-decoration: none;
  transition: all 0.25s var(--tr-out);
  min-height: 92px;
  position: relative;
  overflow: hidden;
}
.cat-chip::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(185,28,28,0.03) 0%, transparent 60%);
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
}
.cat-chip:hover {
  transform: translateY(-4px);
  border-color: #fecaca;
  box-shadow: 0 16px 32px -16px rgba(185,28,28,0.22), 0 6px 14px -6px rgba(15,23,42,0.05);
  text-decoration: none;
}
.cat-chip:hover::before { opacity: 1; }
.cat-chip i {
  font-size: 20px;
  color: var(--brand);
  transition: all 0.25s var(--tr-out);
}
.cat-chip:hover i {
  transform: scale(1.15) rotate(-6deg);
  color: var(--brand-dark);
}
.cat-chip span {
  font-size: 11px;
  font-weight: 700;
  color: var(--ink-2);
  text-align: center;
  line-height: 1.15;
  letter-spacing: -0.1px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-word;
}

/* ═══════ EXPERT SALLA ═══════ */
.ex-featured {
  display: grid;
