/* ═══════ SECTIONS ═══════ */
.section { padding: 80px 0; }
.section:nth-child(even) { background: var(--paper); }
.section-expert { background: linear-gradient(180deg, #fefcf8 0%, #fff 100%) !important; }

.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 24px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}
.sec-head-left { max-width: 640px; }
.eyebrow {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--brand);
