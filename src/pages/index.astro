---
import BaseLayout from '../layouts/BaseLayout.astro';

const CDN = 'https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data';
const LOGO = 'https://blogger.googleusercontent.com/img/a/AVvXsEi2G0UUWPHL9444BBONEoAfhRp3pTKc3gSt0iNdnlZ6nPT6e0EuamQAiA7TIlfqBiuKXsb92v7s9HpUlNY0JTlhWUGorlwXkpdSs1A6dkQ6gM4r6Y58Ymgnm8XNBKzQMvfWrUVqtp5LOYUIoz45nN-HwpeVnIwtBNJgkWMtP2XtvwXacyLjtPYuBwAQxO0=s1600';

const iconMap = {
  'Food & Dining': 'fa-utensils','Grocery & Kirana': 'fa-cart-shopping','Health & Medical': 'fa-stethoscope',
  'Beauty & Personal Care': 'fa-spa','Fitness & Wellness': 'fa-dumbbell','Education & Learning': 'fa-graduation-cap',
  'Fashion & Apparel': 'fa-shirt','Jewelry & Gold': 'fa-gem','Electronics & Gadgets': 'fa-laptop',
  'Home & Interior': 'fa-couch','Automotive': 'fa-car','Domestic Services': 'fa-broom',
  'IT & Digital Services': 'fa-code','Logistics & Movers': 'fa-truck-fast','Hospitality & Travel': 'fa-plane',
  'Entertainment & Events': 'fa-film','Kids & Baby': 'fa-child','Books & Stationery': 'fa-book',
  'Gardening & Outdoor': 'fa-seedling','Pet Care': 'fa-paw','Real Estate & Property': 'fa-building',
  'Finance & Legal': 'fa-coins','Packaging & Printing': 'fa-print','Cafes & Quick Bites': 'fa-mug-hot',
  'Shopping & Retail': 'fa-bag-shopping','Communication & Internet': 'fa-wifi','Security Services': 'fa-shield-halved',
  'Alternative Medicine': 'fa-leaf','Photography & Video': 'fa-camera','Celebrations & Gifts': 'fa-gift',
  'Government Services': 'fa-landmark','Utilities': 'fa-bolt','Daily Use Services': 'fa-screwdriver-wrench',
  'Fitness Equipment': 'fa-person-running','Ayurveda & Wellness': 'fa-mortar-pestle','Coaches & Trainers': 'fa-chalkboard-user',
  'Interior & Exterior Design': 'fa-paint-roller','Consulting Services': 'fa-handshake','Specialty Stores': 'fa-store'
};

const shortNameMap = {
  'Food & Dining': 'Food','Grocery & Kirana': 'Grocery','Health & Medical': 'Health',
  'Beauty & Personal Care': 'Beauty','Fitness & Wellness': 'Fitness','Education & Learning': 'Edu',
  'Fashion & Apparel': 'Fashion','Jewelry & Gold': 'Jewelry','Electronics & Gadgets': 'Elec',
  'Home & Interior': 'Home','Automotive': 'Auto','Domestic Services': 'Domestic',
  'IT & Digital Services': 'IT','Logistics & Movers': 'Logistics','Hospitality & Travel': 'Travel',
  'Entertainment & Events': 'Events','Kids & Baby': 'Kids','Books & Stationery': 'Books',
  'Gardening & Outdoor': 'Garden','Pet Care': 'Pets','Real Estate & Property': 'Realty',
  'Finance & Legal': 'Finance','Packaging & Printing': 'Print','Cafes & Quick Bites': 'Cafes',
  'Shopping & Retail': 'Shop','Communication & Internet': 'Internet','Security Services': 'Security',
  'Alternative Medicine': 'Ayurved','Photography & Video': 'Photo','Celebrations & Gifts': 'Gifts',
  'Government Services': 'Govt','Utilities': 'Utility','Daily Use Services': 'Repair',
  'Fitness Equipment': 'Equip','Ayurveda & Wellness': 'AltMed','Coaches & Trainers': 'Coach',
  'Interior & Exterior Design': 'Design','Consulting Services': 'Consult','Specialty Stores': 'Store'
};

const experts = [
  { name: 'Dr. Saala', cat: 'Health & Medical', icon: 'fa-heart-pulse', grad: 'linear-gradient(135deg,#ef4444,#b91c1c)', sample: '5 early signs of diabetes you should not ignore', slug: 'dr-saala', readers: '8.4k' },
  { name: 'Arthik Saala', cat: 'Finance & Tax', icon: 'fa-coins', grad: 'linear-gradient(135deg,#10b981,#047857)', sample: 'How to save ₹46,800 tax this year (legally)', slug: 'arthik-saala', readers: '6.2k' },
  { name: 'Vastu Saala', cat: 'Vastu & Harmony', icon: 'fa-compass', grad: 'linear-gradient(135deg,#8b5cf6,#5b21b6)', sample: 'Kitchen direction: why it affects your relationships', slug: 'vastu-saala', readers: '5.1k' },
  { name: 'Fit Saala', cat: 'Fitness & Nutrition', icon: 'fa-dumbbell', grad: 'linear-gradient(135deg,#f97316,#c2410c)', sample: 'Lose 5 kg in 8 weeks — without giving up roti', slug: 'fit-saala', readers: '7.3k' },
  { name: 'Kanoon Saala', cat: 'Legal & Rights', icon: 'fa-scale-balanced', grad: 'linear-gradient(135deg,#334155,#0f172a)', sample: 'Rent agreement: 7 clauses you must check', slug: 'kanoon-saala', readers: '4.8k' },
  { name: 'Rashi Saala', cat: 'Astrology', icon: 'fa-star', grad: 'linear-gradient(135deg,#a855f7,#7c3aed)', sample: 'Your weekly rashi phal — career & health', slug: 'rashi-saala', readers: '9.1k' }
];

let categories = [];
let locations = [];

try {
  const catRes = await fetch(`${CDN}/categories.json`);
  const catData = await catRes.json();
  categories = (catData.categories || []).map(c => ({
    ...c,
    iconClass: iconMap[c.categoryName] || 'fa-folder',
    shortName: shortNameMap[c.categoryName] || (c.categoryName.length > 10 ? c.categoryName.substring(0, 8) + '…' : c.categoryName)
  }));
} catch (e) { console.error(e); }

try {
  const locRes = await fetch(`${CDN}/locations.json`);
  const locData = await locRes.json();
  locations = locData.locations || [];
} catch (e) { console.error(e); }
---

<BaseLayout title="Home" description="PCMC Diary — Find trusted local businesses in Pimpri-Chinchwad.">

  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero">
    <div class="hero-mesh"></div>
    <div class="hero-grid"></div>
    <div class="container hero-content">

      <!-- LOGO -->
      <div class="hero-logo-wrap">
        <img src={LOGO} alt="PCMC Diary" class="hero-logo" />
      </div>

      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <span>Trusted by 10,000+ locals in PCMC</span>
      </div>

      <h1 class="hero-title">
        The smarter way to discover<br>
        <span class="hero-accent">Pimpri-Chinchwad</span>
      </h1>

      <p class="hero-sub">
        Verified businesses, exclusive coupons &amp; expert advice — all in one place.
      </p>

      <form class="hero-search" action="/directory" method="get">
        <div class="hs-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
        <input type="search" name="q" placeholder="Search restaurants, gyms, doctors, CA…" />
        <button type="submit">
          Search
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <div class="hero-quick">
        <span class="hero-quick-label">Popular:</span>
        <a href="/category/CAT001">Food</a>
        <a href="/category/CAT005">Fitness</a>
        <a href="/category/CAT003">Doctors</a>
        <a href="/category/CAT004">Salons</a>
        <a href="/category/CAT002">Grocery</a>
      </div>
    </div>

    <div class="container">
      <div class="trust-strip">
        <div class="trust-item">
          <div class="trust-num">{categories.length}<span>+</span></div>
          <div class="trust-lbl">Categories</div>
        </div>
        <div class="trust-div"></div>
        <div class="trust-item">
          <div class="trust-num">{locations.length}</div>
          <div class="trust-lbl">Areas covered</div>
        </div>
        <div class="trust-div"></div>
        <div class="trust-item">
          <div class="trust-num">500<span>+</span></div>
          <div class="trust-lbl">Listed businesses</div>
        </div>
        <div class="trust-div"></div>
        <div class="trust-item">
          <div class="trust-num">21</div>
          <div class="trust-lbl">Expert columns</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ CATEGORIES (ALL) ═══════════ -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div class="sec-head-left">
          <span class="eyebrow">Explore</span>
          <h2 class="sec-title">Browse by category</h2>
          <p class="sec-sub">All {categories.length} categories across every corner of PCMC</p>
        </div>
        <a href="/directory" class="sec-link">
          Open directory
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <div class="cat-grid">
        {categories.map((cat) => (
          <a href={`/category/${cat.categoryId}`} class="cat-chip">
            <i class={`fa-solid ${cat.iconClass}`}></i>
            <span>{cat.shortName}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ EXPERT SALLA ═══════════ -->
  <section class="section section-expert">
    <div class="container">
      <div class="sec-head">
        <div class="sec-head-left">
          <span class="eyebrow eyebrow-gold">Editorial</span>
          <h2 class="sec-title">PCMC <em>Expert Salla</em></h2>
          <p class="sec-sub">Real advice from doctors, CAs, trainers, astrologers &amp; more</p>
        </div>
        <a href="/expert-salla" class="sec-link sec-link-gold">
          All experts
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <div class="ex-featured">
        <div class="ex-featured-left">
          <div class="ex-featured-pill">
            <i class="fa-solid fa-crown"></i>
            Column of the month
          </div>
          <h3 class="ex-featured-title">
            Dr. Saala — <em>Your weekly health companion</em>
          </h3>
          <p class="ex-featured-desc">
            Practical medical advice for PCMC families. Seasonal tips, home remedies, when to see a doctor &amp; how to read reports — in plain language.
          </p>
          <div class="ex-featured-meta">
            <span><i class="fa-solid fa-calendar"></i> Weekly</span>
            <span><i class="fa-solid fa-eye"></i> 8,400+ readers</span>
            <span><i class="fa-solid fa-user-doctor"></i> Verified MD</span>
          </div>
          <a href="/search/label/dr-saala" class="ex-featured-btn">
            <i class="fa-solid fa-book-open"></i>
            Read latest article
          </a>
        </div>
        <div class="ex-featured-right">
          <div class="ex-stat">
            <i class="fa-solid fa-users"></i>
            <div>
              <div class="ex-stat-num">21</div>
              <div class="ex-stat-lbl">Expert columns</div>
            </div>
          </div>
          <div class="ex-stat">
            <i class="fa-solid fa-newspaper"></i>
            <div>
              <div class="ex-stat-num">500+</div>
              <div class="ex-stat-lbl">Articles published</div>
            </div>
          </div>
          <div class="ex-stat">
            <i class="fa-solid fa-hand-holding-dollar"></i>
            <div>
              <div class="ex-stat-num">₹2,999</div>
              <div class="ex-stat-lbl">Sponsor / month</div>
            </div>
          </div>
        </div>
      </div>

      <div class="ex-grid">
        {experts.map(ex => (
          <a href={`/search/label/${ex.slug}`} class="ex-card">
            <div class="ex-card-av" style={`background:${ex.grad}`}>
              <i class={`fa-solid ${ex.icon}`}></i>
            </div>
            <div class="ex-card-body">
              <div class="ex-card-name">{ex.name}</div>
              <div class="ex-card-sample">"{ex.sample}"</div>
              <div class="ex-card-foot">
                <span class="ex-card-cat">{ex.cat}</span>
                <span class="ex-card-read">{ex.readers} <i class="fa-solid fa-arrow-right"></i></span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ REAL ESTATE PROMO ═══════════ -->
  <section class="section">
    <div class="container">
      <div class="re-promo">
        <div class="re-promo-glow-1"></div>
        <div class="re-promo-glow-2"></div>
        <div class="re-promo-inner">
          <div class="re-promo-left">
            <div class="re-promo-badge">
              <i class="fa-solid fa-building"></i>
              Real Estate Special
            </div>
            <h2 class="re-promo-title">List your <em>real estate project</em> on PCMC Diary</h2>
            <p class="re-promo-desc">Get high-intent property leads from thousands of PCMC buyers. Dedicated project pages, verified listings, and direct WhatsApp inquiries.</p>

            <div class="re-promo-stats">
              <div class="re-promo-stat">
                <div class="re-promo-stat-num">10k+</div>
                <div class="re-promo-stat-lbl">Monthly Readers</div>
              </div>
              <div class="re-promo-stat">
                <div class="re-promo-stat-num">₹10k</div>
                <div class="re-promo-stat-lbl">Starting At</div>
              </div>
              <div class="re-promo-stat">
                <div class="re-promo-stat-num">33</div>
                <div class="re-promo-stat-lbl">Areas Covered</div>
              </div>
            </div>

            <div class="re-promo-btns">
              <a href="/real-estate-special" class="re-promo-btn-primary">
                View Packages
                <i class="fa-solid fa-arrow-right"></i>
              </a>
              <a href="https://wa.me/918793932827?text=Hi, I want to list my real estate project" target="_blank" rel="noopener" class="re-promo-btn-outline">
                <i class="fa-brands fa-whatsapp"></i>
                Talk to Us
              </a>
            </div>
          </div>

          <div class="re-promo-right">
            <div class="re-promo-card">
              <div class="re-promo-card-icon"><i class="fa-solid fa-file-signature"></i></div>
              <div class="re-promo-card-body">
                <div class="re-promo-card-title">Dedicated Project Page</div>
                <div class="re-promo-card-desc">Complete project info with gallery, floor plans &amp; amenities.</div>
              </div>
            </div>
            <div class="re-promo-card">
              <div class="re-promo-card-icon"><i class="fa-solid fa-phone"></i></div>
              <div class="re-promo-card-body">
                <div class="re-promo-card-title">Direct Leads</div>
                <div class="re-promo-card-desc">WhatsApp button + contact form — buyers reach you instantly.</div>
              </div>
            </div>
            <div class="re-promo-card">
              <div class="re-promo-card-icon"><i class="fa-solid fa-chart-line"></i></div>
              <div class="re-promo-card-body">
                <div class="re-promo-card-title">Analytics Dashboard</div>
                <div class="re-promo-card-desc">Track views, clicks, and inquiries for your project.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ AREAS (ALL) ═══════════ -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div class="sec-head-left">
          <span class="eyebrow">Neighbourhoods</span>
          <h2 class="sec-title">Every area of PCMC</h2>
          <p class="sec-sub">{locations.length} areas from Hinjawadi to Chakan</p>
        </div>
        <a href="/directory" class="sec-link">
          Full directory
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <div class="loc-grid">
        {locations.map(loc => (
          <a href={`/location/${loc.locationId}`} class="loc-chip">
            <span class="loc-dot"></span>
            <span class="loc-name">{loc.locationName}</span>
            <i class="fa-solid fa-arrow-right loc-arrow"></i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ FINAL CTA ═══════════ -->
  <section class="section">
    <div class="container">
      <div class="final-cta">
        <div class="final-cta-glow-1"></div>
        <div class="final-cta-glow-2"></div>
        <div class="final-cta-inner">
          <div class="final-icon"><i class="fa-solid fa-store"></i></div>
          <h2>Own a business in PCMC?</h2>
          <p>Get discovered by thousands of local customers. Free listings available — upgrade anytime for premium visibility.</p>
          <div class="final-cta-btns">
            <a href="/register" class="btn-primary">
              <i class="fa-solid fa-circle-plus"></i>
              List your business — free
            </a>
            <a href="/plans" class="btn-outline">
              <i class="fa-solid fa-crown"></i>
              View plans
            </a>
          </div>
          <div class="final-cta-note">
            <i class="fa-solid fa-shield-halved"></i>
            No credit card required · Free forever plan
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

:root {
  --brand: #b91c1c;
  --brand-dark: #991b1b;
  --brand-bg: #fef2f2;
  --gold: #d97706;
  --gold-dark: #b45309;
  --gold-bg: #fffbeb;
  --ink: #0f172a;
  --ink-2: #1e293b;
  --ink-3: #334155;
  --slate: #475569;
  --muted: #64748b;
  --muted-2: #94a3b8;
  --line: #e2e8f0;
  --line-2: #f1f5f9;
  --paper: #fafbfc;
  --white: #ffffff;
  --font: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --shadow-sm: 0 1px 2px rgba(15,23,42,0.04);
  --shadow-md: 0 4px 12px -4px rgba(15,23,42,0.06), 0 2px 6px -2px rgba(15,23,42,0.04);
  --shadow-lg: 0 20px 40px -16px rgba(15,23,42,0.12), 0 8px 16px -8px rgba(15,23,42,0.06);
  --shadow-brand: 0 12px 32px -10px rgba(185,28,28,0.28);
  --shadow-gold: 0 12px 32px -10px rgba(217,119,6,0.28);
  --tr: cubic-bezier(0.4, 0, 0.2, 1);
  --tr-out: cubic-bezier(0.16, 1, 0.3, 1);
}

body { font-family: var(--font); -webkit-font-smoothing: antialiased; }
.container { max-width: 1180px; margin: 0 auto; padding: 0 24px; }

/* ═══════ HERO ═══════ */
.hero {
  position: relative;
  padding: 72px 0 0;
  background: #0a0a0a;
  overflow: hidden;
  overflow-x: clip;
  color: #fff;
  max-width: 100vw;
}
.hero-mesh {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 20% 0%, rgba(185,28,28,0.45), transparent 60%),
    radial-gradient(ellipse 60% 50% at 80% 30%, rgba(217,119,6,0.18), transparent 60%),
    radial-gradient(ellipse 100% 80% at 50% 100%, rgba(127,29,29,0.6), transparent 70%);
  pointer-events: none;
}
.hero-grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
  background-size: 64px 64px;
  mask-image: radial-gradient(ellipse 100% 70% at 50% 30%, #000 40%, transparent 85%);
  -webkit-mask-image: radial-gradient(ellipse 100% 70% at 50% 30%, #000 40%, transparent 85%);
  pointer-events: none;
}
.hero-content { position: relative; z-index: 2; text-align: center; max-width: 820px; margin-left: auto; margin-right: auto; }

/* ── LOGO ── */
.hero-logo-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 28px;
}
.hero-logo {
  height: 68px;
  width: auto;
  max-width: 260px;
  object-fit: contain;
  filter: drop-shadow(0 12px 32px rgba(0,0,0,0.5));
  background: rgba(255,255,255,0.98);
  padding: 12px 18px;
  border-radius: 18px;
  box-shadow:
    0 24px 60px -20px rgba(0,0,0,0.6),
    0 8px 24px -8px rgba(0,0,0,0.4),
    inset 0 1px 0 rgba(255,255,255,0.8);
}

.hero-badge {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 8px 18px; border-radius: 50px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  backdrop-filter: blur(16px);
  font-size: 12.5px; font-weight: 600;
  color: rgba(255,255,255,0.9);
  margin-bottom: 28px; letter-spacing: 0.2px;
}
.pulse-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 0 rgba(34,197,94,0.7);
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(34,197,94,0.6); }
  70% { box-shadow: 0 0 0 10px rgba(34,197,94,0); }
  100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
}

.hero-title {
  font-size: 60px;
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -2.2px;
  margin: 0 0 22px;
  color: #fff;
}
.hero-accent {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  font-style: italic;
  padding-right: 6px;
}

.hero-sub {
  font-size: 18px;
  color: rgba(255,255,255,0.72);
  max-width: 560px;
  margin: 0 auto 40px;
  line-height: 1.6;
  font-weight: 400;
}

.hero-search {
  display: flex;
  align-items: center;
  gap: 8px;
  max-width: 660px;
  margin: 0 auto 24px;
  padding: 8px 8px 8px 22px;
  background: rgba(255,255,255,0.98);
  border-radius: 18px;
  box-shadow:
    0 24px 60px -20px rgba(0,0,0,0.6),
    0 8px 24px -8px rgba(0,0,0,0.4),
    inset 0 1px 0 rgba(255,255,255,0.8);
  backdrop-filter: blur(24px);
}
.hs-icon { color: #94a3b8; font-size: 15px; flex-shrink: 0; }
.hero-search input {
  flex: 1;
  border: 0;
  padding: 14px 4px;
  font-size: 15.5px;
  font-family: inherit;
  font-weight: 500;
  color: var(--ink);
  background: transparent;
  outline: none;
  min-width: 0;
}
.hero-search input::placeholder { color: #94a3b8; font-weight: 400; }
.hero-search button {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 14px 26px;
  border: 0; border-radius: 12px;
  background: linear-gradient(135deg, #b91c1c, #7f1d1d);
  color: #fff;
  font-family: inherit;
  font-size: 14.5px; font-weight: 700;
  cursor: pointer;
  transition: all 0.2s var(--tr);
  box-shadow: 0 8px 20px -6px rgba(185,28,28,0.5);
  white-space: nowrap;
}
.hero-search button i { font-size: 12px; transition: transform 0.2s; }
.hero-search button:hover { transform: translateY(-1px); box-shadow: 0 12px 26px -6px rgba(185,28,28,0.6); }
