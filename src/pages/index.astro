---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFile } from 'node:fs/promises';
import path from 'node:path';

const DATA_DIR = path.resolve('./src/data');

const CAT_META = {
  'Food & Dining':              { icon: 'fa-utensils',           c1: '#ef4444', c2: '#be123c' },
  'Grocery & Kirana':           { icon: 'fa-cart-shopping',      c1: '#22c55e', c2: '#047857' },
  'Health & Medical':           { icon: 'fa-stethoscope',        c1: '#f43f5e', c2: '#be185d' },
  'Beauty & Personal Care':     { icon: 'fa-spa',                c1: '#ec4899', c2: '#a21caf' },
  'Fitness & Wellness':         { icon: 'fa-dumbbell',           c1: '#06b6d4', c2: '#1d4ed8' },
  'Education & Learning':       { icon: 'fa-graduation-cap',     c1: '#f59e0b', c2: '#c2410c' },
  'Fashion & Apparel':          { icon: 'fa-shirt',              c1: '#8b5cf6', c2: '#6d28d9' },
  'Jewelry & Gold':             { icon: 'fa-gem',                c1: '#eab308', c2: '#b45309' },
  'Electronics & Gadgets':      { icon: 'fa-laptop',             c1: '#3b82f6', c2: '#4338ca' },
  'Home & Interior':            { icon: 'fa-couch',              c1: '#f97316', c2: '#b91c1c' },
  'Automotive':                 { icon: 'fa-car',                c1: '#475569', c2: '#0f172a' },
  'Domestic Services':          { icon: 'fa-broom',              c1: '#6366f1', c2: '#1d4ed8' },
  'IT & Digital Services':      { icon: 'fa-code',               c1: '#0ea5e9', c2: '#1d4ed8' },
  'Logistics & Movers':         { icon: 'fa-truck-fast',         c1: '#f97316', c2: '#b45309' },
  'Hospitality & Travel':       { icon: 'fa-plane',              c1: '#06b6d4', c2: '#0f766e' },
  'Entertainment & Events':     { icon: 'fa-film',               c1: '#a855f7', c2: '#6d28d9' },
  'Kids & Baby':                { icon: 'fa-child',              c1: '#f472b6', c2: '#e11d48' },
  'Books & Stationery':         { icon: 'fa-book',               c1: '#f59e0b', c2: '#a16207' },
  'Gardening & Outdoor':        { icon: 'fa-seedling',           c1: '#84cc16', c2: '#15803d' },
  'Pet Care':                   { icon: 'fa-paw',                c1: '#fb923c', c2: '#d97706' },
  'Real Estate & Property':     { icon: 'fa-building',           c1: '#a855f7', c2: '#4338ca' },
  'Finance & Legal':            { icon: 'fa-coins',              c1: '#10b981', c2: '#15803d' },
  'Packaging & Printing':       { icon: 'fa-print',              c1: '#3b82f6', c2: '#0e7490' },
  'Cafes & Quick Bites':        { icon: 'fa-mug-hot',            c1: '#d97706', c2: '#b91c1c' },
  'Shopping & Retail':          { icon: 'fa-bag-shopping',       c1: '#ec4899', c2: '#b91c1c' },
  'Communication & Internet':   { icon: 'fa-wifi',               c1: '#0ea5e9', c2: '#4338ca' },
  'Security Services':          { icon: 'fa-shield-halved',      c1: '#475569', c2: '#1e3a8a' },
  'Alternative Medicine':       { icon: 'fa-leaf',               c1: '#22c55e', c2: '#047857' },
  'Photography & Video':        { icon: 'fa-camera',             c1: '#f43f5e', c2: '#be185d' },
  'Celebrations & Gifts':       { icon: 'fa-gift',               c1: '#ef4444', c2: '#be185d' },
  'Government Services':        { icon: 'fa-landmark',           c1: '#4f46e5', c2: '#1e3a8a' },
  'Utilities':                  { icon: 'fa-bolt',               c1: '#eab308', c2: '#ea580c' },
  'Daily Use Services':         { icon: 'fa-screwdriver-wrench', c1: '#f97316', c2: '#b91c1c' },
  'Fitness Equipment':          { icon: 'fa-person-running',     c1: '#06b6d4', c2: '#1d4ed8' },
  'Ayurveda & Wellness':        { icon: 'fa-mortar-pestle',      c1: '#10b981', c2: '#15803d' },
  'Coaches & Trainers':         { icon: 'fa-chalkboard-user',    c1: '#f59e0b', c2: '#c2410c' },
  'Interior & Exterior Design': { icon: 'fa-paint-roller',       c1: '#8b5cf6', c2: '#6d28d9' },
  'Consulting Services':        { icon: 'fa-handshake',          c1: '#3b82f6', c2: '#4338ca' },
  'Specialty Stores':           { icon: 'fa-store',              c1: '#ec4899', c2: '#be123c' },
};

let categories = [];
let locations = [];
let businesses = [];

try {
  categories = JSON.parse(await readFile(path.join(DATA_DIR, 'categories.json'), 'utf8')).categories || [];
} catch (e) { console.error(e); }

try {
  locations = JSON.parse(await readFile(path.join(DATA_DIR, 'locations.json'), 'utf8')).locations || [];
} catch (e) { console.error(e); }

try {
  const results = await Promise.all(categories.map(async (cat) => {
    try {
      const data = JSON.parse(await readFile(path.join(DATA_DIR, 'clients', cat.file), 'utf8'));
      return (Array.isArray(data) ? data : []).map(b => ({
        ...b,
        categoryId: cat.categoryId,
        categoryName: cat.categoryName
      }));
    } catch (e) { return []; }
  }));
  businesses = results.flat();
} catch (e) { console.error(e); }

const catsWithMeta = categories.map(c => {
  const meta = CAT_META[c.categoryName] || { icon: 'fa-folder', c1: '#64748b', c2: '#334155' };
  const count = businesses.filter(b => b.categoryId === c.categoryId).length;
  return { ...c, ...meta, count };
});

// ONLY featured / premium tiers for homepage
const PAID_TIERS = ['featured', 'premium_pro', 'premium', 'vp', 'vb'];
const paidBusinesses = businesses.filter(b => PAID_TIERS.includes((b.tier || '').toLowerCase()));
// Take up to 12 for rotation; if less than 4, fall back to all
const featured = paidBusinesses.length >= 4 ? paidBusinesses.slice(0, 12) : businesses.slice(0, 8);

const stats = {
  categories: categories.length,
  locations: locations.length,
  listings: businesses.length,
  featured: paidBusinesses.length
};
---

<BaseLayout title="PCMC Diary — Discover Pimpri-Chinchwad" description={`Find ${stats.listings}+ trusted businesses across ${stats.locations} PCMC areas.`}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "PCMC Diary",
    "url": "https://pcmcdiary.com",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://pcmcdiary.com/directory?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-orb hero-orb-3"></div>

    <div class="hero-inner">
      <div class="hero-eyebrow">
        <span class="pulse"></span>
        Trusted by locals across Pimpri-Chinchwad
      </div>

      <h1 class="hero-h1">
        Your Local Guide to<br>
        <span class="hero-accent">Pimpri-Chinchwad</span>
      </h1>

      <p class="hero-p">
        Discover {stats.listings}+ businesses across {stats.locations} areas. Restaurants, doctors, salons, services — all in one place.
      </p>

      <form class="hero-search" action="/directory" method="get">
        <i class="fa-solid fa-magnifying-glass hero-icon"></i>
        <input type="text" name="q" placeholder="Search restaurants, doctors, gyms…" />
        <button type="submit">
          Search <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <div class="hero-stats">
        <div class="stat">
          <div class="stat-num">{stats.categories}</div>
          <div class="stat-lbl">Categories</div>
        </div>
        <div class="stat-div"></div>
        <div class="stat">
          <div class="stat-num">{stats.locations}</div>
          <div class="stat-lbl">Areas</div>
        </div>
        <div class="stat-div"></div>
        <div class="stat">
          <div class="stat-num">{stats.listings}<span>+</span></div>
          <div class="stat-lbl">Listings</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED (rotating) -->
  {featured.length > 0 && (
    <section class="sec">
      <div class="sec-head">
        <div>
          <div class="sec-tag">Featured</div>
          <h2 class="sec-title">Top Businesses</h2>
        </div>
        <a href="/directory" class="sec-link">View All <i class="fa-solid fa-arrow-right"></i></a>
      </div>

      <div class="biz-grid" data-shuffle="true">
        {featured.map(b => {
          const name = b.businessName || 'Business';
          const initial = name.trim().charAt(0).toUpperCase();
          const rating = parseFloat(b.rating) || 0;
          const t = (b.tier || '').toLowerCase();
          const isFeatured = t === 'featured';
          const isPro = ['premium_pro','premium'].includes(t);
          const isVerified = ['featured','premium','premium_pro','vp','vb'].includes(t);
          const badgeText = isFeatured ? 'Featured' : (isPro ? 'Premium' : 'Verified');
          return (
            <article class="biz-card">
              <div class={`biz-ribbon ${isFeatured ? 'ribbon-gold' : (isPro ? 'ribbon-purple' : 'ribbon-green')}`}>
                <i class={`fa-solid ${isFeatured ? 'fa-star' : (isPro ? 'fa-crown' : 'fa-circle-check')}`}></i>
                {badgeText}
              </div>
              <div class="biz-head">
                <div class="biz-avatar">{initial}</div>
                <div class="biz-info">
                  <h3 class="biz-name"><a href={`/business/${b.businessId}`}>{name}</a></h3>
                  <div class="biz-sub">{b.subCategory || b.categoryName}</div>
                </div>
              </div>
              <div class="biz-meta">
                {b.location && (
                  <span class="meta-loc"><i class="fa-solid fa-location-dot"></i> {b.location}</span>
                )}
                {rating > 0 && (
                  <span class="meta-rating"><i class="fa-solid fa-star"></i> {rating.toFixed(1)}{parseInt(b.reviews) > 0 ? ` · ${b.reviews}` : ''}</span>
                )}
              </div>
              <p class="biz-desc">{b.description || `Local business serving ${b.location || 'PCMC'}`}</p>
              <a href={`/business/${b.businessId}`} class="biz-btn">
                View Profile <i class="fa-solid fa-arrow-right"></i>
              </a>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <!-- ALL CATEGORIES -->
  <section class="sec sec-alt">
    <div class="sec-head">
      <div>
        <div class="sec-tag">Browse</div>
        <h2 class="sec-title">All {stats.categories} Categories</h2>
      </div>
      <a href="/directory" class="sec-link">Full Directory <i class="fa-solid fa-arrow-right"></i></a>
    </div>

    <div class="cat-grid">
      {catsWithMeta.map(c => (
        <a href={`/category/${c.categoryId}`} class="cat-tile">
          <div class="cat-icon" style={`background: linear-gradient(135deg, ${c.c1}, ${c.c2});`}>
            <i class={`fa-solid ${c.icon}`}></i>
          </div>
          <div class="cat-name">{c.categoryName}</div>
          <div class="cat-count">{c.count}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- LOCATIONS -->
  <section class="sec">
    <div class="sec-head">
      <div>
        <div class="sec-tag">Areas</div>
        <h2 class="sec-title">Browse {stats.locations} Locations</h2>
      </div>
    </div>
    <div class="loc-grid">
      {locations.map(l => (
        <a href={`/location/${l.locationId}`} class="loc-tile">
          <i class="fa-solid fa-location-dot"></i>
          <span>{l.locationName}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="sec sec-alt">
    <div class="sec-head sec-head-center">
      <div>
        <div class="sec-tag">Simple</div>
        <h2 class="sec-title">How It Works</h2>
        <p class="sec-sub">A directory built for PCMC — by people who live here.</p>
      </div>
    </div>

    <div class="steps">
      <div class="step">
        <div class="step-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
        <div class="step-num">01</div>
        <h3 class="step-title">Search & Discover</h3>
        <p class="step-desc">Find any business by name, category, or area — across all {stats.locations} PCMC locations.</p>
      </div>
      <div class="step">
        <div class="step-icon"><i class="fa-solid fa-phone"></i></div>
        <div class="step-num">02</div>
        <h3 class="step-title">Connect Directly</h3>
        <p class="step-desc">Call, WhatsApp, or visit. Every listing shows real contact details — no middlemen.</p>
      </div>
      <div class="step">
        <div class="step-icon"><i class="fa-solid fa-ticket"></i></div>
        <div class="step-num">03</div>
        <h3 class="step-title">Grab Local Deals</h3>
        <p class="step-desc">Exclusive coupons from verified businesses. Save money on things you already need.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="sec">
    <div class="cta">
      <div class="cta-orb"></div>
      <div class="cta-inner">
        <div class="cta-badge"><i class="fa-solid fa-store"></i> For Business Owners</div>
        <h2 class="cta-h2">Get Your Business Listed</h2>
        <p class="cta-p">Join {stats.listings}+ businesses already on PCMC Diary. Free forever plan, upgrade anytime for premium placement.</p>
        <div class="cta-btns">
          <a href="/register" class="cta-btn-primary">
            <i class="fa-solid fa-plus"></i> List Business — Free
          </a>
          <a href="/plans" class="cta-btn-outline">
            <i class="fa-solid fa-crown"></i> View Plans
          </a>
        </div>
        <div class="cta-note">
          <i class="fa-solid fa-shield-halved"></i> No credit card · Cancel anytime
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var grid = document.querySelector('.biz-grid[data-shuffle="true"]');
      if (!grid) return;
      var cards = Array.prototype.slice.call(grid.children);
      if (cards.length < 2) return;
      for (var i = cards.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = cards[i]; cards[i] = cards[j]; cards[j] = t;
      }
      cards.forEach(function (c) { grid.appendChild(c); });
    });
  </script>

</BaseLayout>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

body { font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif; -webkit-font-smoothing: antialiased; }

/* HERO */
.hero {
  position: relative; overflow: hidden;
  background: radial-gradient(ellipse at top, #1a1f35 0%, #0a0f1e 55%, #0f0a1a 100%);
  color: #fff; padding: 96px 24px 80px;
}
.hero-orb { position: absolute; border-radius: 50%; filter: blur(100px); pointer-events: none; }
.hero-orb-1 { top: -180px; right: -120px; width: 520px; height: 520px; background: radial-gradient(circle, rgba(220,38,38,0.55), transparent 70%); }
.hero-orb-2 { bottom: -200px; left: -120px; width: 560px; height: 560px; background: radial-gradient(circle, rgba(217,119,6,0.35), transparent 70%); }
.hero-orb-3 { top: 40%; left: 40%; width: 400px; height: 400px; background: radial-gradient(circle, rgba(168,85,247,0.18), transparent 70%); }
.hero-inner { position: relative; z-index: 2; max-width: 860px; margin: 0 auto; text-align: center; }

.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 9px 20px; border-radius: 50px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.12);
  backdrop-filter: blur(12px);
  font-size: 12.5px; font-weight: 700;
  color: rgba(255,255,255,0.92);
  margin-bottom: 28px;
}
.pulse { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgba(34,197,94,0.7); animation: pulse 2s infinite; }
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(34,197,94,0.6); }
  70% { box-shadow: 0 0 0 10px rgba(34,197,94,0); }
  100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
}

.hero-h1 { font-size: 64px; font-weight: 800; letter-spacing: -2.6px; line-height: 1.02; margin: 0 0 24px; }
.hero-accent {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  font-style: italic; padding-right: 8px;
}
.hero-p { font-size: 17.5px; color: rgba(255,255,255,0.72); line-height: 1.6; margin: 0 auto 44px; max-width: 580px; }

.hero-search {
  display: flex; align-items: center; gap: 6px;
  max-width: 700px; margin: 0 auto 40px;
  padding: 8px 8px 8px 20px;
  background: rgba(255,255,255,0.98);
  border-radius: 20px;
  box-shadow: 0 28px 64px -20px rgba(0,0,0,0.65), 0 12px 28px -10px rgba(0,0,0,0.4);
  transition: all 0.3s;
}
.hero-search:focus-within { box-shadow: 0 28px 64px -20px rgba(0,0,0,0.65), 0 12px 28px -10px rgba(0,0,0,0.4), 0 0 0 4px rgba(220,38,38,0.18); }
.hero-icon { color: #94a3b8; font-size: 15px; padding-left: 4px; flex-shrink: 0; }
.hero-search input {
  flex: 1; border: 0; padding: 15px 6px;
  font-size: 15.5px; font-family: inherit; font-weight: 500;
  color: #0f172a; background: transparent; outline: none; min-width: 0;
}
.hero-search input::placeholder { color: #94a3b8; font-weight: 400; }
.hero-search button {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 14px 26px; border: 0; border-radius: 14px;
  background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
  color: #fff; font-family: inherit; font-size: 14.5px; font-weight: 800;
  cursor: pointer; transition: all 0.2s;
  box-shadow: 0 10px 24px -8px rgba(220,38,38,0.65);
  white-space: nowrap;
}
.hero-search button:hover { transform: translateY(-1px); box-shadow: 0 14px 30px -8px rgba(220,38,38,0.75); }
.hero-search button i { font-size: 12px; transition: transform 0.2s; }
.hero-search button:hover i { transform: translateX(3px); }

.hero-stats { display: flex; align-items: center; justify-content: center; gap: 32px; flex-wrap: wrap; }
.stat { text-align: center; min-width: 80px; }
.stat-num { font-size: 32px; font-weight: 800; color: #fff; letter-spacing: -1.2px; line-height: 1; }
.stat-num span { color: #fbbf24; }
.stat-lbl { font-size: 10.5px; text-transform: uppercase; letter-spacing: 1.6px; color: rgba(255,255,255,0.45); font-weight: 700; margin-top: 10px; }
.stat-div { width: 1px; height: 40px; background: rgba(255,255,255,0.12); }

/* SECTIONS */
.sec { max-width: 1280px; margin: 0 auto; padding: 76px 24px; }
.sec-alt { background: #f8fafc; border-radius: 32px; margin: 8px auto; max-width: 1280px; }
.sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 40px; flex-wrap: wrap; }
.sec-head-center { justify-content: center; text-align: center; flex-direction: column; align-items: center; }
.sec-tag { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.8px; color: #dc2626; margin-bottom: 8px; }
.sec-title { font-size: 36px; font-weight: 800; color: #0f172a; letter-spacing: -1px; line-height: 1.15; margin: 0; }
.sec-sub { font-size: 14.5px; color: #64748b; margin: 10px 0 0; line-height: 1.55; max-width: 500px; }
.sec-link {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 13.5px; font-weight: 700; color: #dc2626;
  text-decoration: none; padding: 10px 20px; border-radius: 40px;
  background: #fef2f2; border: 1px solid #fecaca;
  transition: all 0.2s;
}
.sec-link:hover { background: #dc2626; color: #fff; border-color: #dc2626; text-decoration: none; }
.sec-link i { font-size: 10px; transition: transform 0.2s; }
.sec-link:hover i { transform: translateX(3px); }

/* FEATURED BUSINESS CARDS */
.biz-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
.biz-card {
  display: flex; flex-direction: column;
  padding: 26px; background: #fff;
  border: 1.5px solid #eef1f6; border-radius: 20px;
  transition: all 0.28s cubic-bezier(0.22,1,0.36,1);
  position: relative; overflow: hidden;
}
.biz-card::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: 0;
  height: 3px;
  background: linear-gradient(90deg, #dc2626, #f59e0b);
  transform: scaleX(0); transform-origin: left;
  transition: transform 0.4s cubic-bezier(0.22,1,0.36,1);
}
.biz-card:hover::after { transform: scaleX(1); }
.biz-card:hover {
  transform: translateY(-5px);
  border-color: #fecaca;
  box-shadow: 0 24px 48px -20px rgba(15,23,42,0.15), 0 10px 20px -10px rgba(220,38,38,0.1);
}
.biz-ribbon {
  position: absolute; top: 0; right: 0;
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 14px 7px 12px;
  font-size: 10px; font-weight: 800; text-transform: uppercase;
  letter-spacing: 0.7px;
  border-bottom-left-radius: 14px;
}
.biz-ribbon i { font-size: 10px; }
.ribbon-gold { background: linear-gradient(135deg, #fef3c7, #fbbf24); color: #78350f; }
.ribbon-purple { background: linear-gradient(135deg, #f3e8ff, #c084fc); color: #581c87; }
.ribbon-green { background: linear-gradient(135deg, #d1fae5, #6ee7b7); color: #065f46; }

.biz-head { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; padding-right: 90px; }
.biz-avatar {
  width: 54px; height: 54px; border-radius: 15px;
  background: linear-gradient(135deg, #dc2626, #991b1b);
  color: #fff; font-weight: 800; font-size: 22px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10px 20px -8px rgba(220,38,38,0.5), inset 0 1px 0 rgba(255,255,255,0.15);
}
.biz-info { flex: 1; min-width: 0; }
.biz-name {
  font-size: 16.5px; font-weight: 800; color: #0f172a;
