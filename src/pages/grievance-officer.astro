---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Grievance Officer" description="Grievance officer contact details for PCMC Diary.">
  <div class="page">
    <div class="page-container">
      <div class="page-header">
        <div class="page-icon"><i class="fa-solid fa-gavel"></i></div>
        <h1>Grievance Officer</h1>
        <p class="page-sub"><i class="fa-regular fa-calendar"></i> Last updated: 12 September 2026</p>
      </div>
      <div class="page-body">
        <section>
          <p>In accordance with the Information Technology Act, 2000, and rules made thereunder, the details of the Grievance Officer for PCMC Diary are published below.</p>
        </section>

        <div class="officer-card">
          <div class="officer-avatar">
            <i class="fa-solid fa-user-tie"></i>
          </div>
          <div class="officer-details">
            <h2>Grievance Officer</h2>
            <div class="officer-row">
              <i class="fa-solid fa-envelope"></i>
              <a href="mailto:grievance@pcmcdiary.com">grievance@pcmcdiary.com</a>
            </div>
            <div class="officer-row">
              <i class="fa-solid fa-phone"></i>
              <a href="tel:+918793932827">+91 87939 32827</a>
            </div>
            <div class="officer-row">
              <i class="fa-solid fa-location-dot"></i>
              <span>Nigdi, Pimpri-Chinchwad, Maharashtra, India</span>
            </div>
          </div>
        </div>

        <section>
          <h2><i class="fa-solid fa-circle-info"></i> How to File a Grievance</h2>
          <p>If you have any complaint or grievance regarding content on PCMC Diary, please email us with:</p>
          <ul>
            <li>Your full name and contact details</li>
            <li>Description of the issue or content</li>
            <li>Relevant screenshots or links</li>
            <li>Your relationship to the matter (if applicable)</li>
          </ul>
        </section>

        <section>
          <h2><i class="fa-regular fa-clock"></i> Response Time</h2>
          <p>We acknowledge every grievance within <strong>48 hours</strong> and aim to resolve it within <strong>15 working days</strong> from receipt, as per applicable law.</p>
        </section>

        <section>
          <h2><i class="fa-solid fa-list-check"></i> What We Handle</h2>
          <ul>
            <li>Content removal requests</li>
            <li>Copyright / trademark complaints</li>
            <li>Incorrect or misleading business information</li>
            <li>Abuse or harassment reports</li>
            <li>Payment or refund disputes</li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
.page { background: #f8fafc; padding: 40px 20px 80px; min-height: 60vh; }
.page-container { max-width: 820px; margin: 0 auto; background: #fff; border-radius: 20px; padding: 48px 52px; box-shadow: 0 1px 3px rgba(15,23,42,0.04), 0 12px 32px -16px rgba(15,23,42,0.08); border: 1px solid #f1f5f9; }
.page-header { text-align: center; padding-bottom: 32px; margin-bottom: 32px; border-bottom: 1px solid #f1f5f9; }
.page-icon { width: 64px; height: 64px; margin: 0 auto 16px; background: linear-gradient(135deg, #7c3aed, #5b21b6); border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 26px; color: #fff; box-shadow: 0 12px 24px -8px rgba(124,58,237,0.4); }
.page-header h1 { font-size: 34px; font-weight: 800; color: #0f172a; letter-spacing: -0.8px; margin: 0 0 8px; line-height: 1.15; }
.page-sub { font-size: 13.5px; color: #64748b; margin: 0; font-weight: 600; display: inline-flex; align-items: center; gap: 7px; padding: 6px 14px; background: #f1f5f9; border-radius: 50px; }
.page-body section { margin-bottom: 28px; }
.page-body h2 { font-size: 18px; font-weight: 800; color: #0f172a; margin: 0 0 12px; letter-spacing: -0.3px; display: flex; align-items: center; gap: 10px; }
.page-body h2 i { color: #7c3aed; font-size: 15px; width: 20px; text-align: center; }
.page-body p { color: #334155; line-height: 1.75; font-size: 14.5px; margin: 0; }
.page-body strong { color: #0f172a; font-weight: 800; }
.page-body ul { list-style: none; padding: 0; margin: 12px 0 0; }
.page-body ul li { padding: 8px 14px 8px 36px; position: relative; color: #334155; line-height: 1.6; font-size: 14px; background: #f8fafc; border-radius: 8px; margin-bottom: 6px; }
.page-body ul li::before { content: '\f111'; font-family: 'Font Awesome 6 Free'; font-weight: 900; position: absolute; left: 16px; top: 11px; color: #7c3aed; font-size: 5px; }

.officer-card {
  display: flex;
  gap: 22px;
  align-items: center;
  padding: 24px;
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border: 1px solid #ddd6fe;
  border-radius: 16px;
  margin-bottom: 32px;
}
.officer-avatar {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed, #5b21b6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 12px 24px -8px rgba(124,58,237,0.5);
}
.officer-details { flex: 1; min-width: 0; }
.officer-details h2 { font-size: 20px !important; color: #5b21b6 !important; margin-bottom: 12px !important; }
.officer-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 0;
  font-size: 14px;
  color: #334155;
  font-weight: 600;
}
.officer-row i { color: #7c3aed; font-size: 13px; width: 18px; text-align: center; }
.officer-row a { color: #5b21b6; font-weight: 700; text-decoration: none; }
.officer-row a:hover { text-decoration: underline; }

@media (max-width: 640px) {
  .page { padding: 20px 12px 60px; }
  .page-container { padding: 32px 22px; border-radius: 16px; }
  .page-header h1 { font-size: 24px; }
  .page-icon { width: 54px; height: 54px; font-size: 22px; border-radius: 14px; }
  .page-body h2 { font-size: 16px; }
  .page-body p, .page-body ul li { font-size: 13.5px; }
  .officer-card { flex-direction: column; text-align: center; gap: 16px; padding: 20px; }
  .officer-details h2 { justify-content: center !important; }
  .officer-row { justify-content: center; }
}
</style>
