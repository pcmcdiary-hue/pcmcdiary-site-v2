---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const expertMeta = [
  { name: 'Dr. Saala', slug: 'dr-saala', icon: 'fa-user-doctor', color: '#dc2626', desc: 'Health, diabetes, heart, lifestyle' },
  { name: 'Arthik Saala', slug: 'arthik-saala', icon: 'fa-chart-line', color: '#059669', desc: 'Finance, tax, investment, savings' },
  { name: 'Vastu Saala', slug: 'vastu-saala', icon: 'fa-compass', color: '#7c3aed', desc: 'Vastu, home, office, remedies' },
  { name: 'Fit Saala', slug: 'fit-saala', icon: 'fa-dumbbell', color: '#ea580c', desc: 'Fitness, gym, weight loss, nutrition' },
  { name: 'Kanoon Saala', slug: 'kanoon-saala', icon: 'fa-scale-balanced', color: '#1d4ed8', desc: 'Legal, property, family, consumer' },
  { name: 'Rashi Saala', slug: 'rashi-saala', icon: 'fa-star', color: '#db2777', desc: 'Astrology, horoscope, rashi' },
  { name: 'Career Saala', slug: 'career-saala', icon: 'fa-briefcase', color: '#0891b2', desc: 'Jobs, skills, interview, growth' },
  { name: 'Beauty Saala', slug: 'beauty-saala', icon: 'fa-spa', color: '#e11d48', desc: 'Skin, hair, makeup, salon' },
  { name: 'Food Saala', slug: 'food-saala', icon: 'fa-utensils', color: '#d97706', desc: 'Recipes, restaurants, health food' },
  { name: 'Tech Saala', slug: 'tech-saala', icon: 'fa-microchip', color: '#4f46e5', desc: 'Mobile, apps, AI, gadgets' },
];

const grouped = {};
for (const article of articles) {
  const expert = article.data.expert;
  if (!grouped[expert]) grouped[expert] = [];
  grouped[expert].push(article);
}
---
<BaseLayout title="Expert Salla - PCMC Diary" description="PCMC ke experts se health, finance, vastu, fitness aur zyada jaankari. Har hafte naye articles.">
  <div class="expert-page">
    <div class="expert-hero">
      <div class="hero-badge"><i class="fa-solid fa-user-tie"></i> Expert Salla</div>
      <h1>PCMC Ke Experts Se Seekho</h1>
      <p>Health, paisa, vastu, fitness, kanoon — har topic pe trusted local experts ke articles.</p>
    </div>

    {expertMeta.map(expert => {
      const list = grouped[expert.name] || [];
      if (list.length === 0) return null;
      return (
        <section class="expert-section">
          <div class="section-head">
            <div class="head-left">
              <div class="expert-icon" style={`background:${expert.color}15; color:${expert.color}; border-color:${expert.color}30`}>
                <i class={`fa-solid ${expert.icon}`}></i>
              </div>
              <div>
                <h2>{expert.name}</h2>
                <p>{expert.desc}</p>
              </div>
            </div>
            <a href={`/search/label/${expert.slug}`} class="view-all">
              View all <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>

          <div class="article-grid">
            {list.slice(0, 3).map(article => (
              <a href={`/article/${article.slug}`} class="article-card">
                <div class="card-cat">{article.data.category}</div>
                <h3>{article.data.title}</h3>
                <p>{article.data.excerpt}</p>
                <div class="card-meta">
                  <span><i class="fa-solid fa-calendar"></i> {article.data.date}</span>
                  {article.data.readTime && <span><i class="fa-solid fa-clock"></i> {article.data.readTime}</span>}
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>

<style>
.expert-page { max-width: 1100px; margin: 0 auto; padding: 40px 24px 72px; }
.expert-hero { text-align: center; margin-bottom: 48px; }
.hero-badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; border-radius: 50px; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 16px; }
.expert-hero h1 { font-size: 42px; font-weight: 800; color: #0f172a; letter-spacing: -1.5px; margin: 0 0 12px; }
.expert-hero p { font-size: 16px; color: #64748b; max-width: 600px; margin: 0 auto; line-height: 1.6; }
.expert-section { margin-bottom: 48px; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
.head-left { display: flex; align-items: center; gap: 14px; }
.expert-icon { width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 20px; border: 1px solid; }
.head-left h2 { font-size: 22px; font-weight: 800; color: #0f172a; margin: 0 0 2px; letter-spacing: -0.4px; }
.head-left p { font-size: 13px; color: #64748b; margin: 0; }
.view-all { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 800; color: #dc2626; text-decoration: none; }
.view-all:hover { gap: 11px; }
.article-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.article-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 22px; text-decoration: none; transition: all 0.2s; display: flex; flex-direction: column; }
.article-card:hover { transform: translateY(-3px); box-shadow: 0 12px 24px -12px rgba(15,23,42,0.15); border-color: #cbd5e1; }
.card-cat { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; color: #dc2626; margin-bottom: 10px; }
.article-card h3 { font-size: 16px; font-weight: 800; color: #0f172a; line-height: 1.3; margin: 0 0 10px; letter-spacing: -0.3px; }
.article-card p { font-size: 13px; color: #64748b; line-height: 1.55; margin: 0 0 16px; flex: 1; }
.card-meta { display: flex; gap: 14px; font-size: 11.5px; color: #94a3b8; font-weight: 600; }
.card-meta i { color: #dc2626; font-size: 10px; margin-right: 4px; }
@media (max-width: 900px) { .article-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .expert-hero h1 { font-size: 30px; } .article-grid { grid-template-columns: 1fr; } .section-head { flex-direction: column; align-items: flex-start; } }
</style>
