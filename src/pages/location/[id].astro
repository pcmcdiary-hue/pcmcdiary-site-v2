---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const CDN_URL = 'https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data';
  const url = CDN_URL + '/locations.json';
  console.log('[DEBUG] Fetching locations: ' + url);
  const res = await fetch(url);
  console.log('[DEBUG] Locations status: ' + res.status);
  if (!res.ok) throw new Error('HTTP ' + res.status);
  const data = await res.json();
  const locs = data.locations || [];
  console.log('[DEBUG] Locations found: ' + locs.length);
  if (locs.length === 0) throw new Error('Locations empty');
  return locs.map(loc => ({
    params: { id: loc.locationId },
    props: { location: loc }
  }));
}

const { location } = Astro.props;

let businesses = [];
try {
  const catRes = await fetch('https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data/categories.json');
  const catData = await catRes.json();
  const cats = catData.categories || [];

  const results = await Promise.all(
    cats.map(async (cat) => {
      try {
        const res = await fetch('https://raw.githubusercontent.com/pcmcdiary-hue/pcmcdiary-data-v2/main/data/' + cat.file);
        const data = await res.json();
        return (Array.isArray(data) ? data : []).map(b => ({ ...b, categoryId: cat.categoryId }));
      } catch (e) { return []; }
    })
  );
  const all = results.flat();

  businesses = all.filter(b => {
    if ((b.location || '') === location.locationName) return true;
    const sa = (b.serviceArea || '').split(',').map(s => s.trim());
    return sa.includes(location.locationName);
  });
} catch (e) { businesses = []; }
---

<BaseLayout title={'Businesses in ' + location.locationName} description={'Find verified businesses in ' + location.locationName + ', Pimpri-Chinchwad.'}>
  <div class="loc-page">
    <section class="loc-hero">
      <div class="loc-container">
        <div class="hero-icon"><i class="fa-solid fa-location-dot"></i></div>
        <h1>Businesses in {location.locationName}</h1>
        <p>{businesses.length} verified businesses serving this area</p>
      </div>
    </section>
    <section class="loc-body">
      <div class="loc-container">
        <div id="bizGrid" class="biz-grid"></div>
      </div>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ businesses }}>
  const grid = document.getElementById('bizGrid');
  if (grid) {
    if (businesses.length === 0) {
      grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:60px;color:#64748b">No businesses yet</div>';
    } else {
      grid.innerHTML = businesses.map(b =>
        '<div style="padding:20px;background:#fff;border-radius:12px;border:1px solid #e2e8f0">' +
          '<h3 style="font-weight:800;margin:0 0 8px;color:#0f172a">' + (b.businessName || 'Business') + '</h3>' +
          '<p style="color:#64748b;font-size:13px;margin:0">' + (b.subCategory || '') + ' · ' + (b.location || '') + '</p>' +
        '</div>'
      ).join('');
    }
  }
</script>

<style is:global>
.loc-page { background: #f8fafc; min-height: 60vh; }
.loc-container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
.loc-hero {
  background: linear-gradient(135deg, #b91c1c, #7f1d1d);
  color: #fff; padding: 48px 0; text-align: center;
}
.hero-icon {
  width: 72px; height: 72px; margin: 0 auto 16px;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 20px;
  display: flex; align-items: center; justify-content: center;
  font-size: 30px; color: #fde047;
}
.loc-hero h1 { font-size: 36px; font-weight: 800; margin: 0 0 8px; letter-spacing: -1px; }
.loc-hero p { font-size: 14.5px; opacity: 0.85; margin: 0; }
.loc-body { padding: 40px 0 60px; }
.biz-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
@media (max-width: 768px) { .biz-grid { grid-template-columns: 1fr; } .loc-hero h1 { font-size: 26px; } }
</style>
