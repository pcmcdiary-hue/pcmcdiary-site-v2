---
import BaseLayout from '../layouts/BaseLayout.astro';

const quickLinks = [
  { href: '/', icon: 'fa-house', label: 'Home', desc: 'Back to homepage' },
  { href: '/directory', icon: 'fa-list', label: 'Directory', desc: 'Browse all businesses' },
  { href: '/coupons', icon: 'fa-ticket', label: 'Coupons', desc: 'Exclusive deals' },
  { href: '/expert-advice', icon: 'fa-user-tie', label: 'Expert Advice', desc: 'Expert advice' },
  { href: '/plans', icon: 'fa-crown', label: 'Pricing', desc: 'Plans & features' },
  { href: '/contact', icon: 'fa-envelope', label: 'Contact', desc: 'Get in touch' },
];
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist. Explore PCMC Diary instead.">

  <div class="nf-page">
    <div class="nf-wrap">

      <!-- 404 card -->
      <div class="nf-card">
        <div class="nf-bg"></div>

        <div class="nf-inner">
          <div class="nf-code">
            <span>4</span>
            <span class="nf-zero">
              <i class="fa-solid fa-compass"></i>
            </span>
            <span>4</span>
          </div>

          <div class="nf-badge">
            <i class="fa-solid fa-magnifying-glass"></i>
            Page not found
          </div>

          <h1>Looks like you took a wrong turn</h1>
          <p>The page you're looking for may have been moved, renamed, or never existed. Let's get you back on track.</p>

          <div class="nf-btns">
            <a href="/" class="nf-btn nf-btn-primary">
              <i class="fa-solid fa-house"></i>
              Back to Home
            </a>
            <a href="/directory" class="nf-btn nf-btn-outline">
              <i class="fa-solid fa-list"></i>
              Browse Directory
            </a>
          </div>
        </div>
      </div>

      <!-- Quick links -->
      <div class="nf-links">
        <div class="nf-links-head">
          <span class="nf-links-eyebrow">Quick Links</span>
          <h2>Popular pages</h2>
        </div>

        <div class="nf-links-grid">
          {quickLinks.map(l => (
            <a href={l.href} class="nf-link">
              <div class="nf-link-icon">
                <i class={`fa-solid ${l.icon}`}></i>
              </div>
              <div class="nf-link-body">
                <div class="nf-link-label">{l.label}</div>
                <div class="nf-link-desc">{l.desc}</div>
              </div>
              <i class="fa-solid fa-arrow-right nf-link-arrow"></i>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>

</BaseLayout>

<style is:global>
.nf-page {
  background: #f8fafc;
  min-height: 70vh;
  padding: 60px 0 80px;
}
.nf-wrap {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 20px;
}

/* CARD */
.nf-card {
  position: relative;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 24px;
  padding: 72px 40px;
  text-align: center;
  overflow: hidden;
  box-shadow: 0 24px 56px -28px rgba(15,23,42,0.15);
  margin-bottom: 40px;
}
.nf-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 50% at 20% 20%, rgba(185,28,28,0.06), transparent 60%),
    radial-gradient(ellipse 60% 50% at 80% 80%, rgba(217,119,6,0.06), transparent 60%);
  pointer-events: none;
}
.nf-inner { position: relative; z-index: 2; }

/* 404 */
.nf-code {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6px;
  font-size: 96px;
  font-weight: 800;
  letter-spacing: -6px;
  line-height: 1;
  margin-bottom: 24px;
  background: linear-gradient(135deg, #b91c1c 0%, #d97706 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.nf-zero {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 90px;
  height: 90px;
  border-radius: 50%;
  background: #fef2f2;
  border: 3px dashed #fca5a5;
  position: relative;
}
.nf-zero i {
  font-size: 42px;
  color: #b91c1c;
  -webkit-text-fill-color: #b91c1c;
  letter-spacing: 0;
  animation: nfSpin 8s linear infinite;
}
@keyframes nfSpin {
  to { transform: rotate(360deg); }
}

.nf-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 16px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 50px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #b91c1c;
  margin-bottom: 20px;
}
.nf-badge i { font-size: 11px; }

.nf-card h1 {
  font-size: 34px;
  font-weight: 800;
  letter-spacing: -0.8px;
  color: #0f172a;
  line-height: 1.2;
  margin: 0 0 14px;
}
.nf-card p {
  font-size: 15px;
  color: #64748b;
  line-height: 1.65;
  max-width: 520px;
  margin: 0 auto 28px;
  font-weight: 500;
}

.nf-btns {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}
.nf-btn {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 14px 26px;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 800;
  text-decoration: none;
  transition: all 0.2s;
  letter-spacing: -0.1px;
}
.nf-btn-primary {
  background: linear-gradient(135deg, #b91c1c, #991b1b);
  color: #fff;
  box-shadow: 0 12px 28px -8px rgba(185,28,28,0.5);
}
.nf-btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 16px 34px -8px rgba(185,28,28,0.6);
  text-decoration: none;
}
.nf-btn-outline {
  background: #f1f5f9;
  color: #0f172a;
  border: 1.5px solid #e2e8f0;
}
.nf-btn-outline:hover {
  background: #0f172a;
  color: #fff;
  border-color: #0f172a;
  text-decoration: none;
  transform: translateY(-2px);
}
.nf-btn i { font-size: 13px; }

/* LINKS */
.nf-links-head {
  text-align: center;
  margin-bottom: 24px;
}
.nf-links-eyebrow {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #b91c1c;
  padding: 5px 12px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 50px;
  margin-bottom: 10px;
}
.nf-links-head h2 {
  font-size: 24px;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.5px;
  margin: 0;
}

.nf-links-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 12px;
}
.nf-link {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 18px;
  background: #fff;
  border: 1.5px solid #e2e8f0;
  border-radius: 14px;
  text-decoration: none;
  transition: all 0.22s cubic-bezier(0.4,0,0.2,1);
}
.nf-link:hover {
  border-color: #fca5a5;
  transform: translateY(-3px);
  box-shadow: 0 16px 32px -16px rgba(185,28,28,0.2);
  text-decoration: none;
}
.nf-link-icon {
  width: 42px;
  height: 42px;
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
  color: #b91c1c;
  font-size: 17px;
  flex-shrink: 0;
  transition: all 0.22s;
}
.nf-link:hover .nf-link-icon {
  background: linear-gradient(135deg, #b91c1c, #991b1b);
  color: #fff;
  transform: scale(1.06) rotate(-4deg);
}
.nf-link-body { flex: 1; min-width: 0; }
.nf-link-label {
  font-size: 14px;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.2px;
  margin-bottom: 2px;
}
.nf-link-desc {
  font-size: 11.5px;
  color: #94a3b8;
  font-weight: 600;
}
.nf-link-arrow {
  font-size: 11px;
  color: #cbd5e1;
  transition: all 0.22s;
}
.nf-link:hover .nf-link-arrow {
  color: #b91c1c;
  transform: translateX(3px);
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .nf-page { padding: 32px 0 60px; }
  .nf-wrap { padding: 0 16px; }
  .nf-card { padding: 48px 24px; border-radius: 20px; margin-bottom: 32px; }
  .nf-code { font-size: 64px; letter-spacing: -4px; gap: 4px; margin-bottom: 20px; }
  .nf-zero { width: 62px; height: 62px; }
  .nf-zero i { font-size: 30px; }
  .nf-card h1 { font-size: 24px; letter-spacing: -0.5px; }
  .nf-card p { font-size: 13.5px; }
  .nf-btns { flex-direction: column; }
  .nf-btn { width: 100%; justify-content: center; }
  .nf-links-head h2 { font-size: 20px; }
  .nf-links-grid { grid-template-columns: 1fr; gap: 10px; }
  .nf-link { padding: 14px; }
  .nf-link-icon { width: 38px; height: 38px; font-size: 15px; }
}
</style>
