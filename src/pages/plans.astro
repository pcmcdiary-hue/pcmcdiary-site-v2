---
import BaseLayout from '../layouts/BaseLayout.astro';

const plans = [
  {
    id: 'free',
    name: 'Free',
    price: 0,
    period: 'forever',
    tagline: 'Get listed, get found',
    badge: null,
    gradient: 'linear-gradient(135deg,#94a3b8,#64748b)',
    features: [
      'Basic business listing',
      '1 location visibility',
      'Call button',
    ],
    cta: 'Start Free',
    ctaHref: '/register',
  },
  {
    id: 'starter',
    name: 'Starter',
    price: 1999,
    period: 'for 2 years',
    priceNote: 'Just ₹83 / month',
    tagline: 'Perfect for growing shops',
    badge: 'FOUNDING OFFER',
    gradient: 'linear-gradient(135deg,#fbbf24,#b45309)',
    features: [
      'Everything in Free',
      'All 33 locations',
      'Top 10 position',
      'Verified badge',
      'Customer rating display',
      'Review count display',
      'WhatsApp button',
      'Google Maps link',
      'Coupon / deal badge',
      'Timing display',
      { label: 'Customer Engagement Pack — Web App', highlight: true },
      { label: 'Easy Invoice Generator — Web App', highlight: true },
      { label: 'Apps worth ₹6,500 — FREE', value: true },
    ],
    cta: 'Choose Starter',
    ctaHref: '/register?plan=starter',
  },
  {
    id: 'standard',
    name: 'Standard',
    price: 3999,
    period: 'one-time + 1+1 yr membership',
    tagline: 'Digital Booster — social setup & content',
    badge: null,
    gradient: 'linear-gradient(135deg,#22d3ee,#0891b2)',
    features: [
      'Everything in Starter',
      'Facebook Page Setup',
      'Instagram Account Creation',
      'YouTube Channel Creation',
      'Pinterest Account Setup',
      '7 Creative Posts',
      '2 Promotional Videos',
      'Premium Membership — 1 + 1 Year',
    ],
    cta: 'Choose Standard',
    ctaHref: '/register?plan=standard',
  },
  {
    id: 'gold',
    name: 'Gold',
    price: 4999,
    period: 'one-time + 1+2 yr membership',
    tagline: 'Digital Booster + website & profile',
    badge: 'MOST POPULAR',
    featured: true,
    gradient: 'linear-gradient(135deg,#fbbf24,#d97706)',
    features: [
      'Everything in Standard',
      'Dedicated Webpage',
      'Company Website',
      'Company Profile',
      'Attractive Company Presentation',
      'Premium Membership — 1 + 2 Years',
    ],
    cta: 'Choose Gold',
    ctaHref: '/register?plan=gold',
  },
  {
    id: 'diamond',
    name: 'Diamond',
    price: 9999,
    period: 'one-time + 1+3 yr membership',
    tagline: 'Complete business booster',
    badge: null,
    gradient: 'linear-gradient(135deg,#60a5fa,#2563eb)',
    features: [
      'Everything in Gold',
      '20 Posters',
      '10 Videos',
      'Company Brochure',
      'Premium Membership — 1 + 3 Years',
    ],
    cta: 'Choose Diamond',
    ctaHref: '/register?plan=diamond',
  }
];

const comparison = [
  { feature: 'Business listing',   free: '✓', starter: '✓', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'Locations',          free: '1', starter: '33', standard: '33', gold: '33', diamond: '33' },
  { feature: 'Search position',    free: 'Bottom', starter: 'Top 10', standard: 'Top 10', gold: 'Top 10', diamond: 'Top 10' },
  { feature: 'Call button',        free: '✓', starter: '✓', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'Verified badge',     free: '—', starter: '✓', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'Customer rating',    free: '—', starter: '✓', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'Review count',       free: '—', starter: '✓', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'WhatsApp button',    free: '—', starter: '✓', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'Google Maps link',   free: '—', starter: '✓', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'Coupon / deal badge',free: '—', starter: '✓', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'Timing display',     free: '—', starter: '✓', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'Customer Engagement Pack', free: '—', starter: '✓ Web App', standard: '✓ Web App', gold: '✓ Web App', diamond: '✓ Web App' },
  { feature: 'Easy Invoice Generator',   free: '—', starter: '✓ Web App', standard: '✓ Web App', gold: '✓ Web App', diamond: '✓ Web App' },
  { feature: 'Web Apps value',     free: '—', starter: '₹6,500 FREE', standard: '₹6,500 FREE', gold: '₹6,500 FREE', diamond: '₹6,500 FREE' },
  { feature: 'Dedicated Webpage',  free: '—', starter: '—', standard: '—', gold: '✓', diamond: '✓' },
  { feature: 'Facebook Page Setup',free: '—', starter: '—', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'Instagram Account',  free: '—', starter: '—', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'YouTube Channel',    free: '—', starter: '—', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'Pinterest Setup',    free: '—', starter: '—', standard: '✓', gold: '✓', diamond: '✓' },
  { feature: 'Creative Posts',     free: '—', starter: '—', standard: '7', gold: '7', diamond: '20 Posters + 7 Posts' },
  { feature: 'Promotional Videos', free: '—', starter: '—', standard: '2', gold: '2', diamond: '10' },
  { feature: 'Company Website',    free: '—', starter: '—', standard: '—', gold: '✓', diamond: '✓' },
  { feature: 'Company Profile',    free: '—', starter: '—', standard: '—', gold: '✓', diamond: '✓' },
  { feature: 'Company Presentation', free: '—', starter: '—', standard: '—', gold: '✓', diamond: '✓' },
  { feature: 'Company Brochure',   free: '—', starter: '—', standard: '—', gold: '—', diamond: '✓' },
  { feature: 'Premium Membership', free: '—', starter: '2 Years', standard: '1 + 1 Year', gold: '1 + 2 Years', diamond: '1 + 3 Years' },
];

const faqs = [
  { q: 'How do I pay?', a: 'After registering, you will be redirected to our secure payment page. You can pay via UPI, QR code, or bank transfer.' },
  { q: 'What is the Founding Offer on Starter?', a: 'Starter is available at ₹1,999 for 2 years as a limited founding offer for early businesses on PCMC Diary. This works out to just ₹83 per month. Once the founding slots are filled, the price moves to the regular rate.' },
  { q: 'Can I upgrade later?', a: 'Yes, you can upgrade your plan anytime. The remaining value from your current plan will be adjusted against the new plan.' },
  { q: 'What if I have multiple locations?', a: 'Choose Starter, Standard, Gold, or Diamond — all cover all 33 locations of PCMC automatically.' },
  { q: 'What are the two web apps included in Starter?', a: 'Starter includes full access to our Customer Engagement Pack and Easy Invoice Generator — both web applications worth ₹6,500, completely free with your plan.' },
  { q: 'Is there a refund policy?', a: 'Yes, refunds are available within 7 days if your listing has not gone live. See our Refund Policy for details.' },
  { q: 'Do paid plans guarantee sales?', a: 'No. Paid plans increase visibility and features, but actual sales depend on your business, pricing, and service.' },
  { q: 'Can I add my own images?', a: 'Image support is coming soon. Currently, listings use auto-generated avatar icons based on your business name.' },
];
---

<BaseLayout title="Pricing & Plans" description="Choose the right plan for your business on PCMC Diary. Free, Starter, Digital Booster Standard, Gold & Diamond options.">

  <div class="pl-page">

    <!-- HERO -->
    <section class="pl-hero">
      <div class="pl-hero-bg"></div>
      <div class="pl-container">
        <nav class="breadcrumb">
          <a href="/"><i class="fa-solid fa-house"></i> Home</a>
          <i class="fa-solid fa-chevron-right sep"></i>
          <span>Plans</span>
        </nav>

        <div class="pl-hero-inner">
          <div class="pl-hero-badge">
            <i class="fa-solid fa-crown"></i>
            Founding Offer Live
          </div>
          <h1>Simple plans. <em>Serious reach.</em></h1>
          <p>Choose the plan that fits your business. Upgrade anytime. All prices in INR. Starter is available at a limited founding price — ₹1,999 for 2 years.</p>
        </div>
      </div>
    </section>

    <!-- PLANS GRID -->
    <section class="pl-body">
      <div class="pl-container">
        <div class="plans-grid">
          {plans.map(plan => (
            <div class={`plan-card ${plan.featured ? 'plan-featured' : ''}`}>
              {plan.badge && (
                <div class={`plan-badge ${
                  plan.featured ? 'plan-badge-popular'
                  : plan.badge === 'FOUNDING OFFER' ? 'plan-badge-founding'
                  : ''
                }`}>
                  {plan.badge}
                </div>
              )}

              <div class="plan-accent" style={`background:${plan.gradient}`}></div>

              <div class="plan-head">
                <div class="plan-av" style={`background:${plan.gradient}`}>
                  <i class={`fa-solid ${
                    plan.id === 'free' ? 'fa-seedling' :
                    plan.id === 'starter' ? 'fa-rocket' :
                    plan.id === 'standard' ? 'fa-bullhorn' :
                    plan.id === 'gold' ? 'fa-crown' :
                    plan.id === 'diamond' ? 'fa-gem' :
                    'fa-star'
                  }`}></i>
                </div>
                <div class="plan-name">{plan.name}</div>
                <div class="plan-tag">{plan.tagline}</div>
              </div>

              <div class="plan-price">
                {plan.price === 0 ? (
                  <div class="price-free">Free</div>
                ) : (
                  <>
                    <span class="price-cur">₹</span>
                    <span class="price-num">{plan.price.toLocaleString('en-IN')}</span>
                  </>
                )}
                <div class="price-period">{plan.period}</div>
              </div>

              {plan.priceNote && (
                <div class="price-note">
                  <i class="fa-solid fa-tag"></i>
                  {plan.priceNote}
                </div>
              )}

              <ul class="plan-features">
                {plan.features.map(f => {
                  const isObj = typeof f === 'object';
                  const label = isObj ? f.label : f;
                  const highlight = isObj && f.highlight;
                  const value = isObj && f.value;
                  return (
                    <li class={`${highlight ? 'feat-hl' : ''} ${value ? 'feat-value' : ''}`}>
                      <i class={`fa-solid ${value ? 'fa-star' : highlight ? 'fa-star' : 'fa-circle-check'}`}></i>
                      <span>{label}</span>
                    </li>
                  );
                })}
              </ul>

              <a href={plan.ctaHref} class={`plan-cta ${plan.featured ? 'plan-cta-primary' : ''}`}>
                {plan.cta}
                <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          ))}
        </div>

        <!-- Note -->
        <div class="pl-note">
          <i class="fa-solid fa-circle-info"></i>
          <span>Starter is a one-time payment for a 2-year membership. Standard, Gold, and Diamond include a one-time setup fee plus premium membership as described. GST applicable as per Indian regulations.</span>
        </div>
      </div>
    </section>

    <!-- COMPARISON TABLE -->
    <section class="pl-compare">
      <div class="pl-container">
        <div class="pl-sec-head">
          <span class="pl-eyebrow">Compare</span>
          <h2>Full feature comparison</h2>
          <p>See exactly what's included in every plan.</p>
        </div>

        <div class="compare-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th class="cmp-feature">Feature</th>
                <th>Free</th>
                <th>Starter<br><span>₹1,999 / 2 yrs</span></th>
                <th>Standard<br><span>₹3,999</span></th>
                <th class="cmp-popular">Gold<br><span>₹4,999</span></th>
                <th>Diamond<br><span>₹9,999</span></th>
              </tr>
            </thead>
            <tbody>
              {comparison.map(row => (
                <tr>
                  <td class="cmp-feature">{row.feature}</td>
                  <td>{row.free}</td>
                  <td>{row.starter}</td>
                  <td>{row.standard}</td>
                  <td class="cmp-popular">{row.gold}</td>
                  <td>{row.diamond}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pl-faq">
      <div class="pl-container">
        <div class="pl-sec-head">
          <span class="pl-eyebrow pl-eyebrow-gold">Questions</span>
          <h2>Frequently asked questions</h2>
        </div>

        <div class="faq-grid">
          {faqs.map(faq => (
            <div class="faq-card">
              <div class="faq-q">
                <i class="fa-solid fa-circle-question"></i>
                <span>{faq.q}</span>
              </div>
              <div class="faq-a">{faq.a}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="pl-final">
      <div class="pl-container">
        <div class="pl-cta">
          <div class="pl-cta-glow"></div>
          <div class="pl-cta-inner">
            <div class="pl-cta-icon"><i class="fa-solid fa-store"></i></div>
            <h2>Still deciding?</h2>
            <p>Talk to us on WhatsApp — we'll help you pick the right plan for your business.</p>
            <div class="pl-cta-btns">
              <a href="https://wa.me/918793932827" target="_blank" rel="noopener" class="pl-btn pl-btn-primary">
                <i class="fa-brands fa-whatsapp"></i>
                Chat on WhatsApp
              </a>
              <a href="/register" class="pl-btn pl-btn-outline">
                <i class="fa-solid fa-circle-plus"></i>
                List your business free
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>

</BaseLayout>

<style is:global>
.pl-page { background: #f8fafc; min-height: 60vh; }
.pl-container { max-width: 1180px; margin: 0 auto; padding: 0 24px; }

/* HERO */
.pl-hero {
  background: linear-gradient(135deg, #b91c1c 0%, #7f1d1d 60%, #450a0a 100%);
  color: #fff; padding: 40px 0 72px;
  position: relative; overflow: hidden;
}
.pl-hero-bg {
  position: absolute; inset: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(255,255,255,0.06) 1px, transparent 1px),
    radial-gradient(circle at 80% 70%, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 60px 60px, 80px 80px;
  opacity: 0.6; pointer-events: none;
}
.pl-hero .pl-container { position: relative; z-index: 2; }

.breadcrumb {
  display: flex; align-items: center; gap: 8px;
  font-size: 12.5px; color: rgba(255,255,255,0.7);
  margin-bottom: 24px; flex-wrap: wrap;
}
.breadcrumb a {
  color: rgba(255,255,255,0.85); text-decoration: none;
  font-weight: 600; display: inline-flex; align-items: center;
  gap: 6px; transition: color 0.2s;
}
.breadcrumb a:hover { color: #fde047; }
.breadcrumb a i { font-size: 11px; }
.breadcrumb .sep { font-size: 9px; opacity: 0.5; }
.breadcrumb span { color: #fde047; font-weight: 700; }

.pl-hero-inner { text-align: center; max-width: 720px; margin: 0 auto; }
.pl-hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 7px 16px; border-radius: 50px;
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.18);
  backdrop-filter: blur(10px);
  font-size: 11px; font-weight: 800;
  letter-spacing: 1.2px; text-transform: uppercase;
  color: #fde047; margin-bottom: 18px;
}
.pl-hero h1 {
  font-size: 48px; font-weight: 800;
  letter-spacing: -1.4px; line-height: 1.1;
  margin: 0 0 16px;
}
.pl-hero h1 em {
  font-style: italic;
  background: linear-gradient(135deg, #fde047, #fbbf24);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  padding-right: 6px;
}
.pl-hero p {
  font-size: 16px; color: rgba(255,255,255,0.85);
  line-height: 1.6; max-width: 620px; margin: 0 auto;
  font-weight: 500;
}

/* BODY */
.pl-body { padding: 0 0 72px; margin-top: -36px; position: relative; z-index: 3; }

.plans-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 20px;
  align-items: stretch;
}

/* PLAN CARD */
.plan-card {
  position: relative;
  display: flex; flex-direction: column;
  padding: 28px 24px 24px;
  background: #fff;
  border: 1.5px solid #e2e8f0;
  border-radius: 20px;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4px 12px -8px rgba(15,23,42,0.06);
}
.plan-card:hover {
  transform: translateY(-6px);
  border-color: #cbd5e1;
  box-shadow: 0 24px 48px -20px rgba(15,23,42,0.15), 0 8px 20px -8px rgba(15,23,42,0.06);
}

.plan-featured {
  border-color: #fbbf24;
  border-width: 2px;
  box-shadow: 0 20px 44px -20px rgba(217,119,6,0.3), 0 8px 20px -8px rgba(217,119,6,0.12);
}
.plan-featured:hover {
  box-shadow: 0 28px 56px -20px rgba(217,119,6,0.4), 0 12px 24px -8px rgba(217,119,6,0.18);
}

.plan-accent {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
}

.plan-badge {
  position: absolute;
  top: 16px; right: 16px;
  padding: 5px 11px;
  background: #f1f5f9;
  color: #475569;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  font-size: 9.5px;
  font-weight: 800;
  letter-spacing: 0.6px;
  text-transform: uppercase;
}
.plan-badge-popular {
  background: linear-gradient(135deg, #fef3c7, #fbbf24);
  color: #78350f;
  border-color: #fbbf24;
  box-shadow: 0 4px 12px -4px rgba(251,191,36,0.5);
}
.plan-badge-founding {
  background: linear-gradient(135deg, #d1fae5, #10b981);
  color: #064e3b;
  border-color: #10b981;
  box-shadow: 0 4px 12px -4px rgba(16,185,129,0.5);
}

.plan-head { margin-bottom: 20px; padding-top: 6px; }
.plan-av {
  width: 50px; height: 50px;
  border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 20px;
  margin-bottom: 14px;
  box-shadow: 0 8px 20px -8px rgba(15,23,42,0.25), inset 0 1px 0 rgba(255,255,255,0.2);
}
.plan-name {
  font-size: 20px; font-weight: 800;
  color: #0f172a; letter-spacing: -0.5px;
  margin-bottom: 4px;
}
.plan-tag {
  font-size: 12.5px; color: #64748b;
  font-weight: 600; line-height: 1.45;
}

/* PRICE BLOCK — consistent height across all cards */
.plan-price {
  display: flex;
  align-items: baseline;
  gap: 4px;
  flex-wrap: wrap;
  min-height: 54px;
  padding: 18px 0 0;
  border-top: 1px solid #f1f5f9;
}
.price-free {
  font-size: 34px;
  font-weight: 800;
  letter-spacing: -1.2px;
  background: linear-gradient(135deg, #059669, #047857);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.price-cur {
  font-size: 20px;
  font-weight: 700;
  color: #334155;
  align-self: flex-start;
  margin-top: 6px;
}
.price-num {
  font-size: 38px;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -1.4px;
  line-height: 1;
}
.price-period {
  font-size: 12px;
  color: #94a3b8;
  font-weight: 600;
  margin-left: auto;
  align-self: center;
  text-align: right;
}

/* Fixed-height note slot so all cards align */
.price-note {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin: 8px 0 4px;
  padding: 5px 10px;
  background: #ecfdf5;
  color: #047857;
  border: 1px dashed #6ee7b7;
  border-radius: 8px;
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: -0.1px;
  min-height: 26px;
  visibility: visible;
}
.price-note i { font-size: 10px; }

/* Reserve the space even when a card has no note */
.plan-card .price-note-empty {
  margin: 8px 0 4px;
  min-height: 26px;
}

.plan-features {
  list-style: none;
  padding: 0;
  margin: 8px 0 22px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.plan-features li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 13px;
  line-height: 1.5;
  font-weight: 600;
  color: #334155;
}
.plan-features li i {
  font-size: 13px;
  margin-top: 2px;
  flex-shrink: 0;
  color: #16a34a;
}

/* Highlighted feature rows (web apps) */
.feat-hl {
  padding: 8px 10px 8px 8px;
  margin: 0 -10px 0 -8px;
  border-radius: 10px;
  background: linear-gradient(90deg, #ecfeff, #f0fdfa);
  border: 1px dashed #67e8f9;
}
.feat-hl i { color: #0891b2 !important; }
.feat-hl span { color: #0e7490; }

/* Value badge row */
.feat-value {
  padding: 10px 12px;
  margin: 2px -10px 0 -8px;
  border-radius: 10px;
  background: linear-gradient(135deg, #059669, #047857);
  font-weight: 800;
  letter-spacing: -0.1px;
  box-shadow: 0 8px 18px -8px rgba(5,150,105,0.7);
}
.feat-value i { color: #fde047 !important; }
.feat-value span { color: #fff; }

.plan-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: auto;
  padding: 13px 20px;
  background: #f1f5f9;
  color: #0f172a;
  border: 1.5px solid #e2e8f0;
  border-radius: 11px;
  font-size: 13.5px;
  font-weight: 800;
  text-decoration: none;
  transition: all 0.2s;
  letter-spacing: -0.1px;
}
.plan-cta i { font-size: 11px; transition: transform 0.2s; }
.plan-cta:hover {
  background: #0f172a;
  color: #fff;
  border-color: #0f172a;
  text-decoration: none;
  transform: translateY(-1px);
  box-shadow: 0 12px 24px -8px rgba(15,23,42,0.3);
}
.plan-cta:hover i { transform: translateX(3px); }

.plan-cta-primary {
  background: linear-gradient(135deg, #b91c1c, #991b1b);
  color: #fff;
