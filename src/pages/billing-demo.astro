</div>

<script is:inline>
(function(){
  var root = document.getElementById('pcmd-billing-demo');
  if (!root) return;
  var $ = function(id){ return document.getElementById(id); };

  var RS = '\u20B9';
  var EM = '\u2014';
  var BL = '\u2022';

  var items = [];
  var docType = 'invoice';
  var gstOn = false;

  var SAMPLE_ITEMS = [
    { service: 'Business Directory Listing ' + EM + ' PCMC', schedule: 'Yearly', qty: 1, rate: 1500 },
    { service: 'Featured Placement ' + EM + ' Homepage', schedule: 'Monthly', qty: 1, rate: 800 },
    { service: 'WhatsApp Lead Alerts', schedule: 'Monthly', qty: 3, rate: 200 }
  ];

  function money(n){
    return RS + Math.abs(Number(n) || 0).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2});
  }
  function esc(s){
    return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function todayStr(){
    var d = new Date();
    var m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return String(d.getDate()).padStart(2,'0') + '-' + m[d.getMonth()] + '-' + d.getFullYear();
  }
  function addDaysStr(days){
    var d = new Date();
    d.setDate(d.getDate() + days);
    var m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return String(d.getDate()).padStart(2,'0') + '-' + m[d.getMonth()] + '-' + d.getFullYear();
  }

  function renderItems(){
    var tb = $('demo-items-body');
    tb.innerHTML = '';
    items.forEach(function(it, i){
      var tr = document.createElement('tr');
      tr.style.borderBottom = '1px solid #f1f5f9';
      if (i % 2 === 1) tr.style.background = '#f8fafc';

      tr.innerHTML =
        '<td style="padding:14px 6px; text-align:center; font-weight:700; color:#2c7fb8; font-size:0.9rem;">' + (i+1) + '</td>' +
        '<td style="padding:14px 14px;"><input type="text" data-i="' + i + '" data-f="service" value="' + esc(it.service) + '" placeholder="Service description" style="border:none; background:transparent; width:100%; font-size:0.88rem; font-family:inherit; color:#0f172a; font-weight:500; padding:4px 0; outline:none;"></td>' +
        '<td style="padding:14px 8px; text-align:center;"><select data-i="' + i + '" data-f="schedule" style="border:none; background:transparent; font-size:0.85rem; font-family:inherit; color:#0f172a; font-weight:500; text-align:center; cursor:pointer; outline:none; padding:4px 0; width:100%;">' +
          ['One-time','Monthly','Quarterly','Half-Yearly','Yearly','AMC'].map(function(s){ return '<option value="'+s+'"'+(s===it.schedule?' selected':'')+'>'+s+'</option>'; }).join('') +
        '</select></td>' +
        '<td style="padding:14px 8px; text-align:right;"><input type="number" min="0" data-i="' + i + '" data-f="qty" value="' + it.qty + '" style="border:none; background:transparent; width:100%; font-size:0.88rem; font-family:inherit; color:#0f172a; font-weight:600; text-align:right; padding:4px 0; outline:none;"></td>' +
        '<td style="padding:14px 8px; text-align:right;"><input type="number" min="0" data-i="' + i + '" data-f="rate" value="' + it.rate + '" style="border:none; background:transparent; width:100%; font-size:0.88rem; font-family:inherit; color:#0f172a; font-weight:600; text-align:right; padding:4px 0; outline:none;"></td>' +
        '<td style="padding:14px 8px; text-align:right; font-weight:700; color:#0f172a; font-size:0.88rem;">' + money(it.qty * it.rate) + '</td>' +
        '<td class="demo-act-cell demo-no-print" style="padding:12px 4px; text-align:center;">' +
          '<button class="demo-row-del" data-i="' + i + '" title="Remove" style="width:24px; height:24px; border-radius:50%; border:1px solid #e2e8f0; background:#f1f5f9; color:#64748b; font-size:0.7rem; font-weight:700; cursor:pointer; font-family:inherit; vertical-align:middle;">&#10005;</button>' +
        '</td>';
      tb.appendChild(tr);
    });
    recalc();
  }

  function recalc(){
    var sub = 0;
    items.forEach(function(it){ sub += (Number(it.qty) || 0) * (Number(it.rate) || 0); });
    var tax = gstOn ? sub * 0.18 : 0;
    var total = Math.round(sub + tax);
    $('demo-subtotal').textContent = money(sub);
    $('demo-tax').textContent = money(tax);
    $('demo-total').textContent = money(total);
    $('demo-tax-row').style.display = gstOn ? 'flex' : 'none';
    $('demo-gst-note').style.display = gstOn ? '' : 'none';
  }

  $('demo-items-body').addEventListener('input', function(e){
    var t = e.target;
    if (!t.dataset || !t.dataset.f) return;
    var i = +t.dataset.i;
    var f = t.dataset.f;
    items[i][f] = t.value;
    if (f === 'qty' || f === 'rate') {
      var cell = t.closest('tr').querySelector('td:nth-child(6)');
      if (cell) cell.textContent = money(items[i].qty * items[i].rate);
    }
    recalc();
  });

  $('demo-items-body').addEventListener('change', function(e){
    var t = e.target;
    if (!t.dataset || !t.dataset.f) return;
    items[+t.dataset.i][t.dataset.f] = t.value;
  });

  $('demo-items-body').addEventListener('click', function(e){
    var btn = e.target.closest('button');
    if (!btn) return;
    var i = +btn.dataset.i;
    if (btn.classList.contains('demo-row-del')){
      if (items.length <= 1) { alert('At least one line required'); return; }
      items.splice(i, 1);
    }
    renderItems();
  });

  function addRow() {
    items.push({ service:'', schedule:'One-time', qty:1, rate:0 });
    renderItems();
  }
  $('demo-add-row').addEventListener('click', addRow);
  $('demo-add-row2').addEventListener('click', addRow);

  var titles = { invoice:'INVOICE', proforma:'PROFORMA', quotation:'QUOTATION', proposal:'PROPOSAL' };
  var showValidFor = { quotation:true, proposal:true };

  document.querySelectorAll('.demo-doc-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.demo-doc-btn').forEach(function(b){
        b.style.background = 'transparent';
        b.style.color = '#475569';
        b.style.fontWeight = '500';
        b.classList.remove('active');
      });
      btn.style.background = '#1e3a5f';
      btn.style.color = '#fff';
      btn.style.fontWeight = '600';
      btn.classList.add('active');

      docType = btn.dataset.doc;
      $('demo-doc-title').textContent = titles[docType];

      if (showValidFor[docType]){
        $('demo-valid-row').style.display = 'flex';
        $('demo-valid').textContent = addDaysStr(30);
      } else {
        $('demo-valid-row').style.display = 'none';
      }
    });
  });

  function setGst(on){
    gstOn = on;
    $('demo-gst-on').style.background = on ? '#1e3a5f' : 'transparent';
    $('demo-gst-on').style.color = on ? '#fff' : '#475569';
    $('demo-gst-on').style.fontWeight = on ? '600' : '500';
    $('demo-gst-off').style.background = !on ? '#1e3a5f' : 'transparent';
    $('demo-gst-off').style.color = !on ? '#fff' : '#475569';
    $('demo-gst-off').style.fontWeight = !on ? '600' : '500';
    recalc();
  }
  $('demo-gst-on').addEventListener('click', function(){ setGst(true); });
  $('demo-gst-off').addEventListener('click', function(){ setGst(false); });

  $('demo-print').addEventListener('click', function(){
    var actCells = document.querySelectorAll('.demo-act-cell, .demo-act-head');
    var toolbar = document.querySelector('.demo-toolbar');
    actCells.forEach(function(c){ c.dataset.prev = c.style.display; c.style.display = 'none'; });
    if (toolbar) toolbar.style.display = 'none';
    window.print();
    setTimeout(function(){
      actCells.forEach(function(c){ c.style.display = c.dataset.prev || ''; });
      if (toolbar) toolbar.style.display = '';
    }, 500);
  });

  function openModal(){
    var m = document.createElement('div');
    m.style.cssText = 'position:fixed; inset:0; background:rgba(15,23,42,0.55); backdrop-filter:blur(6px); display:flex; align-items:center; justify-content:center; z-index:99999; padding:20px;';
    m.innerHTML =
      '<div style="background:#fff; border-radius:20px; padding:34px 30px 22px; max-width:400px; width:100%; text-align:center; box-shadow:0 30px 80px -20px rgba(15,23,42,0.4); font-family:inherit;">' +
        '<div style="font-size:1.15rem; font-weight:700; color:#0f172a; margin-bottom:4px;">Download Document</div>' +
        '<div style="font-size:0.82rem; color:#64748b; margin-bottom:20px;">Choose a format</div>' +
        '<button id="demo-dl-png" style="display:flex; align-items:center; gap:14px; width:100%; background:#fff; border:1px solid #e5e7eb; border-radius:14px; padding:15px 18px; margin-bottom:10px; text-align:left; cursor:pointer; font-family:inherit;">' +
          '<div style="width:44px; height:44px; background:#f8fafc; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.2rem;">&#128247;</div>' +
          '<div><div style="font-size:0.9rem; font-weight:600; color:#0f172a;">PNG Image</div><div style="font-size:0.72rem; color:#94a3b8;">Best for WhatsApp</div></div>' +
        '</button>' +
        '<button id="demo-dl-pdf" style="display:flex; align-items:center; gap:14px; width:100%; background:#fff; border:1px solid #e5e7eb; border-radius:14px; padding:15px 18px; margin-bottom:10px; text-align:left; cursor:pointer; font-family:inherit;">' +
          '<div style="width:44px; height:44px; background:#f8fafc; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.2rem;">&#128196;</div>' +
          '<div><div style="font-size:0.9rem; font-weight:600; color:#0f172a;">PDF Document</div><div style="font-size:0.72rem; color:#94a3b8;">Best for email & printing</div></div>' +
        '</button>' +
        '<button id="demo-dl-cancel" style="background:transparent; border:none; color:#94a3b8; font-size:0.82rem; font-weight:500; padding:10px; width:100%; cursor:pointer; font-family:inherit;">Cancel</button>' +
      '</div>';

    document.body.appendChild(m);
    m.addEventListener('click', function(e){ if (e.target === m) m.remove(); });
    document.getElementById('demo-dl-cancel').addEventListener('click', function(){ m.remove(); });
    document.getElementById('demo-dl-png').addEventListener('click', function(){ m.remove(); downloadAs('png'); });
    document.getElementById('demo-dl-pdf').addEventListener('click', function(){ m.remove(); downloadAs('pdf'); });
  }

  $('demo-download').addEventListener('click', openModal);

  async function downloadAs(format) {
    var doc = $('demo-doc');
    var actCells = document.querySelectorAll('.demo-act-cell, .demo-act-head');
    actCells.forEach(function(c){ c.style.display = 'none'; });

    try {
      if (document.fonts && document.fonts.ready) { try { await document.fonts.ready; } catch(e){} }
      await new Promise(function(r){ setTimeout(r, 100); });

      var W = Math.round(doc.getBoundingClientRect().width);
      var H = Math.round(doc.scrollHeight);

      var canvas = await html2canvas(doc, {
        scale: 2, backgroundColor: '#ffffff', useCORS: true, allowTaint: false, logging: false,
        width: W, height: H, windowWidth: W, windowHeight: H, scrollX: 0, scrollY: 0, x: 0, y: 0
      });

      var PAD = 60;
      var padded = document.createElement('canvas');
      padded.width = canvas.width + PAD * 2;
      padded.height = canvas.height + PAD * 2;
      var ctx = padded.getContext('2d');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, padded.width, padded.height);
      ctx.drawImage(canvas, PAD, PAD);

      var filename = 'pcmc-diary-' + docType + '-' + new Date().toISOString().slice(0,10);

      if (format === 'png') {
        await new Promise(function(resolve){
          padded.toBlob(function(blob){
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.download = filename + '.png';
            link.href = url;
            link.click();
            setTimeout(function(){ URL.revokeObjectURL(url); }, 3000);
            resolve();
          }, 'image/png', 1.0);
        });
      } else {
        var jsPDF = window.jspdf.jsPDF;
        var pdf = new jsPDF({ orientation:'portrait', unit:'mm', format:'a4', compress:true });
        var pageW = pdf.internal.pageSize.getWidth();
        var pageH = pdf.internal.pageSize.getHeight();
        var imgData = padded.toDataURL('image/jpeg', 0.95);
        var imgRatio = padded.height / padded.width;
        var imgW = pageW;
        var imgH = imgW * imgRatio;
        if (imgH <= pageH) {
          pdf.addImage(imgData, 'JPEG', 0, 0, imgW, imgH);
        } else {
          var remaining = imgH, y = 0;
          while (remaining > 0) {
            pdf.addImage(imgData, 'JPEG', 0, y, imgW, imgH);
            remaining -= pageH;
            if (remaining > 0) { pdf.addPage(); y = -(imgH - remaining); }
          }
        }
        pdf.save(filename + '.pdf');
      }
    } catch(err) {
      alert('Download failed: ' + err.message);
    } finally {
      actCells.forEach(function(c){ c.style.display = ''; });
    }
  }

  $('demo-date').textContent = todayStr();
  items = SAMPLE_ITEMS.slice();
  renderItems();
  setGst(false);

})();
</script>

</body>
</html>
