<BaseLayout title="Register Your Business" description="List your business on PCMC Diary — free registration for local businesses in Pimpri-Chinchwad.">

  <div class="rg-page">
    <div class="rg-wrap">

      <!-- Hero -->
      <div class="rg-hero">
        <div class="rg-hero-bg"></div>
        <div class="rg-hero-inner">
          <div class="rg-hero-badge">
            <i class="fa-solid fa-circle-plus"></i>
            Free Listing
          </div>
          <h1>List your business on PCMC Diary</h1>
          <p>Reach thousands of local customers across Pimpri-Chinchwad. Free listing, upgrade anytime.</p>
        </div>
      </div>

      <!-- Info grid -->
      <div class="rg-info">
        <div class="rg-info-card">
          <div class="rg-info-icon" style="background:linear-gradient(135deg,#dc2626,#991b1b)">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <h3>Quick & Simple</h3>
          <p>Fill the form once. Our team verifies and lists your business within 24 hours.</p>
        </div>
        <div class="rg-info-card">
          <div class="rg-info-icon" style="background:linear-gradient(135deg,#059669,#047857)">
            <i class="fa-solid fa-indian-rupee-sign"></i>
          </div>
          <h3>Start Free</h3>
          <p>Free listing is always available. Upgrade to paid plans only when ready.</p>
        </div>
        <div class="rg-info-card">
          <div class="rg-info-icon" style="background:linear-gradient(135deg,#7c3aed,#5b21b6)">
            <i class="fa-solid fa-headset"></i>
          </div>
          <h3>Dedicated Support</h3>
          <p>Our team helps you complete the listing and choose the right plan.</p>
        </div>
      </div>

      <!-- Form section -->
      <div class="rg-form-wrap">
        <div class="rg-form-head">
          <div class="rg-form-eyebrow">
            <i class="fa-solid fa-pen-to-square"></i>
            Registration Form
          </div>
          <h2>Tell us about your business</h2>
          <p>Fill in the details below. We will contact you on WhatsApp to confirm and activate your listing.</p>
        </div>

        <form
          class="rg-form"
          id="registerForm"
          action="https://formsubmit.co/info@pcmcdiary.com"
          method="POST"
        >
          <!-- Hidden fields -->
          <input type="hidden" name="_subject" value="New Business Registration — PCMC Diary" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <input type="text"   name="_honey" style="display:none" />
          <input type="hidden" name="json_data" id="jsonDataField" />

          <!-- Business identity -->
          <div class="rg-section-title"><i class="fa-solid fa-store"></i> Business Identity</div>

          <div class="rg-row">
            <div class="rg-field">
              <label>Business Name <span>*</span></label>
              <input type="text" id="businessName" name="businessName" placeholder="e.g. Shubh Griha Housekeeping" required />
            </div>
            <div class="rg-field">
              <label>Owner Name <span>*</span></label>
              <input type="text" name="ownerName" placeholder="Your full name" required />
            </div>
          </div>

          <div class="rg-row">
            <div class="rg-field">
              <label>Phone / WhatsApp <span>*</span></label>
              <input type="tel" id="phone" name="phone" placeholder="+91 98765 43210" required />
            </div>
            <div class="rg-field">
              <label>Email</label>
              <input type="email" id="email" name="email" placeholder="your@email.com" />
            </div>
          </div>

          <!-- Category & location -->
          <div class="rg-section-title"><i class="fa-solid fa-location-dot"></i> Category & Location</div>

          <div class="rg-row">
            <div class="rg-field">
              <label>Category <span>*</span></label>
              <select id="subCategory" name="subCategory" required>
                <option value="">Select category</option>
                {categories.map(c => <option value={c}>{c}</option>)}
              </select>
            </div>
            <div class="rg-field">
              <label>Sub-Category / Service</label>
              <input type="text" id="service" name="service" placeholder="e.g. Housekeeping, Deep Cleaning" />
            </div>
          </div>

          <div class="rg-row">
            <div class="rg-field">
              <label>Primary Location <span>*</span></label>
              <select id="location" name="location" required>
                <option value="">Select area</option>
                {locations.map(l => <option value={l.name} data-pincode={l.pincode} data-lat={l.lat} data-lng={l.lng}>{l.name}</option>)}
              </select>
            </div>
            <div class="rg-field">
              <label>Pincode <span>*</span></label>
              <input type="text" id="pincode" name="pincode" placeholder="411035" required />
            </div>
          </div>

          <div class="rg-field">
            <label>Full Address <span>*</span></label>
            <textarea id="address" name="address" rows="2" placeholder="Shop / building name, street, landmark, pincode" required></textarea>
          </div>

          <div class="rg-field">
            <label>Service Area (comma separated areas)</label>
            <input type="text" id="serviceArea" name="serviceArea" placeholder="Akurdi,Nigdi,Chinchwad" />
            <div class="rg-hint">
              <i class="fa-solid fa-circle-info"></i>
              Pincodes will be auto-detected from these areas.
            </div>
          </div>

          <div class="rg-row">
            <div class="rg-field">
              <label>Location Count</label>
              <select id="locationCount" name="locationCount">
                <option value="1">1 location</option>
                <option value="3">3 locations</option>
                <option value="ALL">All PCMC (ALL)</option>
              </select>
            </div>
            <div class="rg-field">
              <label>Timing</label>
              <input type="text" id="timing" name="timing" placeholder="Mon-Sun 9AM-9PM" />
            </div>
          </div>

          <div class="rg-row">
            <div class="rg-field">
              <label>Latitude</label>
              <input type="text" id="latitude" name="latitude" placeholder="18.6198" />
            </div>
            <div class="rg-field">
              <label>Longitude</label>
              <input type="text" id="longitude" name="longitude" placeholder="73.7635" />
            </div>
          </div>

          <!-- Online presence -->
          <div class="rg-section-title"><i class="fa-solid fa-globe"></i> Online Presence</div>

          <div class="rg-row">
            <div class="rg-field">
              <label>Website (if any)</label>
              <input type="text" id="website" name="website" placeholder="yourbusiness.in" />
            </div>
            <div class="rg-field">
              <label>Google Maps Link (if any)</label>
              <input type="text" id="googleMap" name="googleMap" placeholder="maps.google.com/..." />
            </div>
          </div>

          <div class="rg-field">
            <label>Social Links (comma separated, prefix type: insta:, fb:, yt:)</label>
            <input type="text" id="socialLinks" name="socialLinks" placeholder="insta:instagram.com/yourbrand,fb:facebook.com/yourbrand" />
            <div class="rg-hint">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              No need to type https:// — the system adds it automatically.
            </div>
          </div>

          <!-- Description & tags -->
          <div class="rg-section-title"><i class="fa-solid fa-tags"></i> Description & Tags</div>

          <div class="rg-field">
            <label>Short Description (max 200 chars)</label>
            <textarea id="description" name="description" rows="3" maxlength="200" placeholder="What does your business do? What makes it special?"></textarea>
          </div>

          <div class="rg-field">
            <label>Tags (comma separated)</label>
            <input type="text" id="tags" name="tags" placeholder="Housekeeping,Cleaning,Home" />
          </div>

          <!-- Deals -->
          <div class="rg-section-title"><i class="fa-solid fa-gift"></i> Deal / Offer (optional)</div>

          <div class="rg-row">
            <div class="rg-field">
              <label>Deal / Offer</label>
              <input type="text" id="deals" name="deals" placeholder="10% OFF on deep cleaning" />
            </div>
            <div class="rg-field">
              <label>Deal Code</label>
              <input type="text" id="dealCode" name="dealCode" placeholder="SHUBH10" />
            </div>
          </div>

          <div class="rg-field">
            <label>Deal Expiry</label>
            <input type="date" id="dealExpiry" name="dealExpiry" />
          </div>

          <!-- Terms -->
          <label class="rg-terms">
            <input type="checkbox" required />
            <span>I agree to the <a href="/terms" target="_blank">Terms &amp; Conditions</a> and <a href="/privacy" target="_blank">Privacy Policy</a> of PCMC Diary.</span>
          </label>

          <!-- Submit -->
          <button type="submit" class="rg-submit">
            <i class="fa-solid fa-paper-plane"></i>
            Submit Registration
          </button>

          <div class="rg-form-note">
            <i class="fa-solid fa-shield-halved"></i>
            <span>We'll contact you within 24 hours on WhatsApp. Your data is safe with us.</span>
          </div>
        </form>

        <!-- JSON Preview -->
        <div class="rg-json-wrap">
          <div class="rg-json-head">
            <div><i class="fa-solid fa-code"></i> JSON Preview (submitted with your form)</div>
            <button type="button" class="rg-json-copy" id="copyJson"><i class="fa-solid fa-copy"></i> Copy</button>
          </div>
          <pre class="rg-json" id="jsonPreview">{}</pre>
        </div>
      </div>

      <!-- Help card -->
      <div class="rg-help">
        <div class="rg-help-icon"><i class="fa-solid fa-circle-question"></i></div>
        <div class="rg-help-text">
          <h4>Need help with registration?</h4>
          <p>Message us on WhatsApp — we'll help you complete the form.</p>
        </div>
        <a href="https://wa.me/918793932827" target="_blank" rel="noopener" class="rg-help-btn">
          <i class="fa-brands fa-whatsapp"></i>
          WhatsApp us
        </a>
      </div>

    </div>
  </div>

  <script define:vars={{ locations }}>
    // ================================================================
    // 1. LOCATION LOOKUP (name → pincode)
    // ================================================================
    const locationMap = {};
    locations.forEach(l => {
      locationMap[l.name.toLowerCase()] = l.pincode;
    });

    function lookupPincode(name) {
      if (!name) return '';
      return locationMap[name.trim().toLowerCase()] || '';
    }

    // Build servicePincodes from serviceArea string
    function detectServicePincodes(serviceArea, primaryPincode) {
      // If service area is empty, fall back to the primary pincode
      if (!serviceArea || !serviceArea.trim()) {
        return primaryPincode || '';
      }

      const names = serviceArea.split(',').map(s => s.trim()).filter(Boolean);
      const pincodes = [];

      for (const name of names) {
        const pc = lookupPincode(name);
        if (pc && !pincodes.includes(pc)) {
          pincodes.push(pc);
        }
      }

      // If nothing matched (user typed unknown areas), fall back to primary
      if (pincodes.length === 0 && primaryPincode) {
        return primaryPincode;
      }

      return pincodes.join(',');
    }

    // ================================================================
    // 2. URL NORMALIZATION
    // ================================================================
    // Adds https:// if missing, strips spaces, keeps existing http(s):// intact.
    function normalizeUrl(val) {
      if (!val) return '';
      val = String(val).trim();
      if (!val) return '';
      // Remove accidental internal spaces
      val = val.replace(/\s+/g, '');
      // Already has a protocol?
      if (!/^https?:\/\//i.test(val)) {
        val = 'https://' + val;
      }
      return val;
    }

    // Normalize social links: "insta:user,fb:page" → "insta:https://instagram.com/...,fb:https://facebook.com/..."
    // Handles: missing protocol, plain URLs without prefix, "www." prefix.
    function normalizeSocialLinks(val) {
      if (!val) return '';
      const parts = String(val).split(',');

      return parts
        .map(part => {
          part = part.trim();
          if (!part) return '';

          // If it already starts with http(s)://, treat the whole thing as a URL
          if (/^https?:\/\//i.test(part)) {
            return normalizeUrl(part);
          }

          // Otherwise check for "type:url" — but only if the prefix isn't a protocol
          const idx = part.indexOf(':');
          if (idx > 0 && idx < 20) {
            const prefix = part.slice(0, idx).trim().toLowerCase();
            // Skip if prefix itself looks like a protocol
            if (['http', 'https', 'ftp', 'mailto', 'tel'].includes(prefix)) {
              return normalizeUrl(part);
            }
            const url = part.slice(idx + 1).trim();
            return prefix + ':' + normalizeUrl(url);
          }

          // No prefix — just normalize the URL
          return normalizeUrl(part);
        })
        .filter(Boolean)
        .join(',');
    }

    // ================================================================
    // 3. BUSINESS ID GENERATOR (letters only, no & or other symbols)
    // ================================================================
    function makeBusinessId(cat) {
      const catCode = (cat || 'GEN')
        .replace(/[^A-Za-z\s]/g, ' ')   // strip &, /, -, digits
        .split(/\s+/)
        .filter(Boolean)
        .map(w => w[0])
        .join('')
        .toUpperCase()
        .slice(0, 3) || 'GEN';
      const num = String(Date.now()).slice(-4);
      return catCode + num;
    }

    // ================================================================
    // 4. AUTO-FILL from location select
    // ================================================================
    const locSel   = document.getElementById('location');
    const pincodeI = document.getElementById('pincode');
    const latI     = document.getElementById('latitude');
    const lngI     = document.getElementById('longitude');

    locSel.addEventListener('change', () => {
      const opt = locSel.options[locSel.selectedIndex];
      if (!opt || !opt.value) return;
      pincodeI.value = opt.dataset.pincode || '';
      latI.value     = opt.dataset.lat || '';
      lngI.value     = opt.dataset.lng || '';
      updateJson();
    });

    // ================================================================
    // 5. BUILD JSON PAYLOAD
    // ================================================================
    const form = document.getElementById('registerForm');
    const jsonField = document.getElementById('jsonDataField');
    const jsonPreview = document.getElementById('jsonPreview');

    function buildJson() {
      const get = id => {
        const el = document.getElementById(id);
        return el ? (el.value || '').trim() : '';
      };

      const cat = get('subCategory');
      const serviceArea = get('serviceArea');
      const primaryPincode = get('pincode');

      const data = {
        businessId:      makeBusinessId(cat),
        businessName:    get('businessName'),
        subCategory:     get('service') ? `${cat} / ${get('service')}` : cat,
        location:        get('location'),
        pincode:         primaryPincode,
        address:         get('address'),
        phone:           get('phone'),
        email:           get('email'),
        website:         normalizeUrl(get('website')),
        googleMap:       normalizeUrl(get('googleMap')),
        latitude:        get('latitude'),
        longitude:       get('longitude'),
        serviceArea:     serviceArea,
        servicePincodes: detectServicePincodes(serviceArea, primaryPincode),
        locationCount:   get('locationCount') || '1',
        description:     get('description'),
        tier:            'free',
        socialLinks:     normalizeSocialLinks(get('socialLinks')),
        timing:          get('timing'),
        featured:        'FALSE',
        premium:         'FALSE',
        verified:        'FALSE',
        unclaimed:       'FALSE',
        tags:            get('tags'),
        rating:          '0',
        reviews:         '0',
        deals:           get('deals') || '-',
        dealCode:        get('dealCode') || '-',
        dealExpiry:      get('dealExpiry') || '-'
      };

      return data;
    }

    function updateJson() {
      const data = buildJson();
      const pretty = JSON.stringify(data, null, 2);
      if (jsonPreview) jsonPreview.textContent = pretty;
      if (jsonField) jsonField.value = pretty;
      return data;
    }

    // Live update on every input/change
    form.addEventListener('input', updateJson);
    form.addEventListener('change', updateJson);

    // Ensure JSON is set right before submit
    form.addEventListener('submit', () => {
      const data = buildJson();
      const pretty = JSON.stringify(data, null, 2);
      jsonField.value = pretty;
      jsonPreview.textContent = pretty;
    });

    // Initial render
    updateJson();

    // Copy JSON
    const copyBtn = document.getElementById('copyJson');
    copyBtn?.addEventListener('click', () => {
      const txt = jsonPreview.textContent || '';
      navigator.clipboard.writeText(txt).then(() => {
        copyBtn.innerHTML = '<i class="fa-solid fa-check"></i> Copied';
        setTimeout(() => {
          copyBtn.innerHTML = '<i class="fa-solid fa-copy"></i> Copy';
        }, 1600);
      });
    });
  </script>

</BaseLayout>

<style is:global>
.rg-page { background: #f8fafc; min-height: 60vh; padding: 0 0 72px; }
.rg-wrap { max-width: 960px; margin: 0 auto; padding: 0 20px; }

/* HERO */
.rg-hero {
  background: linear-gradient(135deg, #b91c1c 0%, #7f1d1d 60%, #450a0a 100%);
  color: #fff;
  padding: 48px 32px 80px;
  border-radius: 0 0 28px 28px;
  text-align: center;
  position: relative;
  overflow: hidden;
  margin: 0 -20px 0;
}
.rg-hero-bg {
  position: absolute; inset: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(255,255,255,0.06) 1px, transparent 1px),
    radial-gradient(circle at 80% 70%, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 60px 60px, 80px 80px;
  opacity: 0.6;
}
.rg-hero-inner { position: relative; z-index: 2; max-width: 640px; margin: 0 auto; }
.rg-hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 7px 16px;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 50px;
  font-size: 11px; font-weight: 800;
  letter-spacing: 1px; text-transform: uppercase;
  color: #fde047; margin-bottom: 16px;
  backdrop-filter: blur(10px);
}
.rg-hero h1 {
  font-size: 36px; font-weight: 800;
  letter-spacing: -1px; line-height: 1.15;
  margin: 0 0 12px;
}
.rg-hero p { font-size: 15px; color: rgba(255,255,255,0.85); line-height: 1.6; margin: 0; }

/* INFO CARDS */
.rg-info {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 16px; margin-top: -44px; margin-bottom: 40px;
  position: relative; z-index: 3;
}
.rg-info-card {
  background: #fff; border: 1px solid #e2e8f0;
  border-radius: 16px; padding: 22px; text-align: center;
  box-shadow: 0 12px 32px -16px rgba(15,23,42,0.15);
}
.rg-info-icon {
  width: 48px; height: 48px; border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 14px; color: #fff; font-size: 20px;
  box-shadow: 0 8px 20px -8px rgba(15,23,42,0.3);
}
.rg-info-card h3 { font-size: 15px; font-weight: 800; color: #0f172a; margin: 0 0 8px; letter-spacing: -0.2px; }
.rg-info-card p { font-size: 12.5px; color: #64748b; line-height: 1.55; margin: 0; }

/* FORM WRAP */
.rg-form-wrap {
  background: #fff; border: 1px solid #e2e8f0;
  border-radius: 22px; padding: 40px 44px;
  box-shadow: 0 20px 48px -24px rgba(15,23,42,0.12);
}
.rg-form-head { margin-bottom: 32px; }
.rg-form-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 5px 12px;
