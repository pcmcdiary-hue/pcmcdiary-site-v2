---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = await getCollection('articles');

const experts = [
  { name: 'Dr. Advisor', slug: 'dr-advisor', aliases: ['Dr. Saala'], tagline: 'Health & Wellness', desc: 'Medical advice, symptoms, prevention aur healthy living tips — verified doctors se.', icon: 'fa-user-doctor', color: '#dc2626', gradient: 'linear-gradient(135deg, #dc2626, #991b1b)', category: 'Health' },
  { name: 'Arthik Advisor', slug: 'arthik-advisor', aliases: ['Arthik Saala'], tagline: 'Money & Finance', desc: 'Tax, investment, GST, loan aur savings ke practical tips — CA aur finance experts se.', icon: 'fa-indian-rupee-sign', color: '#059669', gradient: 'linear-gradient(135deg, #059669, #047857)', category: 'Finance' },
  { name: 'Vastu Advisor', slug: 'vastu-advisor', aliases: ['Vastu Saala'], tagline: 'Vastu & Home', desc: 'Ghar, office aur shop ke liye simple Vastu tips — bina tod-phod ke.', icon: 'fa-house-chimney', color: '#d97706', gradient: 'linear-gradient(135deg, #d97706, #b45309)', category: 'Vastu' },
  { name: 'Fit Advisor', slug: 'fit-advisor', aliases: ['Fit Saala'], tagline: 'Fitness & Diet', desc: 'Workout, weight loss, diet plan aur gym tips — certified trainers se.', icon: 'fa-dumbbell', color: '#7c3aed', gradient: 'linear-gradient(135deg, #7c3aed, #6d28d9)', category: 'Fitness' },
  { name: 'Kanoon Advisor', slug: 'kanoon-advisor', aliases: ['Kanoon Saala'], tagline: 'Legal Advice', desc: 'Property, family, consumer aur business law ke simple explanations.', icon: 'fa-scale-balanced', color: '#0f172a', gradient: 'linear-gradient(135deg, #334155, #0f172a)', category: 'Legal' },
  { name: 'Rashi Advisor', slug: 'rashi-advisor', aliases: ['Rashi Saala'], tagline: 'Astrology', desc: 'Daily rashi, weekly predictions aur astrology insights.', icon: 'fa-star', color: '#0891b2', gradient: 'linear-gradient(135deg, #0891b2, #0e7490)', category: 'Astrology' },
  { name: 'Career Advisor', slug: 'career-advisor', aliases: ['Career Saala'], tagline: 'Jobs & Career', desc: 'Resume tips, interview prep, skill development aur job search guidance.', icon: 'fa-briefcase', color: '#2563eb', gradient: 'linear-gradient(135deg, #2563eb, #1d4ed8)', category: 'Career' },
  { name: 'Beauty Advisor', slug: 'beauty-advisor', aliases: ['Beauty Saala'], tagline: 'Beauty & Skin', desc: 'Skin care, hair care aur beauty tips — dermatologist approved.', icon: 'fa-spa', color: '#db2777', gradient: 'linear-gradient(135deg, #db2777, #be185d)', category: 'Beauty' },
  { name: 'Food Advisor', slug: 'food-advisor', aliases: ['Food Saala'], tagline: 'Food & Recipes', desc: 'PCMC ke best restaurants, recipes aur food reviews.', icon: 'fa-utensils', color: '#ea580c', gradient: 'linear-gradient(135deg, #ea580c, #c2410c)', category: 'Food' },
  { name: 'Tech Advisor', slug: 'tech-advisor', aliases: ['Tech Saala'], tagline: 'Tech & Gadgets', desc: 'Mobile, laptop, apps aur tech reviews — simple bhasha me.', icon: 'fa-microchip', color: '#475569', gradient: 'linear-gradient(135deg, #64748b, #334155)', category: 'Tech' }
];

function countArticles(expert) {
  const names = [expert.name, ...(expert.aliases || [])];
  return articles.filter(a => names.includes(a.data.expert)).length;
}

function latestArticles(expert, limit = 3) {
  const names = [expert.name, ...(expert.aliases || [])];
  return articles
    .filter(a => names.includes(a.data.expert))
    .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
    .slice(0, limit);
}

const totalArticles = articles.length;
const activeExperts = experts.filter(e => countArticles(e) > 0).length;
---

<BaseLayout
  title="Expert Advice — PCMC Diary"
  description="PCMC ke top experts se Health, Finance, Vastu, Legal, Career aur zyada topics pe trusted articles. Sirf PCMC Diary pe."
>

  <div class="experts-page">

    <section class="experts-hero">
      <div class="hero-inner">
        <div class="hero-badge">
          <i class="fa-solid fa-award"></i> Expert Advice
        </div>
        <h1>PCMC Ke <span class="hl">Top Experts</span> Se Seekho</h1>
        <p class="hero-sub">
          Health, Finance, Vastu, Legal, Career aur zyada — har topic pe trusted advice.
          Sirf verified experts se. Sirf PCMC Diary pe.
        </p>
        <div class="hero-stats">
          <div class="hs-item">
            <div class="hs-num">{activeExperts}</div>
            <div class="hs-lbl">Active Experts</div>
          </div>
          <div class="hs-div"></div>
          <div class="hs-item">
            <div class="hs-num">{totalArticles}</div>
            <div class="hs-lbl">Articles Published</div>
          </div>
          <div class="hs-div"></div>
          <div class="hs-item">
            <div class="hs-num">10K+</div>
            <div class="hs-lbl">Monthly Readers</div>
          </div>
        </div>
      </div>
    </section>

    <section class="experts-section">
      <div class="section-inner">

        <div class="section-head">
          <h2><i class="fa-solid fa-users-viewfinder"></i> All Experts</h2>
          <p>Har expert apne field ka master hai. Click karo aur unke articles padho.</p>
        </div>

        <div class="experts-grid">
          {experts.map((expert) => {
            const count = countArticles(expert);
            const latest = latestArticles(expert);
            return (
              <div class="expert-card" style={`--accent: ${expert.color};`}>

                <div class="expert-head">
                  <div class="expert-icon" style={`background: ${expert.gradient};`}>
                    <i class={`fa-solid ${expert.icon}`}></i>
                  </div>
                  <div class="expert-title">
                    <h3>{expert.name}</h3>
                    <span class="expert-tag">{expert.tagline}</span>
                  </div>
                  {count > 0 && (
                    <div class="expert-count">{count}</div>
                  )}
                </div>

                <p class="expert-desc">{expert.desc}</p>

                {latest.length > 0 ? (
                  <div class="expert-articles">
                    <div class="ea-label">
                      <i class="fa-solid fa-fire"></i> Latest Articles
                    </div>
                    {latest.map((article) => (
                      <a href={`/article/${article.slug}`} class="ea-item">
                        <i class="fa-solid fa-file-lines"></i>
                        <span>{article.data.title}</span>
                      </a>
                    ))}
                  </div>
                ) : (
                  <div class="expert-coming-soon">
                    <i class="fa-solid fa-hourglass-half"></i>
                    <span>Articles coming soon</span>
                  </div>
                )}

                <a href={`/search/label/${expert.slug}`} class="expert-cta">
                  {count > 0 ? `Read All ${count} Articles` : 'Coming Soon'}
                  <i class="fa-solid fa-arrow-right"></i>
                </a>

              </div>
            );
          })}
        </div>

      </div>
    </section>

    <section class="sponsor-cta">
      <div class="cta-inner">
        <div class="cta-icon-wrap">
          <i class="fa-solid fa-bullhorn"></i>
        </div>
        <div class="cta-content">
          <h3>Apne Business Ko Promote Karo</h3>
          <p>PCMC ke 10,000+ readers tak pahuncho. Expert article sponsorship se apna brand grow karo.</p>
        </div>
        <a href="/sponsor-package" class="cta-btn">
          Sponsor Now <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </section>

    <section class="writer-cta">
      <div class="writer-inner">
        <div class="writer-icon">
          <i class="fa-solid fa-pen-fancy"></i>
        </div>
        <div class="writer-content">
          <h3>Aap Expert Ho? PCMC Diary Pe Likho</h3>
          <p>Apni expertise share karo aur PCMC community ki madad karo. Free publishing platform.</p>
        </div>
        <a href="/contact" class="writer-btn">
          Apply as Writer <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </section>

  </div>

</BaseLayout>

<style is:global>
.experts-page { background: #f8fafc; min-height: 60vh; }

.experts-hero { background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #334155 100%); padding: 72px 24px 80px; position: relative; overflow: hidden; color: #fff; }
.experts-hero::before { content: ''; position: absolute; top: -60px; right: -60px; width: 320px; height: 320px; background: radial-gradient(circle, rgba(220,38,38,0.22) 0%, transparent 70%); border-radius: 50%; }
.experts-hero::after { content: ''; position: absolute; bottom: -80px; left: -60px; width: 280px; height: 280px; background: radial-gradient(circle, rgba(251,191,36,0.15) 0%, transparent 70%); border-radius: 50%; }
.hero-inner { max-width: 980px; margin: 0 auto; text-align: center; position: relative; z-index: 2; }
.hero-badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 18px; background: linear-gradient(135deg, #dc2626, #991b1b); border: 1px solid rgba(255,255,255,0.15); border-radius: 50px; font-size: 12px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 22px; box-shadow: 0 12px 30px -10px rgba(220,38,38,0.6); }
.hero-badge i { font-size: 12px; color: #fbbf24; }
.experts-hero h1 { font-size: 48px; font-weight: 800; line-height: 1.1; letter-spacing: -1.6px; margin: 0 0 18px; }
.experts-hero h1 .hl { background: linear-gradient(135deg, #fbbf24, #d97706); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.hero-sub { font-size: 17px; line-height: 1.6; color: rgba(255,255,255,0.75); max-width: 640px; margin: 0 auto 40px; }
.hero-stats { display: inline-flex; align-items: center; gap: 32px; padding: 20px 36px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; backdrop-filter: blur(12px); }
.hs-item { text-align: center; }
.hs-num { font-size: 28px; font-weight: 800; color: #fbbf24; letter-spacing: -0.8px; line-height: 1; margin-bottom: 6px; }
.hs-lbl { font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.8px; }
.hs-div { width: 1px; height: 36px; background: rgba(255,255,255,0.15); }

.experts-section { padding: 64px 24px 32px; }
.section-inner { max-width: 1200px; margin: 0 auto; }
.section-head { text-align: center; margin-bottom: 44px; }
.section-head h2 { font-size: 32px; font-weight: 800; color: #0f172a; letter-spacing: -0.8px; margin: 0 0 10px; display: inline-flex; align-items: center; gap: 12px; }
.section-head h2 i { color: #dc2626; font-size: 26px; }
.section-head p { font-size: 15px; color: #64748b; margin: 0 auto; max-width: 520px; }

.experts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 22px; }
.expert-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 28px; display: flex; flex-direction: column; transition: all 0.25s ease; position: relative; overflow: hidden; }
.expert-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--accent); opacity: 0; transition: opacity 0.25s; }
.expert-card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 20px 40px -20px rgba(15,23,42,0.2); }
.expert-card:hover::before { opacity: 1; }
.expert-head { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
.expert-icon { width: 58px; height: 58px; border-radius: 16px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 22px; flex-shrink: 0; box-shadow: 0 10px 22px -10px rgba(15,23,42,0.4); }
.expert-title { flex: 1; min-width: 0; }
.expert-title h3 { font-size: 19px; font-weight: 800; color: #0f172a; margin: 0 0 4px; letter-spacing: -0.3px; }
.expert-tag { font-size: 11.5px; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.8px; }
.expert-count { padding: 6px 12px; background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; border-radius: 50px; font-size: 12px; font-weight: 800; flex-shrink: 0; }
.expert-desc { font-size: 13.5px; line-height: 1.6; color: #64748b; margin: 0 0 18px; }

.expert-articles { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 14px 16px; margin-bottom: 18px; flex: 1; }
.ea-label { font-size: 11px; font-weight: 800; color: #dc2626; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
.ea-label i { font-size: 10px; }
.ea-item { display: flex; align-items: flex-start; gap: 10px; padding: 8px 0; border-bottom: 1px dashed #e2e8f0; text-decoration: none; color: #334155; font-size: 13px; font-weight: 600; line-height: 1.4; transition: color 0.2s; }
.ea-item:last-child { border-bottom: none; padding-bottom: 0; }
.ea-item:first-child { padding-top: 0; }
.ea-item i { color: #94a3b8; font-size: 11px; margin-top: 3px; flex-shrink: 0; }
.ea-item:hover { color: #dc2626; }
.ea-item:hover i { color: #dc2626; }

.expert-coming-soon { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 22px 16px; background: linear-gradient(135deg, #fefce8, #fef9c3); border: 1.5px dashed #fde047; border-radius: 14px; margin-bottom: 18px; flex: 1; color: #854d0e; font-size: 13px; font-weight: 700; }
.expert-coming-soon i { font-size: 16px; color: #ca8a04; }

.expert-cta { display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 13px 22px; background: linear-gradient(135deg, #0f172a, #1e293b); color: #fff; border-radius: 12px; font-size: 13.5px; font-weight: 800; text-decoration: none; transition: all 0.2s; margin-top: auto; }
.expert-cta:hover { background: linear-gradient(135deg, var(--accent), #0f172a); transform: translateY(-2px); text-decoration: none; box-shadow: 0 12px 24px -10px rgba(15,23,42,0.4); }
.expert-cta i { font-size: 11px; transition: transform 0.2s; }
.expert-cta:hover i { transform: translateX(3px); }

.sponsor-cta { padding: 32px 24px; max-width: 1200px; margin: 0 auto; }
.cta-inner { display: flex; align-items: center; gap: 26px; padding: 36px 40px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-radius: 24px; color: #fff; flex-wrap: wrap; box-shadow: 0 30px 60px -30px rgba(15,23,42,0.5); position: relative; overflow: hidden; }
.cta-inner::before { content: ''; position: absolute; top: -40px; right: -40px; width: 200px; height: 200px; background: radial-gradient(circle, rgba(251,191,36,0.15), transparent 70%); border-radius: 50%; }
.cta-icon-wrap { width: 64px; height: 64px; border-radius: 18px; background: rgba(251,191,36,0.12); border: 1px solid rgba(251,191,36,0.3); color: #fbbf24; display: flex; align-items: center; justify-content: center; font-size: 26px; flex-shrink: 0; position: relative; z-index: 1; }
.cta-content { flex: 1; min-width: 240px; position: relative; z-index: 1; }
.cta-content h3 { font-size: 20px; font-weight: 800; margin: 0 0 6px; letter-spacing: -0.3px; }
.cta-content p { font-size: 14px; color: rgba(255,255,255,0.7); margin: 0; line-height: 1.55; max-width: 500px; }
.cta-btn { display: inline-flex; align-items: center; gap: 9px; padding: 14px 28px; background: linear-gradient(135deg, #fbbf24, #d97706); color: #0f0a0a; border-radius: 12px; font-size: 14px; font-weight: 800; text-decoration: none; transition: all 0.2s; box-shadow: 0 14px 30px -10px rgba(212,160,23,0.6); white-space: nowrap; position: relative; z-index: 1; }
.cta-btn:hover { transform: translateY(-2px); text-decoration: none; box-shadow: 0 18px 36px -10px rgba(212,160,23,0.7); }
.cta-btn i { font-size: 11px; transition: transform 0.2s; }
.cta-btn:hover i { transform: translateX(3px); }

.writer-cta { padding: 32px 24px 80px; max-width: 1200px; margin: 0 auto; }
.writer-inner { display: flex; align-items: center; gap: 24px; padding: 32px 40px; background: linear-gradient(135deg, #fef2f2, #fff); border: 1.5px solid #fecaca; border-radius: 24px; flex-wrap: wrap; }
.writer-icon { width: 60px; height: 60px; border-radius: 16px; background: linear-gradient(135deg, #dc2626, #991b1b); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0; box-shadow: 0 12px 24px -10px rgba(220,38,38,0.5); }
.writer-content { flex: 1; min-width: 240px; }
.writer-content h3 { font-size: 19px; font-weight: 800; color: #0f172a; margin: 0 0 6px; letter-spacing: -0.3px; }
.writer-content p { font-size: 13.5px; color: #64748b; margin: 0; line-height: 1.55; max-width: 500px; }
.writer-btn { display: inline-flex; align-items: center; gap: 9px; padding: 13px 26px; background: linear-gradient(135deg, #dc2626, #991b1b); color: #fff; border-radius: 12px; font-size: 13.5px; font-weight: 800; text-decoration: none; transition: all 0.2s; box-shadow: 0 12px 26px -10px rgba(220,38,38,0.5); white-space: nowrap; }
.writer-btn:hover { transform: translateY(-2px); text-decoration: none; box-shadow: 0 16px 32px -10px rgba(220,38,38,0.6); }
.writer-btn i { font-size: 11px; transition: transform 0.2s; }
.writer-btn:hover i { transform: translateX(3px); }

@media (max-width: 768px) {
  .experts-hero { padding: 52px 18px 60px; }
  .experts-hero h1 { font-size: 32px; letter-spacing: -1px; }
  .hero-sub { font-size: 15px; margin-bottom: 32px; }
  .hero-stats { padding: 16px 24px; gap: 20px; flex-wrap: wrap; justify-content: center; }
  .hs-num { font-size: 22px; }
  .hs-lbl { font-size: 10px; }
  .experts-section { padding: 44px 16px 20px; }
  .section-head h2 { font-size: 24px; }
  .section-head h2 i { font-size: 20px; }
  .section-head p { font-size: 14px; }
  .experts-grid { grid-template-columns: 1fr; gap: 18px; }
  .expert-card { padding: 24px 22px; border-radius: 18px; }
  .expert-icon { width: 52px; height: 52px; font-size: 20px; border-radius: 14px; }
  .expert-title h3 { font-size: 17px; }
  .expert-desc { font-size: 13px; }
  .cta-inner { padding: 28px 24px; border-radius: 20px; text-align: center; justify-content: center; }
  .cta-content h3 { font-size: 17px; }
  .cta-content p { font-size: 13px; }
  .cta-btn { width: 100%; justify-content: center; }
  .writer-inner { padding: 26px 22px; border-radius: 20px; text-align: center; justify-content: center; }
  .writer-content h3 { font-size: 17px; }
  .writer-content p { font-size: 13px; }
  .writer-btn { width: 100%; justify-content: center; }
  .sponsor-cta, .writer-cta { padding-left: 16px; padding-right: 16px; }
  .writer-cta { padding-bottom: 56px; }
}
</style>
