---
import BaseLayout from '../layouts/BaseLayout.astro';

const DATA = {
  gateway: 'UroPay',
  gatewayRole: 'Secure Payment Processing Partner',
  logo: '/logo.png',
  paymentLink: 'https://p.urpy.link/WdXI'
};
---

<BaseLayout title="Payment" description="Secure payment page for PCMC Diary — choose a plan and pay via UroPay.">

  <div class="pay-page">
    <div class="pay-wrap">

      <div class="pay-card">

        <!-- Header -->
        <div class="pay-head">
          <div class="pay-logo">
            <img src={DATA.logo} alt="PCMC Diary" />
          </div>

          <div class="pay-badge">
            <span class="pay-dot"></span>
            Secure Payment
          </div>

          <h1>Secure Payment Portal</h1>
          <p class="pay-sub">
            Official payment page for PCMC Diary. Choose your plan below and complete payment securely via UroPay.
          </p>

          <div class="pay-trust">
            <span><i class="fa-solid fa-lock"></i> UPI Protected</span>
            <span><i class="fa-solid fa-bolt"></i> Instant Payment</span>
            <span><i class="fa-solid fa-circle-check"></i> Verified Gateway</span>
            <span><i class="fa-solid fa-circle-check"></i> No Extra Fees</span>
          </div>
        </div>

        <!-- Gateway card -->
        <div class="pay-panel">
          <div class="panel-head">
            <div>
              <div class="panel-eyebrow">Secure Payment Gateway</div>
              <div class="panel-name">{DATA.gateway}</div>
            </div>
            <div class="panel-status">
              <span class="panel-dot"></span>
              Active &amp; Verified
            </div>
          </div>

          <div class="payee">
            <div class="payee-top">
              <i class="fa-solid fa-shield-halved"></i>
              <span>Official Payment Gateway</span>
            </div>
            <div class="payee-name">{DATA.gateway}</div>
            <div class="payee-role">{DATA.gatewayRole}</div>
            <div class="payee-badge">
              <i class="fa-solid fa-circle-check"></i>
              PCMC Diary Verified Gateway
            </div>
          </div>

          <!-- Plan selection -->
          <div class="plan-section">
            <h3 class="plan-heading">Choose Your Plan</h3>
            <p class="plan-sub">Tap the plan you want. You can change it any time before paying.</p>

            <div class="plan-grid" id="planGrid">

              <!-- Verified Basic -->
              <label class="plan-card" data-plan="vb" data-name="Verified Basic" data-price="99" data-price-label="₹99">
                <input type="radio" name="pcmc-plan" class="plan-radio" value="99">
                <span class="plan-check">✓</span>
                <div class="plan-av plan-av-vb"><i class="fa-solid fa-circle-check"></i></div>
                <div class="plan-name">Verified Basic</div>
                <div class="plan-price">₹99</div>
                <div class="plan-meta">per year · 3 areas · Verified badge</div>
                <span class="plan-pick">Select this plan</span>
              </label>

              <!-- Verified Pro -->
              <label class="plan-card" data-plan="vp" data-name="Verified Pro" data-price="199" data-price-label="₹199">
                <input type="radio" name="pcmc-plan" class="plan-radio" value="199">
                <span class="plan-check">✓</span>
                <div class="plan-av plan-av-vp"><i class="fa-solid fa-shield-halved"></i></div>
                <div class="plan-name">Verified Pro</div>
                <div class="plan-price">₹199</div>
                <div class="plan-meta">per year · All 33 locations · Top 20</div>
                <span class="plan-pick">Select this plan</span>
              </label>

              <!-- Premium (default) -->
              <label class="plan-card is-selected" data-plan="premium" data-name="Premium" data-price="499" data-price-label="₹499">
                <input type="radio" name="pcmc-plan" class="plan-radio" value="499" checked>
                <span class="plan-check">✓</span>
                <div class="plan-popular">Most Popular</div>
                <div class="plan-av plan-av-premium"><i class="fa-solid fa-crown"></i></div>
                <div class="plan-name">Premium</div>
                <div class="plan-price">₹499</div>
                <div class="plan-meta">per year · Top 10 · WhatsApp + Coupon</div>
                <span class="plan-pick">Selected</span>
              </label>

              <!-- Premium Pro -->
              <label class="plan-card" data-plan="pp" data-name="Premium Pro" data-price="999" data-price-label="₹999">
                <input type="radio" name="pcmc-plan" class="plan-radio" value="999">
                <span class="plan-check">✓</span>
                <div class="plan-av plan-av-pp"><i class="fa-solid fa-gem"></i></div>
                <div class="plan-name">Premium Pro</div>
                <div class="plan-price">₹999</div>
                <div class="plan-meta">per year · Top 5 · Webpage + Priority support</div>
                <span class="plan-pick">Select this plan</span>
              </label>

            </div>

            <!-- Selected summary -->
            <div class="plan-summary" id="planSummary">
              <div class="summary-label">
                Selected plan: <strong id="sumName">Premium</strong>
              </div>
              <div class="summary-price" id="sumPrice">₹499</div>
            </div>
          </div>
        </div>

        <!-- How to pay -->
        <div class="pay-how">
          <h3>
            <i class="fa-solid fa-shield-halved"></i>
            How to complete your payment
          </h3>
          <div class="how-grid">
            <div class="how-item">
              <div class="how-num">1</div>
              <div class="how-title">Select Plan</div>
              <div class="how-desc">Choose the plan that fits your business above.</div>
            </div>
            <div class="how-item">
              <div class="how-num">2</div>
              <div class="how-title">Click Proceed</div>
              <div class="how-desc">Press the “Proceed to Secure Payment” button below.</div>
            </div>
            <div class="how-item">
              <div class="how-num">3</div>
              <div class="how-title">Enter Amount</div>
              <div class="how-desc">On UroPay, enter the <strong>exact amount</strong> for your plan.</div>
            </div>
            <div class="how-item">
              <div class="how-num">4</div>
              <div class="how-title">Pay Securely</div>
              <div class="how-desc">Pay via UPI, Card, or Netbanking. UroPay emails your receipt.</div>
            </div>
          </div>
        </div>

        <!-- CTA Button -->
        <a id="payBtn" href={DATA.paymentLink} class="btn-proceed" target="_blank" rel="noopener">
          <span id="payBtnLabel">Proceed to Secure Payment — ₹499 →</span>
        </a>

        <!-- Footer note -->
        <div class="pay-foot">
          <span class="foot-line"></span>
          <span>PCMC Diary · Secure Payment via UroPay</span>
          <span class="foot-line"></span>
        </div>

      </div>

      <!-- Need help? -->
      <div class="pay-help">
        <div class="pay-help-icon"><i class="fa-solid fa-headset"></i></div>
        <div class="pay-help-text">
          <h4>Payment not going through?</h4>
          <p>Reach out to us on WhatsApp — we usually reply within minutes.</p>
        </div>
        <a href="https://wa.me/918793932827" target="_blank" rel="noopener" class="pay-help-btn">
          <i class="fa-brands fa-whatsapp"></i>
          Contact on WhatsApp
        </a>
      </div>

    </div>
  </div>

  <!-- Toast -->
  <div class="pay-toast" id="toast" role="status" aria-live="polite"></div>

</BaseLayout>

<script define:vars={{ paymentLink: DATA.paymentLink }}>
  // Toast
  const toast = document.getElementById('toast');
  function showToast(msg) {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toast._t);
    toast._t = setTimeout(() => toast.classList.remove('show'), 2400);
  }

  // Plan selection
  const cards    = Array.from(document.querySelectorAll('.plan-card'));
  const sumName  = document.getElementById('sumName');
  const sumPrice = document.getElementById('sumPrice');
  const payLabel = document.getElementById('payBtnLabel');
  const payBtn   = document.getElementById('payBtn');

  function selectPlan(card) {
    cards.forEach(c => {
      const isThis = (c === card);
      c.classList.toggle('is-selected', isThis);

      const radio = c.querySelector('.plan-radio');
      if (radio) radio.checked = isThis;

      const pick = c.querySelector('.plan-pick');
      if (pick) pick.textContent = isThis ? 'Selected' : 'Select this plan';
    });

    const name  = card.getAttribute('data-name')  || '';
    const label = card.getAttribute('data-price-label') || '';

    if (sumName)  sumName.textContent = name;
    if (sumPrice) sumPrice.textContent = label;
    if (payLabel) payLabel.textContent = 'Proceed to Secure Payment — ' + label + ' →';
    if (payBtn)   payBtn.href = paymentLink;

    showToast('✓ ' + name + ' selected');
  }

  cards.forEach(card => {
    card.addEventListener('click', e => {
      e.preventDefault();
      selectPlan(card);
    });

    const radio = card.querySelector('.plan-radio');
    if (radio) {
      radio.addEventListener('change', () => {
        if (radio.checked) selectPlan(card);
      });
    }
  });

  // Apply default state on load
  const initial = document.querySelector('.plan-card.is-selected') || cards[2] || cards[0];
  if (initial) selectPlan(initial);
</script>

<style is:global>
/* ---------- BASE ---------- */
.pay-page {
  background: linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
  min-height: 70vh;
  padding: 44px 0 72px;
}
.pay-wrap {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 20px;
}
.pay-card {
  position: relative;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 18px 40px -16px rgba(15,23,42,0.12), 0 8px 16px -8px rgba(15,23,42,0.06);
}
.pay-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: linear-gradient(90deg, #b91c1c, #d97706);
}

/* HEAD */
.pay-head { padding: 36px 32px 0; text-align: center; }
.pay-logo {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 10px 18px; background: #fff;
  border: 1px solid #e2e8f0; border-radius: 12px;
  box-shadow: 0 1px 3px rgba(15,23,42,0.04);
}
.pay-logo img { display: block; max-width: 150px; max-height: 60px; object-fit: contain; }
.pay-badge {
  display: inline-flex; align-items: center; gap: 8px;
  margin-top: 20px; padding: 8px 14px;
  background: #f1f5f9; color: #1e293b;
  border: 1px solid #cbd5e1; border-radius: 999px;
  font-size: 10.5px; font-weight: 800;
  letter-spacing: 0.8px; text-transform: uppercase;
}
.pay-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: #16a34a;
  box-shadow: 0 0 0 3px rgba(22,163,74,0.15);
}
.pay-head h1 {
  font-size: 32px; font-weight: 800;
  letter-spacing: -0.8px; color: #0f172a;
  line-height: 1.15; margin: 18px 0 12px;
}
.pay-sub {
  max-width: 540px; margin: 0 auto;
  color: #64748b; font-size: 14.5px;
  line-height: 1.65; font-weight: 500;
}
.pay-trust {
  display: flex; flex-wrap: wrap; justify-content: center;
  gap: 8px; margin-top: 22px;
}
.pay-trust span {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 12px; background: #fafbfc;
  border: 1px solid #e2e8f0; border-radius: 999px;
  font-size: 11.5px; font-weight: 700; color: #475569;
}
.pay-trust i { color: #16a34a; font-size: 11px; }

/* PANEL */
.pay-panel {
  margin: 28px 24px 24px; background: #fff;
  border: 1px solid #e2e8f0; border-radius: 18px; overflow: hidden;
}
.panel-head {
  display: flex; justify-content: space-between; align-items: center;
  gap: 16px; padding: 16px 22px;
  background: #f8fafc; border-bottom: 1px solid #e2e8f0;
  flex-wrap: wrap;
}
.panel-eyebrow {
  font-size: 9.5px; font-weight: 800; color: #0891b2;
  letter-spacing: 0.9px; text-transform: uppercase;
}
.panel-name {
  font-size: 17px; font-weight: 800; color: #0f172a;
  margin-top: 3px; letter-spacing: -0.2px;
}
.panel-status {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 6px 12px; background: #ecfdf5; color: #065f46;
  border: 1px solid #a7f3d0; border-radius: 999px;
  font-size: 11px; font-weight: 800;
}
.panel-dot { width: 6px; height: 6px; border-radius: 50%; background: #16a34a; }

.payee {
  margin: 20px 22px; padding: 18px;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border: 1px solid #bae6fd; border-radius: 14px;
}
.payee-top {
  display: flex; align-items: center; gap: 9px;
  color: #0369a1; font-size: 10.5px; font-weight: 800;
  letter-spacing: 0.7px; text-transform: uppercase;
}
.payee-top i { font-size: 11px; }
.payee-name {
  font-size: 18px; font-weight: 800; color: #0f172a;
  margin-top: 10px; letter-spacing: -0.3px;
}
.payee-role {
  font-size: 12.5px; color: #475569; margin-top: 3px; font-weight: 500;
}
.payee-badge {
  display: inline-flex; align-items: center; gap: 6px;
  margin-top: 12px; padding: 5px 10px;
  background: #ecfdf5; color: #065f46;
  border: 1px solid #a7f3d0; border-radius: 999px;
  font-size: 10.5px; font-weight: 800;
}
.payee-badge i { font-size: 10px; }

/* ---------- PLAN SELECTION ---------- */
.plan-section { padding: 0 22px 24px; }
.plan-heading {
  font-size: 14px; font-weight: 800; color: #0f172a;
  text-transform: uppercase; letter-spacing: 0.06em;
  margin: 0 0 6px; text-align: center;
}
.plan-sub {
  text-align: center; font-size: 12.5px;
  color: #64748b; margin: 0 0 20px;
}
.plan-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  margin-bottom: 16px;
}
.plan-card {
  position: relative;
  display: block;
  cursor: pointer;
  border: 2px solid #e2e8f0;
  border-radius: 14px;
  padding: 20px 14px 16px;
  text-align: center;
  background: #fff;
  transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease, background 0.18s ease;
}
.plan-card:hover {
  border-color: #fecaca;
  transform: translateY(-2px);
  box-shadow: 0 14px 26px -18px rgba(15,23,42,0.35);
}
.plan-card.is-selected {
  border-color: #b91c1c;
  background: linear-gradient(135deg, #fef2f2 0%, #fff7ed 100%);
  box-shadow: 0 16px 32px -18px rgba(185,28,28,0.45);
}
.plan-card:has(.plan-radio:focus-visible) {
  outline: 3px solid #fca5a5;
  outline-offset: 3px;
}
.plan-radio {
  position: absolute; opacity: 0;
  width: 1px; height: 1px; margin: 0;
  pointer-events: none;
}
.plan-check {
  position: absolute; top: 10px; right: 10px;
  width: 22px; height: 22px; border-radius: 50%;
  background: #b91c1c; color: #fff;
  font-size: 12px; font-weight: 900; line-height: 22px;
  text-align: center; display: none;
  box-shadow: 0 4px 10px -2px rgba(185,28,28,0.6);
}
.plan-card.is-selected .plan-check { display: block; }

.plan-popular {
  position: absolute; top: -10px; left: 50%;
  transform: translateX(-50%);
  background: #b91c1c; color: #fff;
  font-size: 9px; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.08em;
  padding: 4px 12px; border-radius: 100px;
  white-space: nowrap;
}

.plan-av {
  width: 44px; height: 44px;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 10px;
  border-radius: 12px;
  color: #fff;
  font-size: 18px;
}
.plan-av-vb { background: linear-gradient(135deg, #34d399, #059669); }
.plan-av-vp { background: linear-gradient(135deg, #22d3ee, #0891b2); }
.plan-av-premium { background: linear-gradient(135deg, #fbbf24, #b45309); }
.plan-av-pp { background: linear-gradient(135deg, #a78bfa, #7c3aed); }

.plan-name {
  font-size: 15px; font-weight: 800;
  color: #0f172a; margin-bottom: 6px;
}
.plan-price {
  font-size: 26px; font-weight: 900;
  color: #0f172a; letter-spacing: -0.02em;
  line-height: 1.1;
}
.plan-meta {
  font-size: 11.5px; color: #64748b;
  margin-top: 8px; line-height: 1.45;
}
.plan-pick {
  display: inline-block; margin-top: 12px;
  font-size: 10.5px; font-weight: 800;
  letter-spacing: 0.04em; text-transform: uppercase;
  color: #b91c1c;
}
.plan-card.is-selected .plan-pick { color: #7f1d1d; }

/* summary */
.plan-summary {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; flex-wrap: wrap;
  background: #fef2f2; border: 1px solid #fecaca;
  border-radius: 12px; padding: 14px 18px;
  margin-top: 6px;
}
.summary-label { font-size: 13px; color: #7f1d1d; font-weight: 600; }
.summary-label strong { color: #450a0a; }
.summary-price {
  font-size: 20px; font-weight: 900;
  color: #450a0a; letter-spacing: -0.02em;
}

/* CTA */
.btn-proceed {
  display: block; text-align: center;
  margin: 0 24px 24px;
  background: linear-gradient(135deg, #b91c1c 0%, #991b1b 100%);
  color: #fff; text-decoration: none;
  font-size: 17px; font-weight: 800;
  padding: 20px 32px; border-radius: 14px;
  box-shadow: 0 10px 28px -6px rgba(185,28,28,0.5);
  transition: transform 0.2s, box-shadow 0.2s;
}
.btn-proceed:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 32px -6px rgba(185,28,28,0.6);
}

/* HOW */
.pay-how {
  margin: 0 24px 24px; padding: 22px;
  background: #fff; border: 1px solid #e2e8f0;
  border-radius: 14px;
}
.pay-how h3 {
  display: flex; align-items: center; gap: 9px;
  font-size: 14px; font-weight: 800; color: #0f172a;
  margin: 0 0 16px;
}
.pay-how h3 i { color: #b91c1c; font-size: 14px; }
.how-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
.how-item {
  padding: 16px 12px; background: #f8fafc;
  border: 1px solid #e2e8f0; border-radius: 12px;
  text-align: center; transition: all 0.2s;
}
.how-item:hover {
  border-color: #cbd5e1; transform: translateY(-2px);
  box-shadow: 0 8px 16px -8px rgba(15,23,42,0.1);
}
.how-num {
  width: 30px; height: 30px;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 10px;
  background: linear-gradient(135deg, #b91c1c, #991b1b);
  color: #fff; border-radius: 50%;
  font-size: 13px; font-weight: 800;
}
.how-title {
  font-size: 12.5px; font-weight: 800;
  color: #0f172a; margin-bottom: 6px;
}
.how-desc {
  font-size: 11.5px; color: #64748b;
  line-height: 1.45; font-weight: 500;
}
.how-desc strong { color: #0f172a; font-weight: 700; }

/* FOOT */
.pay-foot {
  display: flex; align-items: center; justify-content: center;
  gap: 14px; padding: 0 24px 22px;
  font-size: 11px; font-weight: 700; color: #94a3b8;
}
.foot-line {
  flex: 1; max-width: 90px; height: 1px; background: #e2e8f0;
}

/* HELP CARD */
.pay-help {
  display: flex; align-items: center; gap: 18px;
  margin-top: 20px; padding: 22px 24px;
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  border-radius: 18px; color: #fff;
  flex-wrap: wrap;
  box-shadow: 0 16px 32px -16px rgba(15,23,42,0.35);
}
.pay-help-icon {
  width: 52px; height: 52px; border-radius: 14px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  display: flex; align-items: center; justify-content: center;
  color: #fbbf24; font-size: 20px; flex-shrink: 0;
}
.pay-help-text { flex: 1; min-width: 200px; }
.pay-help-text h4 {
  font-size: 15px; font-weight: 800;
  margin: 0 0 4px; letter-spacing: -0.2px;
}
.pay-help-text p {
  font-size: 12.5px; opacity: 0.75;
  margin: 0; line-height: 1.5;
}
.pay-help-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 22px;
  background: linear-gradient(135deg, #25d366, #15803d);
  color: #fff; border-radius: 11px;
  font-size: 13px; font-weight: 800;
  text-decoration: none; transition: all 0.2s;
  box-shadow: 0 10px 22px -8px rgba(37,211,102,0.5);
  white-space: nowrap;
}
.pay-help-btn:hover {
  transform: translateY(-2px);
  text-decoration: none;
  box-shadow: 0 14px 28px -8px rgba(37,211,102,0.6);
}

/* TOAST */
.pay-toast {
  position: fixed; left: 50%; bottom: 28px;
  z-index: 9999;
  max-width: calc(100vw - 32px);
  padding: 12px 20px;
  background: #0f172a; color: #fff;
  border-radius: 999px;
  font-size: 13px; font-weight: 700;
  box-shadow: 0 16px 32px -12px rgba(15,23,42,0.4);
  opacity: 0; pointer-events: none;
  transform: translate(-50%, 60px);
  transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
  white-space: nowrap;
  font-family: system-ui, -apple-system, sans-serif;
}
.pay-toast.show { opacity: 1; transform: translate(-50%, 0); }

/* RESPONSIVE */
@media (max-width: 760px) {
  .how-grid { grid-template-columns: repeat(2, 1fr); }
  .pay-help { text-align: center; justify-content: center; }
  .pay-help-btn { width: 100%; justify-content: center; }
}
@media (max-width: 520px) {
  .pay-page { padding: 24px 0 48px; }
  .pay-wrap { padding: 0 12px; }
  .pay-head { padding: 26px 20px 0; }
  .pay-head h1 { font-size: 24px; }
  .pay-sub { font-size: 13.5px; }
