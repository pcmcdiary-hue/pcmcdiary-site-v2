---
import BaseLayout from '../layouts/BaseLayout.astro';

const DATA = {
  name: 'Sachin Ambekar',
  role: 'Authorised Payment Collection Partner',
  upi: 'BHARATPE09B9S1M8C3G33183@yesbankltd',
  qr: '/qr.png',
  logo: '/logo.png'
};
---

<BaseLayout title="Payment" description="Secure UPI payment page for PCMC Diary — scan QR or copy UPI ID.">

  <div class="pay-page">
    <div class="pay-wrap">

      <div class="pay-card">

        <!-- Header -->
        <div class="pay-head">
          <div class="pay-logo">
            <img src={DATA.logo} alt="PCMC Diary" />
          </div>

          <div class="pay-badge">
            <span class="pay-dot"></span>
            Secure UPI Payment
          </div>

          <h1>Secure Payment Portal</h1>
          <p class="pay-sub">
            Official payment page for PCMC Diary. Scan the QR code or copy the UPI ID to make your payment using any UPI app.
          </p>

          <div class="pay-trust">
            <span><i class="fa-solid fa-lock"></i> UPI Protected</span>
            <span><i class="fa-solid fa-bolt"></i> Instant Payment</span>
            <span><i class="fa-solid fa-circle-check"></i> Verified Recipient</span>
            <span><i class="fa-solid fa-circle-check"></i> No Extra Fees</span>
          </div>
        </div>

        <!-- Recipient card -->
        <div class="pay-panel">
          <div class="panel-head">
            <div>
              <div class="panel-eyebrow">Verified Payment Recipient</div>
              <div class="panel-name">{DATA.name}</div>
            </div>
            <div class="panel-status">
              <span class="panel-dot"></span>
              Active &amp; Verified
            </div>
          </div>

          <div class="payee">
            <div class="payee-top">
              <i class="fa-solid fa-user"></i>
              <span>Authorised Collection Partner</span>
            </div>
            <div class="payee-name">{DATA.name}</div>
            <div class="payee-role">{DATA.role}</div>
            <div class="payee-badge">
              <i class="fa-solid fa-circle-check"></i>
              PCMC Diary Verified Merchant
            </div>
          </div>

          <!-- QR + UPI grid -->
          <div class="pay-grid">

            <!-- QR card -->
            <div class="qr-card">
              <div class="qr-title">Scan &amp; Pay with any UPI App</div>
              <button class="qr-frame" id="qrFrame" type="button" aria-label="Enlarge QR Code">
                <img src={DATA.qr} alt={`UPI QR Code for ${DATA.name}`} />
              </button>
              <div class="qr-hint">Tap the QR code to enlarge</div>

              <div class="qr-apps-wrap">
                <div class="qr-apps-label">Accepted on all major UPI apps</div>
                <div class="qr-apps">
                  <div class="qr-app" title="PhonePe">PhonePe</div>
                  <div class="qr-app" title="Google Pay">GPay</div>
                  <div class="qr-app" title="Paytm">Paytm</div>
                  <div class="qr-app" title="BHIM">BHIM</div>
                </div>
                <button class="btn-dl" id="dlBtn" type="button">
                  <i class="fa-solid fa-download"></i>
                  Download QR Code
                </button>
              </div>
            </div>

            <!-- UPI card -->
            <div class="upi-card">
              <div class="upi-title">
                <span class="upi-title-icon">@</span>
                Official UPI ID
              </div>

              <p class="upi-desc">
                Use the UPI ID below in your preferred banking or UPI app. Never share your UPI PIN with anyone.
              </p>

              <div class="upi-box">
                <div class="upi-label">UPI ID · Copy to Pay</div>
                <div class="upi-value" id="upiValue">{DATA.upi}</div>
              </div>

              <button class="btn-copy" id="copyBtn" type="button">
                <i class="fa-regular fa-copy"></i>
                <span>Copy UPI ID</span>
              </button>

              <div class="secure-note">
                <i class="fa-solid fa-shield-halved"></i>
                <span>
                  <strong>Security Check:</strong> After scanning, your UPI app must show
                  <strong>{DATA.name}</strong>. Continue only when the displayed recipient matches.
                </span>
              </div>
            </div>

          </div>
        </div>

        <!-- How to pay -->
        <div class="pay-how">
          <h3>
            <i class="fa-solid fa-shield-halved"></i>
            How to complete your payment
          </h3>
          <div class="how-grid">
            <div class="how-item">
              <div class="how-num">1</div>
              <div class="how-title">Scan QR</div>
              <div class="how-desc">Open PhonePe, GPay, Paytm or BHIM and scan the QR code.</div>
            </div>
            <div class="how-item">
              <div class="how-num">2</div>
              <div class="how-title">Verify Name</div>
              <div class="how-desc">Confirm the recipient is <strong>{DATA.name}</strong> before paying.</div>
            </div>
            <div class="how-item">
              <div class="how-num">3</div>
              <div class="how-title">Enter Amount</div>
              <div class="how-desc">Enter the exact amount requested by PCMC Diary.</div>
            </div>
            <div class="how-item">
              <div class="how-num">4</div>
              <div class="how-title">Authorize</div>
              <div class="how-desc">Review the details and enter your UPI PIN.</div>
            </div>
          </div>
        </div>

        <!-- Footer note -->
        <div class="pay-foot">
          <span class="foot-line"></span>
          <span>PCMC Diary · Secure UPI Payment</span>
          <span class="foot-line"></span>
        </div>

      </div>

      <!-- Need help? -->
      <div class="pay-help">
        <div class="pay-help-icon"><i class="fa-solid fa-headset"></i></div>
        <div class="pay-help-text">
          <h4>Payment not going through?</h4>
          <p>Reach out to us on WhatsApp — we usually reply within minutes.</p>
        </div>
        <a href="https://wa.me/918793932827" target="_blank" rel="noopener" class="pay-help-btn">
          <i class="fa-brands fa-whatsapp"></i>
          Contact on WhatsApp
        </a>
      </div>

    </div>
  </div>

  <!-- Toast -->
  <div class="pay-toast" id="toast" role="status" aria-live="polite"></div>

  <!-- Lightbox -->
  <div class="pay-lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged QR Code">
    <div class="lightbox-content">
      <button class="lightbox-close" id="lightboxClose" aria-label="Close">
        <i class="fa-solid fa-xmark"></i>
      </button>
      <img src={DATA.qr} alt="Enlarged UPI QR Code" />
    </div>
  </div>

</BaseLayout>

<script define:vars={{ upiValue: DATA.upi, userName: DATA.name, qrUrl: DATA.qr }}>
  // Toast
  const toast = document.getElementById('toast');
  function showToast(msg) {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toast._t);
    toast._t = setTimeout(() => toast.classList.remove('show'), 2400);
  }

  // Copy UPI
  const copyBtn = document.getElementById('copyBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(upiValue);
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = upiValue;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (_) {}
        ta.remove();
      }
      copyBtn.innerHTML = '<i class="fa-solid fa-circle-check"></i><span>Copied Successfully</span>';
      copyBtn.classList.add('copied');
      showToast('✓ UPI ID copied to clipboard');
      setTimeout(() => {
        copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i><span>Copy UPI ID</span>';
        copyBtn.classList.remove('copied');
      }, 2000);
    });
  }

  // Download QR
  const dlBtn = document.getElementById('dlBtn');
  if (dlBtn) {
    dlBtn.addEventListener('click', async () => {
      try {
        const res = await fetch(qrUrl, { mode: 'cors' });
        if (!res.ok) throw new Error('failed');
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'PCMC-QR-' + userName.replace(/\s+/g, '_') + '.png';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        showToast('✓ QR Code downloaded');
      } catch (e) {
        window.open(qrUrl, '_blank');
        showToast('QR opened in new tab — save from there');
      }
    });
  }

  // Lightbox
  const lightbox = document.getElementById('lightbox');
  const qrFrame = document.getElementById('qrFrame');
  const lightboxClose = document.getElementById('lightboxClose');

  function openLightbox() { lightbox?.classList.add('open'); }
  function closeLightbox() { lightbox?.classList.remove('open'); }

  qrFrame?.addEventListener('click', openLightbox);
  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox?.classList.contains('open')) closeLightbox();
  });
</script>

<style is:global>
.pay-page {
  background: linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
  min-height: 70vh;
  padding: 44px 0 72px;
}
.pay-wrap {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 20px;
}

.pay-card {
  position: relative;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 18px 40px -16px rgba(15,23,42,0.12), 0 8px 16px -8px rgba(15,23,42,0.06);
}
.pay-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: linear-gradient(90deg, #b91c1c, #d97706);
}

/* HEAD */
.pay-head {
  padding: 36px 32px 0;
  text-align: center;
}
.pay-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 18px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  box-shadow: 0 1px 3px rgba(15,23,42,0.04);
}
.pay-logo img {
  display: block;
  max-width: 150px;
  max-height: 60px;
  object-fit: contain;
}
.pay-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 20px;
  padding: 8px 14px;
  background: #f1f5f9;
  color: #1e293b;
  border: 1px solid #cbd5e1;
  border-radius: 999px;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.8px;
  text-transform: uppercase;
}
.pay-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: #16a34a;
  box-shadow: 0 0 0 3px rgba(22,163,74,0.15);
}
.pay-head h1 {
  font-size: 32px;
  font-weight: 800;
  letter-spacing: -0.8px;
  color: #0f172a;
  line-height: 1.15;
  margin: 18px 0 12px;
}
.pay-sub {
  max-width: 540px;
  margin: 0 auto;
  color: #64748b;
  font-size: 14.5px;
  line-height: 1.65;
  font-weight: 500;
}
.pay-trust {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  margin-top: 22px;
}
.pay-trust span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  background: #fafbfc;
  border: 1px solid #e2e8f0;
  border-radius: 999px;
  font-size: 11.5px;
  font-weight: 700;
  color: #475569;
}
.pay-trust i { color: #16a34a; font-size: 11px; }

/* PANEL */
.pay-panel {
  margin: 28px 24px 24px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  overflow: hidden;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 16px 22px;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
  flex-wrap: wrap;
}
.panel-eyebrow {
  font-size: 9.5px;
  font-weight: 800;
  color: #0891b2;
  letter-spacing: 0.9px;
  text-transform: uppercase;
}
.panel-name {
  font-size: 17px;
  font-weight: 800;
  color: #0f172a;
  margin-top: 3px;
  letter-spacing: -0.2px;
}
.panel-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 12px;
  background: #ecfdf5;
  color: #065f46;
  border: 1px solid #a7f3d0;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
}
.panel-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: #16a34a;
}

.payee {
  margin: 20px 22px;
  padding: 18px;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border: 1px solid #bae6fd;
  border-radius: 14px;
}
.payee-top {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #0369a1;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.7px;
  text-transform: uppercase;
}
.payee-top i { font-size: 11px; }
.payee-name {
  font-size: 18px;
  font-weight: 800;
  color: #0f172a;
  margin-top: 10px;
  letter-spacing: -0.3px;
}
.payee-role {
  font-size: 12.5px;
  color: #475569;
  margin-top: 3px;
  font-weight: 500;
}
.payee-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 12px;
  padding: 5px 10px;
  background: #ecfdf5;
  color: #065f46;
  border: 1px solid #a7f3d0;
  border-radius: 999px;
  font-size: 10.5px;
  font-weight: 800;
}
.payee-badge i { font-size: 10px; }

/* GRID */
.pay-grid {
  display: grid;
  grid-template-columns: minmax(260px, 300px) minmax(0, 1fr);
  gap: 20px;
  padding: 0 22px 24px;
}

/* QR */
.qr-card {
  padding: 22px;
  text-align: center;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
}
.qr-title {
  font-size: 13px;
  font-weight: 800;
  color: #0f172a;
}
.qr-frame {
  display: block;
  width: 220px;
  height: 220px;
  margin: 16px auto 12px;
  padding: 12px;
  background: #fff;
  border: 1px solid #cbd5e1;
  border-radius: 14px;
  box-shadow: 0 8px 20px -8px rgba(15,23,42,0.15);
  cursor: zoom-in;
  transition: all 0.22s cubic-bezier(0.4,0,0.2,1);
  font-family: inherit;
}
.qr-frame:hover {
  transform: translateY(-3px);
  border-color: #94a3b8;
  box-shadow: 0 16px 32px -12px rgba(15,23,42,0.2);
}
.qr-frame img {
  width: 100%; height: 100%;
  object-fit: contain;
  display: block;
}
.qr-hint {
  font-size: 11.5px;
  color: #64748b;
  font-weight: 600;
}

.qr-apps-wrap {
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px dashed #e2e8f0;
}
.qr-apps-label {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.7px;
  text-transform: uppercase;
  color: #94a3b8;
  margin-bottom: 10px;
}
.qr-apps {
  display: flex;
  justify-content: center;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 14px;
}
.qr-app {
  padding: 6px 12px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 800;
  color: #475569;
  transition: all 0.2s;
}
.qr-app:hover {
  border-color: #94a3b8;
  transform: translateY(-1px);
}

.btn-dl {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  width: 100%;
  padding: 11px 14px;
  background: #f1f5f9;
  color: #0f172a;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  font-size: 12.5px;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.2s;
}
.btn-dl i { font-size: 12px; }
.btn-dl:hover {
  background: #e2e8f0;
  border-color: #cbd5e1;
  transform: translateY(-1px);
}

/* UPI */
.upi-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
}
.upi-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 15px;
  font-weight: 800;
  color: #0f172a;
}
.upi-title-icon {
  width: 32px; height: 32px;
  display: flex; align-items: center; justify-content: center;
  background: #1e293b;
  color: #fff;
  border-radius: 9px;
  font-size: 14px;
  font-weight: 800;
}
.upi-desc {
  margin-top: 10px;
  color: #64748b;
  font-size: 12.5px;
  line-height: 1.6;
}
.upi-box {
  margin-top: 18px;
  padding: 16px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  box-shadow: 0 1px 2px rgba(15,23,42,0.03);
}
.upi-label {
  font-size: 10px;
  font-weight: 800;
  color: #94a3b8;
  letter-spacing: 0.7px;
  text-transform: uppercase;
}
.upi-value {
  margin-top: 8px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 14.5px;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.45;
  word-break: break-all;
  user-select: all;
}

.btn-copy {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  margin-top: 14px;
  padding: 13px 16px;
  background: linear-gradient(135deg, #b91c1c, #991b1b);
