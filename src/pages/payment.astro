  color: #334155;
}
.secure-note i {
  color: #0369a1;
  font-size: 14px;
  flex-shrink: 0;
  margin-top: 2px;
}
.secure-note strong { color: #0f172a; font-weight: 800; }

/* HOW */
.pay-how {
  margin: 0 24px 24px;
  padding: 22px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
}
.pay-how h3 {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 14px;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 16px;
}
.pay-how h3 i { color: #b91c1c; font-size: 14px; }

.how-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
.how-item {
  padding: 16px 12px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  text-align: center;
  transition: all 0.2s;
}
.how-item:hover {
  border-color: #cbd5e1;
  transform: translateY(-2px);
  box-shadow: 0 8px 16px -8px rgba(15,23,42,0.1);
}
.how-num {
  width: 30px; height: 30px;
  display: flex; align-items: center; justify-content: center;
