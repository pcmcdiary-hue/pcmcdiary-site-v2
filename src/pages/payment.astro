  font-weight: 800;
}
.how-title {
  font-size: 12.5px;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 6px;
}
.how-desc {
  font-size: 11.5px;
  color: #64748b;
  line-height: 1.45;
  font-weight: 500;
}
.how-desc strong { color: #0f172a; font-weight: 700; }

/* FOOT */
.pay-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 0 24px 22px;
  font-size: 11px;
  font-weight: 700;
  color: #94a3b8;
}
.foot-line {
  flex: 1;
  max-width: 90px;
  height: 1px;
  background: #e2e8f0;
}

/* HELP CARD */
.pay-help {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 20px;
  padding: 22px 24px;
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  border-radius: 18px;
  color: #fff;
  flex-wrap: wrap;
  box-shadow: 0 16px 32px -16px rgba(15,23,42,0.35);
}
.pay-help-icon {
  width: 52px; height: 52px;
  border-radius: 14px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  display: flex; align-items: center; justify-content: center;
  color: #fbbf24;
  font-size: 20px;
  flex-shrink: 0;
}
.pay-help-text { flex: 1; min-width: 200px; }
