---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  // Sab kuch function ke andar — no scope issues
  const expertSlugs = {
    'dr-saala':     { name: 'Dr. Saala',     tagline: 'Health & Wellness', icon: 'fa-user-doctor',       color: '#dc2626' },
    'arthik-saala': { name: 'Arthik Saala',  tagline: 'Money & Finance',   icon: 'fa-indian-rupee-sign', color: '#059669' },
    'vastu-saala':  { name: 'Vastu Saala',   tagline: 'Vastu & Home',      icon: 'fa-house-chimney',     color: '#d97706' },
    'fit-saala':    { name: 'Fit Saala',     tagline: 'Fitness & Diet',    icon: 'fa-dumbbell',          color: '#7c3aed' },
    'kanoon-saala': { name: 'Kanoon Saala',  tagline: 'Legal Advice',      icon: 'fa-scale-balanced',    color: '#334155' },
    'rashi-saala':  { name: 'Rashi Saala',   tagline: 'Astrology',         icon: 'fa-star',              color: '#0891b2' },
    'career-saala': { name: 'Career Saala',  tagline: 'Jobs & Career',     icon: 'fa-briefcase',         color: '#2563eb' },
    'beauty-saala': { name: 'Beauty Saala',  tagline: 'Beauty & Skin',     icon: 'fa-spa',               color: '#db2777' },
    'food-saala':   { name: 'Food Saala',    tagline: 'Food & Recipes',    icon: 'fa-utensils',          color: '#ea580c' },
    'tech-saala':   { name: 'Tech Saala',    tagline: 'Tech & Gadgets',    icon: 'fa-microchip',         color: '#475569' }
  };

  return Object.entries(expertSlugs).map(([slug, data]) => ({
    params: { expert: slug },
    props: { expertData: data }
  }));
}

const { expertData } = Astro.props;
const allArticles = await getCollection('articles');
const articles = allArticles
  .filter(a => a.data.expert === expertData.name)
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
---

<BaseLayout 
  title={`${expertData.name} — Expert Salla | PCMC Diary`}
  description={`${expertData.tagline} articles by ${expertData.name} on PCMC Diary.`}
>

  <div class="expert-page">

    <section class="expert-hero" style={`--accent: ${expertData.color};`}>
      <div class="hero-inner">
        <div class="expert-hero-icon">
          <i class={`fa-solid ${expertData.icon}`}></i>
        </div>
        <div class="hero-badge">Expert Salla</div>
        <h1>{expertData.name}</h1>
        <p class="hero-tagline">{expertData.tagline}</p>
        <div class="hero-count">
          <i class="fa-solid fa-file-lines"></i>
          {articles.length} {articles.length === 1 ? 'Article' : 'Articles'}
        </div>
      </div>
    </section>

    <section class="articles-section">
      <div class="articles-inner">

        <nav class="breadcrumb">
          <a href="/"><i class="fa-solid fa-house"></i> Home</a>
          <i class="fa-solid fa-chevron-right sep"></i>
          <a href="/expert-salla">Expert Salla</a>
          <i class="fa-solid fa-chevron-right sep"></i>
          <span>{expertData.name}</span>
        </nav>

        {articles.length > 0 ? (
          <div class="articles-grid">
            {articles.map((article) => (
              <a href={`/article/${article.slug}`} class="article-card">
                <div class="ac-badge" style={`background: ${expertData.color}15; color: ${expertData.color}; border-color: ${expertData.color}40;`}>
                  <i class="fa-solid fa-tag"></i> {article.data.category}
                </div>
                <h2>{article.data.title}</h2>
                {article.data.excerpt && <p>{article.data.excerpt}</p>}
                <div class="ac-meta">
                  <span><i class="fa-solid fa-calendar"></i> {article.data.date}</span>
                  {article.data.readTime && <span><i class="fa-solid fa-clock"></i> {article.data.readTime}</span>}
                </div>
                <div class="ac-read">Read Article <i class="fa-solid fa-arrow-right"></i></div>
              </a>
            ))}
          </div>
        ) : (
          <div class="coming-soon">
            <div class="cs-icon"><i class="fa-solid fa-hourglass-half"></i></div>
            <h3>Coming Soon</h3>
            <p>{expertData.name} ke articles jald hi aa rahe hain.</p>
            <a href="/expert-salla" class="cs-btn">
              <i class="fa-solid fa-arrow-left"></i> Back to All Experts
            </a>
          </div>
        )}

        <div class="back-cta">
          <a href="/expert-salla">
            <i class="fa-solid fa-arrow-left"></i> All Experts
          </a>
        </div>

      </div>
    </section>

  </div>

</BaseLayout>

<style is:global>
.expert-page { background: #f8fafc; min-height: 60vh; padding-bottom: 64px; }
.expert-hero {
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #334155 100%);
  padding: 56px 24px 64px; text-align: center; color: #fff;
  position: relative; overflow: hidden;
}
.expert-hero::before {
  content: ''; position: absolute; top: -80px; right: -60px;
  width: 300px; height: 300px;
  background: radial-gradient(circle, var(--accent, #dc2626), transparent 70%);
  opacity: 0.25; border-radius: 50%;
}
.hero-inner { max-width: 720px; margin: 0 auto; position: relative; z-index: 2; }
.expert-hero-icon {
  width: 80px; height: 80px; border-radius: 24px;
  background: linear-gradient(135deg, var(--accent, #dc2626), rgba(255,255,255,0.15));
  border: 2px solid rgba(255,255,255,0.2); color: #fff;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 32px; margin-bottom: 20px;
  box-shadow: 0 20px 40px -12px rgba(0,0,0,0.4);
}
.hero-badge {
  display: inline-block; padding: 6px 16px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 50px; font-size: 11px; font-weight: 800;
  letter-spacing: 1px; text-transform: uppercase;
  color: #fbbf24; margin-bottom: 14px;
}
.expert-hero h1 {
  font-size: 40px; font-weight: 800; letter-spacing: -1.2px;
  margin: 0 0 10px; line-height: 1.1;
}
.hero-tagline { font-size: 16px; color: rgba(255,255,255,0.7); margin: 0 0 22px; font-weight: 500; }
.hero-count {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 8px 18px; background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 50px; font-size: 13px; font-weight: 700; color: #fbbf24;
}
.hero-count i { font-size: 12px; }
.articles-section { padding: 40px 24px 0; }
.articles-inner { max-width: 1000px; margin: 0 auto; }
.breadcrumb {
  display: flex; align-items: center; gap: 8px;
  font-size: 12.5px; color: #64748b; margin-bottom: 28px; flex-wrap: wrap;
}
.breadcrumb a { color: #475569; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
.breadcrumb a:hover { color: #dc2626; }
.breadcrumb a i { font-size: 11px; }
.breadcrumb .sep { font-size: 9px; opacity: 0.5; }
.breadcrumb span { color: #dc2626; font-weight: 700; }
.articles-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;
}
.article-card {
  display: flex; flex-direction: column; padding: 26px;
  background: #fff; border: 1px solid #e2e8f0; border-radius: 18px;
  text-decoration: none; color: inherit; transition: all 0.25s ease;
}
.article-card:hover {
  transform: translateY(-4px); border-color: #fecaca;
  box-shadow: 0 20px 40px -20px rgba(220,38,38,0.15); text-decoration: none;
}
.ac-badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 12px; border: 1px solid; border-radius: 50px;
  font-size: 10.5px; font-weight: 800; text-transform: uppercase;
  letter-spacing: 0.7px; margin-bottom: 14px; align-self: flex-start;
}
.ac-badge i { font-size: 9px; }
.article-card h2 {
  font-size: 19px; font-weight: 800; color: #0f172a;
  margin: 0 0 12px; line-height: 1.3; letter-spacing: -0.3px;
}
.article-card p { font-size: 13.5px; color: #64748b; line-height: 1.55; margin: 0 0 18px; flex: 1; }
.ac-meta {
  display: flex; gap: 16px; font-size: 12px; color: #94a3b8; font-weight: 600;
  padding-top: 16px; border-top: 1px solid #f1f5f9; margin-bottom: 14px;
}
.ac-meta span { display: inline-flex; align-items: center; gap: 6px; }
.ac-meta i { font-size: 11px; color: #dc2626; }
.ac-read { display: inline-flex; align-items: center; gap: 8px; color: #dc2626; font-weight: 800; font-size: 13px; }
.ac-read i { font-size: 11px; transition: transform 0.2s; }
.article-card:hover .ac-read i { transform: translateX(4px); }
.coming-soon {
  text-align: center; padding: 80px 24px;
  background: linear-gradient(135deg, #fef2f2, #fff);
  border: 1.5px dashed #fecaca; border-radius: 20px;
}
.cs-icon {
  width: 72px; height: 72px; margin: 0 auto 20px;
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
  border-radius: 20px; display: flex; align-items: center; justify-content: center;
  font-size: 28px; color: #dc2626;
}
.coming-soon h3 { font-size: 22px; font-weight: 800; color: #0f172a; margin: 0 0 10px; letter-spacing: -0.4px; }
.coming-soon p { font-size: 14px; color: #64748b; margin: 0 auto 24px; max-width: 400px; line-height: 1.6; }
.cs-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 24px; background: linear-gradient(135deg, #dc2626, #991b1b);
  color: #fff; border-radius: 11px; font-weight: 700; font-size: 13.5px;
  text-decoration: none; transition: all 0.2s;
  box-shadow: 0 10px 24px -8px rgba(220,38,38,0.5);
}
.cs-btn:hover { transform: translateY(-2px); text-decoration: none; box-shadow: 0 14px 30px -8px rgba(220,38,38,0.6); }
.back-cta { text-align: center; margin-top: 40px; }
.back-cta a {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 24px; background: #fff;
  border: 1.5px solid #e2e8f0; border-radius: 50px;
  color: #334155; font-weight: 700; font-size: 13.5px;
  text-decoration: none; transition: all 0.2s;
}
.back-cta a:hover {
  background: #0f172a; color: #fff; border-color: #0f172a;
  transform: translateY(-2px); text-decoration: none;
}
@media (max-width: 768px) {
  .expert-hero { padding: 44px 18px 52px; }
  .expert-hero h1 { font-size: 30px; letter-spacing: -0.8px; }
  .hero-tagline { font-size: 14px; }
  .expert-hero-icon { width: 68px; height: 68px; font-size: 26px; }
  .articles-section { padding: 28px 16px 0; }
  .articles-grid { grid-template-columns: 1fr; gap: 16px; }
  .article-card { padding: 22px; border-radius: 16px; }
  .article-card h2 { font-size: 17px; }
}
</style>
