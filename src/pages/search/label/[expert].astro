---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const expertSlugs = {
  'Dr. Saala': 'dr-saala',
  'Arthik Saala': 'arthik-saala',
  'Vastu Saala': 'vastu-saala',
  'Fit Saala': 'fit-saala',
  'Kanoon Saala': 'kanoon-saala',
  'Rashi Saala': 'rashi-saala',
  'Career Saala': 'career-saala',
  'Beauty Saala': 'beauty-saala',
  'Food Saala': 'food-saala',
  'Tech Saala': 'tech-saala',
};

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const experts = [...new Set(articles.map(a => a.data.expert))];
  return experts.map(expert => ({
    params: { expert: expertSlugs[expert] || 'expert-salla' },
    props: { expert }
  }));
}

const { expert } = Astro.props;
const articles = (await getCollection('articles'))
  .filter(a => a.data.expert === expert)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---
<BaseLayout title={`${expert} Articles - PCMC Diary`} description={`${expert} ke latest articles PCMC Diary par.`}>
  <div class="label-page">
    <div class="label-header">
      <a href="/expert-salla" class="back-link"><i class="fa-solid fa-arrow-left"></i> Expert Salla</a>
      <h1>{expert}</h1>
      <p>{articles.length} articles</p>
    </div>
    <div class="article-list">
      {articles.map(article => (
        <a href={`/article/${article.slug}`} class="list-card">
          <div class="list-cat">{article.data.category}</div>
          <h2>{article.data.title}</h2>
          <p>{article.data.excerpt}</p>
          <div class="list-meta">
            <span><i class="fa-solid fa-calendar"></i> {article.data.date}</span>
            {article.data.readTime && <span><i class="fa-solid fa-clock"></i> {article.data.readTime}</span>}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
.label-page { max-width: 780px; margin: 0 auto; padding: 40px 24px 72px; }
.label-header { margin-bottom: 32px; }
.back-link { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 700; color: #64748b; text-decoration: none; margin-bottom: 16px; }
.back-link:hover { color: #dc2626; }
.label-header h1 { font-size: 36px; font-weight: 800; color: #0f172a; letter-spacing: -1px; margin: 0 0 6px; }
.label-header p { font-size: 14px; color: #64748b; margin: 0; }
.article-list { display: flex; flex-direction: column; gap: 16px; }
.list-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px; text-decoration: none; transition: all 0.2s; }
.list-card:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -12px rgba(15,23,42,0.15); border-color: #cbd5e1; }
.list-cat { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; color: #dc2626; margin-bottom: 8px; }
.list-card h2 { font-size: 20px; font-weight: 800; color: #0f172a; line-height: 1.25; margin: 0 0 8px; letter-spacing: -0.4px; }
.list-card p { font-size: 14px; color: #64748b; line-height: 1.6; margin: 0 0 14px; }
.list-meta { display: flex; gap: 16px; font-size: 12px; color: #94a3b8; font-weight: 600; }
.list-meta i { color: #dc2626; font-size: 11px; margin-right: 5px; }
</style>
